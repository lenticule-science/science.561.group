[Unit]
Description=L-Space Worker-compatible runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/services/l-space
Environment=HOST=127.0.0.1
Environment=PORT=18848
Environment=LSPACE_DATABASE_PATH=/home/emsenn/services/l-space/state/l-space.sqlite
Environment=LSPACE_DIST_DIRECTORY=/home/emsenn/services/l-space/dist
Environment=LSPACE_WORKER_MODULE=/home/emsenn/services/l-space/worker.mjs
Environment=DISCORD_CLIENT_ID=1346540684810915973
Environment=DISCORD_GUILD_ID=1184863861065658419
Environment=TURNTIDE_ISLANDER_ROLE_ID=1184867019988947065
Environment=VAULTMAZE_AUTHORING_ROOT=/home/emsenn/services/l-space-source/lib/emsenn/services/561-group/services/science-services-section
Environment=VAULTMAZE_AUTHORING_REGION=
Environment=LSPACE_AUTHORING_MODULE=/home/emsenn/services/l-space/dist/vps-authoring.mjs
ExecStart=/usr/bin/node /home/emsenn/services/l-space/lib/vps/server.mjs --env-file /home/emsenn/services/l-space/runtime.env
Restart=always
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/emsenn/services/l-space/state /home/emsenn/services/l-space-source

[Install]
WantedBy=default.target
