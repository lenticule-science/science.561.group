{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lenticule-science-knowledge-vault",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-21",
  "workers_dev": false,
  "routes": [{ "pattern": "science.561.group", "custom_domain": true }],
  "vars": {
    "ACCESS_TEAM_DOMAIN": "https://icy-thunder-e8a0.cloudflareaccess.com",
    "ACCESS_AUD": "24b14d8cb3d99de7427c5e93bdd3960dd0247ef53ce2dd33c49b9de1e613c69b"
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "LEARNER_STATE",
    "database_name": "lenticule-science-vaultmaze",
    "database_id": "__LENTICULE_SCIENCE_D1_DATABASE_ID__",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true }
}
