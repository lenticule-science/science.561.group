{
  "name": "@lenticule-science/l-space",
  "version": "0.2.0",
  "type": "module",
  "description": "L-Space: the Lenticule Science knowledge garden, a VICTOR site configured over the science section.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "victor check ../.. --config=./victor.config.mjs",
    "build": "victor build ../.. dist --config=./victor.config.mjs",
    "serve": "victor serve ../.. --config=./victor.config.mjs --port=8561",
    "start": "victor serve ../.. --config=./victor.config.mjs --release --host=127.0.0.1 --port=18848",
    "mcp:start": "node scripts/serve-mcp.mjs",
    "build:mcp": "node scripts/build-mcp-runtime.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@red-cup-engineering/cairn": "0.1.0",
    "@red-cup-engineering/cloudflare-d1-service": "0.1.0",
    "@red-cup-engineering/education-platform-service": "0.2.5",
    "@red-cup-engineering/geode": "0.2.1",
    "@red-cup-engineering/serve-web-admission-service": "0.1.1",
    "@red-cup-engineering/vault-compiler": "0.1.4",
    "@red-cup-engineering/vaultmaze": "0.2.2",
    "@red-cup-engineering/victor": "0.1.15"
  },
  "devDependencies": {
    "@red-cup-engineering/node-runtime-release-materialization-service": "0.6.0"
  }
}
