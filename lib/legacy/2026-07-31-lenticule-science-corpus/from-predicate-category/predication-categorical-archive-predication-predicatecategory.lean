import Mathlib.CategoryTheory.Category.Basic
import Mathlib.CategoryTheory.Functor.Basic
import PredicationCategories.Categorical.PredicateMap

/-!
# The predicate category as a mathlib `Category`

The [predicate category](../../objects/predicate-category.md) `𝒞` has
predicates as objects and morphisms generated by the four classes
(specialization, converse, subject-projection, object-projection).
Algebraically every fiber algebra over `(L, E)` is the same type
`PredicationFiberAlgebra L E`, so the *generic* predicate category
collapses to a one-object category whose morphisms are cellular
reindexings `E × E → E × E`. This is the version we register as a
mathlib `Category`.

(The corpus's predicate category has multiple object names; for theorems
that only depend on the algebraic action — as `predication-fiber-functor`
does — the one-object collapse is mathematically equivalent and
materially simpler. Multi-object refinements can be added later when
needed, e.g. for `predicate-generator-pullback-closure` where distinct
sub-supports matter.)

This file does *not* yet introduce the partial-restriction generator;
that requires `Bot` on the fiber algebra and is treated separately.
-/

universe v

open CategoryTheory

namespace PredicateCategory

/-- Objects of the predicate category over an entity set `E`: a single
formal predicate. (See module docstring on the one-object collapse.) -/
structure Predicate (E : Type v) where
  /-- A discriminator carried only as documentation; identical predicates
  are equal as objects. The fiber algebra type is invariant in this. -/
  name : Unit := ()

variable {E : Type v}

/-- The category structure: hom from `p` to `q` is a cellular reindexing
`E × E → E × E`. Identity is the identity reindexing; composition is
function composition. -/
instance instCategory : Category (Predicate E) where
  Hom _ _      := E × E → E × E
  id _         := fun p => p
  comp f g     := g ∘ f
  id_comp _    := rfl
  comp_id _    := rfl
  assoc _ _ _  := rfl

/-! ## The total generators as named morphisms

Each generator is a morphism between any pair of predicates (since the
type collapses). The composition table from `PredicateMap` lifts to the
mathlib `≫` notation. -/

/-- Converse generator. -/
def conv (p q : Predicate E) : p ⟶ q := PredicateMap.conv

/-- Subject-projection generator. -/
def subj (p q : Predicate E) : p ⟶ q := PredicateMap.subj

/-- Object-projection generator. -/
def obj (p q : Predicate E) : p ⟶ q := PredicateMap.obj

/-- `conv ≫ conv = 𝟙` — double swap is the identity. -/
@[simp] theorem conv_comp_conv {p q r : Predicate E} :
    conv p q ≫ conv q r = 𝟙 p := by
  show (PredicateMap.conv (E := E)) ∘ PredicateMap.conv = fun x => x
  exact PredicateMap.conv_comp_conv

/-- `subj ≫ subj = subj`. -/
@[simp] theorem subj_comp_subj {p q r : Predicate E} :
    subj p q ≫ subj q r = subj p r :=
  PredicateMap.subj_comp_subj

/-- `obj ≫ obj = obj`. -/
@[simp] theorem obj_comp_obj {p q r : Predicate E} :
    obj p q ≫ obj q r = obj p r :=
  PredicateMap.obj_comp_obj

/-- `subj ≫ conv = subj` — `(s,o) ↦ (s,s) ↦ (s,s)`. -/
@[simp] theorem subj_comp_conv {p q r : Predicate E} :
    subj p q ≫ conv q r = subj p r :=
  PredicateMap.conv_comp_subj

/-- `conv ≫ subj = obj` — `(s,o) ↦ (o,s) ↦ (o,o)`. -/
@[simp] theorem conv_comp_subj {p q r : Predicate E} :
    conv p q ≫ subj q r = obj p r :=
  PredicateMap.subj_comp_conv

/-- `obj ≫ conv = obj` — once on the object diagonal, swap is a no-op. -/
@[simp] theorem obj_comp_conv {p q r : Predicate E} :
    obj p q ≫ conv q r = obj p r :=
  PredicateMap.conv_comp_obj

/-- `conv ≫ obj = subj` — `(s,o) ↦ (o,s) ↦ (s,s)`. -/
@[simp] theorem conv_comp_obj {p q r : Predicate E} :
    conv p q ≫ obj q r = subj p r :=
  PredicateMap.obj_comp_conv

/-- `subj ≫ obj = subj` — once on the subject diagonal, object-projection
re-reads the same coordinate. -/
@[simp] theorem subj_comp_obj {p q r : Predicate E} :
    subj p q ≫ obj q r = subj p r :=
  PredicateMap.obj_comp_subj

/-- `obj ≫ subj = obj` — once on the object diagonal, subject-projection
re-reads the same coordinate. -/
@[simp] theorem obj_comp_subj {p q r : Predicate E} :
    obj p q ≫ subj q r = obj p r :=
  PredicateMap.subj_comp_obj

end PredicateCategory
