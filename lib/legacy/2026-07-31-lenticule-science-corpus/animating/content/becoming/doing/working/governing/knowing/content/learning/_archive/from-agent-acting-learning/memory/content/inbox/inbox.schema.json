{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/memory/inbox/inbox.schema.json",
  "title": "Inbox (agent's incoming-message memory region)",
  "description": "Per lab/.../memory/inbox/ and AGENTIC-EMBEDDING §5: an agent's inbox is a sub-region of memory where federation-delivered messages and dispatched obligations accumulate. Bounded by the agent's scope; settled by the same closure rules that settle the rest of memory.",
  "kind": "object",
  "type": "object",
  "required": ["agent", "items", "evidence"],
  "additionalProperties": false,
  "properties": {
    "agent": { "type": "string", "minLength": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "deliveredAt"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "from": { "type": "string", "minLength": 1 },
          "deliveredAt": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
