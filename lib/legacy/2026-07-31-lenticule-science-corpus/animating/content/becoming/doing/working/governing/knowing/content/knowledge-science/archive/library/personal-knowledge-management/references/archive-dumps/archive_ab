  (fn tab.log [level ...]
    {:fnl/docstring "Print MESSAGE (can be more than one string) if LEVEL is equal or greater to the configured log level."
     :fnl/arglist [level message]}
    (fn print-message [message]
      (print (.. (tab.render-time (os.time) true)
                 "> " level
                 (if (= level :error) ":    "
                     (if (= level :warning) ":  "
                         (if (= level :info) ":     "
                             (if (= level :debug) ":    "
                                 (if (= level :spam) ":     "
