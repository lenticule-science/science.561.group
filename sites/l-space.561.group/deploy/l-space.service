[Unit]
Description=L-Space: the Lenticule Science knowledge garden (VaultMaze and GEODE over the science section), with its MCP endpoint
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/emsenn/.local/share/561-group/releases/info/checkout/lib/emsenn/services/561-group/services/science-services-section/sites/l-space.561.group
# The code runs from a release checkout of the repository (updated by checking out a commit and
# installing), so work in progress in the live tree never stops the site; GEODE authors the live
# science section. Notes are read from their files when they are opened; nothing is built ahead.
ExecStart=/home/emsenn/.local/bin/node scripts/serve.mjs
# Public origin, allowlists and provider credentials are in the environment file, mode 0600.
EnvironmentFile=/home/emsenn/.config/561-group/l-space.env
Environment=LSPACE_STATE_DIR=/home/emsenn/.local/state/561-group/l-space
Environment=GEODE_AUTHORING_ROOT=/home/emsenn/info/lib/emsenn/services/561-group/services/science-services-section
Restart=on-failure
RestartSec=10
TimeoutStartSec=600

[Install]
WantedBy=default.target
