{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "lenticule-science-knowledge-vault",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-08-18",
  // Public TLS currently terminates at cold-red-gate and reverse-proxies to
  // this origin. The former custom domain remains trapped behind a legacy
  // zone-level Cloudflare Access application that the available account API
  // authority cannot remove.
  "workers_dev": false,
  "routes": [],
  // The origin Google redirects back to. Pinned rather than taken from the
  // request, so the redirect URI always matches the one registered with Google.
  "vars": { "PUBLIC_BASE_URL": "https://l-space.561.group" },
  // Google operator admission uses GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and
  // LSPACE_ALLOWED_EMAILS. Turntide islander admission uses DISCORD_CLIENT_ID,
  // DISCORD_CLIENT_SECRET, DISCORD_GUILD_ID and TURNTIDE_ISLANDER_ROLE_ID.
  // SESSION_SECRET protects both providers. All are Worker secrets set with
  // `wrangler secret put` and are deliberately absent from this file.
  // They are deliberately absent here: this file is committed, and an allowlist
  // of readers is no more publishable than the client secret beside it.
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [{
    "binding": "LEARNER_STATE",
    "database_name": "lenticule-science-vaultmaze",
    "database_id": "__LENTICULE_SCIENCE_D1_DATABASE_ID__",
    "migrations_dir": "migrations"
  }],
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 4 * * *"] }
}
