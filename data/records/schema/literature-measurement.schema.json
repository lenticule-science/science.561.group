{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/schema/literature-measurement",
  "title": "Literature measurement",
  "description": "One research question measured against the published literature: every source as it was read, and every search as it was run. A note's claims and its Sources section derive from this record; a search with no qualifying hit is the record behind a statement that something has not been studied.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "question", "notes", "sources", "searches"],
  "properties": {
    "id": { "$ref": "#/$defs/slug" },
    "kind": { "const": "literature-measurement" },
    "question": { "type": "string", "minLength": 1 },
    "frame": {
      "description": "The question's population, exposure, comparator and outcomes, fixed before searching.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": { "type": "string" },
        "exposure": { "type": "string" },
        "comparator": { "type": "string" },
        "outcomes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "notes": {
      "description": "Repository paths of the notes this record grounds.",
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
    "searches": { "type": "array", "items": { "$ref": "#/$defs/search" } }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "citation", "authors", "year", "readFrom", "sourceUrl", "observedAt"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "citation": {
          "description": "How the note names the source in prose, e.g. \"Wardle, Yang & de Wit 2011\". The checker looks for it verbatim.",
          "type": "string",
          "minLength": 1
        },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "journal": { "type": "string" },
        "year": { "type": "integer", "minimum": 1800, "maximum": 2100 },
        "doi": { "type": "string" },
        "pmid": { "type": "string", "pattern": "^\\d+$" },
        "pmcid": { "type": "string", "pattern": "^PMC\\d+$" },
        "country": { "type": "array", "items": { "type": "string" } },
        "design": {
          "enum": [
            "randomized-crossover",
            "randomized-parallel",
            "open-label",
            "residential-laboratory",
            "case-control",
            "cohort",
            "meta-analysis",
            "systematic-review",
            "narrative-review",
            "drug-label",
            "other"
          ]
        },
        "n": { "type": "integer", "minimum": 0 },
        "population": { "type": "string" },
        "exposures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["agent", "dose"],
            "properties": {
              "agent": { "type": "string" },
              "dose": { "type": "string" },
              "schedule": { "type": "string" }
            }
          }
        },
        "findings": {
          "description": "What the source reports, each with the source's own words where the claim rests on them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["finding"],
            "properties": {
              "finding": { "type": "string" },
              "exactSourceLanguage": { "type": "string" }
            }
          }
        },
        "readFrom": {
          "description": "The surface the row was read from. secondary-summary rows are re-read from a first-party surface before a note rests a figure on them.",
          "enum": ["full-text", "abstract", "registry-record", "drug-label", "secondary-summary"]
        },
        "sourceUrl": { "type": "string", "pattern": "^https://" },
        "observedAt": { "$ref": "#/$defs/date" },
        "notFound": {
          "description": "Fields sought on the read surface and not found there.",
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["register", "query", "observedAt", "hitCount", "qualifyingHits"],
      "properties": {
        "register": { "enum": ["europepmc", "clinicaltrials-gov", "web", "other"] },
        "query": { "type": "string", "minLength": 1 },
        "observedAt": { "$ref": "#/$defs/date" },
        "hitCount": { "type": "integer", "minimum": 0 },
        "qualifyingHits": {
          "description": "Ids of source rows this search yielded that meet the frame; empty when nothing qualified.",
          "type": "array",
          "items": { "$ref": "#/$defs/slug" }
        },
        "reading": { "type": "string" }
      }
    }
  }
}
