{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/schema/literature-measurement",
  "title": "Literature measurement",
  "description": "One research question measured against the published literature: every source as it was read (its CSL-JSON item plus what was read from it) and every search as it was run. A note cites rows by their house citation label and carries them as references: derived by `bibliography record-references`; `bibliography record-check` checks both against this schema. A search that included no row is the record behind a statement that something has not been studied.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "id",
    "kind",
    "question",
    "notes",
    "sources",
    "searches"
  ],
  "properties": {
    "id": {
      "$ref": "#/$defs/slug"
    },
    "kind": {
      "const": "literature-measurement"
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "frame": {
      "description": "The question's population, exposure, comparator and outcomes, fixed before searching.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "population": {
          "type": "string"
        },
        "exposure": {
          "type": "string"
        },
        "comparator": {
          "type": "string"
        },
        "outcomes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "notes": {
      "description": "Paths of the notes this record grounds, relative to the record.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "searches": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/search"
      }
    },
    "$schema": {
      "description": "Path of this schema, relative to the record.",
      "type": "string"
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item",
        "readFrom",
        "observedAt"
      ],
      "properties": {
        "item": {
          "description": "The source as a CSL-JSON item; its id is a house citekey.",
          "type": "object",
          "required": [
            "id",
            "type",
            "title",
            "author",
            "issued"
          ]
        },
        "country": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "design": {
          "enum": [
            "randomized-crossover",
            "randomized-parallel",
            "open-label",
            "residential-laboratory",
            "case-control",
            "cohort",
            "meta-analysis",
            "systematic-review",
            "narrative-review",
            "drug-label",
            "other",
            "protocol-source-code",
            "protocol-documentation",
            "on-chain-measurement",
            "dashboard-measurement",
            "governance-record",
            "audit-report",
            "statute",
            "regulatory-guidance",
            "court-decision",
            "theoretical",
            "historical-case-study",
            "field-experiment",
            "simulation",
            "empirical-study",
            "book",
            "primary-text"
          ]
        },
        "n": {
          "type": "integer",
          "minimum": 0
        },
        "population": {
          "type": "string"
        },
        "exposures": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "agent",
              "dose"
            ],
            "properties": {
              "agent": {
                "type": "string"
              },
              "dose": {
                "type": "string"
              },
              "schedule": {
                "type": "string"
              }
            }
          }
        },
        "findings": {
          "description": "What the source reports, each with the source's own words where the claim rests on them.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "finding"
            ],
            "properties": {
              "finding": {
                "type": "string"
              },
              "exactSourceLanguage": {
                "type": "string"
              }
            }
          }
        },
        "readFrom": {
          "description": "The surface the row was read from. secondary-summary rows are re-read from a first-party surface before a note rests a figure on them.",
          "enum": [
            "full-text",
            "abstract",
            "registry-record",
            "drug-label",
            "secondary-summary",
            "source-code",
            "on-chain-read",
            "api-read",
            "first-party-docs",
            "legal-text",
            "forum-post"
          ]
        },
        "observedAt": {
          "$ref": "#/$defs/date"
        },
        "notFound": {
          "description": "Fields sought on the read surface and not found there.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "register",
        "variables",
        "observedAt",
        "count",
        "included"
      ],
      "properties": {
        "register": {
          "description": "The register searched: a register file name under science-services-section/data/registers, or web or other.",
          "type": "string",
          "minLength": 1
        },
        "variables": {
          "description": "The register query's template variables for this search.",
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "observedAt": {
          "$ref": "#/$defs/date"
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "included": {
          "description": "Ids of source rows this search yielded that meet the frame; empty when nothing qualified.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reading": {
          "type": "string"
        }
      }
    }
  },
  "x-citation-policy": {
    "uncitable": {
      "readFrom": [
        "secondary-summary"
      ]
    },
    "requires": [
      "findings"
    ]
  },
  "x-row-defaults": {
    "readFrom": "abstract",
    "findings": []
  }
}
