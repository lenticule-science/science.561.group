{
  "query": {
    "template": "https://api.github.com/search/repositories{?q,sort,order,per_page}",
    "variables": {
      "per_page": "25",
      "sort": "stars",
      "order": "desc"
    },
    "results": "/items",
    "count": "/total_count"
  },
  "item": {
    "id": "full_name",
    "type": {
      "value": "software"
    },
    "title": {
      "path": "full_name",
      "as": "title"
    },
    "author": {
      "path": "owner.login",
      "as": "names"
    },
    "publisher": {
      "value": "GitHub"
    },
    "genre": "language",
    "issued": {
      "first": [
        {
          "path": "pushed_at",
          "as": "date"
        },
        {
          "path": "created_at",
          "as": "date"
        }
      ]
    },
    "URL": "html_url",
    "abstract": "description"
  }
}
