{
  "query": {
    "template": "https://www.ebi.ac.uk/europepmc/webservices/rest/search{?query,format,pageSize,resultType,cursorMark}",
    "variables": {
      "format": "json",
      "pageSize": "25",
      "resultType": "core"
    },
    "results": "/resultList/result",
    "count": "/hitCount"
  },
  "item": {
    "id": {
      "first": [
        "pmid",
        "pmcid",
        "id"
      ]
    },
    "type": {
      "first": [
        {
          "path": "pubTypeList.pubType",
          "as": "type",
          "aliases": {
            "journal article": "article-journal",
            "research-article": "article-journal",
            "review-article": "review",
            "review": "review",
            "systematic review": "review",
            "letter": "article-journal",
            "case reports": "article-journal",
            "clinical trial": "article-journal",
            "randomized controlled trial": "article-journal",
            "preprint": "manuscript",
            "patent": "patent"
          },
          "prefer": [
            "review"
          ]
        },
        {
          "path": "pubType",
          "as": "type",
          "split": "; ",
          "aliases": {
            "journal article": "article-journal",
            "research-article": "article-journal",
            "review-article": "review",
            "review": "review",
            "systematic review": "review",
            "letter": "article-journal",
            "case reports": "article-journal",
            "clinical trial": "article-journal",
            "randomized controlled trial": "article-journal",
            "preprint": "manuscript",
            "patent": "patent"
          },
          "prefer": [
            "review"
          ]
        }
      ]
    },
    "title": {
      "path": "title",
      "as": "title"
    },
    "author": {
      "first": [
        {
          "path": "authorList.author",
          "as": "names",
          "family": "lastName",
          "given": "firstName",
          "literal": "collectiveName"
        },
        {
          "path": "authorString",
          "as": "names",
          "split": ", ",
          "initials": true
        }
      ]
    },
    "container-title": {
      "first": [
        "journalInfo.journal.title",
        "journalTitle"
      ]
    },
    "container-title-short": "journalInfo.journal.isoabbreviation",
    "volume": {
      "first": [
        "journalInfo.volume",
        "journalVolume"
      ]
    },
    "issue": {
      "first": [
        "journalInfo.issue",
        "issue"
      ]
    },
    "page": "pageInfo",
    "issued": {
      "first": [
        {
          "path": "firstPublicationDate",
          "as": "date"
        },
        {
          "path": "pubYear",
          "as": "year"
        }
      ]
    },
    "DOI": {
      "path": "doi",
      "as": "doi"
    },
    "PMID": "pmid",
    "PMCID": "pmcid",
    "URL": {
      "first": [
        {
          "template": "https://pmc.ncbi.nlm.nih.gov/articles/{pmcid}/"
        },
        {
          "template": "https://pubmed.ncbi.nlm.nih.gov/{pmid}/"
        },
        {
          "template": "https://doi.org/{doi}"
        },
        {
          "template": "https://europepmc.org/article/{source}/{id}"
        }
      ]
    },
    "abstract": {
      "path": "abstractText",
      "as": "text"
    }
  }
}
