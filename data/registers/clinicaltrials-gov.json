{
  "query": {
    "template": "https://clinicaltrials.gov/api/v2/studies{?query.term,pageSize,countTotal,pageToken}",
    "variables": { "pageSize": "25", "countTotal": "true" },
    "results": "/studies",
    "count": "/totalCount"
  },
  "item": {
    "id": "protocolSection.identificationModule.nctId",
    "type": { "value": "report" },
    "title": { "first": ["protocolSection.identificationModule.officialTitle", "protocolSection.identificationModule.briefTitle"] },
    "title-short": "protocolSection.identificationModule.briefTitle",
    "author": { "path": "protocolSection.sponsorCollaboratorsModule.leadSponsor.name", "as": "names" },
    "publisher": { "value": "ClinicalTrials.gov" },
    "publisher-place": { "path": "protocolSection.contactsLocationsModule.locations[].country", "as": "join" },
    "number": "protocolSection.identificationModule.nctId",
    "genre": "protocolSection.designModule.studyType",
    "status": "protocolSection.statusModule.overallStatus",
    "issued": { "first": [{ "path": "protocolSection.statusModule.studyFirstPostDateStruct.date", "as": "date" }, { "path": "protocolSection.statusModule.startDateStruct.date", "as": "date" }] },
    "URL": { "template": "https://clinicaltrials.gov/study/{protocolSection.identificationModule.nctId}" },
    "abstract": "protocolSection.descriptionModule.briefSummary"
  }
}
