{
  "query": {
    "template": "https://api.crossref.org/works{?query,query.bibliographic,query.author,filter,rows,sort,order,select,mailto}",
    "variables": {
      "rows": "25",
      "mailto": "morgan.sennhauser@gmail.com"
    },
    "results": "/message/items",
    "count": "/message/total-results"
  },
  "item": {
    "id": {
      "path": "DOI",
      "as": "doi"
    },
    "type": {
      "path": "type",
      "as": "type",
      "aliases": {
        "journal-article": "article-journal",
        "book": "book",
        "monograph": "book",
        "edited-book": "book",
        "book-chapter": "chapter",
        "proceedings-article": "paper-conference",
        "posted-content": "manuscript",
        "report": "report",
        "report-series": "report",
        "dissertation": "thesis",
        "dataset": "dataset",
        "reference-entry": "entry-encyclopedia"
      }
    },
    "title": {
      "path": "title",
      "as": "title"
    },
    "author": {
      "path": "author",
      "as": "names",
      "family": "family",
      "given": "given",
      "literal": "name"
    },
    "container-title": "container-title",
    "publisher": "publisher",
    "volume": "volume",
    "issue": "issue",
    "page": "page",
    "issued": {
      "first": [
        {
          "path": "issued.date-parts[]",
          "as": "year"
        }
      ]
    },
    "DOI": {
      "path": "DOI",
      "as": "doi"
    },
    "URL": {
      "path": "URL"
    },
    "abstract": {
      "path": "abstract",
      "as": "text"
    }
  }
}
