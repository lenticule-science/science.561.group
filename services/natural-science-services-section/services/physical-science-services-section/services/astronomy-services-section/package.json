{
  "name": "@lenticule-science/astronomy-services-section",
  "version": "0.4.2",
  "type": "module",
  "description": "Pure, provenance-carrying geocentric ecliptic position computation for astronomy consumers.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run rebuild",
    "rebuild": "npm run build"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./positions": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./node": {
      "types": "./dist/precision-provider.d.mts",
      "import": "./dist/precision-provider.mjs"
    }
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false
}
