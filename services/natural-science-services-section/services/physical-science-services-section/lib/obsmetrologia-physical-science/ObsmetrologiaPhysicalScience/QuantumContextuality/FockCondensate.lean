import ObsmetrologiaPhysicalScience.CondensedMatter.Crystal.Glass
import ObsmetrologiaPhysicalScience.KineticTheory.Gas.MolecularChaosGluing
import ObsmetrologiaPhysicalScience.CausalSets.BlackHoles.Hole

/-!
# Fock condensates and glass-overlap entanglement

This module records the finite carrier defined in the relational
physics library. A four-entry creation/annihilation ledger indexes finite Fock
**sectors** by particle number, a condensate hole carries a coherent Fock support
with indefinite particle number and one order parameter, and glass overlap is
the order parameter for a two-condensate joint whose state fails to factor.

The construction is intentionally finite. It does not introduce Hilbert spaces,
operators, analytic coherent states, or a continuum field limit. Those remain
frontier claims until their carriers are built.

## Main definitions

* `C4LedgerStep`, `C4Ledger` — the four-entry creation/annihilation ledger.
* `FockSpace`, `FockState` — finite particle-number sectors and predicates over
  them.
* `CoherentCondensate`, `CondensateHole` — indefinite Fock support with one
  retained order parameter, attached to a hole.
* `GlassOverlapEntanglement` — finite glass overlap plus a nonfactorizing joint.

## Main results

* `C4Ledger.fockSector_particleNumber` — the generated sector has the ledger's
  particle number.
* `CoherentCondensate.has_indefinite_particle_number` and
  `CondensateHole.indefinite_particle_number` expose the indefinite support.
* `GlassOverlapEntanglement.orderParameter_eq_overlapCount` and
  `GlassOverlapEntanglement.joint_fails_to_factor` expose the glass-overlap
  order parameter and the factorization obstruction.
* `eprGlassOverlapEntanglement_orderParameter` gives a concrete two-site
  nonfactorizing witness.

## Tags

Fock, condensate, hole, glass overlap, factorization, entanglement
-/

namespace Obsmetrologia
namespace QuantumContextuality

/-- The four entries of the creation/annihilation ledger. -/
inductive C4LedgerStep where
  | matterCreate
  | antimatterCreate
  | matterAnnihilate
  | antimatterAnnihilate
  deriving DecidableEq

namespace C4LedgerStep

/-- Creation entries of the ledger. -/
def isCreation : C4LedgerStep → Bool
  | matterCreate | antimatterCreate => true
  | matterAnnihilate | antimatterAnnihilate => false

/-- Annihilation entries of the ledger. -/
def isAnnihilation : C4LedgerStep → Bool
  | matterCreate | antimatterCreate => false
  | matterAnnihilate | antimatterAnnihilate => true

/-- Matter-sector entries of the ledger. -/
def isMatter : C4LedgerStep → Bool
  | matterCreate | matterAnnihilate => true
  | antimatterCreate | antimatterAnnihilate => false

/-- Antimatter-sector entries of the ledger. -/
def isAntimatter : C4LedgerStep → Bool
  | matterCreate | matterAnnihilate => false
  | antimatterCreate | antimatterAnnihilate => true

end C4LedgerStep

/-- A finite creation/annihilation ledger with four possible entry kinds. -/
structure C4Ledger where
  /-- The listed ledger entries. -/
  steps : List C4LedgerStep

namespace C4Ledger

/-- The number of creation entries in the ledger. -/
def creationCount (L : C4Ledger) : Nat :=
  L.steps.countP C4LedgerStep.isCreation

/-- The number of annihilation entries in the ledger. -/
def annihilationCount (L : C4Ledger) : Nat :=
  L.steps.countP C4LedgerStep.isAnnihilation

/-- The ledger particle number, with annihilation subtracting from creation in
`Nat`'s truncated subtraction. -/
def particleNumber (L : C4Ledger) : Nat :=
  L.creationCount - L.annihilationCount

/-- The empty ledger generates the vacuum sector. -/
theorem particleNumber_nil : particleNumber ⟨[]⟩ = 0 := rfl

/-- A single creation entry generates the one-particle sector. -/
theorem particleNumber_single_create :
    particleNumber ⟨[C4LedgerStep.matterCreate]⟩ = 1 := rfl

/-- A single annihilation entry cannot push below the vacuum sector. -/
theorem particleNumber_single_annihilate :
    particleNumber ⟨[C4LedgerStep.antimatterAnnihilate]⟩ = 0 := rfl

end C4Ledger

/-- The finite Fock carrier: this is where **sector** is first defined in the relational
quantum front. A sector is not an ambient label; it is the dependent pair indexed by
particle number and then by an occupation assignment for the `Fin n` particle slots. -/
abbrev FockSpace (Mode : Type) : Type :=
  Sigma fun n : Nat => Fin n → Mode

/-- The particle number of a Fock sector. -/
def FockSpace.particleNumber {Mode : Type} (s : FockSpace Mode) : Nat :=
  s.1

/-- The sector generated by a C4 ledger: the ledger's creation/annihilation balance selects
the particle-number component of the finite Fock carrier. -/
def C4Ledger.fockSector {Mode : Type} (L : C4Ledger)
    (occupation : Fin L.particleNumber → Mode) : FockSpace Mode :=
  ⟨L.particleNumber, occupation⟩

/-- The generated Fock sector has exactly the ledger particle number. This theorem is the
sector law: the sector index is proved to be the C4 ledger count, not postulated
separately from the creation/annihilation carrier. -/
theorem C4Ledger.fockSector_particleNumber {Mode : Type} (L : C4Ledger)
    (occupation : Fin L.particleNumber → Mode) :
    (L.fockSector occupation).particleNumber = L.particleNumber :=
  rfl

/-- A Fock state is a predicate over the finite Fock carrier. -/
abbrev FockState (Mode : Type) : Type :=
  FockSpace Mode → Prop

/-- A Fock state has indefinite particle number when it supports two distinct
particle-number sectors. -/
def IndefiniteParticleNumber {Mode : Type} (ψ : FockState Mode) : Prop :=
  ∃ s t : FockSpace Mode, ψ s ∧ ψ t ∧ s.particleNumber ≠ t.particleNumber

/-- A coherent condensate state: a Fock support with indefinite particle number
and one retained order parameter. -/
structure CoherentCondensate (Mode OrderParameter : Type) where
  /-- The supported finite Fock sectors. -/
  support : FockState Mode
  /-- The single order parameter retained by this coherent condensate. -/
  orderParameter : OrderParameter
  /-- The support has indefinite particle number. -/
  indefinite : IndefiniteParticleNumber support

namespace CoherentCondensate

/-- Coherent condensates support distinct particle-number sectors. -/
theorem has_indefinite_particle_number {Mode OrderParameter : Type}
    (ψ : CoherentCondensate Mode OrderParameter) :
    IndefiniteParticleNumber ψ.support :=
  ψ.indefinite

/-- The retained order-parameter count of a coherent condensate is one. -/
def orderParameterCount {Mode OrderParameter : Type}
    (_ψ : CoherentCondensate Mode OrderParameter) : Nat :=
  1

/-- A coherent condensate has exactly one retained order parameter. -/
theorem orderParameterCount_eq_one {Mode OrderParameter : Type}
    (ψ : CoherentCondensate Mode OrderParameter) :
    ψ.orderParameterCount = 1 :=
  rfl

end CoherentCondensate

/-- A condensate hole: the causal no-readout carrier together with a coherent
condensate Fock state. -/
structure CondensateHole (Event Mode OrderParameter : Type) where
  /-- The no-readout hole carrier. -/
  hole : CausalSets.BlackHoles.Hole Event
  /-- The coherent condensate state attached to the hole. -/
  condensate : CoherentCondensate Mode OrderParameter

namespace CondensateHole

/-- The hole condensate has indefinite particle number. -/
theorem indefinite_particle_number {Event Mode OrderParameter : Type}
    (H : CondensateHole Event Mode OrderParameter) :
    IndefiniteParticleNumber H.condensate.support :=
  H.condensate.has_indefinite_particle_number

/-- The hole condensate has exactly one retained order parameter. -/
theorem one_order_parameter {Event Mode OrderParameter : Type}
    (H : CondensateHole Event Mode OrderParameter) :
    H.condensate.orderParameterCount = 1 :=
  H.condensate.orderParameterCount_eq_one

end CondensateHole

/-- A two-condensate joint whose order parameter is a finite glass overlap and
whose obstruction is failure of factorization. -/
structure GlassOverlapEntanglement (Site State : Type) [DecidableEq State] where
  /-- The finite support on which the two condensate configurations are compared. -/
  sites : List Site
  /-- The left condensate configuration. -/
  left : AperiodicOrder.GlassDynamics.Configuration Site State
  /-- The right condensate configuration. -/
  right : AperiodicOrder.GlassDynamics.Configuration Site State
  /-- The two-condensate joint state. -/
  joint : KineticTheory.Gas.Joint Site
  /-- The joint state does not split as separated one-condensate sections. -/
  not_factorizes : ¬ KineticTheory.Gas.Factorizes joint

namespace GlassOverlapEntanglement

/-- The glass-overlap order parameter of a two-condensate joint. -/
def orderParameter {Site State : Type} [DecidableEq State]
    (G : GlassOverlapEntanglement Site State) : Nat :=
  AperiodicOrder.GlassDynamics.overlapCount G.sites G.left G.right

/-- The retained order parameter is exactly the finite glass-overlap count. -/
theorem orderParameter_eq_overlapCount {Site State : Type} [DecidableEq State]
    (G : GlassOverlapEntanglement Site State) :
    G.orderParameter = AperiodicOrder.GlassDynamics.overlapCount G.sites G.left G.right :=
  rfl

/-- A glass-overlap entanglement witness is a joint state that fails to factor. -/
theorem joint_fails_to_factor {Site State : Type} [DecidableEq State]
    (G : GlassOverlapEntanglement Site State) :
    ¬ KineticTheory.Gas.Factorizes G.joint :=
  G.not_factorizes

/-- Factorized joints cannot inhabit a glass-overlap entanglement witness. -/
theorem not_factorized_gluing {Site State : Type} [DecidableEq State]
    (G : GlassOverlapEntanglement Site State) {p q : Site → Int}
    (h : G.joint = KineticTheory.Gas.glue p q) : False := by
  apply G.not_factorizes
  rw [h]
  exact KineticTheory.Gas.glue_factorizes p q

end GlassOverlapEntanglement

/-- The canonical correlated two-state joint supplies a concrete
nonfactorization witness. -/
def eprGlassOverlapEntanglement : GlassOverlapEntanglement (Fin 2) Bool where
  sites := [0, 1]
  left := fun s => decide (s = 0)
  right := fun s => decide (s = 0)
  joint := KineticTheory.Gas.eprJoint
  not_factorizes := KineticTheory.Gas.epr_not_factorizes

/-- The canonical correlated witness has full two-site overlap. -/
theorem eprGlassOverlapEntanglement_orderParameter :
    eprGlassOverlapEntanglement.orderParameter = 2 := by
  decide

/-- The canonical correlated witness fails to factor. -/
theorem eprGlassOverlapEntanglement_not_factorizes :
    ¬ KineticTheory.Gas.Factorizes eprGlassOverlapEntanglement.joint :=
  eprGlassOverlapEntanglement.joint_fails_to_factor

end QuantumContextuality
end Obsmetrologia
