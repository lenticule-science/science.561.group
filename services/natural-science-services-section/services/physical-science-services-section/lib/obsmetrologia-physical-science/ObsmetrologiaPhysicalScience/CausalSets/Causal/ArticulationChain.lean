import Obsmetrologia.Articulation.Articulating
import ObsmetrologiaPhysicalScience.CausalSets.Causal.Cone
import ObsmetrologiaPhysicalScience.CausalSets.Causal.Order

/-!
# Articulation chains as causal sets

This module reads one `Articulating` inhabitant as its own finite causal
chain.  The events are the prefix articulations from the primitive floor to the
given node, and the direct edge relation is generated by the recursion
constructor `pair`.
-/

namespace Obsmetrologia
namespace CausalSets.Causal.ArticulationChain

open Obsmetrologia.Discrete
open Obsmetrologia.CausalSets.Causal.Cone
open Obsmetrologia.CausalSets.Causal.Order

/-- The prefix chain of one articulation, from primitive floor to full node. -/
def prefixes : Articulating → List Articulating
  | Articulating.utter u => [Articulating.utter u]
  | Articulating.pair u a => prefixes a ++ [Articulating.pair u a]

/-- Every articulation is listed in its own prefix chain. -/
theorem self_mem_prefixes : ∀ a : Articulating, a ∈ prefixes a
  | Articulating.utter u => by
      simp [prefixes]
  | Articulating.pair u a => by
      simp [prefixes]

/-- Direct continuation in the articulation recursion: `y` directly continues
`x` when `y` is formed by pairing one utterance over `x`. -/
def directlyContinues (x y : Articulating) : Bool :=
  match y with
  | Articulating.utter _ => false
  | Articulating.pair _ tail => decide (tail = x)

/-- The tail of a paired articulation is listed in that pair's prefix chain. -/
theorem tail_mem_prefixes_pair (u : Utterance) (tail : Articulating) :
    tail ∈ prefixes (Articulating.pair u tail) := by
  simp [prefixes, self_mem_prefixes]

/-- A paired articulation is listed as the last point of its own prefix chain. -/
theorem pair_mem_prefixes_pair (u : Utterance) (tail : Articulating) :
    Articulating.pair u tail ∈ prefixes (Articulating.pair u tail) := by
  simp [prefixes]

/-- Direct continuation strictly raises articulation depth. -/
theorem directlyContinues_depth_lt {x y : Articulating}
    (h : directlyContinues x y = true) : x.depth < y.depth := by
  cases y with
  | utter u => simp [directlyContinues] at h
  | pair u tail =>
      simp [directlyContinues] at h
      subst tail
      simp [Articulating.depth]

/-- The direct-continuation graph is acyclic, with depth as ranking. -/
def directlyContinuesStrictOrderClosure :
    Graph.StrictOrderClosure directlyContinues where
  lt := fun x y => x.depth < y.depth
  edge_lt := by
    intro x y h
    exact directlyContinues_depth_lt h
  lt_trans := by
    intro _ _ _ hab hbc
    exact Nat.lt_trans hab hbc
  lt_irrefl := by
    intro x h
    exact Nat.lt_irrefl x.depth h

/-- Every member of an articulation's prefix chain has depth at most that
articulation's depth. -/
theorem mem_prefixes_depth_le {x a : Articulating} :
    x ∈ prefixes a → x.depth ≤ a.depth := by
  induction a generalizing x with
  | utter u =>
      intro h
      simp [prefixes] at h
      subst x
      simp [Articulating.depth]
  | pair u tail ih =>
      intro h
      simp [prefixes] at h
      rcases h with h | h
      · exact Nat.le.step (ih h)
      · subst x
        exact Nat.le_refl _

/-- An articulation's prefix chain contains each articulation exactly once. -/
theorem prefixes_nodup (a : Articulating) : (prefixes a).Nodup := by
  induction a with
  | utter u => simp [prefixes]
  | pair u tail ih =>
      rw [prefixes, List.nodup_append]
      refine ⟨ih, by simp, ?_⟩
      intro x hx y hy
      simp only [List.mem_singleton] at hy
      subst y
      intro heq
      have hle : x.depth ≤ tail.depth := mem_prefixes_depth_le hx
      subst x
      exact Nat.not_succ_le_self tail.depth
        (by simpa [Articulating.depth] using hle)

/-- The causal set generated by one articulation's own prefix chain. -/
def causalSet (a : Articulating) : CausalSet Articulating where
  events := prefixes a
  events_nodup := prefixes_nodup a
  prec0 := directlyContinues
  acyclic := directlyContinuesStrictOrderClosure

/-- A paired articulation is directly reached from its tail in its generated
causal set. -/
theorem tail_reaches_pair (u : Utterance) (tail : Articulating) :
    (causalSet (Articulating.pair u tail)).reaches tail
      (Articulating.pair u tail) :=
  CausalSet.reaches.last (by simp [causalSet, directlyContinues])

/-- Prefix membership is transitive along articulation prefixes. -/
theorem mem_prefixes_trans {x y z : Articulating}
    (hxy : x ∈ prefixes y) (hyz : y ∈ prefixes z) : x ∈ prefixes z := by
  induction z generalizing x y with
  | utter u =>
      simp [prefixes] at hyz
      subst y
      exact hxy
  | pair u tail ih =>
      simp [prefixes] at hyz
      cases hyz with
      | inl hy_tail =>
          have hx_tail : x ∈ prefixes tail := ih hxy hy_tail
          simp [prefixes, hx_tail]
      | inr hy_pair =>
          subst y
          exact hxy

/-- Direct continuation makes the lower articulation a prefix of the upper one. -/
theorem directlyContinues_mem_prefixes {x y : Articulating}
    (h : directlyContinues x y = true) : x ∈ prefixes y := by
  cases y with
  | utter u => simp [directlyContinues] at h
  | pair u tail =>
      simp [directlyContinues] at h
      subst tail
      exact tail_mem_prefixes_pair u x

/-- Reachability in an articulation chain implies prefix membership. -/
theorem reaches_to_mem_prefixes {a x y : Articulating}
    (h : (causalSet a).reaches x y) : x ∈ prefixes y := by
  induction h with
  | last e => exact directlyContinues_mem_prefixes e
  | cons e _ ih =>
      exact mem_prefixes_trans (directlyContinues_mem_prefixes e) ih

/-- A proper prefix reaches the articulation it prefixes. -/
theorem reaches_of_mem_prefixes_ne {a x y : Articulating}
    (hmem : x ∈ prefixes y) (hne : x ≠ y) :
    (causalSet a).reaches x y := by
  induction y with
  | utter u =>
      simp [prefixes] at hmem
      exact False.elim (hne hmem)
  | pair u tail ih =>
      simp [prefixes] at hmem
      cases hmem with
      | inl hx_tail =>
          by_cases hxtail : x = tail
          · subst x
            exact CausalSet.reaches.last
              (by simp [causalSet, directlyContinues])
          · exact (causalSet a).reaches_trans (ih hx_tail hxtail)
              (CausalSet.reaches.last
                (by simp [causalSet, directlyContinues]))
      | inr hx_pair =>
          exact False.elim (hne hx_pair)

/-- Reachability in an articulation chain is exactly proper prefix membership. -/
theorem reaches_iff_mem_prefixes_ne (a x y : Articulating) :
    (causalSet a).reaches x y ↔ x ∈ prefixes y ∧ x ≠ y := by
  constructor
  · intro h
    exact ⟨reaches_to_mem_prefixes h, fun hxy => by
      subst y
      exact (causalSet a).reaches_irrefl x h⟩
  · intro h
    exact reaches_of_mem_prefixes_ne (a := a) h.1 h.2

/-- The articulation-chain causal order is exactly prefix membership. -/
theorem causalLe_iff_mem_prefixes (a x y : Articulating) :
    CausalLe (causalSet a) x y ↔ x ∈ prefixes y := by
  constructor
  · intro h
    cases h with
    | inl hxy =>
        subst y
        exact self_mem_prefixes x
    | inr hreach => exact reaches_to_mem_prefixes hreach
  · intro hmem
    by_cases hxy : x = y
    · exact Or.inl hxy
    · exact Or.inr (reaches_of_mem_prefixes_ne (a := a) hmem hxy)

end CausalSets.Causal.ArticulationChain
end Obsmetrologia
