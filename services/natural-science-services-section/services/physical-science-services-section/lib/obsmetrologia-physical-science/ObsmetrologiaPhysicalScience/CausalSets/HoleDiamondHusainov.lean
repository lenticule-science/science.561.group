import Obsmetrologia.Cohomology.AlexandrovHusainov
import ObsmetrologiaPhysicalScience.CausalSets.BlackHoles.Hole
import ObsmetrologiaPhysicalScience.CausalSets.Causal.Alexandrov

/-!
# Hole/diamond cuts and the Husainov frontier

This module isolates the special Husainov comparison problem generated by
`HoleRegion(C,R)` / `ReadoutExterior(C,R)` pairs when the readout region is a
single closed causal diamond. The general Čech-to-derived comparison remains
unmodelled here; the declarations below name the concrete family and state the
family-specific acyclicity problem as an explicit predicate over whatever
Dedekind--MacNeille-cut acyclicity predicate the comparison machinery later
provides.

## Main definitions

* `HoleDiamondCutFamily` — a finite listed causal set with a readout region
  generated by one closed causal diamond.
* `HoleDiamondCutsAcyclic` — the family-specific cut-acyclicity assertion,
  parameterized by the missing Dedekind--MacNeille-cut predicate.
* `HoleDiamondComparison` — the matching family-specific derived comparison
  target, parameterized by the missing comparison predicate.

## Main results

* `closedDiamondReadout_asProp_eq_diamondRegion` — the Boolean readout, read as
  a Prop-valued predicate, is exactly `Causal.Net.DiamondRegion`.
* `holeDiamond_cech_acyclic` — every such family has the already-proved Čech
  side available.
* `holeDiamond_husainov_comparison_of_cut_acyclic` — once a Husainov
  criterion is supplied, cut acyclicity for the special family gives the
  corresponding comparison for that family.

## Tags

Husainov comparison, Dedekind--MacNeille cuts, HoleRegion, ReadoutExterior,
causal diamond, Alexandrov topology
-/

namespace Obsmetrologia
namespace Alexandrov

open Obsmetrologia.CausalSets.Causal.Order
open Obsmetrologia.CausalSets.Causal.Cone
open Obsmetrologia.CausalSets.Causal.Net
open Obsmetrologia.CausalSets.BlackHoles
open Obsmetrologia.CausalSets.Causal.Alexandrov

variable {E : Type}

/-- The Boolean closed-diamond readout generated by two apexes. -/
def ClosedDiamondReadout (C : CausalSet E) [CausalLeDecision C] (a b : E) :
    CausalSets.BlackHoles.Region E :=
  fun x => CausalLeBool C a x && CausalLeBool C x b

/-- A readout region generated by one nonempty closed causal diamond. -/
def SingleClosedDiamondReadout (C : CausalSet E) [CausalLeDecision C]
    (readout : CausalSets.BlackHoles.Region E) : Prop :=
  ∃ a b, CausalLe C a b ∧ readout = ClosedDiamondReadout C a b

/-- The Boolean closed-diamond readout, read as a Prop-valued predicate, is exactly the causal-net
`DiamondRegion` — the same closed causal diamond `Net.lean` names, at the decidable presentation
this Husainov family needs. -/
theorem closedDiamondReadout_asProp_eq_diamondRegion (C : CausalSet E) [CausalLeDecision C]
    (a b : E) :
    CausalSets.BlackHoles.Region.asProp (ClosedDiamondReadout C a b)
      = DiamondRegion C a b := by
  funext x
  simp only [CausalSets.BlackHoles.Region.asProp, ClosedDiamondReadout,
    DiamondRegion, ClosedDiamond, Bool.and_eq_true, eq_iff_iff]
  exact ⟨fun ⟨h1, h2⟩ => ⟨(causalLeBool_eq_true_iff C a x).1 h1, (causalLeBool_eq_true_iff C x b).1 h2⟩,
    fun ⟨h1, h2⟩ => ⟨(causalLeBool_eq_true_iff C a x).2 h1, (causalLeBool_eq_true_iff C x b).2 h2⟩⟩

/-- A hole/readout cut family whose readout side is one closed causal diamond.

The field `finite_carrier` says the finite event list of the causal set covers
the ambient event type used by this family. -/
structure HoleDiamondCutFamily (E : Type) where
  /-- The finite causal substrate. -/
  C : CausalSet E
  /-- The settled Boolean causal-order presentation used by the finite hole computation. -/
  decision : CausalLeDecision C
  /-- The designated readout region. -/
  readout : CausalSets.BlackHoles.Region E
  /-- Every ambient event is one of the listed causal-set events. -/
  finite_carrier : ∀ x : E, x ∈ C.events
  /-- The readout region is generated by one closed causal diamond. -/
  readout_single_diamond : (letI := decision; SingleClosedDiamondReadout C readout)

namespace HoleDiamondCutFamily

variable (F : HoleDiamondCutFamily E)

/-- The no-readout side of a hole/diamond cut family. -/
def interior (F : HoleDiamondCutFamily E) : CausalSets.BlackHoles.Region E :=
  letI := F.decision
  HoleRegion F.C F.readout

/-- The readout exterior side of a hole/diamond cut family. -/
def exterior (F : HoleDiamondCutFamily E) : CausalSets.BlackHoles.Region E :=
  letI := F.decision
  ReadoutExterior F.C F.readout

/-- The Alexandrov poset attached to the family's causal order. -/
def alexandrovPoset : Order.PartialOrder :=
  causalPartialOrder F.C

/-- The Alexandrov topology attached to the family's causal order. -/
def topology : AlexandrovTopology :=
  causalTopology F.C

/-- The interior is future-closed. -/
theorem interior_future_closed {x y : E}
    (hx : F.interior x = true) (hxy : CausalLe F.C x y) : F.interior y = true := by
  letI := F.decision
  exact hole_future_closed F.C F.readout hx hxy

/-- The exterior is past-closed. -/
theorem exterior_past_closed {x y : E}
    (hxy : CausalLe F.C x y) (hy : F.exterior y = true) : F.exterior x = true := by
  letI := F.decision
  exact readoutExterior_past_closed F.C F.readout hxy hy

/-- The interior and exterior sides of the cut are disjoint. -/
theorem interior_exterior_disjoint (x : E) :
    ¬(F.interior x = true ∧ F.exterior x = true) := by
  letI := F.decision
  exact hole_exterior_disjoint F.C F.readout x

/-- No interior event causally precedes an exterior event. -/
theorem no_future_to_exterior {x y : E}
    (hin : F.interior x = true) (hout : F.exterior y = true) : ¬ CausalLe F.C x y := by
  letI := F.decision
  exact hole_no_future_to_exterior F.C F.readout hin hout

/-- The special-family Dedekind--MacNeille-cut acyclicity obligation.

`CutAcyclic` is intentionally a parameter: this core has not yet introduced
Dedekind--MacNeille cuts as formal objects. -/
def HoleDiamondCutsAcyclic
    (CutAcyclic : Order.PartialOrder → Prop) : Prop :=
  CutAcyclic F.alexandrovPoset

/-- The special-family Husainov comparison target.

`Comparison` is intentionally a parameter: this core has not yet introduced
derived-functor cohomology. -/
def HoleDiamondComparison
    (Comparison : Order.PartialOrder → Prop) : Prop :=
  Comparison F.alexandrovPoset

/-- The Čech side of Husainov's comparison is already available for every
hole/diamond cut family. -/
theorem holeDiamond_cech_acyclic : CechAcyclic :=
  cechAcyclic

/-- If a Husainov criterion is supplied, acyclicity of the special
hole/diamond cuts yields the corresponding comparison for this family. -/
theorem holeDiamond_husainov_comparison_of_cut_acyclic
    (CutAcyclic Comparison : Order.PartialOrder → Prop)
    (hHusainov : ∀ P : Order.PartialOrder, CutAcyclic P → Comparison P)
    (hcuts : F.HoleDiamondCutsAcyclic CutAcyclic) :
    F.HoleDiamondComparison Comparison :=
  hHusainov F.alexandrovPoset hcuts

end HoleDiamondCutFamily

/-- The family-specific acyclicity conjecture for hole/diamond cuts. -/
def holeDiamond_cut_acyclicity_conjecture
    (CutAcyclic : Order.PartialOrder → Prop) : Prop :=
  ∀ {E : Type} (F : HoleDiamondCutFamily E), F.HoleDiamondCutsAcyclic CutAcyclic

end Alexandrov
end Obsmetrologia
