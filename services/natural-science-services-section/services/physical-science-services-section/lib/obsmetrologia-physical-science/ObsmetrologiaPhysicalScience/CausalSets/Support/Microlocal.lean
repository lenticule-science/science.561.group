import ObsmetrologiaPhysicalScience.CausalSets.Causal.Laplacian
import Obsmetrologia.Dynamics.Flow.TransfiniteClosureFlow
import Obsmetrologia.Dynamics.Flow.CurvatureRegime

/-!
# Microlocal support — the NSC singular-support projection of a closure flow

The Obsmetrologia analogue of microlocal singular support: not cotangent wavefront sets, but the
**NSC-firing support** of a closure flow, together with the causal-cone propagation closure of an
event support. The classical frontier says wave singularities propagate along null cones; the
internal analogue is *closure singularities are NSC firings, their support propagates along the
causal reachability cone, and vanishing `H¹` means empty singular support*
(`content/.../lorentzian-causal-settling`; bridges `Flow.TransfiniteClosureFlow` and
`Flow.CurvatureRegime`).

This is a **bridge, not an identity** with smooth microlocal analysis — the formal content is the
NSC/closure-flow and curvature theorems; the physical words are provisional labels. No free data:
the propagation closure reuses `CausalSets.Causal.Laplacian.causalClosure`, and the singularity classification
reuses the existing curvature--regime correspondence.

## Main definitions

* `SingularAt` / `SmoothFlow` — a closure-flow singularity is an NSC firing; smooth = no firing.

## Main results

* `continuous_empty_singular_support` — a settling-continuous flow has empty singular support.
* `causal_propagation_is_closure` — causal forward-closure is a propagation closure operator.
* `h1_classifies_singularity_regime` — `H¹` vanishing classifies flat vs curved (singular) regimes.
* `microlocal_support_propagation` — the bundled headline.

## References

`content/.../lorentzian-causal-settling`. Built on `Obsmetrologia.CausalSets.Causal.Laplacian`,
`Obsmetrologia.Flow.TransfiniteClosureFlow`, `Obsmetrologia.Flow.CurvatureRegime`.

## Tags

microlocal support, singular support, NSC firing, propagation closure, curvature, light cone
-/

namespace Obsmetrologia
namespace CausalSets.Support.Microlocal

open Obsmetrologia.CausalSets.Causal.Order
open Obsmetrologia.CausalSets.Causal.Cone

/-! ## (A) Closure-flow singular support -/

/-- A closure-flow singularity at a limit fundamental sequence: an NSC firing (failure of
settling-continuity at the limit). -/
def SingularAt (w : Valuation.ModalFrame.OrdFlow) (f : Nat → Ord) : Prop :=
  Valuation.ModalFrame.NSCFiringAt w f

/-- A flow is microlocally smooth when it has no NSC firing at any limit. -/
def SmoothFlow (w : Valuation.ModalFrame.OrdFlow) : Prop :=
  ∀ f, ¬ SingularAt w f

/-- A settling-continuous flow has empty singular support — no NSC firing at any limit. -/
theorem continuous_empty_singular_support (w : Valuation.ModalFrame.OrdFlow)
    (hw : Valuation.ModalFrame.Continuous w) : SmoothFlow w :=
  Valuation.ModalFrame.continuous_no_nsc_firing w hw

/-! ## (B) Causal propagation closure

The forward causal closure of an event support — everything reachable from the seed along the
light cone — is exactly `CausalSets.Causal.Laplacian.causalClosure`, reused here as the propagation closure
generated by the causal cone. -/

/-- Causal forward-closure is a propagation closure operator (inflationary, monotone, idempotent):
the support propagates along the causal reachability cone and stabilizes in one step. -/
theorem causal_propagation_is_closure {E : Type} (C : CausalSet E) :
    (∀ (S : CausalSets.Causal.Laplacian.Section E) x, S x → CausalSets.Causal.Laplacian.causalClosure C S x)
    ∧ (∀ (S T : CausalSets.Causal.Laplacian.Section E), (∀ x, S x → T x) →
        ∀ x, CausalSets.Causal.Laplacian.causalClosure C S x → CausalSets.Causal.Laplacian.causalClosure C T x)
    ∧ (∀ (S : CausalSets.Causal.Laplacian.Section E),
        CausalSets.Causal.Laplacian.causalClosure C (CausalSets.Causal.Laplacian.causalClosure C S)
          = CausalSets.Causal.Laplacian.causalClosure C S) :=
  ⟨fun S x hx => CausalSets.Causal.Laplacian.causalClosure_infl C S x hx,
   fun _ _ hsub x h => CausalSets.Causal.Laplacian.causalClosure_mono C hsub x h,
   fun S => CausalSets.Causal.Laplacian.causalClosure_idem C S⟩

/-! ## (C) Curvature / `H¹` classification of singularity -/

/-- `H¹` vanishing classifies the singularity regime: vanishing ⟺ flat (empty singular support),
nonvanishing ⟺ curved (singular). -/
theorem h1_classifies_singularity_regime (r : ClosureRegime) :
    (cohomologyVanishes r = true ↔ Flow.CurvatureRegime.IsFlat r)
    ∧ (cohomologyVanishes r = false ↔ Flow.CurvatureRegime.IsCurved r) :=
  ⟨Flow.CurvatureRegime.vanishes_iff_flat r, Flow.CurvatureRegime.nonvanishes_iff_curved r⟩

/-! ## (D) The bundled headline -/

/-- **The microlocal-support projection.** Causal forward-closure is a propagation closure, and the
`H¹` regime invariant classifies the singular support: vanishing `H¹` is the flat (empty singular
support) regime, nonvanishing `H¹` is the curved/singular regime. -/
theorem microlocal_support_propagation {E : Type} (C : CausalSet E) (r : ClosureRegime) :
    (∀ (S : CausalSets.Causal.Laplacian.Section E),
        CausalSets.Causal.Laplacian.causalClosure C (CausalSets.Causal.Laplacian.causalClosure C S)
          = CausalSets.Causal.Laplacian.causalClosure C S)
    ∧ (cohomologyVanishes r = true ↔ Flow.CurvatureRegime.IsFlat r)
    ∧ (cohomologyVanishes r = false ↔ Flow.CurvatureRegime.IsCurved r) :=
  ⟨fun S => CausalSets.Causal.Laplacian.causalClosure_idem C S,
   Flow.CurvatureRegime.vanishes_iff_flat r,
   Flow.CurvatureRegime.nonvanishes_iff_curved r⟩

end CausalSets.Support.Microlocal
end Obsmetrologia
