import ObsmetrologiaPhysicalScience.CausalSets.Causal.Reachability
import Obsmetrologia.Dynamics.Flow.TransfiniteClosureFlow

/-!
# Arrow of time as ordinal-staged causal asymmetry

The arrow of time enters the relational spacetime layer after causal settling.
The settled future relation is directed reachability. Its arrow law is not an
external thermodynamic principle: a future step has no reverse future step because
the causal settling is acyclic.

An ordinal clock may be attached to a directed carrier when each step advances to
at least the successor stage. This module records that carrier without claiming
that every causal set already has a constructed ordinal stage map.

## Main definitions

* `Future` and `Past` read the settled causal order in the forward and reverse
  directions.
* `OrdinalArrowOfTime` packages a directed relation with an `Ord`-valued stage
  map, successor advance, and no-return law.
* `causalOrdinalArrow` attaches such a clock to a causal set when an ordinal
  stage map is supplied.

## Main results

* `future_irrefl`, `future_asymm`, `future_not_past`, and `past_not_future`
  expose the causal arrow directly from settled reachability.
* `OrdinalArrowOfTime.irrefl` and `OrdinalArrowOfTime.asymm` expose the laws of
  an ordinal-staged arrow.
* `causalOrdinalArrow_no_return` shows that the causal instance inherits
  no-return from causal settling itself.

## Tags

arrow of time, ordinal clock, causal settling, asymmetry, no return
-/

namespace Obsmetrologia
namespace CausalSets.Causal.ArrowOfTime

variable {E : Type}

/-- A local abbreviation for the causal-set carrier. -/
abbrev CausalSet (E : Type) :=
  Obsmetrologia.CausalSets.Causal.Order.CausalSet E

/-- The future relation generated by causal settling. -/
abbrev Future (C : CausalSet E) (a b : E) : Prop :=
  C.reaches a b

/-- The past relation, read as future in the opposite direction. -/
abbrev Past (C : CausalSet E) (a b : E) : Prop :=
  C.reaches b a

/-- Future reachability composes. -/
theorem future_trans (C : CausalSet E) {a b c : E}
    (hab : Future C a b) (hbc : Future C b c) : Future C a c :=
  C.reaches_trans hab hbc

/-- No event is in its own strict future. -/
theorem future_irrefl (C : CausalSet E) (a : E) : Not (Future C a a) :=
  C.reaches_irrefl a

/-- A future step has no reverse future step. -/
theorem future_asymm (C : CausalSet E) {a b : E}
    (hab : Future C a b) (hba : Future C b a) : False :=
  C.reaches_asymm hab hba

/-- A future step excludes the corresponding past step. -/
theorem future_not_past (C : CausalSet E) {a b : E}
    (hab : Future C a b) : Not (Past C a b) :=
  fun hba => C.reaches_asymm hab hba

/-- A past step excludes the corresponding future step. -/
theorem past_not_future (C : CausalSet E) {a b : E}
    (hba : Past C a b) : Not (Future C a b) :=
  fun hab => C.reaches_asymm hab hba

/-- An ordinal-staged arrow of time: every `before` step advances at least to the
successor stage, and no step is reversible. -/
structure OrdinalArrowOfTime (E : Type) where
  /-- The directed temporal relation. -/
  before : E -> E -> Prop
  /-- The ordinal stage read at each carrier. -/
  stage : E -> Ord
  /-- Each temporal step advances by at least one ordinal successor. -/
  advances : forall {a b : E}, before a b -> Ord.Le (Ord.succ (stage a)) (stage b)
  /-- Temporal steps do not reverse. -/
  no_return : forall {a b : E}, before a b -> before b a -> False

namespace OrdinalArrowOfTime

/-- An ordinal arrow has no self-step. -/
theorem irrefl (T : OrdinalArrowOfTime E) (a : E) : Not (T.before a a) :=
  fun h => T.no_return h h

/-- An ordinal arrow is asymmetric. -/
theorem asymm (T : OrdinalArrowOfTime E) {a b : E}
    (hab : T.before a b) (hba : T.before b a) : False :=
  T.no_return hab hba

end OrdinalArrowOfTime

/-- A causal set with an ordinal stage map becomes an ordinal arrow of time when
causal reachability advances stages. The no-return law is supplied by causal
settling itself. -/
def causalOrdinalArrow (C : CausalSet E) (stage : E -> Ord)
    (hstage : forall {a b : E}, C.reaches a b -> Ord.Le (Ord.succ (stage a)) (stage b)) :
    OrdinalArrowOfTime E where
  before := C.reaches
  stage := stage
  advances := hstage
  no_return := fun hab hba => C.reaches_asymm hab hba

/-- The ordinal arrow attached to a causal set has exactly causal reachability as
its temporal relation. -/
theorem causalOrdinalArrow_before (C : CausalSet E) (stage : E -> Ord)
    (hstage : forall {a b : E}, C.reaches a b -> Ord.Le (Ord.succ (stage a)) (stage b))
    {a b : E} :
    (causalOrdinalArrow C stage hstage).before a b <-> C.reaches a b :=
  Iff.rfl

/-- The ordinal arrow attached to a causal set inherits causal no-return. -/
theorem causalOrdinalArrow_no_return (C : CausalSet E) (stage : E -> Ord)
    (hstage : forall {a b : E}, C.reaches a b -> Ord.Le (Ord.succ (stage a)) (stage b))
    {a b : E}
    (hab : (causalOrdinalArrow C stage hstage).before a b)
    (hba : (causalOrdinalArrow C stage hstage).before b a) : False :=
  (causalOrdinalArrow C stage hstage).no_return hab hba

end CausalSets.Causal.ArrowOfTime
end Obsmetrologia
