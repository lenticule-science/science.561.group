{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/artificial-abiogenesis/specimen/v0.1",
  "title": "Artificial Abiogenesis Specimen v0.1",
  "type": "object",
  "required": [
    "specimen_id",
    "family",
    "assay_contract",
    "reality_layer",
    "created_at",
    "genotype_ref",
    "environment_ref",
    "provenance_refs",
    "lineage_edges",
    "observations",
    "phenotypes",
    "capabilities"
  ],
  "properties": {
    "specimen_id": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "assay_contract": {
      "type": "string",
      "minLength": 1
    },
    "reality_layer": {
      "enum": [
        "physical",
        "simulation",
        "reference-oracle"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "genotype_ref": {
      "type": "string"
    },
    "environment_ref": {
      "type": "string"
    },
    "provenance_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lineage_edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "parent_ids",
          "evidence_refs"
        ],
        "properties": {
          "kind": {
            "enum": [
              "manual-replicate",
              "engineered-variant",
              "simulation-fork",
              "sample-derived",
              "material-offspring",
              "material-fusion",
              "protocol-descendant",
              "simulation-calibrated-to-physical"
            ]
          },
          "parent_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measurement"
      }
    },
    "phenotypes": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/measurement"
          },
          {
            "type": "object",
            "required": [
              "analysis_revision",
              "source_observations",
              "derivation_ref"
            ],
            "properties": {
              "analysis_revision": {
                "type": "string"
              },
              "source_observations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "derivation_ref": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "reading",
          "evidence_for",
          "evidence_against",
          "assessment_contract"
        ],
        "properties": {
          "capability": {
            "pattern": "^[RS](?:10|[0-9])$"
          },
          "reading": {
            "enum": [
              "unknown",
              "held",
              "denied",
              "contested"
            ]
          },
          "evidence_for": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_against": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "assessment_contract": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "measurement": {
      "type": "object",
      "required": [
        "measurement_id",
        "metric",
        "value",
        "unit",
        "assay_id",
        "method_ref",
        "evidence_ref",
        "validity",
        "observed_at"
      ],
      "properties": {
        "measurement_id": {
          "type": "string"
        },
        "metric": {
          "type": "string"
        },
        "value": {
          "type": [
            "number",
            "string",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "assay_id": {
          "type": "string"
        },
        "method_ref": {
          "type": "string"
        },
        "evidence_ref": {
          "type": "string"
        },
        "validity": {
          "enum": [
            "valid",
            "censored",
            "invalid",
            "missing"
          ]
        },
        "uncertainty": {
          "type": [
            "object",
            "null"
          ]
        },
        "observed_at": {
          "type": "string"
        }
      }
    }
  }
}
