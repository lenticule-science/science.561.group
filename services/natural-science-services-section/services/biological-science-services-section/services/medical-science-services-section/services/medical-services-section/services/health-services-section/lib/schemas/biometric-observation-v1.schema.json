{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"urn:red-cup-science:health:biometric-observation:1.0.0",
  "title":"Biometric observation v1",
  "description":"General health-science biometric observation record: one measured, estimated, or explicitly missing reading of a named metric, with source, consent, and media-retention custody. Domain sections (nutrition, pacing, and others) profile this schema with an allOf plus their own recordType const rather than copying its fields.",
  "type":"object","additionalProperties":false,
  "required":["recordType","schemaVersion","observationId","metric","source","missingness","consentScope","mediaRetention"],
  "properties":{"recordType":{"$ref":"#/$defs/id"},"schemaVersion":{"const":"1.0.0"},"observationId":{"$ref":"#/$defs/id"},"metric":{"$ref":"#/$defs/metricId"},"measuredAt":{"$ref":"#/$defs/timestamp"},"enteredAt":{"$ref":"#/$defs/timestamp"},"source":{"$ref":"#/$defs/biometricSource"},"measurement":{"$ref":"#/$defs/measurement"},"missingness":{"$ref":"#/$defs/missingness"},"consentScope":{"$ref":"#/$defs/consentScope"},"mediaRetention":{"$ref":"#/$defs/mediaRetention"}},
  "anyOf":[{"required":["measuredAt"]},{"required":["enteredAt"]}],
  "if":{"properties":{"missingness":{"properties":{"status":{"const":"missing"}}}}},
  "then":{"not":{"required":["measurement"]}},
  "else":{"required":["measurement"]},
  "$defs":{
    "id":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "metricId":{"type":"string","pattern":"^[a-z][a-z0-9-]{0,63}$"},
    "timestamp":{"type":"string","pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "biometricSource":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["device","manual","derived"]},"deviceId":{"type":"string","minLength":1},"deviceModel":{"type":"string","minLength":1},"derivedFrom":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/id"}}}},
    "measurement":{"type":"object","additionalProperties":false,"required":["value","unit","precision"],"properties":{"value":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"},"unit":{"type":"string","minLength":1},"precision":{"type":"string","pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$"}}},
    "missingness":{"type":"object","additionalProperties":false,"required":["status"],"properties":{"status":{"enum":["observed","estimated","missing"]},"reason":{"type":"string","minLength":1}}},
    "consentScope":{"type":"object","additionalProperties":false,"required":["kind"],"properties":{"kind":{"enum":["self-only","care-team","research","withdrawn"]},"grantedTo":{"type":"string","minLength":1}}},
    "mediaRetention":{"type":"object","additionalProperties":false,"required":["containsRawPhoto","containsReceiptImage","containsRawAudio","containsAppearanceEmbedding","containsRawWearablePayload"],"properties":{"containsRawPhoto":{"const":false},"containsReceiptImage":{"const":false},"containsRawAudio":{"const":false},"containsAppearanceEmbedding":{"const":false},"containsRawWearablePayload":{"const":false}}}
  }
}
