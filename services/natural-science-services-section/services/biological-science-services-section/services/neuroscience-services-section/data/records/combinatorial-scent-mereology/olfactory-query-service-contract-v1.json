{
  "schemaVersion": 1,
  "type": "CSMOlfactoryQueryServiceContract",
  "serviceId": "urn:561:csm:olfactory-query:v1",
  "recordedAt": "2026-10-03",
  "semanticObject": "context-indexed-human-percept-distribution",
  "requiredContext": [
    "formulaVersion",
    "doseOrConcentration",
    "substrateOrApplication",
    "elapsedTimeOrTrajectory",
    "observerOrPopulationModel"
  ],
  "optionalContext": [
    "temperature",
    "humidity",
    "airflow",
    "deliveryMethod",
    "priorAdaptationState"
  ],
  "evidenceStrata": [
    "sourced",
    "measured-human",
    "measured-sensor",
    "derived-deterministic",
    "predicted",
    "counterfactual",
    "constraint-or-obstruction"
  ],
  "operations": [
    {
      "name": "predict_percept",
      "inputs": ["formula", "context"],
      "outputs": ["descriptorDistribution", "intensityDistribution", "uncertainty", "warrant"]
    },
    {
      "name": "predict_trajectory",
      "inputs": ["formula", "context", "times"],
      "outputs": ["trajectory", "uncertainty", "warrant"]
    },
    {
      "name": "compare_percepts",
      "inputs": ["a", "b", "task"],
      "outputs": ["distanceOrScore", "metric", "residualVector", "uncertainty"]
    },
    {
      "name": "predict_intervention",
      "inputs": ["formula", "intervention", "context"],
      "outputs": ["propertyDeltas", "uncertainty", "support"]
    },
    {
      "name": "find_substitute",
      "inputs": ["formula", "part", "preserve", "constraints"],
      "outputs": ["candidates", "residuals", "costDeltas", "constraintReceipts"]
    },
    {
      "name": "compile_target",
      "inputs": ["target", "palette", "constraints"],
      "outputs": ["candidateFormulas", "tradeoffs", "constraintReceipts"]
    },
    {
      "name": "compile_surrogate",
      "inputs": ["reference", "palette", "preserve", "constraints"],
      "outputs": ["candidateFormulas", "residualVectors", "costDeltas", "sourceRiskDeltas", "validationPlan"]
    },
    {
      "name": "explain_obstruction",
      "inputs": ["target", "palette", "constraints"],
      "outputs": ["conflictingConstraints", "missingCapabilities", "relaxationOptions"]
    },
    {
      "name": "query_formula_impact",
      "inputs": ["materialOrRuleChange"],
      "outputs": ["affectedFormulas", "affectedBatches", "candidateActions"]
    }
  ],
  "graphArchitecture": {
    "explicitGraphs": [
      "urn:csm:graph:source",
      "urn:csm:graph:observation",
      "urn:csm:graph:derived"
    ],
    "virtualGraphs": [
      "urn:csm:graph:prediction:<modelVersion>",
      "urn:csm:graph:counterfactual:<queryDigest>",
      "urn:csm:graph:rules:<ruleSetVersion>"
    ],
    "sparqlPolicy": "Explicit state is queried normally. Predictive and inverse-design work is invoked through a federated service or domain function and returned as a provenance-bearing virtual named graph."
  },
  "predictionReceipt": {
    "required": [
      "queryDigest",
      "inputDigests",
      "formulaVersion",
      "context",
      "modelId",
      "modelVersion",
      "dataVersion",
      "ruleSetVersion",
      "prediction",
      "uncertainty",
      "evidenceBoundary",
      "rights",
      "generatedAt"
    ]
  },
  "surrogatePolicy": {
    "goal": "functional-or-perceptual-equivalence-under-stated-context-not-chemical-identity",
    "allowedConstraintExamples": [
      "lower-cost",
      "animal-free",
      "protected-source-free",
      "synthetic-or-biotech-only",
      "natural-free",
      "current-stock-only",
      "high-supply-robustness",
      "maximum-ingredient-count",
      "robot-dispensable",
      "current-safety-envelope"
    ],
    "prohibitedBehavior": [
      "provide-procurement-help-for-protected-or-illegal-source-material",
      "claim-chemical-identity-from-perceptual-similarity",
      "collapse-reference-natural-to-one-idealized-lot-when-lot-data-exist"
    ]
  },
  "failClosedConditions": [
    "formula-identity-unresolved",
    "material-composition-insufficient-for-requested-constraint",
    "context-outside-model-support",
    "required-rule-version-missing",
    "required-rights-or-license-unresolved",
    "uncertainty-above-operation-threshold"
  ],
  "benchmarkGates": [
    "reproduce-single-material-baseline",
    "reproduce-mixture-baseline",
    "held-out-intervention-delta-test",
    "uncertainty-calibration-test",
    "surrogate-vs-simple-one-to-one-baseline-test"
  ],
  "economicSurfaces": [
    "metered-query-api",
    "private-formula-graph",
    "reformulation-oracle",
    "surrogate-compiler",
    "formula-impact-watch",
    "ingredient-function-api",
    "historical-reconstruction-api",
    "enterprise-private-instance"
  ]
}
