{
  "name": "@lenticule-science/obsmetrologia",
  "version": "0.1.1",
  "type": "module",
  "description": "Obsmetrologia's dependency-free Lean 4 library of pure mathematics generated from its mathematical corpus.",
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@red-cup-engineering/lean-blueprint-chart-service": "0.0.2"
  },
  "files": [
    "AGENTS.md",
    "CLAUDE.md",
    "Obsmetrologia.lean",
    "Obsmetrologia/",
    "Makefile",
    "package-scope.json",
    "PROJECTIZATION.md",
    "README.md",
    "docs/blueprint/README.md",
    "docs/blueprint/src/",
    "lake-manifest.json",
    "lakefile.toml",
    "lean-toolchain",
    "package.json",
    "scripts/",
    "test/"
  ],
  "scripts": {
    "collatz:audit:axioms": "node scripts/audit-collatz-axioms.mjs",
    "collatz:audit:denominator-growth": "python3 scripts/collatz-denominator-growth-audit.py",
    "collatz:audit:frontier": "node scripts/audit-collatz-frontier.mjs",
    "collatz:audit:parent-gap": "python3 scripts/collatz-parent-gap-audit.py",
    "lean:audit": "npm run lean:audit:scope && npm run lean:audit:packaging && npm run lean:audit:frontier && npm run collatz:audit:frontier && npm run collatz:audit:axioms && npm run lean:audit:surfaces && npm run collatz:audit:parent-gap && npm run collatz:audit:denominator-growth",
    "lean:audit:blueprint:local": "node scripts/audit-blueprint.mjs --fail",
    "lean:audit:frontier": "node scripts/audit-lean-frontier.mjs --fail-on-trust",
    "lean:audit:local": "npm run lean:audit && npm run lean:audit:blueprint:local",
    "lean:audit:packaging": "node scripts/audit-obsmetrologia-packaging.mjs --fail",
    "lean:audit:scope": "node scripts/audit-package-scope.mjs --fail && node --test test/package-scope.test.mjs",
    "lean:audit:surfaces": "node scripts/audit-cross-surfaces.mjs --fail-on-bad-blueprint --fail-on-bad-verso",
    "lean:build": "lake build",
    "lean:check": "make check",
    "lean:check:primitive": "lake env lean Obsmetrologia/Primitive.lean",
    "lean:lsp": "lake env lean --server",
    "lean:mcp": "uvx lean-lsp-mcp --lean-project-path . --instructions \"Obsmetrologia Lean proofing server. Use Lean LSP tools before shell/read/grep for Lean questions: diagnostics, term goals, hover, outline, local_search, run_code #print axioms, and multi_attempt. Whole-project checks still use make build or make check.\"",
    "lean:mcp:tools": "uv run --with mcp python scripts/lean-mcp-call.py --list-tools"
  },
  "ick": {
    "lean": {
      "rootModule": "Obsmetrologia",
      "rootModuleFile": "Obsmetrologia.lean",
      "moduleRoots": [
        "Obsmetrologia"
      ],
      "declarationIndexFiles": [
        "docs/blueprint/lean_decls"
      ],
      "conformanceDir": "conformance",
      "gates": {
        "fullBuild": {
          "command": "lake",
          "args": [
            "build"
          ]
        },
        "targetedModule": {
          "command": "lake",
          "argsTemplate": [
            "env",
            "lean",
            "{modulePath}"
          ]
        },
        "check": {
          "command": "make",
          "args": [
            "check"
          ]
        }
      }
    }
  }
}
