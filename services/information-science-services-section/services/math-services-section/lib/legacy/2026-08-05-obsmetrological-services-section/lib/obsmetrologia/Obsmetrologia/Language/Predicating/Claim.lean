import Obsmetrologia.Language.Predicating.Cell

/-!
# Claim point

Predicating turns the claim-side mark of an utterance into an oriented assertion
position. This module names that generated point: a `Claim` is the predication
cell read as the point at which later value, settlement, and descent can be
carried.

## Main definitions

* `Claim`
* `Claim.seed`
* `Claim.ofPotential`

## Main results

* `Claim.seed_predicate`
* `Claim.ofPotential_eq_seed`
-/

namespace Obsmetrologia

/-- A claim point: the oriented assertion-position generated by predicating. -/
abbrev Claim : Type :=
  PredicationCell

namespace Claim

/-- The claim point generated directly by an utterance. -/
def seed (u : Utterance) : Claim :=
  PredicationCell.seed u

/-- The claim point generated from a typed potential articulation cell. -/
def ofPotential (c : Articulating.PotentialCell) : Claim :=
  PredicationCell.predicating c

@[simp] theorem seed_subject (u : Utterance) : (seed u).subject = u.token := rfl

@[simp] theorem seed_predicate (u : Utterance) : (seed u).predicate = u.claim := rfl

@[simp] theorem seed_object (u : Utterance) : (seed u).object = u.token := rfl

@[simp] theorem ofPotential_eq_seed (c : Articulating.PotentialCell) :
    ofPotential c = seed c.utterance := rfl

/-- Claim points inherit predication-cell converse. -/
def converse (q : Claim) : Claim :=
  PredicationCell.converse q

@[simp] theorem converse_converse (q : Claim) : converse (converse q) = q :=
  PredicationCell.converse_converse q

end Claim

end Obsmetrologia
