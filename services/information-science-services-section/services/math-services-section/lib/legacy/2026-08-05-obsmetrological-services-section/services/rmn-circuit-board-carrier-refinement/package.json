{
  "name": "@lenticule-science/rmn-circuit-board-carrier-refinement",
  "version": "2.0.2",
  "type": "module",
  "description": "Independent canonical RMN netlist carrier refinement assay for recursive composite circuit boards.",
  "exports": {
    ".": "./src/refinement-assay.mjs",
    "./client": "./src/client.mjs",
    "./package.json": "./package.json"
  },
  "bin": {
    "serve-rmn-circuit-board-carrier-refinement-a2a": "./scripts/server.mjs"
  },
  "scripts": {
    "check": "node --check src/refinement-assay.mjs && node --check src/client.mjs && node --check scripts/execute-a2a-task.mjs && node --check scripts/server.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@red-cup-engineering/relation-model-notation-cbor-codec": "0.1.0",
    "@a2a-js/sdk": "1.0.0-beta.0",
    "@lenticule-science/hierarchical-circuit-equivalence-assay": "1.0.2",
    "@lenticule-science/infomaterial-observation": "2.0.2",
    "@red-cup-engineering/a2a-contracted-agent-service": "2.0.5",
    "@red-cup-engineering/a2a-rmn-part-service": "1.0.1",
    "@red-cup-engineering/a2a-rmn-task-client-service": "1.1.1",
    "@red-cup-engineering/relation-model-notation-runtime": "7.0.0",
    "@red-cup-engineering/relational-value-graph-service": "0.1.1",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.2",
    "@red-cup-engineering/witness-journal-rdf-projection-service": "1.1.0"
  }
}
