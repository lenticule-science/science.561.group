  "requirements": [
    {"id":"utterance-only-marks","statement":"An utterance mark list contains exactly the primitive marks already carried by its token and claim."},
    {"id":"recursion-provenance","statement":"An articulating mark list is obtained recursively from head utterance marks and tail articulating marks."},
    {"id":"head-floor-provenance","statement":"The head and floor token and claim marks belong to the articulating mark list."},
    {"id":"trace-provenance","statement":"A mark carried by an articulating in a trace belongs to the trace mark list."}
