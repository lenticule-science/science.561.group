import Obsmetrologia.KineticTheory.Gas.DiscreteVelocityCollision
import Obsmetrologia.Closure.RuleSystem

/-!
# BoltzmannClosure - finite collisions as closure rules

Finite discrete-velocity collisions can be read as positive closure rules: when the
incoming velocity pair is present as evidence, the outgoing pair is asserted as
evidence. This module wires `KineticTheory.Gas.Collision` into `Closure.RuleSystem` without
rebuilding the collision-invariant algebra already proved in
`KineticTheory.Gas.DiscreteVelocityCollision`.

## Main definitions
* `collisionAntecedent` - the positive test that an incoming pair is present.
* `collisionRule` - the closure rule generated by one collision.
* `collisionRuleSystem` - a finite collision list as a rule system.
* `collisionClosure` - the three-step closure operator supplied by `Closure.RuleSystem`.

## Main results
* `finite_boltzmann_collision_lfp` - the collision closure is the least fixed point of
  the immediate-consequence operator, under the same settled-orbit hypothesis as
  `ClosureRule.immediate_consequence_lfp`.
* `finite_collision_invariants_preserved` - shared collision invariants are preserved
  along finite collision evolutions, reusing `KineticTheory.Gas.evolution_conserves`.

## References
`dev/content/dreaming/reflecting/2026/06/27/obsmetrologia_gases_liquids_plasmas_proof_frontier.md`
sections 2.5, 3.1.1, and Batch A.

## Tags
kinetic theory, Boltzmann, closure rule, immediate consequence, least fixed point
-/

namespace Obsmetrologia
namespace KineticTheory.Gas

open Obsmetrologia.ClosureRule

/-! ## Collision rules -/

/-- The antecedent of a finite collision rule: the incoming pair cell already carries
positive evidence. The embedding `pairCell` says how velocity pairs are represented in
the ambient predication-cell base. -/
def collisionAntecedent {V : Type} (pairCell : V -> V -> PredicationCell)
    (c : Collision V) (v : Valuation) : Bool :=
  Charge.leK Charge.tTop (v (pairCell c.inL c.inR))

/-- The collision antecedent is positive in the valuation, hence admissible as a
`ClosureRule` antecedent. -/
theorem collisionAntecedent_mono {V : Type} (pairCell : V -> V -> PredicationCell)
    (c : Collision V) {v w : Valuation} (h : Valuation.leK v w)
    (hv : collisionAntecedent pairCell c v = true) :
    collisionAntecedent pairCell c w = true := by
  unfold collisionAntecedent at hv
  unfold collisionAntecedent
  exact Charge.kle_trans Charge.tTop (v (pairCell c.inL c.inR))
    (w (pairCell c.inL c.inR)) hv (h (pairCell c.inL c.inR))

/-- The closure rule generated by one collision `(a,b) -> (a',b')`: if the incoming
pair cell is present, assert positive evidence for the outgoing pair cell. -/
def collisionRule {V : Type} (pairCell : V -> V -> PredicationCell)
    (c : Collision V) : ClosureRule where
  antecedent := collisionAntecedent pairCell c
  antMono := fun h hv => collisionAntecedent_mono pairCell c h hv
  cell := pairCell c.outL c.outR
  charge := Charge.tTop

/-- A finite collision list as a finite closure-rule system. -/
def collisionRuleSystem {V : Type} (pairCell : V -> V -> PredicationCell)
    (cs : List (Collision V)) : RuleSystem :=
  cs.map (collisionRule pairCell)

/-- One immediate-consequence step of the finite Boltzmann collision rule system. -/
def collisionTstep {V : Type} (pairCell : V -> V -> PredicationCell)
    (cs : List (Collision V)) (v : Valuation) : Valuation :=
  Tstep (collisionRuleSystem pairCell cs) v

/-- The finite Boltzmann collision closure supplied by the closure-rule engine. -/
def collisionClosure {V : Type} (pairCell : V -> V -> PredicationCell)
    (cs : List (Collision V)) (seed : Valuation) : Valuation :=
  clS (collisionRuleSystem pairCell cs) seed

/-- The collision-rule closure is the least fixed point of the immediate-consequence
operator above the seed, once the finite rule orbit has reached a fixed point. -/
theorem finite_boltzmann_collision_lfp {V : Type}
    (pairCell : V -> V -> PredicationCell) (cs : List (Collision V))
    (seed : Valuation)
    (hfix : SClosed (collisionRuleSystem pairCell cs)
      (collisionClosure pairCell cs seed)) :
    collisionTstep pairCell cs (collisionClosure pairCell cs seed)
      = collisionClosure pairCell cs seed
    /\ Valuation.leK seed (collisionClosure pairCell cs seed)
    /\ (forall x, Valuation.leK seed x ->
      collisionTstep pairCell cs x = x ->
      Valuation.leK (collisionClosure pairCell cs seed) x) := by
  unfold collisionTstep collisionClosure
  exact immediate_consequence_lfp (collisionRuleSystem pairCell cs) seed hfix

/-- In a closed collision rule system, any fired collision has its outgoing pair already
asserted in the closed valuation. -/
theorem closed_collision_outputs {V : Type}
    (pairCell : V -> V -> PredicationCell) (cs : List (Collision V))
    {w : Valuation} (hw : SClosed (collisionRuleSystem pairCell cs) w)
    (c : Collision V) (hc : c ∈ cs)
    (hant : collisionAntecedent pairCell c w = true) :
    Charge.KLE Charge.tTop (w (pairCell c.outL c.outR)) := by
  have hr : collisionRule pairCell c ∈ collisionRuleSystem pairCell cs :=
    List.mem_map.2 ⟨c, hc, rfl⟩
  exact rule_respecting (collisionRuleSystem pairCell cs) hw
    (collisionRule pairCell c) hr hant

/-! ## Conserved invariants -/

/-- Shared finite collision invariants are preserved along every finite collision
evolution. This is the invariant side of Batch A, reused from the existing
`DiscreteVelocityCollision` module. -/
theorem finite_collision_invariants_preserved {V : Type}
    {cs : List (Collision V)} {w : V -> Int}
    (hcs : forall c, c ∈ cs -> c.Conserves w)
    {p q : Population V} (h : Evolves cs p q) :
    total w p = total w q :=
  evolution_conserves hcs h

end KineticTheory.Gas
end Obsmetrologia
