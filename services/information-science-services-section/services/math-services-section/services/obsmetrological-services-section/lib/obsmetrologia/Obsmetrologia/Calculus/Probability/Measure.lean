import Obsmetrologia.Language.Positing.Value.Category
import Obsmetrologia.Language.Predicating.HyperdoctrineDual
import Obsmetrologia.Calculus.Order.SetNumberGraphTheory

/-!
# Probability measure — the posit made quantitative

Probability theory is generated by the **posit** morphism — the third stage of
*articulate → predicate → posit → settle*, where value enters predication by
**evidence**. A bare predication says only *that* an event holds; a probability
says *with what standing*. A probability is therefore a **valuation**: a measure
assigning graded charge to the events of a sample space, with the certain event
weighted maximally, the impossible event `0`, and disjoint events adding. It is
positing made quantitative (formalizes
`positing/content/probability-theory/probability-theory.md`).

This module derives the formalizable spine, dependency-free and finite-friendly:

## Events — the Boolean algebra of the sample space
An **event** over a finite sample space `Ω` is a `Obsmetrologia.Discrete.Set`: the
extension of a predicate `Ω → Bool`. We REUSE `SetNumberGraphTheory`'s `Set`
type wholesale — intersection `∩`, union `∪`, complement `ᶜ`, subset `⊆`, the
empty/`univ` events, and De Morgan are already proved there as the canonical
Boolean algebra. The sample space is a duplicate-free *listed* carrier `Ω`, the
finite support over which counting is defined.

## Measure — a valuation into a counting value
We model the measure value, **by design**, as the **finite uniform / counting
measure** `μ(A) = |A ∩ Ω| ∈ Nat`: the number of listed
outcomes at which the event's predicate holds. Additivity is then the `Nat`
identity `|A ⊔ B| = |A| + |B|` for disjoint `A,B`, proven by induction on the
outcome list; normalization is `μ(∅) = 0` and `μ(Ω) = |Ω|` (the counting
analogue of `P(Ω) = 1`); monotonicity is `A ⊆ B → μ(A) ≤ μ(B)`; the complement
law is `μ(Aᶜ) = |Ω| − μ(A)`. This is exactly the valuation reading: the certain
event carries the full count, the impossible event none, disjoint evidence adds.

## Conditioning — the hyperdoctrine FIBER-ADJOINT
Conditioning on an event `B` is **restriction to the sub-event-algebra of `B`** —
the corpus's reindexing `f*` (`Hyperdoctrine.reindex`, precomposition in the
base): `P(A | B)` is the `B`-restricted measure `μ(A ∩ B)`, and the symmetric
**Bayes** identity is the count equation
`μ(A ∩ B) = P(A|B)·… = P(B|A)·…`, here read as the single shared count
`μ(A ∩ B) = μ(B ∩ A)` (the numerator of `P(A|B)P(B)` and of `P(B|A)P(A)`), the
fiber-adjoint making conditioning a restriction. Reindexing-as-restriction is
the `f*` of `Hyperdoctrine`; conditioning lands in the fiber over `B`.
-/

namespace Obsmetrologia
namespace Probability.Measure

open Obsmetrologia.Discrete

/-! ## (A) Events — the Boolean algebra of a finite sample space -/

/-- An **event** over a sample space carrier `Ω` is a `Discrete.Set Ω`: the
extension of a predicate `Ω → Bool`. We reuse the powerset Boolean algebra of
`SetNumberGraphTheory` wholesale (no new event data model). -/
abbrev Event (Ω : Type) : Type := Set Ω

/-- A **finite sample space**: a carrier `Ω` together with a (duplicate-free,
exhaustive) list of its outcomes `outcomes`. This is the finite support over
which the counting measure `μ(A) = |A ∩ Ω|` is defined — the analogue of the
listed-vertex `FinGraph`. -/
structure SampleSpace (Ω : Type) where
  /-- The listed outcomes of the sample space `Ω`. -/
  outcomes : List Ω

namespace SampleSpace
variable {Ω : Type}

/-! ## (B) The counting measure — a valuation into `Nat` -/

/-- The **counting measure** `μ(A) = |A ∩ Ω|`: the number of listed outcomes at
which the event's predicate holds. Defined by direct recursion on the outcome
list — a `Nat` count. This is the finite uniform
measure; `P(A) = μ(A) / |Ω|` is tracked as the pair `(μ(A), μ(Ω))`. -/
def measure (S : SampleSpace Ω) (A : Event Ω) : Nat :=
  go S.outcomes A
where
  go : List Ω → Event Ω → Nat
  | [], _ => 0
  | x :: xs, A => (if A x = true then 1 else 0) + go xs A

/-- The total mass `μ(Ω) = |Ω|`: every listed outcome is in the certain event. -/
def total (S : SampleSpace Ω) : Nat := S.outcomes.length

/-! ### Pointwise recursion lemmas for the counting `go` -/

theorem measure_go_nil (A : Event Ω) : SampleSpace.measure.go ([] : List Ω) A = 0 := rfl

theorem measure_go_cons (x : Ω) (xs : List Ω) (A : Event Ω) :
    SampleSpace.measure.go (x :: xs) A = (if A x = true then 1 else 0) + measure.go xs A := rfl

/-- **The empty event has measure zero** (Kolmogorov: `P(∅) = 0`). On `Set.empty`
the indicator is `false` at every outcome, so the count is `0`. -/
theorem measure_empty (S : SampleSpace Ω) : S.measure Set.empty = 0 := by
  show SampleSpace.measure.go S.outcomes Set.empty = 0
  induction S.outcomes with
  | nil => rfl
  | cons x xs ih =>
    rw [measure_go_cons]
    show (if (Set.empty : Event Ω) x = true then 1 else 0) + SampleSpace.measure.go xs Set.empty = 0
    have : (Set.empty : Event Ω) x = false := rfl
    rw [this, ih]
    rfl

/-- **The certain event carries the full mass** `μ(Ω) = |Ω|` (the counting
analogue of Kolmogorov's `P(Ω) = 1`). On `Set.univ` the indicator is `true`
everywhere, so the count is the length of the outcome list. -/
theorem measure_univ (S : SampleSpace Ω) : S.measure Set.univ = S.total := by
  show SampleSpace.measure.go S.outcomes Set.univ = S.outcomes.length
  induction S.outcomes with
  | nil => rfl
  | cons x xs ih =>
    rw [measure_go_cons]
    show (if (Set.univ : Event Ω) x = true then 1 else 0) + SampleSpace.measure.go xs Set.univ
        = (x :: xs).length
    have : (Set.univ : Event Ω) x = true := rfl
    rw [this, ih]
    simp [List.length_cons, Nat.add_comm]

/-! ### Finite additivity on disjoint events -/

/-- **Finite additivity on disjoint events** (Kolmogorov, finite form):
`μ(A ⊔ B) = μ(A) + μ(B)` whenever `A ∩ B = ∅`. The hypothesis is the pointwise
disjointness `∀ x, ¬(A x ∧ B x)`; on each outcome at most one indicator fires, so
the union's count splits as the sum. Proven by induction on the outcome list over
`Nat`. -/
theorem measure_union_disjoint (S : SampleSpace Ω) (A B : Event Ω)
    (hdisj : Set.inter A B = Set.empty) :
    S.measure (Set.union A B) = S.measure A + S.measure B := by
  -- Pointwise disjointness extracted from the set equation.
  have hpt : ∀ x, A x = true → B x = true → False := by
    intro x hax hbx
    have : (Set.inter A B) x = (Set.empty : Event Ω) x := congrFun hdisj x
    show False
    simp only [Set.inter, hax, hbx] at this
    exact Bool.noConfusion this
  show SampleSpace.measure.go S.outcomes (Set.union A B)
      = SampleSpace.measure.go S.outcomes A + SampleSpace.measure.go S.outcomes B
  induction S.outcomes with
  | nil => rfl
  | cons x xs ih =>
    rw [measure_go_cons, measure_go_cons, measure_go_cons, ih]
    -- Compare the head indicators; the union indicator is the `||`.
    show (if (Set.union A B) x = true then 1 else 0)
          + (SampleSpace.measure.go xs A + SampleSpace.measure.go xs B)
        = ((if A x = true then 1 else 0) + SampleSpace.measure.go xs A)
          + ((if B x = true then 1 else 0) + SampleSpace.measure.go xs B)
    have hu : (Set.union A B) x = (A x || B x) := rfl
    rw [hu]
    cases hA : A x <;> cases hB : B x
    · -- both false
      simp
    · -- A false, B true
      simp [Nat.add_left_comm]
    · -- A true, B false
      simp [Nat.add_assoc]
    · -- both true — contradicts disjointness
      exact absurd hB (by have := hpt x hA; simp_all)

/-! ### Monotonicity -/

/-- **Monotonicity** of the counting measure: `A ⊆ B → μ(A) ≤ μ(B)`. Subset means
the `A`-indicator implies the `B`-indicator at every outcome, so the count cannot
decrease. Proven by induction on the outcome list. -/
theorem measure_mono (S : SampleSpace Ω) {A B : Event Ω} (h : Set.subset A B) :
    S.measure A ≤ S.measure B := by
  show SampleSpace.measure.go S.outcomes A ≤ SampleSpace.measure.go S.outcomes B
  induction S.outcomes with
  | nil => exact Nat.le_refl 0
  | cons x xs ih =>
    rw [measure_go_cons, measure_go_cons]
    -- head terms: if A x then so is B x.
    have hhead : (if A x = true then 1 else 0) ≤ (if B x = true then 1 else 0) := by
      cases hA : A x
      · simp
      · have hB : B x = true := h x hA
        rw [hB]; simp
    exact Nat.add_le_add hhead ih

/-! ### The complement law -/

/-- **The complement law** `μ(Aᶜ) = |Ω| − μ(A)` (the counting analogue of
`P(Aᶜ) = 1 − P(A)`). `A` and `Aᶜ` are disjoint and union to `Ω`, so
`μ(A) + μ(Aᶜ) = μ(Ω) = |Ω|`; the subtraction form follows over `Nat`. -/
theorem measure_compl_add (S : SampleSpace Ω) (A : Event Ω) :
    S.measure A + S.measure (Set.compl A) = S.total := by
  have hdisj : Set.inter A (Set.compl A) = Set.empty := Set.inter_compl A
  have hunion : Set.union A (Set.compl A) = Set.univ := Set.union_compl A
  have hadd := S.measure_union_disjoint A (Set.compl A) hdisj
  rw [hunion, measure_univ] at hadd
  exact hadd.symm

/-- **The complement law, subtraction form** `μ(Aᶜ) = |Ω| − μ(A)`. -/
theorem measure_compl (S : SampleSpace Ω) (A : Event Ω) :
    S.measure (Set.compl A) = S.total - S.measure A := by
  have h := S.measure_compl_add A
  omega

/-! ## (C) Conditioning data — the restricted (fiber) measure -/

/-- The intersection is **commutative** as an event: `A ∩ B = B ∩ A`. This is the
set-level fact backing the symmetry of the Bayes numerator. -/
theorem inter_comm (A B : Event Ω) : Set.inter A B = Set.inter B A := by
  funext x
  show (A x && B x) = (B x && A x)
  exact Bool.and_comm (A x) (B x)

/-- **Conditioning as restriction = the fiber-adjoint.** `P(A | B)` is the measure
of `A` *restricted to* `B`: the count of outcomes in `A ∩ B`. Conditioning on `B`
is reindexing into the sub-event-algebra of `B` — `Hyperdoctrine.reindex` is the
`f*` whose action is precisely restriction (precomposition in the base). We name
the numerator `μ(A ∩ B)`; the normalized conditional is the pair `(μ(A∩B), μ(B))`,
i.e. `P(A|B) = μ(A∩B)/μ(B)` with the `/` tracked. -/
def condMeasure (S : SampleSpace Ω) (A B : Event Ω) : Nat :=
  S.measure (Set.inter A B)

/-- The conditional **numerator** equals the restricted measure (definitional):
`condMeasure S A B = μ(A ∩ B)`. This is the value the fiber over `B` carries. -/
theorem condMeasure_eq (S : SampleSpace Ω) (A B : Event Ω) :
    S.condMeasure A B = S.measure (Set.inter A B) := rfl

/-- The restricted measure sits **inside** its conditioning event's fiber:
`condMeasure S A B ≤ μ(B)` since `A ∩ B ⊆ B`. The structural bound making
`P(A|B) = μ(A∩B)/μ(B)` a fraction. -/
theorem condMeasure_le (S : SampleSpace Ω) (A B : Event Ω) :
    S.condMeasure A B ≤ S.measure B := by
  show S.measure (Set.inter A B) ≤ S.measure B
  apply S.measure_mono
  intro x hx
  show B x = true
  have hand : (A x && B x) = true := hx
  rw [Bool.and_eq_true] at hand
  exact hand.2

/-- The Bayes **symmetry** of the restricted measure: `condMeasure S A B =
condMeasure S B A`, i.e. `μ(A ∩ B) = μ(B ∩ A)`. -/
theorem condMeasure_symm (S : SampleSpace Ω) (A B : Event Ω) :
    S.condMeasure A B = S.condMeasure B A := by
  show S.measure (Set.inter A B) = S.measure (Set.inter B A)
  rw [inter_comm]

end SampleSpace

/-! ## (D) A probability measure is a valuation -/

/-- **a probability measure is a VALUATION satisfying the Kolmogorov
axioms.** The counting measure `μ` over a finite sample space `Ω` is a valuation
in the corpus sense (the posit made quantitative): it assigns graded `Nat` charge
to events and satisfies, *constructively over `Nat`*,

* **`P(∅) = 0`** — the impossible event carries no evidence (`measure_empty`);
* **`P(Ω) = |Ω|`** — the certain event carries the full mass, the counting
  analogue of `P(Ω) = 1` (`measure_univ`);
* **finite additivity on disjoint events** — `A ∩ B = ∅ → μ(A ⊔ B) = μ(A) + μ(B)`
  (`measure_union_disjoint`): disjoint evidence adds;
* **monotonicity** — `A ⊆ B → μ(A) ≤ μ(B)` (`measure_mono`);
* **the complement law** — `μ(Aᶜ) = |Ω| − μ(A)` (`measure_compl`), with the
  additive form `μ(A) + μ(Aᶜ) = |Ω|`.

This is exactly the corpus's reading: *probability is a valuation, a measure
assigning graded charge to events, with the certain event weighted maximally, the
impossible event 0, and disjoint events adding* — value entering predication by
evidence. -/
theorem measure_is_valuation {Ω : Type} (S : SampleSpace Ω) :
    (S.measure Set.empty = 0)
    ∧ (S.measure Set.univ = S.total)
    ∧ (∀ A B : Event Ω, Set.inter A B = Set.empty →
        S.measure (Set.union A B) = S.measure A + S.measure B)
    ∧ (∀ A B : Event Ω, Set.subset A B → S.measure A ≤ S.measure B)
    ∧ (∀ A : Event Ω, S.measure A + S.measure (Set.compl A) = S.total)
    ∧ (∀ A : Event Ω, S.measure (Set.compl A) = S.total - S.measure A) :=
  ⟨S.measure_empty,
   S.measure_univ,
   fun A B h => S.measure_union_disjoint A B h,
   fun _ _ h => S.measure_mono h,
   fun A => S.measure_compl_add A,
   fun A => S.measure_compl A⟩

/-! ## (E) Conditioning via the hyperdoctrine fiber-adjoint -/

/-- The **fiber-adjoint reading of conditioning, abstractly.** Conditioning on `B`
is the corpus's reindexing `f* = reindex` of the predication hyperdoctrine: a pure
restriction (precomposition) in the base. We exhibit the reindexing law that backs
"conditioning = restriction": for the event predicates read as valuations,
restriction along a base map is `Valuation.reindex`, which is contravariantly
functorial — `r* ∘ s* = (s ∘ r)*` — exactly the fiber-adjoint substrate
conditioning rides on. -/
theorem conditioning_is_reindex (r s : PredicationCell → PredicationCell)
    (v : Valuation) :
    Valuation.reindex r (Valuation.reindex s v) = Valuation.reindex (s ∘ r) v :=
  Valuation.reindex_comp r s v

/-- **conditional probability via the fiber-adjoint, and BAYES.**
Conditioning on `B` is the hyperdoctrine **fiber-adjoint** `f*` — restriction to
the sub-event-algebra of `B` (`reindex`, precomposition in the base). The
`B`-restricted measure is `condMeasure S A B = μ(A ∩ B)` (`condMeasure_eq`), and
the symmetric **Bayes identity** is the single shared count

  `P(A|B)·μ(B)  =  μ(A ∩ B)  =  μ(B ∩ A)  =  P(B|A)·μ(A)`,

here the count equation `condMeasure S A B = condMeasure S B A`: the numerator of
`P(A|B)P(B)` and of `P(B|A)P(A)` is the *same* restricted measure `μ(A ∩ B)`. So
`P(A|B)P(B) = P(B|A)P(A) = P(A ∩ B)` is the Bayes consequence of conditioning's
symmetry, and conditioning IS the fiber-adjoint restriction. The bundle records:

* **(restriction)** `condMeasure S A B = μ(A ∩ B)` — conditioning is the restricted
  (fiber) measure;
* **(Bayes, symmetric numerator)** `condMeasure S A B = condMeasure S B A` — the
  shared count `μ(A ∩ B) = μ(B ∩ A)`, the symmetric identity
  `P(A|B)P(B) = P(B|A)P(A) = P(A ∩ B)`;
* **(restriction ≤ marginal)** `condMeasure S A B ≤ μ(B)` — the restricted measure
  sits inside its conditioning event's fiber (`A ∩ B ⊆ B`), the structural bound
  making `P(A|B) = μ(A∩B)/μ(B)` a fraction in `[0,1]`.
sound`. -/
theorem conditional_via_fiber_adjoint {Ω : Type} (S : SampleSpace Ω) (A B : Event Ω) :
    (S.condMeasure A B = S.measure (Set.inter A B))
    ∧ (S.condMeasure A B = S.condMeasure B A)
    ∧ (S.condMeasure A B ≤ S.measure B) :=
  ⟨S.condMeasure_eq A B, S.condMeasure_symm A B, S.condMeasure_le A B⟩

end Probability.Measure
end Obsmetrologia
