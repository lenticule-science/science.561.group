import Obsmetrologia.Language.Predicating.Orbital
import Obsmetrologia.Language.Predicating.Oriented

/-!
# Generators — the four generator classes, derived

The predicate category's morphisms are generated by four classes: specialization,
converse, subject-projection and object-projection. This module derives them rather
than listing them.

The derivation starts from the mark: its surface string is presentation, not
identity (`Primitive/Mark.lean`). A reindexing of the entity pair that could tell two
marks apart by their surfaces would be using surface as identity. So a legitimate
reindexing must commute with every relabeling of marks, a permutation of the entity
type. That is the naturality condition `NaturalPartial`.

Two facts then force the four classes:

* `support_cases`: the supports a relabeling cannot see into are exactly the four
  unions of the two orbits of ordered pairs, the diagonal `{(s, s)}` and the
  off-diagonal `{(s, o) | s ≠ o}`.
* `natural_partial_cases`: with four distinct entities, every natural partial
  reindexing reads one of the four index maps (`Orbital.orbital_exhaustive`) on one of
  those supports. `natural_of` is the converse.

The index map with a restricting support is specialization. The other three index
maps, on the full support, are converse, subject-projection and object-projection.
None is special: all four are the same construction, an index map on a support.

At the spine: tokens are the entities (`four_tokens`, `token_natural_cases`), the
cell-level generators of `Predicating/Cell.lean` are the index maps on a cell's
subject and object (`converse_cell`, `subjProj_cell`, `objProj_cell`), and
articulating supplies the pairs (`Predicating/Oriented.lean`).

Every declaration here is axiom-free.

## References

* The four generator classes and their exhaustiveness for natural bilattice
  homomorphisms between predication fiber algebras are from the predication-categories
  formulation (git `9be46127758`, `theorems/predicate-generator-exhaustiveness.md`),
  whose stated bound of three entities is corrected to four by `Orbital`.
-/

namespace Obsmetrologia
namespace Generators
open Orbital

variable {E : Type} [DecidableEq E]

/-! ## Supports invariant under relabeling are unions of the two orbits -/

/-- A support on ordered pairs, as a decidable (Bool-valued) predicate, is
**invariant** when no relabeling moves it. -/
def Invariant (D : E × E → Bool) : Prop := ∀ (σ : Perm E) (p : E × E), D (σ.mapPair p) = D p

theorem invariant_offdiag {D : E × E → Bool} (hD : Invariant D) {s o s' o' : E}
    (h : s ≠ o) (h' : s' ≠ o') : D (s, o) = D (s', o') := by
  obtain ⟨σ, hs, ho⟩ := transport_exists s o s' o' h h'
  have hmap : σ.mapPair (s, o) = (s', o') := by
    show (σ.toFun s, σ.toFun o) = (s', o')
    rw [hs, ho]
  have := hD σ (s, o)
  rw [hmap] at this
  exact this.symm

theorem invariant_diag {D : E × E → Bool} (hD : Invariant D) (s t : E) :
    D (s, s) = D (t, t) := by
  have hmap : (swap s t).mapPair (s, s) = (t, t) := by
    show ((swap s t).toFun s, (swap s t).toFun s) = (t, t)
    rw [swap_left]
  have := hD (swap s t) (s, s)
  rw [hmap] at this
  exact this.symm


/-! ## The four index maps and the four supports -/

/-- The four ways to read an ordered pair back off itself: each output position
takes one of the two input positions. -/
inductive IndexMap where
  | identity
  | converse
  | subjectProjection
  | objectProjection
  deriving DecidableEq, Repr

namespace IndexMap

/-- The pair an index map reads off `p`. -/
def apply : IndexMap → E × E → E × E
  | identity, p => p
  | converse, p => (p.2, p.1)
  | subjectProjection, p => (p.1, p.1)
  | objectProjection, p => (p.2, p.2)

end IndexMap

/-- A support relabeling cannot see into: whether it holds on the diagonal and
whether it holds off it. -/
structure Support where
  diagonal : Bool
  offDiagonal : Bool
  deriving DecidableEq, Repr

namespace Support

/-- Whether a support holds at a pair. -/
def holds (d : Support) (p : E × E) : Bool := if p.1 = p.2 then d.diagonal else d.offDiagonal

/-- The support holding everywhere. -/
def full : Support := ⟨true, true⟩

end Support

/-- **Invariant supports are the four unions of the two orbits.** Given two
distinct elements, a support invariant under relabeling is determined by its
value on the diagonal and its value off it. -/
theorem support_cases {D : E × E → Bool} (hD : Invariant D) {a b : E} (hab : a ≠ b) :
    ∀ p, D p = (Support.mk (D (a, a)) (D (a, b))).holds p := by
  intro p
  obtain ⟨s, o⟩ := p
  show D (s, o) = if s = o then D (a, a) else D (a, b)
  by_cases hso : s = o
  · rw [if_pos hso, hso]
    exact invariant_diag hD o a
  · rw [if_neg hso]
    exact invariant_offdiag hD hso hab

/-! ## Natural partial reindexings -/

/-- A partial reindexing of pairs is **natural** when it commutes with every
relabeling: relabel then reindex is reindex then relabel. -/
def NaturalPartial (R : E × E → Option (E × E)) : Prop :=
  ∀ (σ : Perm E) (p : E × E), R (σ.mapPair p) = (R p).map σ.mapPair

omit [DecidableEq E] in
private theorem isSome_map_pair (σ : Perm E) (x : Option (E × E)) :
    (x.map σ.mapPair).isSome = x.isSome := by
  cases x <;> rfl

omit [DecidableEq E] in
private theorem getD_map_pair (σ : Perm E) (x : Option (E × E)) (d : E × E) :
    (x.map σ.mapPair).getD (σ.mapPair d) = σ.mapPair (x.getD d) := by
  cases x <;> rfl

/-- **The four generator classes, derived.** With four distinct elements, every
natural partial reindexing of pairs reads one of the four index maps on a support
that is one of the four unions of the diagonal and off-diagonal orbits. -/
theorem natural_partial_cases
    (four : ∃ a b c d : E, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d)
    (R : E × E → Option (E × E)) (hR : NaturalPartial R) :
    ∃ (g : IndexMap) (d : Support), ∀ p, R p = if d.holds p then some (g.apply p) else none := by
  obtain ⟨a, b, c, e, hab, hac, hae, hbc, hbe, hce⟩ := four
  -- The support: where the reindexing is defined.
  let D : E × E → Bool := fun p => (R p).isSome
  have hD : Invariant D := by
    intro σ p
    show (R (σ.mapPair p)).isSome = (R p).isSome
    rw [hR σ p]
    exact isSome_map_pair σ (R p)
  -- The total map: the reindexing where defined, subject-projection elsewhere.
  let f : E × E → E × E := fun p => (R p).getD (p.1, p.1)
  have hf : Equivariant f := by
    intro σ p
    show (R (σ.mapPair p)).getD ((σ.mapPair p).1, (σ.mapPair p).1) = σ.mapPair ((R p).getD (p.1, p.1))
    rw [hR σ p]
    exact getD_map_pair σ (R p) (p.1, p.1)
  have hsupp := support_cases hD hab
  -- Where `R` is defined it agrees with `f`.
  have hagree : ∀ p, R p = if D p then some (f p) else none := by
    intro p
    show R p = if (R p).isSome then some ((R p).getD (p.1, p.1)) else none
    cases R p <;> rfl
  have hclass := orbital_exhaustive ⟨a, b, c, e, hab, hac, hae, hbc, hbe, hce⟩ f hf
  have hfinal : ∀ g : IndexMap, (∀ p, f p = g.apply p) →
      ∃ (g : IndexMap) (d : Support), ∀ p, R p = if d.holds p then some (g.apply p) else none := by
    intro g hg
    refine ⟨g, Support.mk (D (a, a)) (D (a, b)), fun p => ?_⟩
    rw [hagree p, ← hsupp p, hg p]
  rcases hclass with h | h | h | h
  · exact hfinal .identity h
  · exact hfinal .converse h
  · exact hfinal .subjectProjection h
  · exact hfinal .objectProjection h

/-- Relabeling preserves whether a pair is on the diagonal. -/
private theorem holds_mapPair (d : Support) (σ : Perm E) (p : E × E) :
    d.holds (σ.mapPair p) = d.holds p := by
  obtain ⟨s, o⟩ := p
  show (if σ.toFun s = σ.toFun o then d.diagonal else d.offDiagonal) =
    (if s = o then d.diagonal else d.offDiagonal)
  by_cases hso : s = o
  · rw [if_pos hso, hso, if_pos rfl]
  · have hne : σ.toFun s ≠ σ.toFun o := fun h => hso (σ.toFun_injective h)
    rw [if_neg hso, if_neg hne]

omit [DecidableEq E] in
private theorem apply_mapPair (g : IndexMap) (σ : Perm E) (p : E × E) :
    g.apply (σ.mapPair p) = σ.mapPair (g.apply p) := by
  cases g <;> rfl

/-- Conversely, every index map on every invariant support is natural. -/
theorem natural_of (g : IndexMap) (d : Support) :
    NaturalPartial (fun p : E × E => if d.holds p then some (g.apply p) else none) := by
  intro σ p
  show (if d.holds (σ.mapPair p) then some (g.apply (σ.mapPair p)) else none) =
    (if d.holds p then some (g.apply p) else none).map σ.mapPair
  rw [holds_mapPair d σ p, apply_mapPair g σ p]
  cases d.holds p <;> rfl

omit [DecidableEq E] in
/-- Natural partial reindexings compose: reindex by `R`, then by `S`. -/
theorem natural_comp {R S : E × E → Option (E × E)} (hR : NaturalPartial R)
    (hS : NaturalPartial S) : NaturalPartial (fun p => (R p).bind S) := by
  intro σ p
  show (R (σ.mapPair p)).bind S = ((R p).bind S).map σ.mapPair
  rw [hR σ p]
  cases R p with
  | none => rfl
  | some q => exact hS σ q

/-! ## At the spine: tokens are the entities -/

/-- Tokens have four distinct inhabitants, so exhaustiveness applies to them. -/
theorem four_tokens : ∃ a b c d : Token, a ≠ b ∧ a ≠ c ∧ a ≠ d ∧ b ≠ c ∧ b ≠ d ∧ c ≠ d :=
  ⟨⟨⟨"a"⟩⟩, ⟨⟨"b"⟩⟩, ⟨⟨"c"⟩⟩, ⟨⟨"d"⟩⟩,
    by decide, by decide, by decide, by decide, by decide, by decide⟩

/-- **The generator classes at the spine.** Every reindexing of token pairs that
commutes with relabeling marks is an index map on an invariant support. -/
theorem token_natural_cases (R : Token × Token → Option (Token × Token))
    (hR : NaturalPartial R) :
    ∃ (g : IndexMap) (d : Support), ∀ p, R p = if d.holds p then some (g.apply p) else none :=
  natural_partial_cases four_tokens R hR

/-- The subject and object of a cell, as an ordered pair of tokens. -/
def pairOf (φ : PredicationCell) : Token × Token := (φ.subject, φ.object)

/-- Read an index map on a cell's pair, keeping its predicate. -/
def reindexCell (g : IndexMap) (φ : PredicationCell) : PredicationCell :=
  ⟨(g.apply (pairOf φ)).1, φ.predicate, (g.apply (pairOf φ)).2⟩

/-- The cell's converse is the converse index map on its pair. -/
theorem converse_cell (φ : PredicationCell) :
    PredicationCell.converse φ = reindexCell .converse φ := rfl

/-- The cell's subject-projection is the subject-projection index map on its pair. -/
theorem subjProj_cell (φ : PredicationCell) :
    PredicationCell.subjProj φ = reindexCell .subjectProjection φ := rfl

/-- The cell's object-projection is the object-projection index map on its pair. -/
theorem objProj_cell (φ : PredicationCell) :
    PredicationCell.objProj φ = reindexCell .objectProjection φ := rfl

/-- The identity index map leaves a cell unchanged. -/
theorem identity_cell (φ : PredicationCell) : reindexCell .identity φ = φ := rfl

end Generators
end Obsmetrologia
