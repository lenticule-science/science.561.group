import Obsmetrologia.Articulation.Articulating
import Obsmetrologia.Language.Predicating.Claim
import Obsmetrologia.Language.Predicating.SiblingSeed

/-!
# Oriented cells generated by articulating

`PredicationCell.seed u = ⟨u.token, u.claim, u.token⟩` is the reflexive cell an utterance
generates, and the spine's predicating morphism reads only the head of an
articulating: `Spine.predicate a = PredicationCell.seed a.head`. So every cell the spine's
own morphism generates has subject equal to object. `SiblingSeed` supplies the
off-diagonal cells as *compositions* `composeSeeds u v` of any two seeds drawn
from the recursion's flat pool of utterances, under a stated linear reading of
"sibling"; it leaves open which composition the recursion itself determines.

The articulating recursion already is the directed asymmetry: in `pair u a` the
head `u` is articulated *over* the tail `a`. Reading that asymmetry into
predication gives the **oriented cell** of an articulating: the head's token as
subject, the head's claim as predicate, and the tail's head token as object —
that is, `composeSeeds` of the head with the utterance immediately below it,
the one composition the recursion picks out without a choice from the pool
(`orientedCell_pair_eq_composeSeeds`, `orientedCell_mem_cellsOf`). On the floor
(`utter u`) it is the reflexive seed, so the spine's predicate is its depth-zero
case; at depth one it generates oriented cells, and the converse of a generated
cell is again generated, by the articulation with the two tokens exchanged and
the claim carried.

Read as geometry: an oriented cell is an edge from the head token to the tail
token labelled by a claim, so the cells articulating generates are the pairs of
tokens with a claim between them — the shape a causal set has (pairs of events
with "precedes" between them), here reached from articulating rather than taken
as a given graph.

**Ruling.** The oriented cell is what *measuring* reads: `witnesses` and
`measure` (`Language/Positing/Measure.lean`) collect witnesses by
`orientedCell`, not by the spine's reflexive seed (`measure_self_pos`,
`no_denial`). `Spine.predicate`, the reflexive seed of the head, stays as
its depth-zero case, `orientedCell_utter`. Every declaration is
axiom-free.
-/

namespace Obsmetrologia
namespace Articulating

/-- The oriented cell an articulating generates: the head articulated over the
tail. On the floor it is the reflexive seed. -/
def orientedCell : Articulating → PredicationCell
  | utter u => ⟨u.token, u.claim, u.token⟩
  | pair u a => ⟨u.token, u.claim, a.head.token⟩

/-- On the floor the oriented cell is the reflexive seed — the spine's predicate. -/
@[simp] theorem orientedCell_utter (u : Utterance) :
    orientedCell (utter u) = PredicationCell.seed u := rfl

@[simp] theorem orientedCell_pair (u : Utterance) (a : Articulating) :
    orientedCell (pair u a) = ⟨u.token, u.claim, a.head.token⟩ := rfl

/-- The subject is always the head's token. -/
@[simp] theorem orientedCell_subject (a : Articulating) :
    (orientedCell a).subject = a.head.token := by cases a <;> rfl

/-- The predicate is always the head's claim. -/
@[simp] theorem orientedCell_predicate (a : Articulating) :
    (orientedCell a).predicate = a.head.claim := by cases a <;> rfl

/-- The object is the token of the first utterance below the head, or the head's
own token on the floor. -/
theorem orientedCell_object (u : Utterance) (a : Articulating) :
    (orientedCell (pair u a)).object = a.head.token := rfl

/-! ### The oriented cell is the recursion's own sibling composition -/

/-- **The oriented cell is a sibling composition**: the head's seed composed with
the seed of the utterance immediately below it. -/
theorem orientedCell_pair_eq_composeSeeds (u : Utterance) (a : Articulating) :
    orientedCell (pair u a) = PredicationCell.composeSeeds u a.head := rfl

/-- The head is among the recursion's utterances (axiom-free form of
`head_mem_utterances`). -/
theorem head_mem_utterances' (a : Articulating) : a.head ∈ a.utterances := by
  cases a <;> exact List.Mem.head _

/-- **The oriented cell is drawn from the recursion's own siblings**: it is a
member of `cellsOf`, the pool of all sibling compositions. Where `cellsOf` offers
every pair, the recursion determines this one. -/
theorem orientedCell_mem_cellsOf (a : Articulating) :
    orientedCell a ∈ PredicationCell.cellsOf a := by
  -- `cellsOf (pair u a)` unfolds to `composeSeeds u u :: composeSeeds u a.head :: _`,
  -- so the oriented cell is its second element; on the floor it is the only element.
  cases a with
  | utter u => exact List.Mem.head _
  | pair u a =>
    cases a with
    | utter v => exact List.Mem.tail _ (List.Mem.head _)
    | pair v b => exact List.Mem.tail _ (List.Mem.head _)

/-- **Orientation is generated.** A depth-one articulation over a different token
has subject distinct from object. -/
theorem orientation_generated :
    ∃ a : Articulating, (orientedCell a).subject ≠ (orientedCell a).object :=
  ⟨pair ⟨⟨⟨"0"⟩⟩, ⟨⟨"p"⟩⟩⟩ (utter ⟨⟨⟨"1"⟩⟩, ⟨⟨"q"⟩⟩⟩), by decide⟩

/-- A generated cell is reflexive exactly when the tail's head token is the head's
token. -/
theorem orientedCell_reflexive_iff (u : Utterance) (a : Articulating) :
    (orientedCell (pair u a)).subject = (orientedCell (pair u a)).object
      ↔ u.token = a.head.token :=
  Iff.rfl

/-- **The converse of a generated cell is generated**: by the articulation with the
two tokens exchanged and the head's claim carried. -/
theorem converse_orientedCell_pair (u : Utterance) (a : Articulating) :
    PredicationCell.converse (orientedCell (pair u a))
      = orientedCell (pair ⟨a.head.token, u.claim⟩ (utter u)) := rfl

/-- The subject projection of a generated cell is the head's reflexive seed. -/
theorem subjProj_orientedCell (a : Articulating) :
    PredicationCell.subjProj (orientedCell a) = PredicationCell.seed a.head := by cases a <;> rfl

/-- The object projection of a generated cell is the reflexive seed of the tail's
token under the head's claim. -/
theorem objProj_orientedCell_pair (u : Utterance) (a : Articulating) :
    PredicationCell.objProj (orientedCell (pair u a))
      = PredicationCell.seed ⟨a.head.token, u.claim⟩ := rfl

/-- The token edge an articulating generates: from the head token to the object
token. Each `pair` is one edge of the token graph. -/
def tokenEdge (a : Articulating) : Token × Token :=
  ((orientedCell a).subject, (orientedCell a).object)

@[simp] theorem tokenEdge_utter (u : Utterance) : tokenEdge (utter u) = (u.token, u.token) := rfl

@[simp] theorem tokenEdge_pair (u : Utterance) (a : Articulating) :
    tokenEdge (pair u a) = (u.token, a.head.token) := rfl

/-- The edge reads only the head and the tail's head: articulating deeper below the
tail's head changes no edge. -/
theorem tokenEdge_pair_pair (u v : Utterance) (a b : Articulating) :
    tokenEdge (pair u (pair v a)) = tokenEdge (pair u (pair v b)) := rfl

end Articulating
end Obsmetrologia
