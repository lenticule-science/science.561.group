import Obsmetrologia.AperiodicOrder.MaterialSectors.KappaSectorCharges
import Obsmetrologia.AperiodicOrder.Tiling.MetallicModuli

/-!
# Sector phase diagrams over material carriers

This module packages the corrected material readout shape: a chunk of informational matter
does not sit on one phase ladder. It carries parallel sector readouts over the same material
point, with transport/metallization fibered over the structural predictor-level side and a
modulus inside that transport fiber.

The proved content is intentionally conservative:

* the structural sector is the finite diffraction component from `Diffraction`;
* the transport sector is metallizable when it carries a `MetallicModuliWitness`, i.e. a
  StepN moduli representative with a finite ordinal and the metallic power expansion;
* the topological sector is the `H¹`/Landauer/load-bearing readout of a cover nerve,
  carrying the actual load-bearing witness supplied by material supports;
* the thermal control is the basin temperature/threshold readout from the material glass
  rung, kept as a control parameter rather than listed as another sector;
* the existing Pisot/Salem/structural equalities are exposed as coupling data, not as a
  collapse of all sectors into one phase.

The global converse reading "metallic iff conducting" is not asserted here. What is proved is
the material-carrier bridge: a sector phase point built from a metallic/moduli transport
witness also carries an actual topological conducting witness on the same material basin.
-/

namespace Obsmetrologia
namespace AperiodicOrder.MaterialSectors.SectorPhaseDiagram

open Obsmetrologia.AperiodicOrder.Tiling
open Obsmetrologia.AperiodicOrder.Tiling.Moduli

/-- The sector axes carried in the product part of the material phase diagram. Thermal data
acts as a control parameter over these axes, so it is packaged separately. -/
inductive MaterialSector where
  | structural
  | transport
  | topological
  deriving DecidableEq, Repr

/-- The transport-sector readout currently used by the algebraic/transcendental cut. -/
inductive TransportReadout where
  | metallizable
  | transcendental
  deriving DecidableEq, Repr

/-- The structural sector: the finite diffraction component read from a predictor-level side. -/
structure StructuralSector where
  /-- The predictor-level Pisot/Salem side. -/
  side : PhaseSubstitution
  /-- The diffraction component over this side. -/
  component : FiniteDiffractionKind
  /-- The component is exactly the existing finite diffraction readout. -/
  component_eq : component = phaseDiffractionComponent side

/-- The structural sector generated by a predictor-level side. -/
def StructuralSector.ofSide (side : PhaseSubstitution) : StructuralSector where
  side := side
  component := phaseDiffractionComponent side
  component_eq := rfl

/-- The transport sector over a moduli point: metallizable when it carries the finite-ordinal
metallic/moduli witness. -/
structure TransportSector (κ : Ord) (p : ModuliPoint) where
  /-- The transport readout label. -/
  readout : TransportReadout
  /-- The richer witness: step rule, realized moduli point, finite ordinal, and metallic powers. -/
  witness : MetallicModuliWitness κ p
  /-- Carrying a metallic witness places this transport fiber on the metallizable side. -/
  readout_eq : readout = TransportReadout.metallizable

/-- A metallic/moduli witness generates a metallizable transport sector. -/
def TransportSector.ofMetallicWitness {κ : Ord} {p : ModuliPoint}
    (w : MetallicModuliWitness κ p) : TransportSector κ p where
  readout := TransportReadout.metallizable
  witness := w
  readout_eq := rfl

/-- A metallizable transport sector has finite ordinal shape. -/
theorem TransportSector.ordinal_isFinite {κ : Ord} {p : ModuliPoint}
    (T : TransportSector κ p) : κ.isFinite = true :=
  metallicModuliWitness_isFinite T.witness

/-- A metallizable transport sector carries the metallic power expansion at its StepN
coordinate. -/
theorem TransportSector.power_expansion {κ : Ord} {p : ModuliPoint}
    (T : TransportSector κ p) :
    ∀ k : Nat,
      AperiodicOrder.Tiling.StepN.zpow
          (AperiodicOrder.Tiling.StepN.metallicZ T.witness.stage) k =
        (AperiodicOrder.Tiling.StepN.coef T.witness.stage k).1 *
          AperiodicOrder.Tiling.StepN.metallicZ T.witness.stage +
        (AperiodicOrder.Tiling.StepN.coef T.witness.stage k).2 :=
  metallicModuliWitness_power_expansion T.witness

/-- The topological sector over a cover nerve: Landauer bits, `H¹`, and load-bearing are read
on the same carrier. -/
structure TopologicalSector where
  /-- The topological carrier nerve. -/
  nerve : Cohomology.CoverNerve
  /-- Landauer cost is the first cohomology rank on this carrier. -/
  landauerIsH1 : Landauer.landauerBits nerve = nerve.H1rank
  /-- This carrier is load-bearing, the internal topological/conducting witness. -/
  loadBearingWitness : loadBearing nerve
  /-- Load-bearing is positivity of the same Landauer/`H¹` quantity. -/
  loadBearingIffPositiveLandauer : loadBearing nerve ↔ 0 < Landauer.landauerBits nerve

/-- A load-bearing cover nerve has the topological sector readout already proved in the
`κ`/temperature interfaces. -/
def TopologicalSector.ofLoadBearing (N : Cohomology.CoverNerve)
    (hload : loadBearing N) : TopologicalSector where
  nerve := N
  landauerIsH1 := AperiodicOrder.Tiling.KappaStratification.landauer_cost_is_h1 N
  loadBearingWitness := hload
  loadBearingIffPositiveLandauer := Thermodynamics.Temperature.loadBearing_iff_positive_landauer N

/-- The internal topological reading of "conducting": the carrier is load-bearing. -/
def TopologicalSector.Conducting (T : TopologicalSector) : Prop :=
  loadBearing T.nerve

/-- Every material topological sector carries the conducting witness it names. -/
theorem TopologicalSector.conducting (T : TopologicalSector) : T.Conducting :=
  T.loadBearingWitness

/-- Conducting topological sectors have positive Landauer/`H¹` readout. -/
theorem TopologicalSector.positive_landauer (T : TopologicalSector) :
    0 < Landauer.landauerBits T.nerve :=
  (T.loadBearingIffPositiveLandauer).1 T.loadBearingWitness

/-- The thermal control over a material basin: temperature is the stationary distribution
value, and any threshold cuts the basin into frozen/hopping sides. -/
structure ThermalControl {G : AperiodicOrder.Crystal.Glass}
    (γ : G.RatBasinFreeEnergyBridge) (θ : Real.Internal.Rat) where
  /-- The temperature readout equals the basin distribution value. -/
  temperature_eq : γ.temperature = γ.thermalization.distribution γ.thermalization.basin
  /-- The threshold dichotomy controlled by this temperature value. -/
  threshold : γ.thermalization.frozenAt θ ∨ γ.thermalization.hoppingAt θ

/-- Project the thermal control fields out of the material sector readout. -/
def ThermalControl.ofMaterialReadout {G : AperiodicOrder.Crystal.Glass}
    {γ : G.RatBasinFreeEnergyBridge} {b : G.basins.Basin} {θ : Real.Internal.Rat}
    (h : KappaSectorCharges.MaterialSectorReadout γ b θ) : ThermalControl γ θ := by
  rcases h with ⟨_energy, htemp, hthreshold, _h1, _hload, _balanced, _cost, _discharge⟩
  exact ⟨htemp, hthreshold⟩

/-- A full material phase point: structural, transport, and topological sectors over the same
material basin, with thermal control over the product and the original material readout retained
as the shared-carrier certificate. -/
structure SectorPhasePoint {G : AperiodicOrder.Crystal.Glass}
    (γ : G.RatBasinFreeEnergyBridge) (b : G.basins.Basin) (θ : Real.Internal.Rat)
    (κ : Ord) (p : ModuliPoint) where
  /-- Structural/positional sector. -/
  structural : StructuralSector
  /-- Transport/metallization sector. -/
  transport : TransportSector κ p
  /-- Topological `H¹`/Landauer sector. -/
  topological : TopologicalSector
  /-- Thermal control over the sector product. -/
  thermal : ThermalControl γ θ
  /-- The material shared-carrier readout from the glass rung. -/
  material : KappaSectorCharges.MaterialSectorReadout γ b θ

/-- The topological sector over the material basin's shared carrier nerve. -/
def topologicalSectorOfMaterial {G : AperiodicOrder.Crystal.Glass}
    (γ : G.RatBasinFreeEnergyBridge) (b : G.basins.Basin) (θ : Real.Internal.Rat) :
    TopologicalSector :=
  TopologicalSector.ofLoadBearing
    (KappaSectorCharges.material_shared_kappa_carrier γ b θ).carrierNerve
    (γ.thermalization.toBasinThermalization.support b).loadBearing

/-- Build a full sector phase point from a material basin, a metallic/moduli transport witness,
and a structural predictor-level side. -/
def SectorPhasePoint.ofMetallic {G : AperiodicOrder.Crystal.Glass}
    (γ : G.RatBasinFreeEnergyBridge) (b : G.basins.Basin) (θ : Real.Internal.Rat)
    {κ : Ord} {p : ModuliPoint} (w : MetallicModuliWitness κ p) (side : PhaseSubstitution) :
    SectorPhasePoint γ b θ κ p :=
  let h := KappaSectorCharges.material_sector_readout γ b θ
  { structural := StructuralSector.ofSide side
    transport := TransportSector.ofMetallicWitness w
    topological := topologicalSectorOfMaterial γ b θ
    thermal := ThermalControl.ofMaterialReadout h
    material := h }

/-- The existing predictor-level equalities are coupling data between structural and
Pisot/Salem transport readings, not a replacement of the sector product by a single ladder. -/
theorem structural_transport_coupling (side : PhaseSubstitution) :
    lebesgueType (phaseDiffractionComponent side) = phaseType side
      ∧ pisotSalemClass (phaseScaling side) = phaseType side
      ∧ closureRegime side = phaseType side := by
  rcases phaseType_readings_agree side with ⟨hstruct, _hcharge, hpisot, hclosure⟩
  exact ⟨hstruct, hpisot, hclosure⟩

/-- A sector phase point exposes the whole package: material readout, finite transport
ordinal, metallizable transport label, topological Landauer/`H¹` identification, and thermal
temperature control. -/
theorem sector_phase_point_package {G : AperiodicOrder.Crystal.Glass}
    {γ : G.RatBasinFreeEnergyBridge} {b : G.basins.Basin} {θ : Real.Internal.Rat}
    {κ : Ord} {p : ModuliPoint} (P : SectorPhasePoint γ b θ κ p) :
    KappaSectorCharges.MaterialSectorReadout γ b θ
      ∧ κ.isFinite = true
      ∧ P.transport.readout = TransportReadout.metallizable
      ∧ P.topological.Conducting
      ∧ 0 < Landauer.landauerBits P.topological.nerve
      ∧ P.topological.landauerIsH1 =
          AperiodicOrder.Tiling.KappaStratification.landauer_cost_is_h1 P.topological.nerve
      ∧ P.thermal.temperature_eq =
          AperiodicOrder.Crystal.Glass.RatBasinFreeEnergyBridge.temperature_eq_distribution γ := by
  exact ⟨P.material,
    P.transport.ordinal_isFinite,
    P.transport.readout_eq,
    P.topological.conducting,
    P.topological.positive_landauer,
    rfl,
    rfl⟩

/-- At the material-carrier level, the metallic/moduli transport witness and conducting
topological witness are carried together. This is the proved internal bridge, weaker than a
global biconditional but stronger than a mere metaphor. -/
theorem SectorPhasePoint.metallic_transport_conducts {G : AperiodicOrder.Crystal.Glass}
    {γ : G.RatBasinFreeEnergyBridge} {b : G.basins.Basin} {θ : Real.Internal.Rat}
    {κ : Ord} {p : ModuliPoint} (P : SectorPhasePoint γ b θ κ p) :
    P.transport.readout = TransportReadout.metallizable ∧ P.topological.Conducting :=
  ⟨P.transport.readout_eq, P.topological.conducting⟩

end AperiodicOrder.MaterialSectors.SectorPhaseDiagram
end Obsmetrologia
