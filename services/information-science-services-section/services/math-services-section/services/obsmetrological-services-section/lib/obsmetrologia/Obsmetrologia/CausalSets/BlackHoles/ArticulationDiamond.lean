import Obsmetrologia.CausalSets.BlackHoles.HoleDiamondCausalSet
import Obsmetrologia.CausalSets.Causal.ArticulationChain

/-!
# Articulation-generated causal diamonds

This module gives the first diamond carrier obtained from the mark-threaded
spine.  A concrete `Articulating.pair u tail` supplies both the generated
causal set of its prefix chain and the strict step from `tail` to that pair.
-/

namespace Obsmetrologia
namespace CausalSets.BlackHoles

open Obsmetrologia.CausalSets.Causal.Order
open Obsmetrologia.CausalSets.Causal.ArticulationChain
open Obsmetrologia.CausalSets.Causal.Cone

/-- Reachability in an articulation-generated causal set is decidable because it
is exactly proper prefix membership in the finite recursive articulation. -/
instance articulationChainReachesDecidable (a : Articulating) :
    DecidableRel (causalSet a).reaches := by
  intro x y
  exact decidable_of_iff (x ∈ prefixes y ∧ x ≠ y)
    (Iff.symm (reaches_iff_mem_prefixes_ne a x y))

/-- The settled causal order of an articulation-generated causal set is the
Boolean prefix-membership test. -/
instance articulationChainCausalLeDecision (a : Articulating) :
    CausalLeDecision (causalSet a) where
  leq := fun x y => decide (x ∈ prefixes y)
  leq_iff_causalLe := by
    intro x y
    rw [decide_eq_true_iff]
    exact Iff.symm (causalLe_iff_mem_prefixes a x y)

/-- The causal diamond point generated by one actual articulation continuation
step, with lower endpoint the previous tail and upper endpoint the paired node. -/
def articulationStepDiamondPoint (u : Utterance) (tail : Articulating) :
    DiamondPoint
      (causalSet (Articulating.pair u tail)) where
  lower :=
    { point := tail
      listed :=
        tail_mem_prefixes_pair u tail }
  upper :=
    { point := Articulating.pair u tail
      listed :=
        pair_mem_prefixes_pair u tail }
  reaches_upper :=
    tail_reaches_pair u tail

/-- The generated diamond's lower endpoint is the articulation tail. -/
@[simp] theorem articulationStepDiamondPoint_lower_point
    (u : Utterance) (tail : Articulating) :
    (articulationStepDiamondPoint u tail).lower.point = tail :=
  rfl

/-- The generated diamond's upper endpoint is the paired articulation. -/
@[simp] theorem articulationStepDiamondPoint_upper_point
    (u : Utterance) (tail : Articulating) :
    (articulationStepDiamondPoint u tail).upper.point =
      Articulating.pair u tail :=
  rfl

/-- The utterance assembled directly from its two mark positions. -/
def utteranceOfMarks (token claim : Mark) : Utterance where
  token := token
  claim := claim

/-- The one-step articulation assembled directly from two marks over a tail. -/
def markStepArticulating (token claim : Mark) (tail : Articulating) :
    Articulating :=
  Articulating.pair (utteranceOfMarks token claim) tail

/-- The causal set generated by one mark-built articulation step. -/
def markStepCausalSet (token claim : Mark) (tail : Articulating) :
    CausalSet Articulating :=
  causalSet (markStepArticulating token claim tail)

/-- Reachability in a mark-built articulation step is decidable by the inherited
proper-prefix test. -/
instance markStepReachesDecidable (token claim : Mark) (tail : Articulating) :
    DecidableRel (markStepCausalSet token claim tail).reaches :=
  articulationChainReachesDecidable (markStepArticulating token claim tail)

/-- The Boolean causal-order presentation for a mark-built articulation step is
the inherited prefix-membership presentation. -/
instance markStepCausalLeDecision (token claim : Mark) (tail : Articulating) :
    CausalLeDecision (markStepCausalSet token claim tail) :=
  articulationChainCausalLeDecision (markStepArticulating token claim tail)

/-- The diamond generated by one mark-built articulation step. -/
def markStepDiamondPoint (token claim : Mark) (tail : Articulating) :
    DiamondPoint (markStepCausalSet token claim tail) :=
  articulationStepDiamondPoint (utteranceOfMarks token claim) tail

/-- The token side of a mark-built utterance is the supplied token mark. -/
@[simp] theorem utteranceOfMarks_token (token claim : Mark) :
    (utteranceOfMarks token claim).token = token :=
  rfl

/-- The claim side of a mark-built utterance is the supplied claim mark. -/
@[simp] theorem utteranceOfMarks_claim (token claim : Mark) :
    (utteranceOfMarks token claim).claim = claim :=
  rfl

/-- The mark-built generated diamond's lower endpoint is the articulation tail. -/
@[simp] theorem markStepDiamondPoint_lower_point
    (token claim : Mark) (tail : Articulating) :
    (markStepDiamondPoint token claim tail).lower.point = tail :=
  rfl

/-- The mark-built generated diamond's upper endpoint is the paired
mark-utterance articulation. -/
@[simp] theorem markStepDiamondPoint_upper_point
    (token claim : Mark) (tail : Articulating) :
    (markStepDiamondPoint token claim tail).upper.point =
      markStepArticulating token claim tail :=
  rfl

/-! ## Kugelblitz frontier -/

/-- Strict growth of a Boolean region: the old region is included in the new one,
and at least one point newly enters. -/
def RegionStrictlyGrows {E : Type} (before after : Region E) : Prop :=
  (∀ x, before x = true → after x = true) ∧ ∃ x, before x = false ∧ after x = true

/-- A diamond crosses the readout horizon when its lower endpoint is in the
readout exterior and its upper endpoint lands on the shroud.  This is the
finite exterior-to-interior direction allowed by the hole laws. -/
def DiamondCrossesReadoutHorizon {E : Type} (C : CausalSet E) [CausalLeDecision C]
    (readout : Region E) (p : DiamondPoint C) : Prop :=
  ReadoutExterior C readout p.lower.point = true ∧ Shroud C readout p.upper.point = true

/-- A kugelblitz step is an articulation-generated diamond that crosses the
readout horizon. -/
def ArticulationKugelblitzStep (readout : Region Articulating)
    (u : Utterance) (tail : Articulating) : Prop :=
  DiamondCrossesReadoutHorizon (causalSet (Articulating.pair u tail)) readout
    (articulationStepDiamondPoint u tail)

/-- A kugelblitz articulation site: a tail articulation together with the next
utterance whose generated diamond crosses the readout horizon. -/
structure KugelblitzArticulationSite (readout : Region Articulating) where
  /-- The next utterance added at the site. -/
  utterance : Utterance
  /-- The articulation tail being extended. -/
  tail : Articulating
  /-- The generated step diamond crosses the readout horizon. -/
  crosses : ArticulationKugelblitzStep readout utterance tail

namespace KugelblitzArticulationSite

/-- The next articulation generated at a kugelblitz site. -/
def next {readout : Region Articulating} (K : KugelblitzArticulationSite readout) :
    Articulating :=
  Articulating.pair K.utterance K.tail

/-- The causal set generated by the site's next articulation. -/
def causalSet {readout : Region Articulating} (K : KugelblitzArticulationSite readout) :
    CausalSet Articulating :=
  CausalSets.Causal.ArticulationChain.causalSet K.next

instance causalSetCausalLeDecision {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) : CausalLeDecision K.causalSet := by
  unfold causalSet
  infer_instance

/-- The diamond point generated by the site's next articulation. -/
def diamondPoint {readout : Region Articulating} (K : KugelblitzArticulationSite readout) :
    DiamondPoint K.causalSet :=
  articulationStepDiamondPoint K.utterance K.tail

/-- The site tail is in the readout exterior of the generated causal set. -/
theorem tail_exterior {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    ReadoutExterior K.causalSet readout K.tail = true :=
  K.crosses.1

/-- The next articulation lands on the shroud. -/
theorem next_shroud {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    Shroud K.causalSet readout K.next = true :=
  K.crosses.2

/-- The next articulation is inside the computed hole region. -/
theorem next_in_hole {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    HoleRegion K.causalSet readout K.next = true :=
  shroud_in_hole K.causalSet readout K.next_shroud

/-- The site tail is not in the computed hole region of the generated causal
set. -/
theorem tail_not_in_hole {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    HoleRegion K.causalSet readout K.tail = false := by
  have hnot : ¬ HoleRegion K.causalSet readout K.tail = true := by
    intro hhole
    exact hole_exterior_disjoint K.causalSet readout K.tail
      ⟨hhole, K.tail_exterior⟩
  cases h : HoleRegion K.causalSet readout K.tail
  · rfl
  · exact False.elim (hnot h)

/-- The next articulation is no longer in the readout exterior. -/
theorem next_not_exterior {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    ReadoutExterior K.causalSet readout K.next = false :=
  shroud_not_exterior K.causalSet readout K.next_shroud

end KugelblitzArticulationSite

/-- In a kugelblitz step, the tail endpoint is in the readout exterior. -/
theorem articulationKugelblitz_tail_exterior
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    ReadoutExterior (causalSet (Articulating.pair u tail)) readout tail = true := by
  exact h.1

/-- In a kugelblitz step, the paired articulation lands on the shroud. -/
theorem articulationKugelblitz_pair_shroud
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    Shroud (causalSet (Articulating.pair u tail)) readout
      (Articulating.pair u tail) = true := by
  exact h.2

/-- In a kugelblitz step, the paired articulation is inside the hole region. -/
theorem articulationKugelblitz_pair_in_hole
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    HoleRegion (causalSet (Articulating.pair u tail)) readout
      (Articulating.pair u tail) = true := by
  exact shroud_in_hole (causalSet (Articulating.pair u tail)) readout h.2

/-- A local hole-region switch at an articulation step, read in the causal set
generated by the next paired articulation.  This is the proved local carrier
beneath the global strict-growth conjecture: the tail endpoint is exterior and
not yet hole-side, while the next paired articulation is shroud-side, hole-side,
and not exterior. -/
def ArticulationHoleRegionSwitchesAt (readout : Region Articulating)
    (u : Utterance) (tail : Articulating) : Prop :=
  let C := causalSet (Articulating.pair u tail)
  ReadoutExterior C readout tail = true ∧
    HoleRegion C readout tail = false ∧
      Shroud C readout (Articulating.pair u tail) = true ∧
        HoleRegion C readout (Articulating.pair u tail) = true ∧
          ReadoutExterior C readout (Articulating.pair u tail) = false

/-- In a kugelblitz step, the tail endpoint is not yet on the hole side of the
generated causal set. -/
theorem articulationKugelblitz_tail_not_in_hole
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    HoleRegion (causalSet (Articulating.pair u tail)) readout tail = false := by
  have hnot :
      ¬ HoleRegion (causalSet (Articulating.pair u tail)) readout tail = true := by
    intro hhole
    exact hole_exterior_disjoint (causalSet (Articulating.pair u tail))
      readout tail ⟨hhole, articulationKugelblitz_tail_exterior h⟩
  cases hhole : HoleRegion (causalSet (Articulating.pair u tail)) readout tail
  · rfl
  · exact False.elim (hnot hhole)

/-- In a kugelblitz step, the paired articulation is no longer exterior. -/
theorem articulationKugelblitz_pair_not_exterior
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    ReadoutExterior (causalSet (Articulating.pair u tail)) readout
      (Articulating.pair u tail) = false :=
  shroud_not_exterior (causalSet (Articulating.pair u tail)) readout
    (articulationKugelblitz_pair_shroud h)

/-- Every kugelblitz articulation step gives the proved local hole-region
switch. -/
theorem articulationKugelblitz_holeRegionSwitch
    {readout : Region Articulating} {u : Utterance} {tail : Articulating}
    (h : ArticulationKugelblitzStep readout u tail) :
    ArticulationHoleRegionSwitchesAt readout u tail := by
  unfold ArticulationHoleRegionSwitchesAt
  exact ⟨articulationKugelblitz_tail_exterior h,
    articulationKugelblitz_tail_not_in_hole h,
    articulationKugelblitz_pair_shroud h,
    articulationKugelblitz_pair_in_hole h,
    articulationKugelblitz_pair_not_exterior h⟩

namespace KugelblitzArticulationSite

/-- A kugelblitz articulation site packages the local hole-region switch at its
next step. -/
theorem holeRegionSwitch {readout : Region Articulating}
    (K : KugelblitzArticulationSite readout) :
    ArticulationHoleRegionSwitchesAt readout K.utterance K.tail :=
  articulationKugelblitz_holeRegionSwitch K.crosses

end KugelblitzArticulationSite

/-- Strict growth of the computed hole region from an articulation tail to its
next paired articulation, keeping the readout predicate fixed. -/
def ArticulationHoleRegionStrictlyGrowsAt (readout : Region Articulating)
    (u : Utterance) (tail : Articulating) : Prop :=
  RegionStrictlyGrows
    (HoleRegion (causalSet tail) readout)
    (HoleRegion (causalSet (Articulating.pair u tail)) readout)

/-- The kugelblitz growth conjecture: for a fixed readout on the articulation
chain, the hole region strictly grows exactly at articulation-generated diamonds
that cross the readout horizon. -/
def kugelblitz_growth_conjecture (readout : Region Articulating) : Prop :=
  ∀ (u : Utterance) (tail : Articulating),
    ArticulationHoleRegionStrictlyGrowsAt readout u tail ↔
      ArticulationKugelblitzStep readout u tail

end CausalSets.BlackHoles
end Obsmetrologia
