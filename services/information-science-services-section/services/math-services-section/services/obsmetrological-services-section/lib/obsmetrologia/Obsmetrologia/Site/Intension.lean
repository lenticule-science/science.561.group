namespace Obsmetrologia
namespace PredicationCell

namespace TermContext

/-- The direct claim profile of a term in a term context. -/
def profile (C : TermContext) (t : C.Term) : FCA.ExtSet PredicationCell :=
  fun q => C.incidence q t

/-- The FCA concept generated by a term's direct claim profile. -/
def generatedConcept (C : TermContext) (t : C.Term) : Concept C :=
  Concept.ofExtent C (profile C t)

/-- The concept generated by a term has a closed extent. -/
theorem generatedConcept_extent_closed (C : TermContext) (t : C.Term) :
    FCA.closeA C.incidence (generatedConcept C t).extent =
      (generatedConcept C t).extent :=
  Concept.extent_closed (generatedConcept C t)

/-- The term that generates a concept lies in the generated concept's intent. -/
theorem generatedConcept_in_intent (C : TermContext) (t : C.Term) :
    (generatedConcept C t).intent t := by
  intro q hq
  exact hq t (fun q' hq' => hq')

/-- A transport between term contexts: a claim map and a term map preserving incidence. -/
structure Hom (C D : TermContext) where
  /-- The claim-side map. -/
  claimMap : PredicationCell -> PredicationCell
  /-- The term-side map. -/
  termMap : C.Term -> D.Term
  /-- Incidence is preserved by the pair of maps. -/
  preserves : ∀ q t, C.incidence q t -> D.incidence (claimMap q) (termMap t)

namespace Hom

/-- A term-context transport sends a term's direct profile into the transported profile. -/
theorem profile_preserved {C D : TermContext} (F : Hom C D) {q : PredicationCell} {t : C.Term}
    (h : profile C t q) : profile D (F.termMap t) (F.claimMap q) :=
  F.preserves q t h

/-- Pull a valuation on the target context back along the claim map of a transport. -/
def pullbackValuation {C D : TermContext} (F : Hom C D) (v : Valuation) : Valuation :=
  Valuation.reindex F.claimMap v

@[simp] theorem pullbackValuation_apply {C D : TermContext} (F : Hom C D)
    (v : Valuation) (q : PredicationCell) :
    pullbackValuation F v q = v (F.claimMap q) :=
  rfl

/-- Pullback along a claim-fixing transport recovers the original valuation. -/
theorem pullbackValuation_eq_self_of_claimMap_eq {C D : TermContext}
    (F : Hom C D) (v : Valuation) (hclaim : ∀ q, F.claimMap q = q) :
    pullbackValuation F v = v := by
  funext q
  change v (F.claimMap q) = v q
  rw [hclaim q]

/-- Target valuation support for a transported profile pulls back to source support. -/
theorem pullback_supports_profile {C D : TermContext} (F : Hom C D)
    (v : Valuation) {q : PredicationCell} {t : C.Term}
    (hsupport : ∀ q', profile D (F.termMap t) q' ->
      Reading.isTruthFiring (v q') = true)
    (h : profile C t q) :
    Reading.isTruthFiring (pullbackValuation F v q) = true :=
  hsupport (F.claimMap q) (profile_preserved F h)

/-- Pullback along term-context transport commutes with pointwise valuation closure. -/
theorem pullbackValuation_liftOp {C D : TermContext} (F : Hom C D)
    (c : Reading.Closure) (v : Valuation) :
    pullbackValuation F (Valuation.liftOp c.op v) =
      Valuation.liftOp c.op (pullbackValuation F v) :=
  (Valuation.liftOp_c_natural c F.claimMap v).symm

end Hom

end TermContext

/-- A term reading is a term carried by the closed intent of a local topic. -/
structure TermReading (C : TermContext) where
  /-- The local topic in which the term is read. -/
  topic : Topic C
  /-- The term being read. -/
  term : C.Term
  /-- The topic concept's intent contains the term. -/
  in_intent : topic.concept.intent term

namespace TermReading

/-- A term reading inherits the closed extent of its topic's concept. -/
theorem extent_closed {C : TermContext} (R : TermReading C) :
    FCA.closeA C.incidence R.topic.concept.extent = R.topic.concept.extent :=
  Concept.extent_closed R.topic.concept

/-- A term reading inherits the fiber-local cover of its topic. -/
theorem cover_is_fiber_local {C : TermContext} (R : TermReading C) :
    (∀ Ui ∈ R.topic.cover, Ui ⊑ R.topic.point.U) ∧
      Site.joinList R.topic.cover = R.topic.point.U :=
  Topic.cover_is_fiber_local R.topic

/-- Restrict a term reading along a fixed-fiber inclusion of claim site points. -/
def restrict {C : TermContext} (R : TermReading C) {src : SitePoint}
    (f : FiberHom src R.topic.point) : TermReading C where
  topic := Topic.restrict R.topic f
  term := R.term
  in_intent := R.in_intent

@[simp] theorem restrict_topic {C : TermContext} (R : TermReading C)
    {src : SitePoint} (f : FiberHom src R.topic.point) :
    (restrict R f).topic = Topic.restrict R.topic f := rfl

@[simp] theorem restrict_term {C : TermContext} (R : TermReading C)
    {src : SitePoint} (f : FiberHom src R.topic.point) :
    (restrict R f).term = R.term := rfl

/-- Restricting a term reading preserves the fiber-local cover law at the source point. -/
theorem restrict_cover_is_fiber_local {C : TermContext} (R : TermReading C)
    {src : SitePoint} (f : FiberHom src R.topic.point) :
    (∀ Ui ∈ (restrict R f).topic.cover, Ui ⊑ src.U) ∧
      Site.joinList (restrict R f).topic.cover = src.U :=
  Topic.restrict_cover_is_fiber_local R.topic f

/-- The local term reading induced on a member of the reading topic's cover. -/
def coverRestriction {C : TermContext} (R : TermReading C) (Ui : Site.Clopen)
    (hUi : Ui ∈ R.topic.cover) : TermReading C :=
  restrict R (Topic.coverFiberHom R.topic Ui hUi)

@[simp] theorem coverRestriction_term {C : TermContext} (R : TermReading C)
    (Ui : Site.Clopen) (hUi : Ui ∈ R.topic.cover) :
    (coverRestriction R Ui hUi).term = R.term := rfl

/-- A cover-restricted term reading is fiber-local over the cover member. -/
theorem coverRestriction_cover_is_fiber_local {C : TermContext} (R : TermReading C)
    (Ui : Site.Clopen) (hUi : Ui ∈ R.topic.cover) :
    (∀ Wi ∈ (coverRestriction R Ui hUi).topic.cover, Wi ⊑ Ui) ∧
      Site.joinList (coverRestriction R Ui hUi).topic.cover = Ui := by
  exact restrict_cover_is_fiber_local R (Topic.coverFiberHom R.topic Ui hUi)

/-- The two local term readings induced by cover members agree in term on their overlap. -/
theorem coverRestriction_overlap_terms_agree {C : TermContext} (R : TermReading C)
    (Ui Uj : Site.Clopen) (hUi : Ui ∈ R.topic.cover) (hUj : Uj ∈ R.topic.cover) :
    (coverRestriction (coverRestriction R Ui hUi) (Site.meet Ui Uj)
        (Topic.coverOverlap_left_mem R.topic Ui Uj hUi hUj)).term =
      (coverRestriction (coverRestriction R Uj hUj) (Site.meet Ui Uj)
        (Topic.coverOverlap_right_mem R.topic Ui Uj hUi hUj)).term := by
  simp

end TermReading

/-- A term reading whose direct claim profile is supported by a valuation. -/
structure ValuatedTermReading (C : TermContext) where
  /-- The term reading being valued. -/
  reading : TermReading C
  /-- The valuation against which the reading is tested. -/
  valuation : Valuation
  /-- Every claim in the term's direct profile fires truthwise under the valuation. -/
  supports : ∀ q, TermContext.profile C reading.term q ->
    Reading.isTruthFiring (valuation q) = true

namespace ValuatedTermReading

/-- A valuated reading supports every claim in its direct term profile. -/
theorem supports_profile {C : TermContext} (R : ValuatedTermReading C) {q : PredicationCell}
    (h : TermContext.profile C R.reading.term q) :
    Reading.isTruthFiring (R.valuation q) = true :=
  R.supports q h

/-- A valuated reading still carries the local cover of its underlying term reading. -/
theorem cover_is_fiber_local {C : TermContext} (R : ValuatedTermReading C) :
    (∀ Ui ∈ R.reading.topic.cover, Ui ⊑ R.reading.topic.point.U) ∧
      Site.joinList R.reading.topic.cover = R.reading.topic.point.U :=
  TermReading.cover_is_fiber_local R.reading

/-- Restrict a valuated term reading along a fixed-fiber inclusion of claim site points. -/
def restrict {C : TermContext} (R : ValuatedTermReading C) {src : SitePoint}
    (f : FiberHom src R.reading.topic.point) : ValuatedTermReading C where
  reading := TermReading.restrict R.reading f
  valuation := R.valuation
  supports := by
    intro q hq
    exact R.supports q hq

@[simp] theorem restrict_reading {C : TermContext} (R : ValuatedTermReading C)
    {src : SitePoint} (f : FiberHom src R.reading.topic.point) :
    (restrict R f).reading = TermReading.restrict R.reading f := rfl

@[simp] theorem restrict_valuation {C : TermContext} (R : ValuatedTermReading C)
    {src : SitePoint} (f : FiberHom src R.reading.topic.point) :
    (restrict R f).valuation = R.valuation := rfl

/-- Restricting a valuated term reading preserves profile support. -/
theorem restrict_supports_profile {C : TermContext} (R : ValuatedTermReading C)
    {src : SitePoint} (f : FiberHom src R.reading.topic.point) {q : PredicationCell}
    (h : TermContext.profile C (restrict R f).reading.term q) :
    Reading.isTruthFiring ((restrict R f).valuation q) = true :=
  supports_profile (restrict R f) h

/-- Restricting a valuated reading preserves the fiber-local cover law at the source point. -/
theorem restrict_cover_is_fiber_local {C : TermContext} (R : ValuatedTermReading C)
    {src : SitePoint} (f : FiberHom src R.reading.topic.point) :
    (∀ Ui ∈ (restrict R f).reading.topic.cover, Ui ⊑ src.U) ∧
      Site.joinList (restrict R f).reading.topic.cover = src.U :=
  TermReading.restrict_cover_is_fiber_local R.reading f

/-- The local valuated reading induced on a member of the reading topic's cover. -/
def coverRestriction {C : TermContext} (R : ValuatedTermReading C)
    (Ui : Site.Clopen) (hUi : Ui ∈ R.reading.topic.cover) :
    ValuatedTermReading C :=
  restrict R (Topic.coverFiberHom R.reading.topic Ui hUi)

@[simp] theorem coverRestriction_valuation {C : TermContext}
    (R : ValuatedTermReading C) (Ui : Site.Clopen)
    (hUi : Ui ∈ R.reading.topic.cover) :
    (coverRestriction R Ui hUi).valuation = R.valuation := rfl

/-- A cover-restricted valuated reading still supports its direct term profile. -/
theorem coverRestriction_supports_profile {C : TermContext}
    (R : ValuatedTermReading C) (Ui : Site.Clopen)
    (hUi : Ui ∈ R.reading.topic.cover) {q : PredicationCell}
    (h : TermContext.profile C (coverRestriction R Ui hUi).reading.term q) :
    Reading.isTruthFiring ((coverRestriction R Ui hUi).valuation q) = true :=
  supports_profile (coverRestriction R Ui hUi) h

/-- A cover-restricted valuated reading is fiber-local over the cover member. -/
theorem coverRestriction_cover_is_fiber_local {C : TermContext}
    (R : ValuatedTermReading C) (Ui : Site.Clopen)
    (hUi : Ui ∈ R.reading.topic.cover) :
    (∀ Wi ∈ (coverRestriction R Ui hUi).reading.topic.cover, Wi ⊑ Ui) ∧
      Site.joinList (coverRestriction R Ui hUi).reading.topic.cover = Ui := by
  exact restrict_cover_is_fiber_local R
    (Topic.coverFiberHom R.reading.topic Ui hUi)

  /-- The two local valuated readings induced by cover members agree in valuation on their overlap. -/
  theorem coverRestriction_overlap_valuations_agree {C : TermContext}
      (R : ValuatedTermReading C) (Ui Uj : Site.Clopen)
      (hUi : Ui ∈ R.reading.topic.cover) (hUj : Uj ∈ R.reading.topic.cover) :
    (coverRestriction (coverRestriction R Ui hUi) (Site.meet Ui Uj)
        (Topic.coverOverlap_left_mem R.reading.topic Ui Uj hUi hUj)).valuation =
        (coverRestriction (coverRestriction R Uj hUj) (Site.meet Ui Uj)
          (Topic.coverOverlap_right_mem R.reading.topic Ui Uj hUi hUj)).valuation := by
    simp

  /-- The valuation-read cell mask induced by a pairwise-Stone clopen.

  A clopen has a positive and negative evidence slot; a valuation gives each
  predication cell a reading with positive and negative slots. The induced patch
  admits a cell exactly when the clopen admits at least one slot present in the cell's
  reading. -/
  def clopenPatch (v : Valuation) (U : Site.Clopen) : PredicationCell -> Bool :=
    fun φ => (U.1 && Reading.pos (v φ)) || (U.2 && Reading.neg (v φ))

  /-- Reading a valuation through a clopen join is pointwise Boolean union of the
  corresponding patches. -/
  theorem clopenPatch_join (v : Valuation) (U V : Site.Clopen) (φ : PredicationCell) :
      clopenPatch v (Site.join U V) φ =
        (clopenPatch v U φ || clopenPatch v V φ) := by
    obtain ⟨up, un⟩ := U
    obtain ⟨vp, vn⟩ := V
    cases up <;> cases un <;> cases vp <;> cases vn <;>
      cases hpos : Reading.pos (v φ) <;> cases hneg : Reading.neg (v φ) <;>
      simp [clopenPatch, Site.join, Stone.ClopenUp.join, hpos, hneg]

  /-- If a cell is admitted by the valuation-read join of a finite clopen family,
  then some member of that family admits the cell. -/
  theorem clopenPatch_joinList_true (v : Valuation) (φ : PredicationCell) :
      ∀ {fam : List Site.Clopen},
        clopenPatch v (Site.joinList fam) φ = true ->
          ∃ U, U ∈ fam ∧ clopenPatch v U φ = true
    | [], h => by
        simp [clopenPatch, Site.joinList, Site.bot, Stone.ClopenUp.bot] at h
    | U :: rest, h => by
        rw [Site.joinList_cons, clopenPatch_join] at h
        cases hor : clopenPatch v U φ
        · have hrest : clopenPatch v (Site.joinList rest) φ = true := by
            simpa [hor] using h
          obtain ⟨V, hV, hpatch⟩ := clopenPatch_joinList_true v φ hrest
          exact ⟨V, List.mem_cons_of_mem U hV, hpatch⟩
        · exact ⟨U, by simp, hor⟩

  /-- A relative patch family: patches cover the displayed support mask, not
  necessarily every predication cell. This is the bridge from a topic cover
  to sheaf-style patches before any full-support hypothesis is supplied. -/
  structure PatchFamily where
    /-- The cell mask being covered by the patches. -/
    support : PredicationCell -> Bool
    /-- The local cell masks induced by the clopen family. -/
    patches : List (PredicationCell -> Bool)
    /-- Every cell in the support mask lies in one of the local patches. -/
    covers_support : ∀ φ, support φ = true -> ∃ p, p ∈ patches ∧ p φ = true

  /-- The patch family induced by a valuated reading's topic cover.

  The topic cover still covers only the topic point's clopen support; reading it
  through the valuation turns that clopen cover into a cover of the corresponding
  cell support mask. -/
  def topicPatchFamily {C : TermContext} (R : ValuatedTermReading C) : PatchFamily where
    support := clopenPatch R.valuation R.reading.topic.point.U
    patches := R.reading.topic.cover.map (clopenPatch R.valuation)
    covers_support := by
      intro φ hφ
      have hjoin :
          clopenPatch R.valuation (Site.joinList R.reading.topic.cover) φ = true := by
        rw [(cover_is_fiber_local R).2]
        exact hφ
      obtain ⟨U, hU, hpatch⟩ := clopenPatch_joinList_true R.valuation φ hjoin
      exact ⟨clopenPatch R.valuation U, List.mem_map.mpr ⟨U, hU, rfl⟩, hpatch⟩

  @[simp] theorem topicPatchFamily_support {C : TermContext} (R : ValuatedTermReading C) :
      (topicPatchFamily R).support =
        clopenPatch R.valuation R.reading.topic.point.U :=
    rfl

  @[simp] theorem topicPatchFamily_patches {C : TermContext} (R : ValuatedTermReading C) :
      (topicPatchFamily R).patches =
        R.reading.topic.cover.map (clopenPatch R.valuation) :=
    rfl

  /-- A valuated reading's topic patches become a global sheaf cover exactly when its
  valuation-read topic support contains every predication cell. -/
  def topicSheafCover {C : TermContext} (R : ValuatedTermReading C)
      (hfull : ∀ φ, clopenPatch R.valuation R.reading.topic.point.U φ = true) :
      Sheaf.Cover where
    patches := (topicPatchFamily R).patches
    covers := by
      intro φ
      exact (topicPatchFamily R).covers_support φ (hfull φ)

end ValuatedTermReading

/-- A frame of varying term contexts, indexed by scenario-like positions. -/
structure IntensionalFrame where
  /-- The index of contexts in the frame. -/
  Index : Type
  /-- The term context available at each index. -/
  context : Index -> TermContext

namespace IntensionalFrame

/-- A term family chooses a local term in each context of an intensional frame. -/
structure TermFamily (F : IntensionalFrame) where
  /-- The term selected at each index. -/
  termAt : (i : F.Index) -> (F.context i).Term

/-- Primary concept reading: at each index, close the term chosen there. -/
def primaryConcept {F : IntensionalFrame} (T : TermFamily F) (i : F.Index) :
    Concept (F.context i) :=
  TermContext.generatedConcept (F.context i) (T.termAt i)

/-- Primary concept readings have closed extents. -/
theorem primaryConcept_extent_closed {F : IntensionalFrame} (T : TermFamily F)
    (i : F.Index) :
    FCA.closeA (F.context i).incidence (primaryConcept T i).extent =
      (primaryConcept T i).extent :=
  TermContext.generatedConcept_extent_closed (F.context i) (T.termAt i)

/-- The topic localized from a primary concept at a witnessed site point. -/
def primaryTopic {F : IntensionalFrame} (T : TermFamily F) (i : F.Index)
    (point : SitePoint) (h : (primaryConcept T i).extent point.q) :
    Topic (F.context i) :=
  Topic.selfCover (primaryConcept T i) point h

/-- Primary topics carry a fiber-local cover at their site point. -/
theorem primaryTopic_cover_is_fiber_local {F : IntensionalFrame} (T : TermFamily F)
    (i : F.Index) (point : SitePoint) (h : (primaryConcept T i).extent point.q) :
    (∀ Ui ∈ (primaryTopic T i point h).cover, Ui ⊑ point.U) ∧
      Site.joinList (primaryTopic T i point h).cover = point.U :=
  Topic.cover_is_fiber_local (primaryTopic T i point h)

/-- The term reading localized from a primary concept at a witnessed site point. -/
def primaryReading {F : IntensionalFrame} (T : TermFamily F) (i : F.Index)
    (point : SitePoint) (h : (primaryConcept T i).extent point.q) :
    TermReading (F.context i) where
  topic := primaryTopic T i point h
  term := T.termAt i
  in_intent := TermContext.generatedConcept_in_intent (F.context i) (T.termAt i)

/-- Primary readings carry the fiber-local cover of their localized topic. -/
theorem primaryReading_cover_is_fiber_local {F : IntensionalFrame} (T : TermFamily F)
    (i : F.Index) (point : SitePoint) (h : (primaryConcept T i).extent point.q) :
    (∀ Ui ∈ (primaryReading T i point h).topic.cover, Ui ⊑ point.U) ∧
      Site.joinList (primaryReading T i point h).topic.cover = point.U :=
  TermReading.cover_is_fiber_local (primaryReading T i point h)

/-- The valuated reading localized from a primary concept at a witnessed site point. -/
def primaryValuatedReading {F : IntensionalFrame} (T : TermFamily F) (i : F.Index)
    (point : SitePoint) (h : (primaryConcept T i).extent point.q)
    (v : Valuation)
    (hsupport : ∀ q, TermContext.profile (F.context i) (T.termAt i) q ->
      Reading.isTruthFiring (v q) = true) :
    ValuatedTermReading (F.context i) where
  reading := primaryReading T i point h
  valuation := v
  supports := hsupport

/-- Primary valuated readings carry the fiber-local cover of their reading. -/
  theorem primaryValuatedReading_cover_is_fiber_local {F : IntensionalFrame}
      (T : TermFamily F) (i : F.Index) (point : SitePoint)
      (h : (primaryConcept T i).extent point.q) (v : Valuation)
      (hsupport : ∀ q, TermContext.profile (F.context i) (T.termAt i) q ->
      Reading.isTruthFiring (v q) = true) :
    (∀ Ui ∈ (primaryValuatedReading T i point h v hsupport).reading.topic.cover,
      Ui ⊑ point.U) ∧
      Site.joinList (primaryValuatedReading T i point h v hsupport).reading.topic.cover =
        point.U :=
  ValuatedTermReading.cover_is_fiber_local
    (primaryValuatedReading T i point h v hsupport)

  /-- The relative patch family induced by a primary valuated reading's topic cover. -/
  def primaryPatchFamily {F : IntensionalFrame} (T : TermFamily F) (i : F.Index)
      (point : SitePoint) (h : (primaryConcept T i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q, TermContext.profile (F.context i) (T.termAt i) q ->
        Reading.isTruthFiring (v q) = true) :
      ValuatedTermReading.PatchFamily :=
    ValuatedTermReading.topicPatchFamily (primaryValuatedReading T i point h v hsupport)

  /-- Primary patch families cover the valuation-read support of the primary topic point. -/
  theorem primaryPatchFamily_covers_support {F : IntensionalFrame} (T : TermFamily F)
      (i : F.Index) (point : SitePoint) (h : (primaryConcept T i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q, TermContext.profile (F.context i) (T.termAt i) q ->
        Reading.isTruthFiring (v q) = true) :
      ∀ φ, (primaryPatchFamily T i point h v hsupport).support φ = true ->
        ∃ p, p ∈ (primaryPatchFamily T i point h v hsupport).patches ∧ p φ = true :=
    (primaryPatchFamily T i point h v hsupport).covers_support

  /-- A primary valuated reading's topic patches become a sheaf cover under an explicit
  full-support hypothesis. -/
  def primarySheafCover {F : IntensionalFrame} (T : TermFamily F) (i : F.Index)
      (point : SitePoint) (h : (primaryConcept T i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q, TermContext.profile (F.context i) (T.termAt i) q ->
        Reading.isTruthFiring (v q) = true)
      (hfull : ∀ φ, ValuatedTermReading.clopenPatch v point.U φ = true) :
      Sheaf.Cover :=
    ValuatedTermReading.topicSheafCover (primaryValuatedReading T i point h v hsupport)
      hfull

  /-- An anchored term fixes one actual term and transports it into every context. -/
  structure AnchoredTerm (F : IntensionalFrame) where
  /-- The actual index where the term is fixed. -/
  actual : F.Index
  /-- The term fixed at the actual index. -/
  term : (F.context actual).Term
  /-- A transport from the actual context to each context in the frame. -/
  transport : (i : F.Index) -> TermContext.Hom (F.context actual) (F.context i)
  /-- The transport at the actual index fixes claims. -/
  transport_actual_claim : ∀ q, (transport actual).claimMap q = q
  /-- The transport at the actual index fixes the anchored term. -/
  transport_actual_term : (transport actual).termMap term = term

  namespace AnchoredTerm

  /-- The primary term family induced by a secondary anchor: transport the actual
  anchored term into every context. -/
  def termFamily {F : IntensionalFrame} (A : AnchoredTerm F) : TermFamily F where
    termAt i := (A.transport i).termMap A.term

  @[simp] theorem termFamily_termAt {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) :
      (termFamily A).termAt i = (A.transport i).termMap A.term :=
    rfl

  /-- At the actual index, the anchor-induced primary family recovers the anchored term. -/
  @[simp] theorem termFamily_actual {F : IntensionalFrame} (A : AnchoredTerm F) :
      (termFamily A).termAt A.actual = A.term :=
    A.transport_actual_term

  /-- Pullback along the actual transport of an anchor recovers the valuation. -/
  theorem actual_pullbackValuation {F : IntensionalFrame} (A : AnchoredTerm F)
      (v : Valuation) :
      TermContext.Hom.pullbackValuation (A.transport A.actual) v = v :=
    TermContext.Hom.pullbackValuation_eq_self_of_claimMap_eq
      (A.transport A.actual) v A.transport_actual_claim

  /-- Support for the anchored actual term supports its actual transport. -/
  theorem actual_supports_transport {F : IntensionalFrame} (A : AnchoredTerm F)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context A.actual) A.term q ->
          Reading.isTruthFiring (v q) = true) :
      ∀ q,
        TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true := by
    intro q hq
    exact hsupport q (by simpa [A.transport_actual_term] using hq)

  end AnchoredTerm

  /-- Secondary concept reading: fix the actual term, transport it, then close. -/
  def secondaryConcept {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index) :
    Concept (F.context i) :=
  TermContext.generatedConcept (F.context i) ((A.transport i).termMap A.term)

  /-- A secondary concept is the primary concept of the family induced by its anchor. -/
  theorem primaryConcept_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) :
      primaryConcept (AnchoredTerm.termFamily A) i = secondaryConcept A i :=
    rfl

  /-- At the actual index, the secondary concept is the concept generated by the anchored term. -/
  theorem secondaryConcept_actual {F : IntensionalFrame} (A : AnchoredTerm F) :
    secondaryConcept A A.actual =
      TermContext.generatedConcept (F.context A.actual) A.term := by
    simp [secondaryConcept, A.transport_actual_term]

/-- Secondary concept readings have closed extents. -/
theorem secondaryConcept_extent_closed {F : IntensionalFrame} (A : AnchoredTerm F)
    (i : F.Index) :
    FCA.closeA (F.context i).incidence (secondaryConcept A i).extent =
      (secondaryConcept A i).extent :=
  TermContext.generatedConcept_extent_closed
    (F.context i) ((A.transport i).termMap A.term)

/-- Secondary reading preserves the actual direct profile along the chosen transport. -/
theorem secondary_profile_preserved {F : IntensionalFrame} (A : AnchoredTerm F)
    (i : F.Index) {q : PredicationCell}
    (h : TermContext.profile (F.context A.actual) A.term q) :
    TermContext.profile (F.context i) ((A.transport i).termMap A.term)
      ((A.transport i).claimMap q) :=
  TermContext.Hom.profile_preserved (A.transport i) h

/-- The actual transport preserves the actual profile at the same claim. -/
theorem secondary_profile_preserved_at_actual {F : IntensionalFrame} (A : AnchoredTerm F)
    {q : PredicationCell} (h : TermContext.profile (F.context A.actual) A.term q) :
    TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q := by
  simpa [A.transport_actual_claim q] using
    (secondary_profile_preserved A A.actual h)

/-- The topic localized from a secondary concept at a witnessed site point. -/
  def secondaryTopic {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
    Topic (F.context i) :=
  Topic.selfCover (secondaryConcept A i) point h

  /-- A secondary topic is the primary topic of the family induced by its anchor. -/
  theorem primaryTopic_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
      primaryTopic (AnchoredTerm.termFamily A) i point h = secondaryTopic A i point h :=
    rfl

  /-- Secondary topics carry a fiber-local cover at their site point. -/
  theorem secondaryTopic_cover_is_fiber_local {F : IntensionalFrame} (A : AnchoredTerm F)
    (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
    (∀ Ui ∈ (secondaryTopic A i point h).cover, Ui ⊑ point.U) ∧
      Site.joinList (secondaryTopic A i point h).cover = point.U :=
  Topic.cover_is_fiber_local (secondaryTopic A i point h)

/-- The term reading localized from a secondary concept at a witnessed site point. -/
  def secondaryReading {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
    TermReading (F.context i) where
  topic := secondaryTopic A i point h
  term := (A.transport i).termMap A.term
  in_intent := TermContext.generatedConcept_in_intent
    (F.context i) ((A.transport i).termMap A.term)

  /-- A secondary reading is the primary reading of the family induced by its anchor. -/
  theorem primaryReading_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
      primaryReading (AnchoredTerm.termFamily A) i point h = secondaryReading A i point h :=
    rfl

  /-- Secondary readings carry the fiber-local cover of their localized topic. -/
  theorem secondaryReading_cover_is_fiber_local {F : IntensionalFrame} (A : AnchoredTerm F)
    (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q) :
    (∀ Ui ∈ (secondaryReading A i point h).topic.cover, Ui ⊑ point.U) ∧
      Site.joinList (secondaryReading A i point h).topic.cover = point.U :=
  TermReading.cover_is_fiber_local (secondaryReading A i point h)

/-- The valuated reading localized from a secondary concept at a witnessed site point. -/
  def secondaryValuatedReading {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
    (hsupport : ∀ q,
      TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
        Reading.isTruthFiring (v q) = true) :
    ValuatedTermReading (F.context i) where
  reading := secondaryReading A i point h
  valuation := v
  supports := hsupport

  /-- A secondary valuated reading is the primary valuated reading of the family
  induced by its anchor. -/
  theorem primaryValuatedReading_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      primaryValuatedReading (AnchoredTerm.termFamily A) i point h v hsupport =
        secondaryValuatedReading A i point h v hsupport :=
    rfl

  /-- Secondary valuated readings carry the fiber-local cover of their reading. -/
  theorem secondaryValuatedReading_cover_is_fiber_local {F : IntensionalFrame}
      (A : AnchoredTerm F) (i : F.Index) (point : SitePoint)
      (h : (secondaryConcept A i).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
      TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
        Reading.isTruthFiring (v q) = true) :
    (∀ Ui ∈ (secondaryValuatedReading A i point h v hsupport).reading.topic.cover,
      Ui ⊑ point.U) ∧
      Site.joinList (secondaryValuatedReading A i point h v hsupport).reading.topic.cover =
        point.U :=
  ValuatedTermReading.cover_is_fiber_local
    (secondaryValuatedReading A i point h v hsupport)

  /-- The relative patch family induced by a secondary valuated reading's topic cover. -/
  def secondaryPatchFamily {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      ValuatedTermReading.PatchFamily :=
  ValuatedTermReading.topicPatchFamily
    (secondaryValuatedReading A i point h v hsupport)

  /-- A secondary patch family is the primary patch family of the family induced by
  its anchor. -/
  theorem primaryPatchFamily_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      primaryPatchFamily (AnchoredTerm.termFamily A) i point h v hsupport =
        secondaryPatchFamily A i point h v hsupport :=
    rfl

  /-- Secondary patch families cover the valuation-read support of the secondary topic point. -/
  theorem secondaryPatchFamily_covers_support {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      ∀ φ, (secondaryPatchFamily A i point h v hsupport).support φ = true ->
        ∃ p, p ∈ (secondaryPatchFamily A i point h v hsupport).patches ∧ p φ = true :=
    (secondaryPatchFamily A i point h v hsupport).covers_support

  /-- A secondary valuated reading's topic patches become a sheaf cover under an explicit
  full-support hypothesis. -/
  def secondarySheafCover {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true)
      (hfull : ∀ φ, ValuatedTermReading.clopenPatch v point.U φ = true) :
      Sheaf.Cover :=
  ValuatedTermReading.topicSheafCover
    (secondaryValuatedReading A i point h v hsupport) hfull

  /-- A secondary sheaf cover is the primary sheaf cover of the family induced by its
  anchor, under the same full-support hypothesis. -/
  theorem primarySheafCover_from_anchor {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint) (h : (secondaryConcept A i).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true)
      (hfull : ∀ φ, ValuatedTermReading.clopenPatch v point.U φ = true) :
      primarySheafCover (AnchoredTerm.termFamily A) i point h v hsupport hfull =
        secondarySheafCover A i point h v hsupport hfull :=
    rfl

  /-- Pull target valuation support back to a valuated secondary reading at the actual index. -/
  def secondaryActualPullbackValuatedReading {F : IntensionalFrame} (A : AnchoredTerm F)
    (i : F.Index) (point : SitePoint)
    (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
    (hsupport : ∀ q,
      TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
        Reading.isTruthFiring (v q) = true) :
    ValuatedTermReading (F.context A.actual) where
  reading := secondaryReading A A.actual point h
  valuation := TermContext.Hom.pullbackValuation (A.transport i) v
  supports := by
    intro q hq
    exact TermContext.Hom.pullback_supports_profile (A.transport i) v hsupport
      (by simpa [secondaryReading, A.transport_actual_term] using hq)

/-- At the actual index, the pullback-valuated secondary reading carries the
original valuation. -/
theorem secondaryActualPullbackValuation_at_actual {F : IntensionalFrame}
    (A : AnchoredTerm F) (point : SitePoint)
    (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
    (hsupport : ∀ q,
      TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q ->
        Reading.isTruthFiring (v q) = true) :
    (secondaryActualPullbackValuatedReading A A.actual point h v hsupport).valuation = v :=
  AnchoredTerm.actual_pullbackValuation A v

/-- Pullback-valuated secondary readings carry the actual reading's fiber-local cover. -/
theorem secondaryActualPullbackReading_cover_is_fiber_local
    {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
    (point : SitePoint) (h : (secondaryConcept A A.actual).extent point.q)
    (v : Valuation)
    (hsupport : ∀ q,
      TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
        Reading.isTruthFiring (v q) = true) :
    (∀ Ui ∈
      (secondaryActualPullbackValuatedReading A i point h v hsupport).reading.topic.cover,
      Ui ⊑ point.U) ∧
      Site.joinList
        (secondaryActualPullbackValuatedReading A i point h v hsupport).reading.topic.cover =
        point.U :=
  ValuatedTermReading.cover_is_fiber_local
    (secondaryActualPullbackValuatedReading A i point h v hsupport)

  /-- The relative patch family induced by a secondary pullback-valuated actual reading. -/
  def secondaryActualPullbackPatchFamily {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint)
      (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      ValuatedTermReading.PatchFamily :=
    ValuatedTermReading.topicPatchFamily
      (secondaryActualPullbackValuatedReading A i point h v hsupport)

  /-- At the actual index, the pullback patch-family support is the ordinary
  secondary patch-family support. -/
  theorem secondaryActualPullbackPatchFamily_support_at_actual
      {F : IntensionalFrame} (A : AnchoredTerm F) (point : SitePoint)
      (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      (secondaryActualPullbackPatchFamily A A.actual point h v hsupport).support =
        (secondaryPatchFamily A A.actual point h v hsupport).support := by
    simp [secondaryActualPullbackPatchFamily, secondaryPatchFamily,
      ValuatedTermReading.topicPatchFamily, secondaryActualPullbackValuatedReading,
      secondaryValuatedReading, AnchoredTerm.actual_pullbackValuation]

  /-- At the actual index, the pullback patch list is the ordinary secondary
  patch list. -/
  theorem secondaryActualPullbackPatchFamily_patches_at_actual
      {F : IntensionalFrame} (A : AnchoredTerm F) (point : SitePoint)
      (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      (secondaryActualPullbackPatchFamily A A.actual point h v hsupport).patches =
        (secondaryPatchFamily A A.actual point h v hsupport).patches := by
    simp [secondaryActualPullbackPatchFamily, secondaryPatchFamily,
      ValuatedTermReading.topicPatchFamily, secondaryActualPullbackValuatedReading,
      secondaryValuatedReading, AnchoredTerm.actual_pullbackValuation]

  /-- Pullback-valuated secondary patch families cover the valuation-read support of
  the actual secondary topic point. -/
  theorem secondaryActualPullbackPatchFamily_covers_support
      {F : IntensionalFrame} (A : AnchoredTerm F) (i : F.Index)
      (point : SitePoint) (h : (secondaryConcept A A.actual).extent point.q)
      (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true) :
      ∀ φ,
        (secondaryActualPullbackPatchFamily A i point h v hsupport).support φ = true ->
          ∃ p,
            p ∈ (secondaryActualPullbackPatchFamily A i point h v hsupport).patches ∧
              p φ = true :=
    (secondaryActualPullbackPatchFamily A i point h v hsupport).covers_support

  /-- A pullback-valuated secondary actual reading's topic patches become a sheaf cover
  under an explicit full-support hypothesis. -/
  def secondaryActualPullbackSheafCover {F : IntensionalFrame} (A : AnchoredTerm F)
      (i : F.Index) (point : SitePoint)
      (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context i) ((A.transport i).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true)
      (hfull : ∀ φ,
        ValuatedTermReading.clopenPatch
          (TermContext.Hom.pullbackValuation (A.transport i) v) point.U φ = true) :
      Sheaf.Cover :=
    ValuatedTermReading.topicSheafCover
      (secondaryActualPullbackValuatedReading A i point h v hsupport) hfull

  /-- Full support for the actual pullback valuation is full support for the
  original valuation. -/
  def actualFullSupport_of_pullback {F : IntensionalFrame} (A : AnchoredTerm F)
      (point : SitePoint) (v : Valuation)
      (hfull : ∀ φ,
        ValuatedTermReading.clopenPatch
          (TermContext.Hom.pullbackValuation (A.transport A.actual) v) point.U φ = true) :
      ∀ φ, ValuatedTermReading.clopenPatch v point.U φ = true := by
    intro φ
    simpa [AnchoredTerm.actual_pullbackValuation] using hfull φ

  /-- At the actual index, the pullback sheaf cover has the ordinary secondary
  sheaf-cover patch list. -/
  theorem secondaryActualPullbackSheafCover_patches_at_actual
      {F : IntensionalFrame} (A : AnchoredTerm F) (point : SitePoint)
      (h : (secondaryConcept A A.actual).extent point.q) (v : Valuation)
      (hsupport : ∀ q,
        TermContext.profile (F.context A.actual) ((A.transport A.actual).termMap A.term) q ->
          Reading.isTruthFiring (v q) = true)
      (hfull : ∀ φ,
        ValuatedTermReading.clopenPatch
          (TermContext.Hom.pullbackValuation (A.transport A.actual) v) point.U φ = true) :
      (secondaryActualPullbackSheafCover A A.actual point h v hsupport hfull).patches =
        (secondarySheafCover A A.actual point h v hsupport
          (actualFullSupport_of_pullback A point v hfull)).patches := by
    simp [secondaryActualPullbackSheafCover, secondarySheafCover,
      ValuatedTermReading.topicSheafCover, ValuatedTermReading.topicPatchFamily,
      secondaryActualPullbackValuatedReading, secondaryValuatedReading,
      AnchoredTerm.actual_pullbackValuation]

end IntensionalFrame

end PredicationCell
end Obsmetrologia
