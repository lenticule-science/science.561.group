import Obsmetrologia.Language.Predicating.Claim
import Obsmetrologia.Language.Positing.Charge

/-!
# Positing.Valuation

The charge assignment generated by positing: each claim point receives a
bilattice charge, with the knowledge-least valuation as the seed for settling.
-/

namespace Obsmetrologia

/-! ## Valuation - the charge assignment -/

/-- A valuation assigns a charge to each claim point.

It is represented by the predication cell generated under that claim point. -/
abbrev Valuation := PredicationCell -> Charge

namespace Valuation

/-- Valuations are definitionally charge assignments on claim points. -/
theorem isClaimCharge : Valuation = (Claim -> Charge) := rfl

/-- Evaluate a valuation at a claim point. -/
def atClaim (v : Valuation) (q : Claim) : Charge := v q

@[simp] theorem atClaim_apply (v : Valuation) (q : Claim) : atClaim v q = v q := rfl

/-- The knowledge-least valuation positing seeds: bottom charge on every claim point. -/
def knowledgeLeast : Valuation := fun _ => Charge.kBot

/-- Pointwise knowledge order on valuations. -/
def leK (v w : Valuation) : Prop := forall phi, Charge.leK (v phi) (w phi) = true

/-- The knowledge-least valuation is below every valuation. -/
theorem knowledgeLeast_le (v : Valuation) : leK knowledgeLeast v := by
  intro phi
  exact Charge.kBot_leK (v phi)

/-- Pointwise knowledge-join of valuations. -/
def joinK (v w : Valuation) : Valuation := fun phi => Charge.joinK (v phi) (w phi)

end Valuation

end Obsmetrologia
