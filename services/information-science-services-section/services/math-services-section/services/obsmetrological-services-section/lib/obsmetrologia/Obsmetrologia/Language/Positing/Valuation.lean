import Obsmetrologia.Language.Predicating.Claim
import Obsmetrologia.Language.Positing.Reading

/-!
# Positing.Valuation

The reading assignment generated by positing: each predication cell receives a
bilattice reading, with the knowledge-least valuation as the seed for settling.
-/

namespace Obsmetrologia

/-! ## Valuation - the reading assignment -/

/-- A valuation assigns a reading to each predication cell.

It is represented by the predication cell generated under that cell. -/
abbrev Valuation := PredicationCell -> Reading

namespace Valuation

/-- Valuations are definitionally reading assignments on predication cells. -/
theorem isClaimReading : Valuation = (PredicationCell -> Reading) := rfl

/-- Evaluate a valuation at a predication cell. -/
def atClaim (v : Valuation) (q : PredicationCell) : Reading := v q

@[simp] theorem atClaim_apply (v : Valuation) (q : PredicationCell) : atClaim v q = v q := rfl

/-- The knowledge-least valuation positing seeds: bottom reading on every predication cell. -/
def knowledgeLeast : Valuation := fun _ => Reading.kBot

/-- Pointwise knowledge order on valuations. -/
def leK (v w : Valuation) : Prop := forall phi, Reading.leK (v phi) (w phi) = true

/-- The knowledge-least valuation is below every valuation. -/
theorem knowledgeLeast_le (v : Valuation) : leK knowledgeLeast v := by
  intro phi
  exact Reading.kBot_leK (v phi)

/-- Pointwise knowledge-join of valuations. -/
def joinK (v w : Valuation) : Valuation := fun phi => Reading.joinK (v phi) (w phi)

end Valuation

end Obsmetrologia
