import Obsmetrologia.Calculus.Optimization.FixedPoint

/-!
# Majorization — improvement by a touching minorant, and its ω-orbit

The corpus node `…/settling/content/continuous-valued-settling/continuous-valued-settling.md`
names the Lawvere-quantale case `𝒱 = [0,∞]` a *metric* settling whose closure operator is
"find shortest path / minimal distance" iterated, and admits into the Scott-continuous regime
both `κ = ω` in discrete time and `κ = ∞` with explicit countable-rate convergence.

`Optimization.FixedPoint` requires the improvement operator to be a `VClosure` — monotone,
inflationary, and idempotent — so its `settle` is a single application. This module carries the
improvement operators that are inflationary and monotone but **not** idempotent: the improvement
is generated by a `minorant` that touches the value at its anchor, and the optimum is reached by
the ω-orbit rather than by one step.

## Main definitions

* `MajorizationScheme` — a value, a two-argument `minorant` under it that touches on the diagonal,
  and a `step` maximizing the minorant at its anchor.
* `MajorizationScheme.orbit` — the ω-orbit of `step` from a seed.
* `MajorizationScheme.Quiescent` — a `step`-fixed point.
* `SettledScheme` — a scheme together with a `limit` exhibiting each orbit's value as a least
  upper bound, and quiescent.

## Main results

* `value_le_step` — the step never retracts the value (the sandwich `value z = minorant z z ≤
  minorant (step z) z ≤ value (step z)`).
* `value_orbit_monotone` — the orbit's values ascend in `V`.
* `orbit_of_quiescent` — a quiescent point's orbit is constant.
* `limit_quiescent_is_locally_optimal` — the limit is `LocallyOptimal` for the induced improvement.
* `limit_value_idempotent` — re-settling a settled seed does not move its value.
* `settled_orbit_is_scott_regime` — the bundled headline.

## Implementation notes

`ValueCategory` carries a partial order and a seed, not joins, so the ω-limit is not definable
from `MajorizationScheme` alone; `SettledScheme` takes the least-upper-bound data as explicit
fields. Monotonicity of `limit` in the seed's value does not follow from these fields and is not
claimed here.

## References

* `…/settling/content/continuous-valued-settling/continuous-valued-settling.md`
* `…/settling/content/operations-research/optimization.md`

## Tags

majorization, settling, optimization, Scott-continuous regime
-/

namespace Obsmetrologia
namespace Optimization.Majorization

open Positing.Value

/-! ## (A) The scheme -/

/-- A **majorization scheme** over `V`: a `point` carrier with a `value` into `V`
(*better = higher*), a `minorant x z` lying `≤_V` the value at `x` for every anchor `z` and
agreeing with the value on the diagonal, and a `step` whose image maximizes the minorant at its
anchor.

Read against the stress formulation, `V`'s order is the reversed stress order, so the
stress-majorizer `τ(·,z)` is `minorant ·  z` and `step` is the argmin of `τ(·,z)`. -/
structure MajorizationScheme (V : ValueCategory) where
  /-- The carrier the improvement moves through. -/
  point : Type
  /-- The measure: the value of a point in `V`, *better = higher*. -/
  value : point → V.carrier
  /-- The minorant at anchor `z`, evaluated at `x`. -/
  minorant : point → point → V.carrier
  /-- The minorant lies under the value at every anchor. -/
  minorant_le_value : ∀ x z, V.le (minorant x z) (value x)
  /-- The minorant agrees with the value on the diagonal. -/
  minorant_touches : ∀ z, minorant z z = value z
  /-- The improvement step. -/
  step : point → point
  /-- `step z` maximizes the minorant anchored at `z`. -/
  step_maximizes : ∀ x z, V.le (minorant x z) (minorant (step z) z)

namespace MajorizationScheme

variable {V : ValueCategory} (S : MajorizationScheme V)

/-- **The step does not retract the value**: `value z ≤_V value (step z)`, by
`value z = minorant z z ≤_V minorant (step z) z ≤_V value (step z)`. This is the inflationary law
of `VClosure` for a step that is not assumed idempotent. -/
theorem value_le_step (z : S.point) : V.le (S.value z) (S.value (S.step z)) := by
  have h : V.le (S.minorant z z) (S.value (S.step z)) :=
    V.le_trans (S.step_maximizes z z) (S.minorant_le_value (S.step z) z)
  rw [S.minorant_touches z] at h
  exact h

/-! ## (B) The ω-orbit -/

/-- The **orbit** of `step` from a seed: `orbit seed 0 = seed`, `orbit seed (n+1) =
step (orbit seed n)`. -/
def orbit (S : MajorizationScheme V) (seed : S.point) : Nat → S.point
  | 0 => seed
  | n + 1 => S.step (S.orbit seed n)

/-- Each orbit step does not retract the value. -/
theorem value_orbit_le_succ (seed : S.point) (n : Nat) :
    V.le (S.value (S.orbit seed n)) (S.value (S.orbit seed (n + 1))) :=
  S.value_le_step (S.orbit seed n)

/-- **The orbit's values ascend in `V`**: `m ≤ n → value (orbit seed m) ≤_V value (orbit seed n)`.
The orbit is a chain in the value order. -/
theorem value_orbit_monotone (seed : S.point) {m n : Nat} (h : m ≤ n) :
    V.le (S.value (S.orbit seed m)) (S.value (S.orbit seed n)) := by
  induction h with
  | refl => exact V.le_refl _
  | step h ih => exact V.le_trans ih (S.value_orbit_le_succ seed _)

/-! ## (C) Quiescence -/

/-- **Quiescent** at `x`: the step makes no move, `step x = x`. -/
def Quiescent (S : MajorizationScheme V) (x : S.point) : Prop := S.step x = x

/-- A quiescent point's orbit is constant. -/
theorem orbit_of_quiescent (x : S.point) (hx : S.Quiescent x) (n : Nat) :
    S.orbit x n = x := by
  induction n with
  | zero => rfl
  | succ n ih =>
      show S.step (S.orbit x n) = x
      rw [ih]
      exact hx

/-! ## (D) The settled scheme — the ω-limit as a least upper bound -/

/-- A **settled scheme**: a majorization scheme with a `limit` map whose value is, for each seed,
a least upper bound of the orbit's values, and which lands on a quiescent point.

`ValueCategory` has no joins, so this data is not derivable from `MajorizationScheme`; these are
the fields the `κ = ω` regime supplies. -/
structure SettledScheme (V : ValueCategory) where
  /-- The underlying scheme. -/
  scheme : MajorizationScheme V
  /-- The ω-limit of the orbit from a seed. -/
  limit : scheme.point → scheme.point
  /-- The limit's value bounds every orbit value above. -/
  limit_upper : ∀ seed n, V.le (scheme.value (scheme.orbit seed n)) (scheme.value (limit seed))
  /-- The limit's value is the least such bound. -/
  limit_least : ∀ seed y, (∀ n, V.le (scheme.value (scheme.orbit seed n)) y) →
    V.le (scheme.value (limit seed)) y
  /-- The limit is quiescent — the step makes no further move there. -/
  limit_quiescent : ∀ seed, scheme.Quiescent (limit seed)

namespace SettledScheme

variable {V : ValueCategory} (P : SettledScheme V)

/-- The seed's value lies under its limit's value (the `n = 0` upper bound). -/
theorem value_le_limit (seed : P.scheme.point) :
    V.le (P.scheme.value seed) (P.scheme.value (P.limit seed)) :=
  P.limit_upper seed 0

/-- **The limit is locally optimal**: it is a fixed point of the step, so no improving move
remains. -/
theorem limit_quiescent_is_locally_optimal (seed : P.scheme.point) :
    P.scheme.step (P.limit seed) = P.limit seed :=
  P.limit_quiescent seed

/-- **Re-settling a settled seed does not move its value**: `value (limit (limit seed)) =
value (limit seed)`. The idempotence `VClosure` demands, recovered at the ω-limit for a step that
is not itself idempotent. -/
theorem limit_value_idempotent (seed : P.scheme.point) :
    P.scheme.value (P.limit (P.limit seed)) = P.scheme.value (P.limit seed) := by
  have hq : P.scheme.Quiescent (P.limit seed) := P.limit_quiescent seed
  have hconst : ∀ n, P.scheme.orbit (P.limit seed) n = P.limit seed :=
    P.scheme.orbit_of_quiescent (P.limit seed) hq
  have hle : V.le (P.scheme.value (P.limit (P.limit seed))) (P.scheme.value (P.limit seed)) := by
    refine P.limit_least (P.limit seed) (P.scheme.value (P.limit seed)) ?_
    intro n
    rw [hconst n]
    exact V.le_refl _
  exact V.le_antisymm hle (P.value_le_limit (P.limit seed))

/-- **The ω-orbit settles the scheme.** For every seed:

* the orbit's values ascend in `V` (`value_orbit_monotone`);
* the seed's value lies under the limit's (`value_le_limit`);
* the limit is a step fixed point (`limit_quiescent_is_locally_optimal`);
* the limit's value is the least upper bound of the orbit's values (`limit_least`);
* re-settling the limit does not move its value (`limit_value_idempotent`).
-/
theorem settled_orbit_is_scott_regime (seed : P.scheme.point) :
    (∀ m n : Nat, m ≤ n →
      V.le (P.scheme.value (P.scheme.orbit seed m)) (P.scheme.value (P.scheme.orbit seed n)))
    ∧ V.le (P.scheme.value seed) (P.scheme.value (P.limit seed))
    ∧ P.scheme.step (P.limit seed) = P.limit seed
    ∧ (∀ y, (∀ n, V.le (P.scheme.value (P.scheme.orbit seed n)) y) →
        V.le (P.scheme.value (P.limit seed)) y)
    ∧ P.scheme.value (P.limit (P.limit seed)) = P.scheme.value (P.limit seed) :=
  ⟨fun _ _ h => P.scheme.value_orbit_monotone seed h,
   P.value_le_limit seed,
   P.limit_quiescent_is_locally_optimal seed,
   P.limit_least seed,
   P.limit_value_idempotent seed⟩

end SettledScheme
end MajorizationScheme
end Optimization.Majorization
end Obsmetrologia
