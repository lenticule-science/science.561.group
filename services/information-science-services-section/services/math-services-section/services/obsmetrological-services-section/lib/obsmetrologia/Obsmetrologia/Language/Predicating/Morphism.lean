import Obsmetrologia.Language.Predicating.Cell

/-!
# Predicating.Morphism

Canonical import home for the cellwise morphisms generated by predicating.
-/

namespace Obsmetrologia
namespace Predicating

/-- A predicating morphism, realized concretely as a cellwise reindexing. -/
abbrev Morphism := PredicationCell -> PredicationCell

namespace Morphism

/-- Identity predicating morphism. -/
def id : Morphism := fun phi => phi

/-- Converse generator. -/
def converse : Morphism := PredicationCell.converse

/-- Subject-projection generator. -/
def subjectProjection : Morphism := PredicationCell.subjProj

/-- Object-projection generator. -/
def objectProjection : Morphism := PredicationCell.objProj

/-- Predicate-specialization generator. -/
def specialize (f : Predicate -> Predicate) : Morphism := PredicationCell.specialize f

@[simp] theorem converse_comp_converse_eq_id (phi : PredicationCell) :
    converse (converse phi) = id phi :=
  Obsmetrologia.PredicationCell.converse_converse phi

end Morphism

end Predicating
end Obsmetrologia
