import Obsmetrologia.Closure.Collatz.ResidueGap
import Obsmetrologia.Closure.Scott
import Obsmetrologia.AperiodicOrder.Tiling.Diffraction
import Obsmetrologia.AperiodicOrder.Tiling.SubstitutionPrimitivity
import Obsmetrologia.AperiodicOrder.Tiling.UpToClosureCoinduction

/-!
# Arithmetic zeta-star finite bridge

This module introduces the finite bridge object formalized in the
Obsmetrologia Lean corpus.  The object is not a complex analytic zeta function.
It is the arithmetic residual generated by the Collatz affine-trace theorem,
read on the finite displacement carrier used by `Diffraction`.

For a seed `m` and finite window `N`, the value at a displacement
`d : Fin (N + 1)` is the proposition that the affine trace of the parity word
of length `d.val` has zero residual:

`B_d * orbit m d.val = A_d * m + C_d`.

The affine-trace theorem proves this at every displacement, so the zero-set is
the full finite displacement carrier.  That is enough to build a finite discrete
Delone surrogate and to feed the existing finite diffraction mass.  The analytic
Delone point-set and pure-point diffraction statements remain frontier claims.

## Main definitions

* `ArithmeticZetaStar` packages a positive Collatz seed and a StepN phase side.
* `canonicalZetaStar` is the concrete Pisot-side witness with seed `1`.
* `zetaStarZeroSet` is the affine-trace residual zero-set on `Fin (N + 1)`.
* `FiniteDiscreteDelone` is a compatibility alias for the diffraction-owned
  `FiniteDisplacementDelone` finite carrier.

## Main results

* `zetaStarTrace_affine_identity` and `zetaStarTrace_B_eq_two_pow` expose the
  Collatz affine-trace identity and its 2-adic denominator scale.
* `zetaStarZeroSet_eq_univ` proves the residual vanishes at every displacement.
* `zetaStarZeroSet_finiteDisplacementDelone` proves the finite Delone carrier.
* `zetaStar_finiteDiffractionMass_univ` feeds the zero-set to finite diffraction
  mass.
* `zetaStar_phase_purePoint_iff_pisot` identifies the pure-point finite readout
  with the Pisot side of the existing StepN phase carrier.
* `zetaStar_finiteDiffractionMass_purePoint_of_pisot` packages the finite
  diffraction readout of `Z(ζ★)` as pure-point on the Pisot side.
* `zetaStar_phaseType_readout` ties the zeta-star finite readout to the
  corpus's existing `phaseType` map.
* `zetaStar_phaseType_trichotomy` places the zeta-star phase in the corpus's
  bigraded trichotomy.
* `zetaStar_arithmeticSettling_certificate` bundles the affine-trace, 2-adic,
  finite diffraction, and primitive substitution witnesses.
* `exists_zetaStar_finitePurePointQuasicrystal` supplies the concrete
  existential finite zeta-star witness.
* `exists_zetaStar_finiteDysonQuasicrystalForm` packages the current single
  finite diffraction statement.
* `canonicalZetaStarDisplacementCoalgebra` is the finite observed displacement
  coalgebra currently available: it carries the zero-set, mass, component, and
  phase observation through its unfold step.
* `metallization_algebraCoalgebraBoundary` names the already-proved
  metallization split as the algebra/coalgebra boundary used by the promotion.
* `zetaStar_coalgebraicPromotion_apparatus` packages the finite statement
  together with the existing Scott/coinductive promotion machinery.
* `zetaStar_algebraCoalgebraBoundary` bundles the finite zeta-star forms, the
  metallization boundary, and the Scott/coinductive apparatus.
* `zetaStar_analyticRichnessRecovery` records the observed-coinduction interface
  needed to keep diffraction or spectral readouts inside the coalgebra.
* `zetaStar_bridge_evidence` bundles the bridge.

## Tags

zeta-star, Collatz, affine trace, finite diffraction, Delone surrogate
-/

namespace Obsmetrologia
namespace AperiodicOrder.Tiling

open Obsmetrologia.Discrete
open Obsmetrologia.Closure.Collatz

/-- The finite arithmetic generating object currently available for the
zeta-star bridge: a positive Collatz seed plus the StepN phase side used by the
finite diffraction readout. -/
structure ArithmeticZetaStar (N : Nat) where
  /-- The positive Collatz seed. -/
  seed : Nat
  /-- The seed is positive, so the Collatz orbit stays inside positive naturals. -/
  seed_pos : 0 < seed
  /-- The StepN phase side: `false` is Pisot, `true` is Salem. -/
  phase : PhaseSubstitution

/-- The canonical finite zeta-star witness: seed `1` on the Pisot side. -/
def canonicalZetaStar (N : Nat) : ArithmeticZetaStar N where
  seed := 1
  seed_pos := Nat.succ_pos 0
  phase := false

/-- The canonical zeta-star witness lies on the Pisot side. -/
theorem canonicalZetaStar_pisot (N : Nat) :
    IsPisotInflation (canonicalZetaStar N).phase :=
  rfl

/-- The canonical zeta-star seed is odd. -/
theorem canonicalZetaStar_seed_odd (N : Nat) :
    (canonicalZetaStar N).seed % 2 = 1 :=
  rfl

/-- The affine trace attached to a zeta-star displacement. -/
def zetaStarTrace {N : Nat} (z : ArithmeticZetaStar N) (d : Fin (N + 1)) :
    AffineTrace :=
  traceOfWord (parityWord z.seed d.val)

/-- The zeta-star affine trace satisfies the Collatz affine-trace identity at
each finite displacement. -/
theorem zetaStarTrace_affine_identity {N : Nat} (z : ArithmeticZetaStar N)
    (d : Fin (N + 1)) :
    (zetaStarTrace z d).B * orbit z.seed d.val =
      (zetaStarTrace z d).A * z.seed + (zetaStarTrace z d).C := by
  unfold zetaStarTrace
  exact affine_trace_parityWord z.seed d.val

/-- The denominator coefficient of the zeta-star affine trace is exactly the
2-adic scale of the displacement length. -/
theorem zetaStarTrace_B_eq_two_pow {N : Nat} (z : ArithmeticZetaStar N)
    (d : Fin (N + 1)) :
    (zetaStarTrace z d).B = 2 ^ d.val := by
  unfold zetaStarTrace
  rw [trace_B_eq_two_pow_length, parityWord_length]

/-- The numerator coefficient of the zeta-star affine trace is the odd-branch
count scale. -/
theorem zetaStarTrace_A_eq_three_pow_oddCount {N : Nat}
    (z : ArithmeticZetaStar N) (d : Fin (N + 1)) :
    (zetaStarTrace z d).A =
      3 ^ oddCount (parityWord z.seed d.val) := by
  unfold zetaStarTrace
  exact trace_A_eq_three_pow_oddCount (parityWord z.seed d.val)

/-- The affine residual zero-set of `zetaStarTrace` on the finite displacement
space. -/
def zetaStarZeroSet {N : Nat} (z : ArithmeticZetaStar N) : Fin (N + 1) → Bool :=
  fun d =>
    decide
      ((zetaStarTrace z d).B * orbit z.seed d.val =
        (zetaStarTrace z d).A * z.seed + (zetaStarTrace z d).C)

/-- The zeta-star residual vanishes at every finite displacement. -/
theorem zetaStarZeroSet_eq_true {N : Nat} (z : ArithmeticZetaStar N)
    (d : Fin (N + 1)) :
    zetaStarZeroSet z d = true := by
  unfold zetaStarZeroSet zetaStarTrace
  rw [decide_eq_true_eq]
  exact zetaStarTrace_affine_identity z d

/-- The zeta-star zero-set is the whole finite displacement carrier. -/
theorem zetaStarZeroSet_eq_univ {N : Nat} (z : ArithmeticZetaStar N) :
    zetaStarZeroSet z = fun _ => true := by
  funext d
  exact zetaStarZeroSet_eq_true z d

/-- Compatibility name for the diffraction-owned finite-displacement Delone
carrier. -/
abbrev FiniteDiscreteDelone {N : Nat} (w : Fin (N + 1) → Bool) : Prop :=
  FiniteDisplacementDelone N w

/-- A full finite displacement mask is finite-discrete Delone. -/
theorem finiteDiscreteDelone_of_full {N : Nat} {w : Fin (N + 1) → Bool}
    (h : ∀ d, w d = true) : FiniteDiscreteDelone w :=
  finiteDisplacementDelone_of_full h

/-- The zeta-star zero-set is finite-displacement Delone on the finite
diffraction displacement carrier. -/
theorem zetaStarZeroSet_finiteDisplacementDelone {N : Nat}
    (z : ArithmeticZetaStar N) :
    FiniteDisplacementDelone N (zetaStarZeroSet z) :=
  finiteDisplacementDelone_of_full (zetaStarZeroSet_eq_true z)

/-- The zeta-star zero-set is finite-discrete Delone on the finite diffraction
displacement carrier. -/
theorem zetaStarZeroSet_finiteDiscreteDelone {N : Nat}
    (z : ArithmeticZetaStar N) :
    FiniteDiscreteDelone (zetaStarZeroSet z) :=
  zetaStarZeroSet_finiteDisplacementDelone z

/-- The zeta-star zero-set has total finite diffraction mass `N + 1`. -/
theorem zetaStar_finiteDiffractionMass_univ {N : Nat}
    (z : ArithmeticZetaStar N) :
    finiteDiffractionMass N (zetaStarZeroSet z) Set.univ = N + 1 :=
  finiteDiffractionMass_univ N (zetaStarZeroSet z)

/-- The finite Fourier-side readout of the zeta-star zero-set. -/
def zetaStarFiniteDiffractionReadout {N : Nat} (z : ArithmeticZetaStar N) :
    FiniteFourierDualReadout N (zetaStarZeroSet z) :=
  finiteFourierDualReadout N (zetaStarZeroSet z) z.phase

/-- The zeta-star finite readout atom is the finite diffraction mass of its
zero-set, and is positive. -/
theorem zetaStarFiniteDiffractionReadout_mass {N : Nat}
    (z : ArithmeticZetaStar N) :
    (zetaStarFiniteDiffractionReadout z).atomMass =
        finiteDiffractionMass N (zetaStarZeroSet z) Set.univ ∧
      0 < (zetaStarFiniteDiffractionReadout z).atomMass :=
  finiteFourierDualReadout_mass N (zetaStarZeroSet z) z.phase

/-- The zeta-star phase type is the existing finite predictor-level phase map
read on its StepN side. -/
def zetaStarPhaseType {N : Nat} (z : ArithmeticZetaStar N) : Regime :=
  phaseType z.phase

/-- The concrete primitive substitution matrix retained by the finite zeta-star
bridge. This is the Fibonacci abelianization already proved primitive in the
StepN substitution spine. -/
def zetaStarSubstitutionMatrix {N : Nat} (_z : ArithmeticZetaStar N) :
    Universality.Mat 2 :=
  StepN.fibonacciMatrix

/-- The retained zeta-star substitution matrix is primitive: the integer
Perron--Frobenius precondition available in the corpus core. -/
theorem zetaStarSubstitutionMatrix_primitive {N : Nat}
    (z : ArithmeticZetaStar N) :
    StepN.Primitive (zetaStarSubstitutionMatrix z) :=
  StepN.fibonacciMatrix_primitive

/-- The retained zeta-star substitution matrix is annihilated by the Fibonacci
characteristic polynomial. -/
theorem zetaStarSubstitutionMatrix_cayleyHamilton {N : Nat}
    (z : ArithmeticZetaStar N) :
    StepN.evalMatPoly StepN.charPolyFib (zetaStarSubstitutionMatrix z) =
      (StepN.matZero : Universality.Mat 2) :=
  StepN.cayleyHamilton_fibonacci

/-- The zeta-star seed inherits the two-adic shortcut witness when it begins on
the odd branch. -/
theorem zetaStar_shortcut_odd_part {N : Nat} (z : ArithmeticZetaStar N)
    (hodd : z.seed % 2 = 1) :
    ∃ k m, 1 ≤ k ∧ m % 2 = 1 ∧ 3 * z.seed + 1 = 2 ^ k * m :=
  shortcut_odd_part hodd

/-- On an odd seed, the zeta-star Collatz shortcut is witnessed by the 2-adic
valuation scale: the extracted power of two divides `3 * seed + 1`, hence lies
below its `twoAdicVal`. -/
theorem zetaStar_shortcut_twoAdicValuation {N : Nat}
    (z : ArithmeticZetaStar N) (hodd : z.seed % 2 = 1) :
    ∃ k m, 1 ≤ k ∧ m % 2 = 1 ∧ 3 * z.seed + 1 = 2 ^ k * m ∧
      twoAdicVal (2 ^ k) = k ∧ k ≤ twoAdicVal (3 * z.seed + 1) := by
  obtain ⟨k, m, hk, hm, hfac⟩ := zetaStar_shortcut_odd_part z hodd
  refine ⟨k, m, hk, hm, hfac, twoAdicVal_two_pow k, ?_⟩
  have hpos : 0 < 3 * z.seed + 1 := Nat.succ_pos (3 * z.seed)
  exact (dvd_two_pow_iff_le_twoAdicVal (3 * z.seed + 1) hpos k).mp
    ⟨m, hfac⟩

/-- The canonical zeta-star witness carries the odd-seed 2-adic shortcut
valuation without any extra hypothesis. -/
theorem canonicalZetaStar_shortcut_twoAdicValuation (N : Nat) :
    ∃ k m, 1 ≤ k ∧ m % 2 = 1 ∧
      3 * (canonicalZetaStar N).seed + 1 = 2 ^ k * m ∧
        twoAdicVal (2 ^ k) = k ∧
          k ≤ twoAdicVal (3 * (canonicalZetaStar N).seed + 1) :=
  zetaStar_shortcut_twoAdicValuation
    (canonicalZetaStar N) (canonicalZetaStar_seed_odd N)

/-- The zeta-star finite diffraction readout is pure-point exactly on the Pisot
side of its StepN phase. -/
theorem zetaStar_phase_purePoint_iff_pisot {N : Nat}
    (z : ArithmeticZetaStar N) :
    finiteFourierDualKind z.phase = FiniteDiffractionKind.purePoint ↔
      IsPisotInflation z.phase :=
  finiteFourierDualKind_purePoint_iff_pisot z.phase

/-- The finite readout component of the zeta-star zero-set is pure-point exactly
on the Pisot side. -/
theorem zetaStarFiniteDiffractionReadout_component_purePoint_iff_pisot {N : Nat}
    (z : ArithmeticZetaStar N) :
    (zetaStarFiniteDiffractionReadout z).component =
        FiniteDiffractionKind.purePoint ↔
      IsPisotInflation z.phase := by
  change finiteFourierDualKind z.phase = FiniteDiffractionKind.purePoint ↔
    IsPisotInflation z.phase
  exact zetaStar_phase_purePoint_iff_pisot z

/-- On the Pisot side, the finite diffraction mass of the zeta-star zero-set is
read as a positive pure-point atom. -/
theorem zetaStar_finiteDiffractionMass_purePoint_of_pisot {N : Nat}
    (z : ArithmeticZetaStar N) (h : IsPisotInflation z.phase) :
    (zetaStarFiniteDiffractionReadout z).component =
        FiniteDiffractionKind.purePoint ∧
      (zetaStarFiniteDiffractionReadout z).atomMass =
        finiteDiffractionMass N (zetaStarZeroSet z) Set.univ ∧
      0 < (zetaStarFiniteDiffractionReadout z).atomMass := by
  exact ⟨(zetaStarFiniteDiffractionReadout_component_purePoint_iff_pisot z).mpr h,
    (zetaStarFiniteDiffractionReadout_mass z).1,
    (zetaStarFiniteDiffractionReadout_mass z).2⟩

/-- The zeta-star finite readout agrees with the corpus's finite predictor-level
`phaseType` map. -/
theorem zetaStar_phaseType_readout {N : Nat} (z : ArithmeticZetaStar N) :
    lebesgueType (zetaStarFiniteDiffractionReadout z).component =
      zetaStarPhaseType z := by
  change lebesgueType (phaseDiffractionComponent z.phase) = phaseType z.phase
  exact (phaseType_readings_agree z.phase).1

/-- The zeta-star finite phase lies in the corpus's bigraded trichotomy. -/
theorem zetaStar_phaseType_trichotomy {N : Nat} (z : ArithmeticZetaStar N) :
    zetaStarPhaseType z = Regime.consistent ∨
      zetaStarPhaseType z = Regime.paraconsistent ∨
        zetaStarPhaseType z = Regime.mixed := by
  unfold zetaStarPhaseType
  exact phaseType_nontrivial z.phase

/-- The zeta-star phase type is consistent exactly on the Pisot side. -/
theorem zetaStar_phaseType_consistent_iff_pisot {N : Nat}
    (z : ArithmeticZetaStar N) :
    zetaStarPhaseType z = Regime.consistent ↔ IsPisotInflation z.phase := by
  unfold zetaStarPhaseType phaseType phaseTruthContent phaseInconsistencyContent
    IsPisotInflation
  cases z.phase <;> simp [regimeOf]

/-- For zeta-star, finite pure-point readout is the same as consistent
`phaseType`. -/
theorem zetaStar_readout_purePoint_iff_phaseType_consistent {N : Nat}
    (z : ArithmeticZetaStar N) :
    (zetaStarFiniteDiffractionReadout z).component =
        FiniteDiffractionKind.purePoint ↔
      zetaStarPhaseType z = Regime.consistent := by
  constructor
  · intro h
    exact (zetaStar_phaseType_consistent_iff_pisot z).mpr
      ((zetaStarFiniteDiffractionReadout_component_purePoint_iff_pisot z).mp h)
  · intro h
    exact (zetaStarFiniteDiffractionReadout_component_purePoint_iff_pisot z).mpr
      ((zetaStar_phaseType_consistent_iff_pisot z).mp h)

/-- On the Pisot side, the zeta-star zero-set is a finite pure-point
quasicrystal surrogate in the diffraction module's finite sense. -/
theorem zetaStar_finitePurePointQuasicrystal_of_pisot {N : Nat}
    (z : ArithmeticZetaStar N) (h : IsPisotInflation z.phase) :
    FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase :=
  finitePurePointQuasicrystal_of_pisot
    (zetaStarZeroSet_finiteDisplacementDelone z) h

/-- The canonical zeta-star finite phase is the consistent face. -/
theorem canonicalZetaStar_phaseType_consistent (N : Nat) :
    zetaStarPhaseType (canonicalZetaStar N) = Regime.consistent :=
  (zetaStar_phaseType_consistent_iff_pisot (canonicalZetaStar N)).mpr
    (canonicalZetaStar_pisot N)

/-- The canonical zeta-star zero-set has pure-point finite diffraction readout. -/
theorem canonicalZetaStar_finiteDiffractionMass_purePoint (N : Nat) :
    (zetaStarFiniteDiffractionReadout (canonicalZetaStar N)).component =
        FiniteDiffractionKind.purePoint ∧
      (zetaStarFiniteDiffractionReadout (canonicalZetaStar N)).atomMass =
        finiteDiffractionMass N
          (zetaStarZeroSet (canonicalZetaStar N)) Set.univ ∧
      0 < (zetaStarFiniteDiffractionReadout (canonicalZetaStar N)).atomMass :=
  zetaStar_finiteDiffractionMass_purePoint_of_pisot
    (canonicalZetaStar N) (canonicalZetaStar_pisot N)

/-- The canonical zeta-star zero-set is a finite pure-point quasicrystal
surrogate. -/
theorem canonicalZetaStar_finitePurePointQuasicrystal (N : Nat) :
    FinitePurePointQuasicrystal N
      (zetaStarZeroSet (canonicalZetaStar N)) (canonicalZetaStar N).phase :=
  zetaStar_finitePurePointQuasicrystal_of_pisot
    (canonicalZetaStar N) (canonicalZetaStar_pisot N)

/-- The finite arithmetic-settling certificate carried by zeta-star: affine
zeros, finite-discrete Delone support, finite diffraction mass, 2-adic shortcut
valuation, primitive substitution matrix data, and the finite phase readout. -/
structure ZetaStarArithmeticSettlingCertificate {N : Nat}
    (z : ArithmeticZetaStar N) : Prop where
  /-- The affine-trace identity holds at every finite displacement. -/
  affineTraceIdentity :
    ∀ d : Fin (N + 1),
      (zetaStarTrace z d).B * orbit z.seed d.val =
        (zetaStarTrace z d).A * z.seed + (zetaStarTrace z d).C
  /-- The affine-trace denominator coefficient is the displacement's power of
  two. -/
  traceDenominator :
    ∀ d : Fin (N + 1), (zetaStarTrace z d).B = 2 ^ d.val
  /-- The affine-trace residual zero-set fills the finite displacement carrier. -/
  affineZeros : zetaStarZeroSet z = fun _ => true
  /-- The finite zero-set is finite-discrete Delone. -/
  finiteDelone : FiniteDisplacementDelone N (zetaStarZeroSet z)
  /-- The zero-set has total finite diffraction mass. -/
  finiteMass : finiteDiffractionMass N (zetaStarZeroSet z) Set.univ = N + 1
  /-- Odd seeds carry the 2-adic shortcut valuation witness. -/
  shortcutValuation :
    z.seed % 2 = 1 →
      ∃ k m, 1 ≤ k ∧ m % 2 = 1 ∧ 3 * z.seed + 1 = 2 ^ k * m ∧
        twoAdicVal (2 ^ k) = k ∧ k ≤ twoAdicVal (3 * z.seed + 1)
  /-- The retained substitution matrix is primitive. -/
  substitutionPrimitive : StepN.Primitive (zetaStarSubstitutionMatrix z)
  /-- The retained substitution matrix satisfies its characteristic polynomial. -/
  substitutionPolynomial :
    StepN.evalMatPoly StepN.charPolyFib (zetaStarSubstitutionMatrix z) =
      (StepN.matZero : Universality.Mat 2)
  /-- The finite readout agrees with the existing `phaseType` map. -/
  phaseTypeReadout :
    lebesgueType (zetaStarFiniteDiffractionReadout z).component =
      zetaStarPhaseType z
  /-- The finite phase lands in the bigraded trichotomy. -/
  phaseTypeTrichotomy :
    zetaStarPhaseType z = Regime.consistent ∨
      zetaStarPhaseType z = Regime.paraconsistent ∨
        zetaStarPhaseType z = Regime.mixed
  /-- Finite pure-point readout is exactly the consistent/Pisot phase. -/
  purePointConsistent :
    (zetaStarFiniteDiffractionReadout z).component =
        FiniteDiffractionKind.purePoint ↔
      zetaStarPhaseType z = Regime.consistent
  /-- On the Pisot side, the zero-set is a finite pure-point quasicrystal
  surrogate in the diffraction module's finite sense. -/
  finiteQuasicrystal :
    IsPisotInflation z.phase →
      FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase

/-- Zeta-star carries the finite arithmetic-settling certificate. -/
theorem zetaStar_arithmeticSettling_certificate {N : Nat}
    (z : ArithmeticZetaStar N) :
    ZetaStarArithmeticSettlingCertificate z where
  affineTraceIdentity := zetaStarTrace_affine_identity z
  traceDenominator := zetaStarTrace_B_eq_two_pow z
  affineZeros := zetaStarZeroSet_eq_univ z
  finiteDelone := zetaStarZeroSet_finiteDiscreteDelone z
  finiteMass := zetaStar_finiteDiffractionMass_univ z
  shortcutValuation := zetaStar_shortcut_twoAdicValuation z
  substitutionPrimitive := zetaStarSubstitutionMatrix_primitive z
  substitutionPolynomial := zetaStarSubstitutionMatrix_cayleyHamilton z
  phaseTypeReadout := zetaStar_phaseType_readout z
  phaseTypeTrichotomy := zetaStar_phaseType_trichotomy z
  purePointConsistent := zetaStar_readout_purePoint_iff_phaseType_consistent z
  finiteQuasicrystal := zetaStar_finitePurePointQuasicrystal_of_pisot z

/-- In every finite displacement window there exists a concrete zeta-star
witness carrying the arithmetic-settling certificate and finite pure-point
quasicrystal surrogate. -/
theorem exists_zetaStar_finitePurePointQuasicrystal (N : Nat) :
    ∃ z : ArithmeticZetaStar N,
      ZetaStarArithmeticSettlingCertificate z ∧
        IsPisotInflation z.phase ∧
          FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase := by
  refine ⟨canonicalZetaStar N, zetaStar_arithmeticSettling_certificate _,
    canonicalZetaStar_pisot N, ?_⟩
  exact zetaStar_finitePurePointQuasicrystal_of_pisot
    (canonicalZetaStar N) (canonicalZetaStar_pisot N)

/-- In every finite displacement window there exists a concrete zeta-star
witness whose finite diffraction mass readout is pure-point. -/
theorem exists_zetaStar_finiteDiffractionMass_purePoint (N : Nat) :
    ∃ z : ArithmeticZetaStar N,
      ZetaStarArithmeticSettlingCertificate z ∧
        zetaStarPhaseType z = Regime.consistent ∧
          (zetaStarFiniteDiffractionReadout z).component =
              FiniteDiffractionKind.purePoint ∧
            (zetaStarFiniteDiffractionReadout z).atomMass =
              finiteDiffractionMass N (zetaStarZeroSet z) Set.univ ∧
              0 < (zetaStarFiniteDiffractionReadout z).atomMass := by
  exact ⟨canonicalZetaStar N, zetaStar_arithmeticSettling_certificate _,
    canonicalZetaStar_phaseType_consistent N,
    (canonicalZetaStar_finiteDiffractionMass_purePoint N).1,
    (canonicalZetaStar_finiteDiffractionMass_purePoint N).2.1,
    (canonicalZetaStar_finiteDiffractionMass_purePoint N).2.2⟩

/-! ## The single finite quasicrystal form -/

/-- The single finite zeta-star diffraction form. It packages the
arithmetic-settling certificate, finite Delone zero-set,
finite diffraction mass, pure-point readout, consistent phase, and finite
pure-point quasicrystal carrier. -/
structure ZetaStarFiniteDysonQuasicrystalForm {N : Nat}
    (z : ArithmeticZetaStar N) : Prop where
  /-- The arithmetic-settling certificate over affine traces, 2-adics, and
  substitution primitivity. -/
  certificate : ZetaStarArithmeticSettlingCertificate z
  /-- The zero-set is Delone in the finite displacement carrier. -/
  finiteDelone : FiniteDisplacementDelone N (zetaStarZeroSet z)
  /-- The zero-set has total finite diffraction mass. -/
  finiteMass : finiteDiffractionMass N (zetaStarZeroSet z) Set.univ = N + 1
  /-- The zeta-star phase lies in the bigraded trichotomy. -/
  phaseTrichotomy :
    zetaStarPhaseType z = Regime.consistent ∨
      zetaStarPhaseType z = Regime.paraconsistent ∨
        zetaStarPhaseType z = Regime.mixed
  /-- The zeta-star phase is the consistent/Pisot face. -/
  phaseConsistent : zetaStarPhaseType z = Regime.consistent
  /-- The finite Fourier-side component is pure-point. -/
  purePointReadout :
    (zetaStarFiniteDiffractionReadout z).component =
      FiniteDiffractionKind.purePoint
  /-- The readout atom is exactly the finite diffraction mass of the zero-set. -/
  atomMass :
    (zetaStarFiniteDiffractionReadout z).atomMass =
      finiteDiffractionMass N (zetaStarZeroSet z) Set.univ
  /-- The finite readout atom is positive. -/
  atomPositive : 0 < (zetaStarFiniteDiffractionReadout z).atomMass
  /-- The zero-set is a finite pure-point quasicrystal surrogate. -/
  finiteQuasicrystal :
    FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase

/-- The canonical zeta-star witness carries the single finite diffraction form. -/
theorem canonicalZetaStar_finiteDysonQuasicrystalForm (N : Nat) :
    ZetaStarFiniteDysonQuasicrystalForm (canonicalZetaStar N) where
  certificate := zetaStar_arithmeticSettling_certificate _
  finiteDelone := zetaStarZeroSet_finiteDisplacementDelone _
  finiteMass := zetaStar_finiteDiffractionMass_univ _
  phaseTrichotomy := zetaStar_phaseType_trichotomy _
  phaseConsistent := canonicalZetaStar_phaseType_consistent N
  purePointReadout := (canonicalZetaStar_finiteDiffractionMass_purePoint N).1
  atomMass := (canonicalZetaStar_finiteDiffractionMass_purePoint N).2.1
  atomPositive := (canonicalZetaStar_finiteDiffractionMass_purePoint N).2.2
  finiteQuasicrystal := canonicalZetaStar_finitePurePointQuasicrystal N

/-- In every finite displacement window there exists a zeta-star witness carrying
the single finite diffraction form. -/
theorem exists_zetaStar_finiteDysonQuasicrystalForm (N : Nat) :
    ∃ z : ArithmeticZetaStar N,
      ZetaStarFiniteDysonQuasicrystalForm z :=
  ⟨canonicalZetaStar N, canonicalZetaStar_finiteDysonQuasicrystalForm N⟩

/-! ## Finite observed displacement coalgebra -/

/-- The finite diffraction observation carried by a zeta-star displacement
state. This is the analytic readout that the bare settled-value coalgebra was
forgetting: zero-set, finite mass, finite Fourier component, and phase type. -/
structure ZetaStarDisplacementReadout (N : Nat) where
  /-- The observed affine-trace zero-set on the finite displacement carrier. -/
  zeroSet : Fin (N + 1) → Bool
  /-- The total finite diffraction mass of the observed zero-set. -/
  mass : Nat
  /-- The finite Fourier-side component. -/
  component : FiniteDiffractionKind
  /-- The corpus phase readout attached to the finite component. -/
  phase : Regime

/-- The finite displacement readout of a zeta-star state. -/
def zetaStarDisplacementReadout {N : Nat}
    (z : ArithmeticZetaStar N) : ZetaStarDisplacementReadout N where
  zeroSet := zetaStarZeroSet z
  mass := finiteDiffractionMass N (zetaStarZeroSet z) Set.univ
  component := (zetaStarFiniteDiffractionReadout z).component
  phase := zetaStarPhaseType z

/-- The zeta-star displacement readout carries exactly the finite observation
proved earlier: full zero-set, total finite mass, phase agreement, and pure
point iff consistent/Pisot. -/
theorem zetaStarDisplacementReadout_evidence {N : Nat}
    (z : ArithmeticZetaStar N) :
    (zetaStarDisplacementReadout z).zeroSet = zetaStarZeroSet z ∧
      FiniteDisplacementDelone N (zetaStarDisplacementReadout z).zeroSet ∧
      (zetaStarDisplacementReadout z).mass = N + 1 ∧
      lebesgueType (zetaStarDisplacementReadout z).component =
        (zetaStarDisplacementReadout z).phase ∧
      ((zetaStarDisplacementReadout z).component =
          FiniteDiffractionKind.purePoint ↔
        (zetaStarDisplacementReadout z).phase = Regime.consistent) ∧
      ((zetaStarDisplacementReadout z).component =
          FiniteDiffractionKind.purePoint ↔
        IsPisotInflation z.phase) := by
  constructor
  · rfl
  constructor
  · exact zetaStarZeroSet_finiteDisplacementDelone z
  constructor
  · exact zetaStar_finiteDiffractionMass_univ z
  constructor
  · exact zetaStar_phaseType_readout z
  constructor
  · exact zetaStar_readout_purePoint_iff_phaseType_consistent z
  · exact zetaStarFiniteDiffractionReadout_component_purePoint_iff_pisot z

/-- A finite zeta-star displacement coalgebra with an explicit observation
layer. The carrier unfolds by `step`, and the observation is required to be the
zeta-star displacement readout and to be stable under that unfold step. -/
structure ZetaStarDisplacementCoalgebra (N : Nat) where
  /-- The state carrier. -/
  carrier : Type
  /-- Each state names a zeta-star arithmetic generator. -/
  state : carrier → ArithmeticZetaStar N
  /-- The coalgebra unfold step on states. -/
  step : carrier → carrier
  /-- The observed finite diffraction readout. -/
  observe : carrier → ZetaStarDisplacementReadout N
  /-- The observation is the zeta-star displacement readout of the state. -/
  observe_eq : ∀ x, observe x = zetaStarDisplacementReadout (state x)
  /-- The unfold step carries the observation. -/
  observe_step : ∀ x, observe (step x) = observe x

/-- The finite zeta-star displacement coalgebra.
Its carrier is the finite zeta-star state space and its unfold step is the
idempotent finite observation step. This is not yet the analytic displacement
coalgebra. -/
def canonicalZetaStarDisplacementCoalgebra (N : Nat) :
    ZetaStarDisplacementCoalgebra N where
  carrier := ArithmeticZetaStar N
  state := id
  step := id
  observe := zetaStarDisplacementReadout
  observe_eq := fun _ => rfl
  observe_step := fun _ => rfl

/-- Any state of a zeta-star displacement coalgebra carries the finite Delone
zero-set observation. -/
theorem zetaStarDisplacementCoalgebra_finiteDelone {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x : C.carrier) :
    FiniteDisplacementDelone N (C.observe x).zeroSet := by
  rw [C.observe_eq x]
  exact (zetaStarDisplacementReadout_evidence (C.state x)).2.1

/-- Any state of a zeta-star displacement coalgebra carries total finite
diffraction mass. -/
theorem zetaStarDisplacementCoalgebra_mass {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x : C.carrier) :
    (C.observe x).mass = N + 1 := by
  rw [C.observe_eq x]
  exact (zetaStarDisplacementReadout_evidence (C.state x)).2.2.1

/-- The coalgebra unfold step preserves the finite diffraction observation. -/
theorem zetaStarDisplacementCoalgebra_observe_step {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x : C.carrier) :
    C.observe (C.step x) = C.observe x :=
  C.observe_step x

/-- The finite orbit of a zeta-star displacement coalgebra. -/
def zetaStarDisplacementCoalgebraOrbit {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) : Nat → C.carrier → C.carrier
  | 0, x => x
  | n + 1, x => C.step (zetaStarDisplacementCoalgebraOrbit C n x)

/-- Observational equivalence in a zeta-star displacement coalgebra. -/
def ZetaStarDisplacementObservedEq {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x y : C.carrier) : Prop :=
  C.observe x = C.observe y

/-- The finite coalgebra step is compatible with observational equivalence. -/
theorem zetaStarDisplacementObservedEq_step {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) {x y : C.carrier}
    (h : ZetaStarDisplacementObservedEq C x y) :
    ZetaStarDisplacementObservedEq C (C.step x) (C.step y) := by
  unfold ZetaStarDisplacementObservedEq at *
  rw [C.observe_step x, C.observe_step y]
  exact h

/-- The finite zeta-star displacement coalgebra carries its observation along
every orbit stage. -/
theorem zetaStarDisplacementCoalgebra_observe_orbit {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x : C.carrier) :
    ∀ n, C.observe (zetaStarDisplacementCoalgebraOrbit C n x) =
      C.observe x := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
      simp [zetaStarDisplacementCoalgebraOrbit, C.observe_step, ih]

/-- Observational equivalence is preserved along the finite coalgebra orbit. -/
theorem zetaStarDisplacementObservedEq_orbit {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) {x y : C.carrier}
    (h : ZetaStarDisplacementObservedEq C x y) :
    ∀ n, ZetaStarDisplacementObservedEq C
      (zetaStarDisplacementCoalgebraOrbit C n x)
      (zetaStarDisplacementCoalgebraOrbit C n y) := by
  intro n
  unfold ZetaStarDisplacementObservedEq at *
  rw [zetaStarDisplacementCoalgebra_observe_orbit C x n,
    zetaStarDisplacementCoalgebra_observe_orbit C y n]
  exact h

/-- The observed component is pure-point exactly on the Pisot side of the
underlying zeta-star state. -/
theorem zetaStarDisplacementCoalgebra_purePoint_iff_pisot {N : Nat}
    (C : ZetaStarDisplacementCoalgebra N) (x : C.carrier) :
    (C.observe x).component = FiniteDiffractionKind.purePoint ↔
      IsPisotInflation (C.state x).phase := by
  rw [C.observe_eq x]
  exact (zetaStarDisplacementReadout_evidence (C.state x)).2.2.2.2.2

/-- The canonical finite displacement coalgebra has a pure-point observation at
the canonical zeta-star state. -/
theorem canonicalZetaStarDisplacementCoalgebra_purePoint (N : Nat) :
    ((canonicalZetaStarDisplacementCoalgebra N).observe
        (canonicalZetaStar N)).component =
      FiniteDiffractionKind.purePoint := by
  exact (canonicalZetaStar_finiteDiffractionMass_purePoint N).1

/-- The canonical finite displacement coalgebra carries the finite pure-point
quasicrystal witness at its canonical state. -/
theorem canonicalZetaStarDisplacementCoalgebra_quasicrystal (N : Nat) :
    FinitePurePointQuasicrystal N
      ((canonicalZetaStarDisplacementCoalgebra N).observe
        (canonicalZetaStar N)).zeroSet
      (canonicalZetaStar N).phase := by
  change FinitePurePointQuasicrystal N
    (zetaStarZeroSet (canonicalZetaStar N))
    (canonicalZetaStar N).phase
  exact canonicalZetaStar_finitePurePointQuasicrystal N

/-! ## Coalgebraic promotion apparatus -/

/-- The already-proved metallization split, read here as the
algebra/coalgebra boundary: metallic powers close by a finite recurrence, while
the chromatic/exponential side is non-idempotent and limit-settled. -/
def MetallizationAlgebraCoalgebraBoundary : Prop :=
  (∀ (n k : Nat),
    StepN.zpow (StepN.metallicZ n) k =
      (StepN.coef n k).1 * StepN.metallicZ n + (StepN.coef n k).2) ∧
    (ChromaticLorentzian.step
        (ChromaticLorentzian.step ChromaticLorentzian.mark0) ≠
      ChromaticLorentzian.step ChromaticLorentzian.mark0) ∧
      (∀ (N M : Nat), 1 ≤ N →
        Obsmetrologia.Real.Internal.expSeq (N + M) ≤
          Obsmetrologia.Real.Internal.expSeq N +
            (Obsmetrologia.Real.Internal.expTerm N +
              Obsmetrologia.Real.Internal.expTerm N))

/-- The metallization dichotomy is the algebra/coalgebra boundary needed by the
zeta-star promotion story. This is a renaming and packaging of the existing
theorem, not a new analytic conclusion. -/
theorem metallization_algebraCoalgebraBoundary :
    MetallizationAlgebraCoalgebraBoundary :=
  metallization_dichotomy

/-- The apparatus currently available for the coalgebraic promotion of the
finite zeta-star form: the bundled finite form, finite directed-join
attainment, finite Scott-continuity, the metallization boundary,
algebra/coalgebra duality for settling orbits, and up-to-closure coinductive
classification. This packages the machinery; it does not instantiate an
analytic displacement coalgebra. -/
structure ZetaStarCoalgebraicPromotionApparatus : Prop where
  /-- Every finite displacement window has the bundled zeta-star finite
  diffraction form. -/
  finiteForm :
    ∀ N : Nat, ∃ z : ArithmeticZetaStar N,
      ZetaStarFiniteDysonQuasicrystalForm z
  /-- The metallization dichotomy is the finite algebra / limit coalgebra
  boundary. -/
  metallizationBoundary : MetallizationAlgebraCoalgebraBoundary
  /-- Finite directed joins are attained by a member. -/
  directedJoinAttained :
    ∀ S : Obsmetrologia.Closure.Scott.DirectedFamily,
      S.sup ∈ S.elems
  /-- Every finite charge closure is Scott-continuous. -/
  finiteScottContinuous :
    ∀ c : Charge.Closure,
      Obsmetrologia.Closure.Scott.IsScottContinuous c
  /-- Settling already has the algebra/coalgebra duality package. -/
  algebraCoalgebraDual :
    ∀ (M : Valuation.ModalFrame) (E : Valuation),
      (∀ {m n : Nat}, m ≤ n → (M.orbit E m).leK (M.orbit E n)) ∧
        (∀ (μ σ : Nat), σ < μ →
          (Obsmetrologia.Coalgebra.coalgebraOrbit M E σ).leK
            (Obsmetrologia.Coalgebra.coalgebraOrbitLimit M E μ)) ∧
          (∀ (μ : Nat) (w : Valuation),
            (∀ (σ : Nat), σ < μ →
              (Obsmetrologia.Coalgebra.coalgebraOrbit M E σ).leK w) →
              (Obsmetrologia.Coalgebra.coalgebraOrbitLimit M E μ).leK w) ∧
            (M.ClAlgebraStructure E →
              (M.closureOp E).leK E ∧
                E.leK (Obsmetrologia.Coalgebra.settlingEndofunctor M
                  Valuation.knowledgeLeast E)) ∧
              (M.Quiescent E →
                Obsmetrologia.Coalgebra.settlingEndofunctor M
                  Valuation.knowledgeLeast E = E)
  /-- Up-to-closure coinduction classifies geometric MLD by settled equality. -/
  upToClosureClassification :
    ∀ M : Valuation.ModalFrame,
      (∀ E : Valuation, AperiodicOrder.Tiling.UpTo.GeoMld M E E) ∧
        (∀ E E' : Valuation,
          AperiodicOrder.Tiling.UpTo.GeoMld M E E' →
            AperiodicOrder.Tiling.UpTo.GeoMld M E' E) ∧
          (∀ E E' E'' : Valuation,
            AperiodicOrder.Tiling.UpTo.GeoMld M E E' →
              AperiodicOrder.Tiling.UpTo.GeoMld M E' E'' →
                AperiodicOrder.Tiling.UpTo.GeoMld M E E'') ∧
            ∀ E E' : Valuation,
            AperiodicOrder.Tiling.UpTo.GeoMld M E E' ↔
                M.settle E = M.settle E'
  /-- Observed up-to-closure coinduction preserves any analytic observation
  carried by the relation. This is the recovered richness missing from the bare
  settled-value kernel. -/
  observedCoinduction :
    ∀ {α : Type} (observe : Valuation → α) (M : Valuation.ModalFrame)
      {R : Valuation → Valuation → Prop} {E E' : Valuation},
      AperiodicOrder.Tiling.UpTo.ObservedBisimUTC M observe R →
        R E E' →
          AperiodicOrder.Tiling.UpTo.ObservedBisim M observe E E'
  /-- The observed carrier forgets to the ordinary geometric MLD carrier. -/
  observedForgets :
    ∀ {α : Type} (observe : Valuation → α) (M : Valuation.ModalFrame)
      {E E' : Valuation},
      AperiodicOrder.Tiling.UpTo.ObservedGeoMld M observe E E' →
        AperiodicOrder.Tiling.UpTo.GeoMld M E E'

/-- The current corpus already supplies the finite zeta-star form and the
Scott/coinductive promotion apparatus around it. The remaining frontier is the
instantiation of this apparatus as the zeta-star displacement coalgebra. -/
theorem zetaStar_coalgebraicPromotion_apparatus :
    ZetaStarCoalgebraicPromotionApparatus where
  finiteForm := exists_zetaStar_finiteDysonQuasicrystalForm
  metallizationBoundary := metallization_algebraCoalgebraBoundary
  directedJoinAttained := Obsmetrologia.Closure.Scott.DirectedFamily.sup_mem
  finiteScottContinuous := Obsmetrologia.Closure.Scott.finite_scott_continuous
  algebraCoalgebraDual := Obsmetrologia.Coalgebra.coalgebra_dual_of_algebra
  upToClosureClassification := AperiodicOrder.Tiling.UpTo.crossBase_classification
  observedCoinduction := fun {_α} observe M {R} {E} {E'} hR h =>
    AperiodicOrder.Tiling.UpTo.observedBisimUTC_sound
      (M := M) (observe := observe) (R := R) (E := E) (E' := E') hR h
  observedForgets := fun {_α} observe M {E} {E'} h =>
    AperiodicOrder.Tiling.UpTo.observedGeoMld_to_geoMld
      (M := M) (observe := observe) (E := E) (E' := E') h

/-- The algebra/coalgebra boundary for zeta-star, stated as a single receipt:
finite windows have the initial-algebra-style zeta-star form, the
metallization dichotomy identifies the finite/limit boundary, and the existing
Scott/coinductive apparatus supplies the coalgebraic promotion machinery. -/
structure ZetaStarAlgebraCoalgebraBoundary : Prop where
  /-- Every finite displacement window has the bundled zeta-star finite
  diffraction form. -/
  finiteAlgebraForms :
    ∀ N : Nat, ∃ z : ArithmeticZetaStar N,
      ZetaStarFiniteDysonQuasicrystalForm z
  /-- The already-proved metallization split is the boundary certificate. -/
  metallizationBoundary : MetallizationAlgebraCoalgebraBoundary
  /-- The coalgebraic side is the existing Scott/coinductive apparatus. -/
  coalgebraicPromotion : ZetaStarCoalgebraicPromotionApparatus
  /-- The Scott bridge: finite charge closures preserve directed joins. -/
  scottBridge :
    ∀ c : Charge.Closure,
      Obsmetrologia.Closure.Scott.IsScottContinuous c

/-- The corpus already proves the finite algebra / analytic coalgebra boundary
needed around zeta-star. What remains open is not the boundary itself, but the
construction of the zeta-star displacement coalgebra and its analytic
diffraction theorem. -/
theorem zetaStar_algebraCoalgebraBoundary :
    ZetaStarAlgebraCoalgebraBoundary where
  finiteAlgebraForms :=
    zetaStar_coalgebraicPromotion_apparatus.finiteForm
  metallizationBoundary :=
    zetaStar_coalgebraicPromotion_apparatus.metallizationBoundary
  coalgebraicPromotion := zetaStar_coalgebraicPromotion_apparatus
  scottBridge :=
    zetaStar_coalgebraicPromotion_apparatus.finiteScottContinuous

/-- The recovered analytic-richness interface around zeta-star. The existing
coalgebraic apparatus can preserve analytic data once that data is presented as
an observation and the up-to-closure relation is proved to carry it. The
remaining gap is exactly the construction of the zeta-star diffraction
observation and its observed-closure compatibility. -/
structure ZetaStarAnalyticRichnessRecovery where
  /-- The finite algebra / analytic coalgebra boundary is already named. -/
  boundary : ZetaStarAlgebraCoalgebraBoundary
  /-- Every finite displacement window has the observed zeta-star displacement
  coalgebra. -/
  finiteDisplacementCoalgebra :
    ∀ N : Nat, ZetaStarDisplacementCoalgebra N
  /-- The finite displacement coalgebra carries Delone observations. -/
  finiteDisplacementDelone :
    ∀ (N : Nat) (x : (finiteDisplacementCoalgebra N).carrier),
      FiniteDisplacementDelone N
        ((finiteDisplacementCoalgebra N).observe x).zeroSet
  /-- The finite displacement coalgebra carries the total finite diffraction
  mass observation. -/
  finiteDisplacementMass :
    ∀ (N : Nat) (x : (finiteDisplacementCoalgebra N).carrier),
      ((finiteDisplacementCoalgebra N).observe x).mass = N + 1
  /-- The finite displacement coalgebra carries its observation through the
  unfold step. -/
  finiteObservationStep :
    ∀ (N : Nat) (x : (finiteDisplacementCoalgebra N).carrier),
      (finiteDisplacementCoalgebra N).observe
          ((finiteDisplacementCoalgebra N).step x) =
        (finiteDisplacementCoalgebra N).observe x
  /-- Observational equivalence in the finite displacement coalgebra is
  compatible with its unfold step. -/
  finiteObservedStepCompatibility :
    ∀ (N : Nat) {x y : (finiteDisplacementCoalgebra N).carrier},
      ZetaStarDisplacementObservedEq (finiteDisplacementCoalgebra N) x y →
        ZetaStarDisplacementObservedEq (finiteDisplacementCoalgebra N)
          ((finiteDisplacementCoalgebra N).step x)
          ((finiteDisplacementCoalgebra N).step y)
  /-- Observational equivalence is preserved along every finite orbit stage. -/
  finiteObservedOrbitSound :
    ∀ (N : Nat) {x y : (finiteDisplacementCoalgebra N).carrier},
      ZetaStarDisplacementObservedEq (finiteDisplacementCoalgebra N) x y →
        ∀ n, ZetaStarDisplacementObservedEq (finiteDisplacementCoalgebra N)
          (zetaStarDisplacementCoalgebraOrbit
            (finiteDisplacementCoalgebra N) n x)
          (zetaStarDisplacementCoalgebraOrbit
            (finiteDisplacementCoalgebra N) n y)
  /-- The coalgebraic apparatus includes observed coinduction. -/
  apparatus : ZetaStarCoalgebraicPromotionApparatus
  /-- Any observation carried by an up-to-closure relation is preserved along
  the resulting coinductive orbit. -/
  observedCoinduction :
    ∀ {α : Type} (observe : Valuation → α) (M : Valuation.ModalFrame)
      {R : Valuation → Valuation → Prop} {E E' : Valuation},
      AperiodicOrder.Tiling.UpTo.ObservedBisimUTC M observe R →
        R E E' →
          AperiodicOrder.Tiling.UpTo.ObservedBisim M observe E E'
  /-- Observed geometric MLD still maps to the ordinary geometric MLD carrier. -/
  observedForgets :
    ∀ {α : Type} (observe : Valuation → α) (M : Valuation.ModalFrame)
      {E E' : Valuation},
      AperiodicOrder.Tiling.UpTo.ObservedGeoMld M observe E E' →
        AperiodicOrder.Tiling.UpTo.GeoMld M E E'

/-- Zeta-star now has the recovery interface for analytic-rich coalgebraic
promotion: the finite observed displacement coalgebra, plus the exact
observed-coinduction slot where the analytic diffraction observation must be
installed. -/
def zetaStar_analyticRichnessRecovery :
    ZetaStarAnalyticRichnessRecovery where
  boundary := zetaStar_algebraCoalgebraBoundary
  finiteDisplacementCoalgebra := canonicalZetaStarDisplacementCoalgebra
  finiteDisplacementDelone := fun N x =>
    zetaStarDisplacementCoalgebra_finiteDelone
      (canonicalZetaStarDisplacementCoalgebra N) x
  finiteDisplacementMass := fun N x =>
    zetaStarDisplacementCoalgebra_mass
      (canonicalZetaStarDisplacementCoalgebra N) x
  finiteObservationStep := fun N x =>
    zetaStarDisplacementCoalgebra_observe_step
      (canonicalZetaStarDisplacementCoalgebra N) x
  finiteObservedStepCompatibility := fun N {x} {y} h =>
    zetaStarDisplacementObservedEq_step
      (canonicalZetaStarDisplacementCoalgebra N) (x := x) (y := y) h
  finiteObservedOrbitSound := fun N {x} {y} h =>
    zetaStarDisplacementObservedEq_orbit
      (canonicalZetaStarDisplacementCoalgebra N) (x := x) (y := y) h
  apparatus := zetaStar_coalgebraicPromotion_apparatus
  observedCoinduction :=
    zetaStar_coalgebraicPromotion_apparatus.observedCoinduction
  observedForgets :=
    zetaStar_coalgebraicPromotion_apparatus.observedForgets

/-- In every finite displacement window there exists a concrete zeta-star
witness whose arithmetic-settling certificate includes the odd-seed 2-adic
shortcut valuation explicitly. -/
theorem exists_zetaStar_arithmeticSettling_with_odd_shortcut (N : Nat) :
    ∃ z : ArithmeticZetaStar N,
      ZetaStarArithmeticSettlingCertificate z ∧
        IsPisotInflation z.phase ∧
          z.seed % 2 = 1 ∧
            (∃ k m, 1 ≤ k ∧ m % 2 = 1 ∧
              3 * z.seed + 1 = 2 ^ k * m ∧
                twoAdicVal (2 ^ k) = k ∧
                  k ≤ twoAdicVal (3 * z.seed + 1)) ∧
              FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase := by
  refine ⟨canonicalZetaStar N, zetaStar_arithmeticSettling_certificate _,
    canonicalZetaStar_pisot N, canonicalZetaStar_seed_odd N,
    canonicalZetaStar_shortcut_twoAdicValuation N, ?_⟩
  exact zetaStar_finitePurePointQuasicrystal_of_pisot
    (canonicalZetaStar N) (canonicalZetaStar_pisot N)

/-- The zeta-star finite diffraction readout is singular-continuous exactly on
the Salem side of its StepN phase. -/
theorem zetaStar_phase_singularContinuous_iff_salem {N : Nat}
    (z : ArithmeticZetaStar N) :
    finiteFourierDualKind z.phase = FiniteDiffractionKind.singularContinuous ↔
      IsSalemInflation z.phase :=
  finiteFourierDualKind_singularContinuous_iff_salem z.phase

/-- The zeta-star bridge: affine-trace zeros fill
the finite displacement carrier, that zero-set is finite-discrete Delone, its
finite diffraction mass is the total counting mass, and the finite pure-point
readout is exactly the Pisot side. -/
theorem zetaStar_bridge_evidence {N : Nat} (z : ArithmeticZetaStar N) :
    (zetaStarZeroSet z = fun _ => true)
      ∧ FiniteDisplacementDelone N (zetaStarZeroSet z)
      ∧ finiteDiffractionMass N (zetaStarZeroSet z) Set.univ = N + 1
      ∧ (finiteFourierDualKind z.phase = FiniteDiffractionKind.purePoint ↔
        IsPisotInflation z.phase)
      ∧ (lebesgueType (zetaStarFiniteDiffractionReadout z).component =
        zetaStarPhaseType z)
      ∧ ((zetaStarFiniteDiffractionReadout z).component =
        FiniteDiffractionKind.purePoint ↔
          zetaStarPhaseType z = Regime.consistent)
      ∧ (IsPisotInflation z.phase →
        (zetaStarFiniteDiffractionReadout z).component =
            FiniteDiffractionKind.purePoint ∧
          (zetaStarFiniteDiffractionReadout z).atomMass =
            finiteDiffractionMass N (zetaStarZeroSet z) Set.univ ∧
          0 < (zetaStarFiniteDiffractionReadout z).atomMass ∧
            FinitePurePointQuasicrystal N (zetaStarZeroSet z) z.phase) := by
  exact ⟨zetaStarZeroSet_eq_univ z, zetaStarZeroSet_finiteDiscreteDelone z,
    zetaStar_finiteDiffractionMass_univ z, zetaStar_phase_purePoint_iff_pisot z,
    zetaStar_phaseType_readout z, zetaStar_readout_purePoint_iff_phaseType_consistent z,
    fun h => ⟨(zetaStar_finiteDiffractionMass_purePoint_of_pisot z h).1,
      (zetaStar_finiteDiffractionMass_purePoint_of_pisot z h).2.1,
      (zetaStar_finiteDiffractionMass_purePoint_of_pisot z h).2.2,
      zetaStar_finitePurePointQuasicrystal_of_pisot z h⟩⟩

