import Obsmetrologia.CausalSets.BlackHoles.Hole
import Obsmetrologia.Calculus.Order.TileAdjacencyChromatic

/-!
# Post-hole tile carriers

This module treats a computed hole region as a tile-level object.  The hole
events carry their own causal adjacency graph, and a post-hole tile records a
FOUR-valued colouring of that graph together with the future-core data needed
to certify Alexandrov connectedness.

## Main definitions

* `HoleTileAdjacency` -- the causal adjacency graph restricted to hole events.
* `HoleTileColoring` -- a `Reading`-valued proper colouring of that graph.
* `HoleColorFutureCore` -- a future core generated by one FOUR phase.
* `PrincipalColorFutureCore` -- a colour future core generated by one root
  event's causal future.
* `AnchoredPrincipalColorFutureCore` -- a principal colour future core whose
  root is reached by every hole event.
* `PostHoleTile` -- a hole-region-as-tile carrier with a realised adjacency
  convention, colouring, and future core.
* `ColorSettledPostHoleTile` -- a post-hole tile whose future core is generated
  by its colouring.

## Main results

* `holeTileColoring_iff_hom` -- post-hole colouring is a factor map to FOUR.
* `holeRegion_connected_of_colorFutureCore` -- a cofinal connected FOUR phase
  connects the computed hole region.
* `holeRegion_connected_of_principalColorFutureCore` -- a principal cofinal
  FOUR phase connects the computed hole region.
* `holeRegion_connected_of_anchoredPrincipalColorFutureCore` -- a single
  settled colour anchor connects the computed hole region.
* `holeRegion_connected_of_coloredFutureAnchor` -- a pure hole future anchor
  presented by one FOUR phase connects the computed hole region.
* `holeRegion_connected_of_coloredSettlingAnchor` -- a hole-side settling
  anchor presented by one FOUR phase connects the computed hole region.
* `holeRegion_connected_of_coloredStepSettlingAnchor` -- a finite causal
  step dynamics presented by one FOUR phase connects the computed hole region.
* `holeRegion_connected_of_coloredRankedStepAnchor` -- a ranked finite local
  step presented by one FOUR phase connects the computed hole region.
* `holeRegion_connected_of_coloredTileRankedStepAnchor` -- a ranked finite
  local step along the post-hole tile graph, presented by one FOUR phase,
  connects the computed hole region.
* `HoleColorFutureCore.shroud_between_exterior_and_core` -- the shroud sits
  between a backward exterior predecessor and a future colour-core anchor.
* `PostHoleTile.holeRegionConnected` -- a post-hole tile certifies the computed
  hole region as connected.
* `ColorSettledPostHoleTile.holeRegionConnected` -- the colour-generated core
  certifies the computed hole region as connected.
-/

namespace Obsmetrologia
namespace CausalSets.BlackHoles

open Obsmetrologia.CausalSets.Causal.Order
open Obsmetrologia.CausalSets.Causal.Cone
open Obsmetrologia.CausalSets.Causal.Alexandrov
open Obsmetrologia.Combinatorics
open Obsmetrologia.Discrete (Graph)

variable {E : Type} (C : CausalSet E) [CausalLeDecision C]

/-! ## Hole-region tile graph -/

/-- The post-hole tile sites: events lying in the computed no-readout region. -/
def HoleTileSites (readout : Region E) : E → Prop :=
  fun x => HoleRegion C readout x = true

/- `HoleTileAdjacency` and everything built from it (`HoleTileColoring`,
`PostHoleTile` and its descendants) needs `x`/`y` distinguishable, to exclude
the diagonal below. The pure future-core/connectedness machinery elsewhere in
this file never inspects adjacency and stays outside this scope. -/
section
variable [DecidableEq E]

/-- The causal adjacency graph restricted to computed hole events. Two
guards keep this satisfiable: distinct events only (`CausalAdjacent` is
reflexive -- `x ≤ x` always holds -- so without `x ≠ y` every nonempty hole
would carry an unavoidable self-loop), and *listed* events only. Dropping the
listedness guard would let `CausalAdjacent`'s full transitive comparability
range over the whole (possibly infinite) ambient type `E`, not just the
finitely many events `C` actually carries -- and an unbounded causal set
(e.g. an articulation chain, whose depth has no upper bound) has arbitrarily
long comparability chains that no four-colour palette can properly colour. -/
def HoleTileAdjacency (readout : Region E) : Graph E :=
  fun x y =>
    (((HoleRegion C readout x && HoleRegion C readout y) && CausalAdjacent C x y)
        && !decide (x = y))
      && (decide (x ∈ C.events) && decide (y ∈ C.events))

/-- A post-hole edge starts at a computed hole event. -/
theorem holeTileAdjacency_left (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) :
    HoleRegion C readout x = true := by
  simp only [HoleTileAdjacency, Bool.and_eq_true] at h
  exact h.1.1.1.1

/-- A post-hole edge ends at a computed hole event. -/
theorem holeTileAdjacency_right (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) :
    HoleRegion C readout y = true := by
  simp only [HoleTileAdjacency, Bool.and_eq_true] at h
  exact h.1.1.1.2

/-- A post-hole edge is a causal adjacency edge in the underlying causal set. -/
theorem holeTileAdjacency_causalAdjacent (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) :
    CausalAdjacent C x y = true := by
  simp only [HoleTileAdjacency, Bool.and_eq_true] at h
  exact h.1.1.2

/-- A post-hole edge joins two distinct events. -/
theorem holeTileAdjacency_ne (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) : x ≠ y := by
  simp only [HoleTileAdjacency, Bool.and_eq_true, Bool.not_eq_true', decide_eq_false_iff_not]
    at h
  exact h.1.2

/-- A post-hole edge starts at a listed event of the underlying causal set. -/
theorem holeTileAdjacency_mem_left (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) : x ∈ C.events := by
  simp only [HoleTileAdjacency, Bool.and_eq_true, decide_eq_true_iff] at h
  exact h.2.1

/-- A post-hole edge ends at a listed event of the underlying causal set. -/
theorem holeTileAdjacency_mem_right (readout : Region E) {x y : E}
    (h : HoleTileAdjacency C readout x y = true) : y ∈ C.events := by
  simp only [HoleTileAdjacency, Bool.and_eq_true, decide_eq_true_iff] at h
  exact h.2.2

/-! ## FOUR-coloured post-hole tiles -/

/-- A FOUR-colouring of the post-hole tile adjacency graph. -/
def HoleTileColoring (readout : Region E) (color : E → Reading) : Prop :=
  ProperColoring (HoleTileAdjacency C readout) color

/-- A post-hole FOUR-colouring is a factor map to the complete graph on FOUR. -/
theorem holeTileColoring_iff_hom (readout : Region E) (color : E → Reading) :
    HoleTileColoring C readout color ↔
      GraphHom (HoleTileAdjacency C readout) (completeGraph Reading) color :=
  properColoring_iff_hom (HoleTileAdjacency C readout) color

end

/-! ## Colour-generated future cores -/

/-- The subcarrier of hole events in one FOUR phase. -/
def ColorPhaseCore (readout : Region E) (color : E → Reading) (phase : Reading) :
    Obsmetrologia.Alexandrov.Opens (causalPartialOrder C) :=
  fun x => HoleRegion C readout x = true ∧ color x = phase

/-- A future core generated by one FOUR phase of the post-hole colouring. -/
structure HoleColorFutureCore (readout : Region E) (color : E → Reading) where
  /-- The FOUR phase that carries the connected cofinal core. -/
  phase : Reading
  /-- The phase subcarrier is connected in the causal Alexandrov topology. -/
  connected :
    Obsmetrologia.Alexandrov.IsConnected (causalTopology C)
      (ColorPhaseCore C readout color phase)
  /-- Every hole event causally reaches the phase subcarrier. -/
  cofinal :
    ∀ x, HoleRegion C readout x = true →
      ∃ k, ColorPhaseCore C readout color phase k ∧ CausalLe C x k

namespace HoleColorFutureCore

/-- A colour-generated future core is a `HoleFutureCore`. -/
def toFutureCore {readout : Region E} {color : E → Reading}
    (K : HoleColorFutureCore C readout color) : HoleFutureCore C readout where
  core := ColorPhaseCore C readout color K.phase
  connected := K.connected
  subset_hole := fun _ hx => hx.1
  cofinal := K.cofinal

/-- A colour-generated future core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E} {color : E → Reading}
    (K : HoleColorFutureCore C readout color) : HoleRegionConnected C readout :=
  holeRegion_connected_of_futureCore C readout K.toFutureCore

/-- A shroud event lies between a backward exterior predecessor and a future colour-core anchor. -/
theorem shroud_between_exterior_and_core {readout : Region E} {color : E → Reading}
    (K : HoleColorFutureCore C readout color) {x : E} (hx : Shroud C readout x = true) :
    ∃ y k,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout color K.phase k
        ∧ CausalLe C x k := by
  obtain ⟨y, hymem, hyout, hyx⟩ := shroud_has_exterior_predecessor C readout hx
  obtain ⟨k, hkcore, hxk⟩ := K.cofinal x (shroud_in_hole C readout hx)
  exact ⟨y, k, hymem, hyout, hyx, hkcore, hxk⟩

end HoleColorFutureCore

/-- A hole region is connected when one FOUR phase is connected and cofinal in it. -/
theorem holeRegion_connected_of_colorFutureCore (readout : Region E) (color : E → Reading)
    (K : HoleColorFutureCore C readout color) : HoleRegionConnected C readout :=
  K.holeRegionConnected C

/-! ## Principal colour cores -/

/-- A colour future core generated by the causal future of one root event. -/
structure PrincipalColorFutureCore (readout : Region E) (color : E → Reading) where
  /-- The root event whose causal future is the settled colour phase. -/
  root : E
  /-- The FOUR phase carried by the root future. -/
  phase : Reading
  /-- The selected colour phase is exactly the root's causal future. -/
  principal :
    ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C root x
  /-- Every hole event causally reaches the root-generated colour phase. -/
  cofinal :
    ∀ x, HoleRegion C readout x = true →
      ∃ k, ColorPhaseCore C readout color phase k ∧ CausalLe C x k

namespace PrincipalColorFutureCore

/-- A principal colour core is a connected colour future core. -/
def toColorFutureCore {readout : Region E} {color : E → Reading}
    (K : PrincipalColorFutureCore C readout color) : HoleColorFutureCore C readout color where
  phase := K.phase
  connected := by
    exact Obsmetrologia.Alexandrov.isConnected_congr
      (causalTopology C)
      (U := (causalTopology C).upperSet K.root)
      (V := ColorPhaseCore C readout color K.phase)
      (fun x => by
        constructor
        · intro hx
          exact (K.principal x).mpr hx
        · intro hx
          exact (K.principal x).mp hx)
      (Obsmetrologia.Alexandrov.isConnected_upperSet (causalTopology C) K.root)
  cofinal := K.cofinal

/-- A principal colour core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E} {color : E → Reading}
    (K : PrincipalColorFutureCore C readout color) : HoleRegionConnected C readout :=
  (K.toColorFutureCore C).holeRegionConnected C

/-- A shroud event lies between a backward exterior predecessor and the principal colour core. -/
theorem shroud_between_exterior_and_core {readout : Region E} {color : E → Reading}
    (K : PrincipalColorFutureCore C readout color) {x : E} (hx : Shroud C readout x = true) :
    ∃ y k,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout color K.phase k
        ∧ CausalLe C x k :=
  (K.toColorFutureCore C).shroud_between_exterior_and_core C hx

end PrincipalColorFutureCore

/-- A hole region is connected when one FOUR phase is a cofinal principal future. -/
theorem holeRegion_connected_of_principalColorFutureCore
    (readout : Region E) (color : E → Reading)
    (K : PrincipalColorFutureCore C readout color) : HoleRegionConnected C readout :=
  K.holeRegionConnected C

/-! ## Anchored principal colour cores -/

/-- A principal colour future core whose root is reached by every computed hole event. -/
structure AnchoredPrincipalColorFutureCore (readout : Region E) (color : E → Reading) where
  /-- The root event serving as the settled colour anchor. -/
  root : E
  /-- The FOUR phase carried by the root future. -/
  phase : Reading
  /-- The selected colour phase is exactly the root's causal future. -/
  principal :
    ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C root x
  /-- Every hole event reaches the colour anchor. -/
  anchors :
    ∀ x, HoleRegion C readout x = true → CausalLe C x root

namespace AnchoredPrincipalColorFutureCore

/-- Present a pure hole future anchor as one principal FOUR phase. -/
def ofHoleFutureAnchor {readout : Region E} {color : E → Reading}
    (A : HoleFutureAnchor C readout) (phase : Reading)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C A.root x) :
    AnchoredPrincipalColorFutureCore C readout color where
  root := A.root
  phase := phase
  principal := hprincipal
  anchors := A.anchors

/-- An anchored principal colour core induces a principal cofinal colour core. -/
def toPrincipalColorFutureCore {readout : Region E} {color : E → Reading}
    (K : AnchoredPrincipalColorFutureCore C readout color) :
    PrincipalColorFutureCore C readout color where
  root := K.root
  phase := K.phase
  principal := K.principal
  cofinal := by
    intro x hx
    exact ⟨K.root, (K.principal K.root).mpr (causalLe_refl C K.root), K.anchors x hx⟩

/-- An anchored principal colour core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E} {color : E → Reading}
    (K : AnchoredPrincipalColorFutureCore C readout color) : HoleRegionConnected C readout :=
  (K.toPrincipalColorFutureCore C).holeRegionConnected C

/-- A shroud event lies between a backward exterior predecessor and the colour anchor. -/
theorem shroud_between_exterior_and_anchor {readout : Region E} {color : E → Reading}
    (K : AnchoredPrincipalColorFutureCore C readout color) {x : E}
    (hx : Shroud C readout x = true) :
    ∃ y,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout color K.phase K.root
        ∧ CausalLe C x K.root := by
  obtain ⟨y, hymem, hyout, hyx⟩ := shroud_has_exterior_predecessor C readout hx
  exact ⟨y, hymem, hyout, hyx,
    (K.principal K.root).mpr (causalLe_refl C K.root),
    K.anchors x (shroud_in_hole C readout hx)⟩

end AnchoredPrincipalColorFutureCore

/-- A hole region is connected when all hole events reach one principal FOUR-phase anchor. -/
theorem holeRegion_connected_of_anchoredPrincipalColorFutureCore
    (readout : Region E) (color : E → Reading)
    (K : AnchoredPrincipalColorFutureCore C readout color) : HoleRegionConnected C readout :=
  K.holeRegionConnected C

/-- A hole region is connected when a pure future anchor is presented by one FOUR phase. -/
theorem holeRegion_connected_of_coloredFutureAnchor
    (readout : Region E) (color : E → Reading) (phase : Reading)
    (A : HoleFutureAnchor C readout)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C A.root x) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_anchoredPrincipalColorFutureCore C readout color
    (AnchoredPrincipalColorFutureCore.ofHoleFutureAnchor C A phase hprincipal)

/-- A hole region is connected when a hole-side settling anchor is presented by one FOUR phase. -/
theorem holeRegion_connected_of_coloredSettlingAnchor
    (readout : Region E) (color : E → Reading) (phase : Reading)
    (S : HoleSettlingAnchor C readout)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C S.root x) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_coloredFutureAnchor C readout color phase
    S.toFutureAnchor hprincipal

/-- A hole region is connected when finite hole-side step settling is presented by one FOUR phase. -/
theorem holeRegion_connected_of_coloredStepSettlingAnchor
    (readout : Region E) (color : E → Reading) (phase : Reading)
    (S : HoleStepSettlingAnchor C readout)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C S.root x) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_coloredSettlingAnchor C readout color phase
    S.toSettlingAnchor hprincipal

/-- A hole region is connected when a ranked local step is presented by one FOUR phase. -/
theorem holeRegion_connected_of_coloredRankedStepAnchor
    (readout : Region E) (color : E → Reading) (phase : Reading)
    (S : HoleRankedStepAnchor C readout)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C S.root x) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_coloredStepSettlingAnchor C readout color phase
    S.toStepSettlingAnchor hprincipal

/-! ## Tile-local ranked settling -/

/- `tile_step` below reads `HoleTileAdjacency` directly, so this carrier and
everything built from it needs the same distinguishability as that section. -/
section
variable [DecidableEq E]

/-- A ranked local step carried by the post-hole tile adjacency graph. -/
structure HoleTileRankedStepAnchor (readout : Region E) where
  /-- The settled anchor event. -/
  root : E
  /-- One local post-hole tile step. -/
  step : E → E
  /-- A finite-stage height measuring remaining local settling stages. -/
  height : E → FiniteStage
  /-- The settled anchor lies in the computed hole region. -/
  root_in_hole : HoleRegion C readout root = true
  /-- The root has height zero. -/
  height_root : (height root).count = 0
  /-- Height-zero hole events are the root. -/
  root_of_height_zero : ∀ x, HoleRegion C readout x = true → (height x).count = 0 → x = root
  /-- Hole events remain in the hole after one local step. -/
  step_in_hole : ∀ x, HoleRegion C readout x = true → HoleRegion C readout (step x) = true
  /-- Hole events move causally forward after one local step. -/
  causal_step : ∀ x, HoleRegion C readout x = true → CausalLe C x (step x)
  /-- Non-root hole events step along the post-hole tile adjacency graph. -/
  tile_step :
    ∀ x, HoleRegion C readout x = true → x ≠ root →
      HoleTileAdjacency C readout x (step x) = true
  /-- Non-root hole events strictly lower their finite height by one local step. -/
  height_step :
    ∀ x, HoleRegion C readout x = true → x ≠ root →
      (height (step x)).count + 1 = (height x).count

namespace HoleTileRankedStepAnchor

/-- A tile-local ranked step has a causal-adjacent non-root edge. -/
theorem tile_step_causalAdjacent {readout : Region E}
    (S : HoleTileRankedStepAnchor C readout) {x : E}
    (hx : HoleRegion C readout x = true) (hxr : x ≠ S.root) :
    CausalAdjacent C x (S.step x) = true :=
  holeTileAdjacency_causalAdjacent C readout (S.tile_step x hx hxr)

/-- A tile-local ranked step induces the order-local ranked carrier. -/
def toRankedStepAnchor {readout : Region E}
    (S : HoleTileRankedStepAnchor C readout) : HoleRankedStepAnchor C readout where
  root := S.root
  step := S.step
  height := S.height
  root_in_hole := S.root_in_hole
  height_root := S.height_root
  root_of_height_zero := S.root_of_height_zero
  step_in_hole := S.step_in_hole
  causal_step := S.causal_step
  height_step := S.height_step

/-- A tile-local ranked step connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E}
    (S : HoleTileRankedStepAnchor C readout) : HoleRegionConnected C readout :=
  holeRegion_connected_of_rankedStepAnchor C readout S.toRankedStepAnchor

/-- A shroud event lies between a backward exterior predecessor and the tile-settled root. -/
theorem shroud_between_exterior_and_tile_ranked_anchor {readout : Region E}
    (S : HoleTileRankedStepAnchor C readout) {x : E} (hx : Shroud C readout x = true) :
    ∃ y,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ CausalLe C x S.root :=
  S.toRankedStepAnchor.toStepSettlingAnchor
    |>.shroud_between_exterior_and_step_settled_anchor C hx

end HoleTileRankedStepAnchor

/-- A hole region is connected when a tile-local ranked step is presented by one FOUR phase. -/
theorem holeRegion_connected_of_coloredTileRankedStepAnchor
    (readout : Region E) (color : E → Reading) (phase : Reading)
    (S : HoleTileRankedStepAnchor C readout)
    (hprincipal : ∀ x, ColorPhaseCore C readout color phase x ↔ CausalLe C S.root x) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_coloredRankedStepAnchor C readout color phase
    S.toRankedStepAnchor hprincipal

/-- A post-hole tile: the hole region treated as a coloured tile-level carrier. -/
structure PostHoleTile (readout : Region E) where
  /-- The realised tile-adjacency convention through which this post-hole tile is read. -/
  convention : CorpusTileAdjacencyConvention
  /-- The FOUR-valued colour of each event in the ambient causal substrate. -/
  color : E → Reading
  /-- The colour law on the causal adjacency graph restricted to the hole region. -/
  coloring : HoleTileColoring C readout color
  /-- The future-side connected core anchoring the computed hole region. -/
  futureCore : HoleFutureCore C readout

namespace PostHoleTile

variable {C}

/-- The tile colouring as a graph homomorphism to the complete graph on FOUR. -/
theorem coloring_hom {readout : Region E} (T : PostHoleTile C readout) :
    GraphHom (HoleTileAdjacency C readout) (completeGraph Reading) T.color :=
  (holeTileColoring_iff_hom C readout T.color).mp T.coloring

/-- The future core carried by a post-hole tile connects its computed hole region. -/
theorem holeRegionConnected {readout : Region E} (T : PostHoleTile C readout) :
    HoleRegionConnected C readout :=
  holeRegion_connected_of_futureCore C readout T.futureCore

/-- A post-hole tile promotes the computed hole region to a topological region. -/
def topologicalRegion {readout : Region E} (T : PostHoleTile C readout) :
    Obsmetrologia.Alexandrov.Region (causalTopology C) :=
  HoleRegion.topologicalRegion C readout T.holeRegionConnected

end PostHoleTile

/-! ## Colour-settled post-hole tiles -/

/-- A post-hole tile whose future core is generated by one FOUR phase of its colouring. -/
structure ColorSettledPostHoleTile (readout : Region E) where
  /-- The realised tile-adjacency convention through which this post-hole tile is read. -/
  convention : CorpusTileAdjacencyConvention
  /-- The FOUR-valued colour of each event in the ambient causal substrate. -/
  color : E → Reading
  /-- The colour law on the causal adjacency graph restricted to the hole region. -/
  coloring : HoleTileColoring C readout color
  /-- The settled phase core generated by the colouring. -/
  colorCore : HoleColorFutureCore C readout color

namespace ColorSettledPostHoleTile

variable {C}

/-- A colour-settled post-hole tile is a post-hole tile with the induced future core. -/
def toPostHoleTile {readout : Region E} (T : ColorSettledPostHoleTile C readout) :
    PostHoleTile C readout where
  convention := T.convention
  color := T.color
  coloring := T.coloring
  futureCore := T.colorCore.toFutureCore C

/-- The tile colouring as a graph homomorphism to the complete graph on FOUR. -/
theorem coloring_hom {readout : Region E} (T : ColorSettledPostHoleTile C readout) :
    GraphHom (HoleTileAdjacency C readout) (completeGraph Reading) T.color :=
  (holeTileColoring_iff_hom C readout T.color).mp T.coloring

/-- The colour-generated future core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E} (T : ColorSettledPostHoleTile C readout) :
    HoleRegionConnected C readout :=
  T.colorCore.holeRegionConnected C

/-- A colour-settled post-hole tile promotes the computed hole region to a topological region. -/
def topologicalRegion {readout : Region E} (T : ColorSettledPostHoleTile C readout) :
    Obsmetrologia.Alexandrov.Region (causalTopology C) :=
  HoleRegion.topologicalRegion C readout T.holeRegionConnected

/-- A shroud event is bounded by the exterior on the past side and the colour core on the future side. -/
theorem shroud_between_exterior_and_core {readout : Region E}
    (T : ColorSettledPostHoleTile C readout) {x : E} (hx : Shroud C readout x = true) :
    ∃ y k,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout T.color T.colorCore.phase k
        ∧ CausalLe C x k :=
  T.colorCore.shroud_between_exterior_and_core C hx

end ColorSettledPostHoleTile

/-! ## Principal colour-settled post-hole tiles -/

/-- A post-hole tile whose settled colour core is generated by one root event. -/
structure PrincipalColorSettledPostHoleTile (readout : Region E) where
  /-- The realised tile-adjacency convention through which this post-hole tile is read. -/
  convention : CorpusTileAdjacencyConvention
  /-- The FOUR-valued colour of each event in the ambient causal substrate. -/
  color : E → Reading
  /-- The colour law on the causal adjacency graph restricted to the hole region. -/
  coloring : HoleTileColoring C readout color
  /-- The principal settled phase generated by the colouring. -/
  principalCore : PrincipalColorFutureCore C readout color

namespace PrincipalColorSettledPostHoleTile

variable {C}

/-- A principal colour-settled tile induces a colour-settled tile. -/
def toColorSettledPostHoleTile {readout : Region E}
    (T : PrincipalColorSettledPostHoleTile C readout) :
    ColorSettledPostHoleTile C readout where
  convention := T.convention
  color := T.color
  coloring := T.coloring
  colorCore := T.principalCore.toColorFutureCore C

/-- The tile colouring as a graph homomorphism to the complete graph on FOUR. -/
theorem coloring_hom {readout : Region E}
    (T : PrincipalColorSettledPostHoleTile C readout) :
    GraphHom (HoleTileAdjacency C readout) (completeGraph Reading) T.color :=
  (holeTileColoring_iff_hom C readout T.color).mp T.coloring

/-- The principal colour core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E}
    (T : PrincipalColorSettledPostHoleTile C readout) :
    HoleRegionConnected C readout :=
  T.principalCore.holeRegionConnected C

/-- A principal colour-settled post-hole tile promotes the hole to a topological region. -/
def topologicalRegion {readout : Region E}
    (T : PrincipalColorSettledPostHoleTile C readout) :
    Obsmetrologia.Alexandrov.Region (causalTopology C) :=
  HoleRegion.topologicalRegion C readout T.holeRegionConnected

/-- A shroud event is bounded by the exterior and the principal colour core. -/
theorem shroud_between_exterior_and_core {readout : Region E}
    (T : PrincipalColorSettledPostHoleTile C readout) {x : E}
    (hx : Shroud C readout x = true) :
    ∃ y k,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout T.color T.principalCore.phase k
        ∧ CausalLe C x k :=
  T.principalCore.shroud_between_exterior_and_core C hx

end PrincipalColorSettledPostHoleTile

/-! ## Anchored principal colour-settled post-hole tiles -/

/-- A post-hole tile whose settled colour core is generated by one reached anchor event. -/
structure AnchoredColorSettledPostHoleTile (readout : Region E) where
  /-- The realised tile-adjacency convention through which this post-hole tile is read. -/
  convention : CorpusTileAdjacencyConvention
  /-- The FOUR-valued colour of each event in the ambient causal substrate. -/
  color : E → Reading
  /-- The colour law on the causal adjacency graph restricted to the hole region. -/
  coloring : HoleTileColoring C readout color
  /-- The anchored principal settled phase generated by the colouring. -/
  anchorCore : AnchoredPrincipalColorFutureCore C readout color

namespace AnchoredColorSettledPostHoleTile

variable {C}

/-- An anchored colour-settled tile induces a principal colour-settled tile. -/
def toPrincipalColorSettledPostHoleTile {readout : Region E}
    (T : AnchoredColorSettledPostHoleTile C readout) :
    PrincipalColorSettledPostHoleTile C readout where
  convention := T.convention
  color := T.color
  coloring := T.coloring
  principalCore := T.anchorCore.toPrincipalColorFutureCore C

/-- The tile colouring as a graph homomorphism to the complete graph on FOUR. -/
theorem coloring_hom {readout : Region E}
    (T : AnchoredColorSettledPostHoleTile C readout) :
    GraphHom (HoleTileAdjacency C readout) (completeGraph Reading) T.color :=
  (holeTileColoring_iff_hom C readout T.color).mp T.coloring

/-- The anchored principal colour core connects the computed hole region. -/
theorem holeRegionConnected {readout : Region E}
    (T : AnchoredColorSettledPostHoleTile C readout) :
    HoleRegionConnected C readout :=
  T.anchorCore.holeRegionConnected C

/-- An anchored colour-settled post-hole tile promotes the hole to a topological region. -/
def topologicalRegion {readout : Region E}
    (T : AnchoredColorSettledPostHoleTile C readout) :
    Obsmetrologia.Alexandrov.Region (causalTopology C) :=
  HoleRegion.topologicalRegion C readout T.holeRegionConnected

/-- A shroud event is bounded by the exterior and the settled colour anchor. -/
theorem shroud_between_exterior_and_anchor {readout : Region E}
    (T : AnchoredColorSettledPostHoleTile C readout) {x : E}
    (hx : Shroud C readout x = true) :
    ∃ y,
      y ∈ C.events
        ∧ ReadoutExterior C readout y = true
        ∧ CausalLe C y x
        ∧ ColorPhaseCore C readout T.color T.anchorCore.phase T.anchorCore.root
        ∧ CausalLe C x T.anchorCore.root :=
  T.anchorCore.shroud_between_exterior_and_anchor C hx

end AnchoredColorSettledPostHoleTile

end

end CausalSets.BlackHoles
end Obsmetrologia
