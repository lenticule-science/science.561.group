import Obsmetrologia.Language.Predicating.Cell

/-!
# Predication syntax

This module turns the useful dependency-free core of the archived
`semiotic-universe` syntax attempt into an active predication-stage carrier:
an intrinsically typed operator grammar over the predicate base.

## Main definitions

* `PredicationSyntax.Ty` is the generated type grammar.
* `PredicationSyntax.Var` and `PredicationSyntax.Term` are intrinsically typed
  de Bruijn variables and terms.
* `PredicationSyntax.RawOp` is the closed syntax carrier for predicate
  operators.

## Main results

* `PredicationSyntax.predPower_zero`
* `PredicationSyntax.predPower_succ`
* `PredicationSyntax.rawOp_one`
-/

namespace Obsmetrologia
namespace PredicationSyntax

/-- Predicate-level types generated by predicating. -/
inductive Ty : Type where
  /-- The predicate base. -/
  | pred : Ty
  /-- Function type. -/
  | arr : Ty → Ty → Ty
  /-- Product type. -/
  | prod : Ty → Ty → Ty
  deriving DecidableEq, Repr

infixr:25 " ⇒ₚ " => Ty.arr
infixl:35 " ⊗ₚ " => Ty.prod

/-- A predication-syntax context. -/
abbrev Ctx := List Ty

/-- A de Bruijn variable in a predication-syntax context. -/
inductive Var : Ctx → Ty → Type where
  /-- The newest variable in the context. -/
  | zero {A : Ty} {Γ : Ctx} : Var (A :: Γ) A
  /-- A variable weakened across one newer binding. -/
  | succ {A B : Ty} {Γ : Ctx} : Var Γ A → Var (B :: Γ) A

/-- Intrinsically typed terms generated over the predicate base. -/
inductive Term : Ctx → Ty → Type where
  /-- Variable reference. -/
  | var {Γ : Ctx} {A : Ty} : Var Γ A → Term Γ A
  /-- Lambda abstraction. -/
  | lam {Γ : Ctx} {A B : Ty} : Term (A :: Γ) B → Term Γ (A ⇒ₚ B)
  /-- Application. -/
  | app {Γ : Ctx} {A B : Ty} : Term Γ (A ⇒ₚ B) → Term Γ A → Term Γ B
  /-- Product introduction. -/
  | pair {Γ : Ctx} {A B : Ty} : Term Γ A → Term Γ B → Term Γ (A ⊗ₚ B)
  /-- First product projection. -/
  | fst {Γ : Ctx} {A B : Ty} : Term Γ (A ⊗ₚ B) → Term Γ A
  /-- Second product projection. -/
  | snd {Γ : Ctx} {A B : Ty} : Term Γ (A ⊗ₚ B) → Term Γ B

/-- The right-associated finite product of predicate inputs. -/
def Ty.predPower : Nat → Ty
  | 0 => Ty.pred
  | n + 1 => Ty.pred ⊗ₚ Ty.predPower n

/-- A raw n-ary predicate operator is a closed term from the input carrier to a predicate. -/
def RawOp (n : Nat) : Type :=
  Term [] (Ty.predPower n ⇒ₚ Ty.pred)

/-- A nullary predicate constant is a closed predicate term. -/
def Const : Type := Term [] Ty.pred

/-- An operator name carries the arity of the raw syntax it can denote. -/
structure DefOp where
  /-- The number of predicate inputs. -/
  arity : Nat

/-- The identity predicate operator. -/
def idPred : Term [] (Ty.pred ⇒ₚ Ty.pred) :=
  Term.lam (Term.var Var.zero)

/-- The constant predicate operator. -/
def constPred : Term [] (Ty.pred ⇒ₚ Ty.pred ⇒ₚ Ty.pred) :=
  Term.lam (Term.lam (Term.var (Var.succ Var.zero)))

/-- Pairing of two predicate inputs. -/
def pairPred : Term [] (Ty.pred ⇒ₚ Ty.pred ⇒ₚ Ty.pred ⊗ₚ Ty.pred) :=
  Term.lam
    (Term.lam
      (Term.pair
        (Term.var (Var.succ Var.zero))
        (Term.var Var.zero)))

/-- First projection from a predicate pair. -/
def fstPred : Term [] ((Ty.pred ⊗ₚ Ty.pred) ⇒ₚ Ty.pred) :=
  Term.lam (Term.fst (Term.var Var.zero))

/-- Second projection from a predicate pair. -/
def sndPred : Term [] ((Ty.pred ⊗ₚ Ty.pred) ⇒ₚ Ty.pred) :=
  Term.lam (Term.snd (Term.var Var.zero))

/-- A context-level composition term for unary predicate endomorphisms. -/
def composePred :
    Term [Ty.pred ⇒ₚ Ty.pred, Ty.pred ⇒ₚ Ty.pred] (Ty.pred ⇒ₚ Ty.pred) :=
  Term.lam
    (Term.app
      (Term.var (Var.succ (Var.succ Var.zero)))
      (Term.app (Term.var (Var.succ Var.zero)) (Term.var Var.zero)))

/-- The zero input carrier is the predicate base. -/
theorem predPower_zero : Ty.predPower 0 = Ty.pred := rfl

/-- A successor input carrier adds one fresh predicate to the prior carrier. -/
theorem predPower_succ (n : Nat) :
    Ty.predPower (n + 1) = (Ty.pred ⊗ₚ Ty.predPower n) := rfl

/-- Raw unary operators have the expected closed function type. -/
theorem rawOp_one :
    RawOp 1 = Term [] ((Ty.pred ⊗ₚ Ty.pred) ⇒ₚ Ty.pred) := rfl

end PredicationSyntax
end Obsmetrologia
