import Obsmetrologia.AperiodicOrder.MaterialSectors.Contact.Keratin

/-!
# Hoare programs

This module records the minimal program-logic carrier used by the computing
surface: a precondition, a move, a postcondition, and the proof that the move
carries every precondition witness to the postcondition.

The keratinous specialization uses the existing material-contact machinery. Its
move first applies irreversible lock histories to a seed section and then settles
that locked seed to the least compatible section.
-/

namespace Obsmetrologia
namespace Computing

universe u v

/-- A Hoare program is a move equipped with pre/post predicates and the proof
that the move transports precondition witnesses to postcondition witnesses. -/
structure HoareProgram (Input : Type u) (Output : Type v) where
  /-- The input states where the program is allowed to start. -/
  precondition : Input → Prop
  /-- The program transition. -/
  move : Input → Output
  /-- The output states certified by the program. -/
  postcondition : Output → Prop
  /-- The proof that the transition carries precondition witnesses to
  postcondition witnesses. -/
  preserves : ∀ input, precondition input → postcondition (move input)

namespace HoareProgram

variable {Input : Type u} {Output : Type v}

/-- The preservation proof exposed as a theorem. -/
theorem preserves_post (P : HoareProgram Input Output) (input : Input)
    (hpre : P.precondition input) :
    P.postcondition (P.move input) :=
  P.preserves input hpre

end HoareProgram

open AperiodicOrder.MaterialSectors.Contact

/-- A keratinous Hoare program is a Hoare program whose move is generated by
vertexwise irreversible locking followed by Tarski settling on a keratin complex. -/
structure KeratinousHoareProgram (S : Order.CompleteLattice) where
  /-- The keratin contact complex whose sections carry the program state. -/
  complex : KeratinComplex S
  /-- The irreversible lock history applied at each vertex before settling. -/
  history : complex.Vertex → History S
  /-- The admissible seed sections. -/
  precondition : Obsmetrologia.Tarski.Assign complex → Prop
  /-- The certified settled sections. -/
  postcondition : Obsmetrologia.Tarski.Assign complex → Prop
  /-- Locking and settling every precondition witness produces a postcondition
  witness. -/
  preserves :
    ∀ seed,
      precondition seed →
        postcondition (Obsmetrologia.Tarski.settle complex (lockSeed complex history seed))

namespace KeratinousHoareProgram

variable {S : Order.CompleteLattice}

/-- The locked seed generated before settling. -/
def lockedSeed (P : KeratinousHoareProgram S)
    (seed : Obsmetrologia.Tarski.Assign P.complex) :
    Obsmetrologia.Tarski.Assign P.complex :=
  lockSeed P.complex P.history seed

/-- The keratinous program move: lock the seed, then settle it. -/
def move (P : KeratinousHoareProgram S)
    (seed : Obsmetrologia.Tarski.Assign P.complex) :
    Obsmetrologia.Tarski.Assign P.complex :=
  Obsmetrologia.Tarski.settle P.complex (P.lockedSeed seed)

/-- Forgetting the keratin origin leaves an ordinary Hoare program. -/
def toHoareProgram (P : KeratinousHoareProgram S) :
    HoareProgram (Obsmetrologia.Tarski.Assign P.complex)
      (Obsmetrologia.Tarski.Assign P.complex) where
  precondition := P.precondition
  move := P.move
  postcondition := P.postcondition
  preserves := P.preserves

/-- Keratinous preservation is ordinary Hoare preservation after forgetting the
material origin of the move. -/
theorem toHoareProgram_preserves (P : KeratinousHoareProgram S)
    (seed : Obsmetrologia.Tarski.Assign P.complex)
    (hpre : P.precondition seed) :
    P.postcondition (P.toHoareProgram.move seed) :=
  P.preserves seed hpre

/-- The keratinous move reaches the least compatible state above the locked seed. -/
theorem move_least_compatible (P : KeratinousHoareProgram S)
    (seed x : Obsmetrologia.Tarski.Assign P.complex)
    (hcomp : Obsmetrologia.Tarski.IsCompatible P.complex x)
    (hx : ∀ v, S.le (P.lockedSeed seed v) (x v)) :
    (Obsmetrologia.Tarski.AssignCL S P.complex.Vertex).le (P.move seed) x :=
  settle_lock_is_least_compatible P.complex P.history seed x hcomp hx

end KeratinousHoareProgram

/-- A keratinous Hoare program derives an ordinary Hoare program. -/
theorem keratinousHoareProgram_derives_hoare_program {S : Order.CompleteLattice}
    (P : KeratinousHoareProgram S) :
    ∀ seed, P.precondition seed → P.postcondition (P.toHoareProgram.move seed) :=
  P.toHoareProgram_preserves

/-- The derived Hoare program carries the keratin least-compatible-state law. -/
theorem keratinousHoareProgram_least_compatible_state {S : Order.CompleteLattice}
    (P : KeratinousHoareProgram S)
    (seed x : Obsmetrologia.Tarski.Assign P.complex)
    (hcomp : Obsmetrologia.Tarski.IsCompatible P.complex x)
    (hx : ∀ v, S.le (P.lockedSeed seed v) (x v)) :
    (Obsmetrologia.Tarski.AssignCL S P.complex.Vertex).le
      (P.toHoareProgram.move seed) x :=
  P.move_least_compatible seed x hcomp hx

end Computing
end Obsmetrologia
