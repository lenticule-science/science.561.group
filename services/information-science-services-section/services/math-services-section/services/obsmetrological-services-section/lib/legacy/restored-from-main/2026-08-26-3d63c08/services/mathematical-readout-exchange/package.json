{
  "name": "@lenticule-science/mathematical-readout-exchange",
  "version": "0.2.6",
  "type": "module",
  "description": "A2A boundary for normalized relational-graph metrology and siloxane-zeolite rigidity simulation.",
  "exports": {
    "./client": "./src/client.mjs",
    "./siloxane-zeolite-rigidity": "./src/siloxane-zeolite-rigidity.mjs",
    "./siloxane-zeolite-rigidity-protocol": "./src/siloxane-zeolite-rigidity-protocol.mjs",
