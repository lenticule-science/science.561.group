{
  "name": "@lenticule-science/software-change-proposal-assay",
  "version": "0.1.4",
  "type": "module",
  "exports": {
    ".": "./src/client.mjs",
    "./client": "./src/client.mjs",
    "./executor": "./src/a2a-executor.mjs"
  },
  "bin": {
    "execute-software-change-proposal-assay-a2a-message": "scripts/execute-a2a-message.mjs",
    "serve-software-change-proposal-assay-a2a": "scripts/serve-a2a.mjs"
  },
  "scripts": {
