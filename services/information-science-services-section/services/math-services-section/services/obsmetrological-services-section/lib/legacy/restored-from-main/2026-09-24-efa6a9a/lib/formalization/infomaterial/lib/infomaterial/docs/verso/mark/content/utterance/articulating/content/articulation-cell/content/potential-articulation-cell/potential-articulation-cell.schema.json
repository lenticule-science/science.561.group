{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mark/content/utterance/articulating/content/articulation-cell/content/potential-articulation-cell",
  "title": "potential-articulation-cell",
  "description": "The initial corner of the articulation-cell partition - neither side articulated (no, no). The seed presentation of articulating's codomain, from which active, stable, and absurd are reached.",
  "allOf": [
    {
      "$ref": "mark/content/utterance/articulating/content/articulation-cell"
    }
  ],
  "type": "object",
  "required": [
    "token-articulated",
    "claim-articulated"
  ],
  "properties": {
    "token-articulated": {
      "const": false,
      "description": "token side not yet articulated"
    },
    "claim-articulated": {
      "const": false,
      "description": "claim side not yet articulated"
    }
  }
}
