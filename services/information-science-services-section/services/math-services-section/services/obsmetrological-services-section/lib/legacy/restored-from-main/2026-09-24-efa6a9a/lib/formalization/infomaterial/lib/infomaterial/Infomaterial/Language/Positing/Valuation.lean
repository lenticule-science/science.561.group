import Infomaterial.Language.Predicating.Cell
import Infomaterial.Language.Positing.Charge

/-!
# Positing.Valuation

The charge assignment generated by positing: each predication cell receives a
bilattice charge, with the knowledge-least valuation as the seed for settling.
-/

namespace Infomaterial

/-! ## Valuation - the charge assignment -/

/-- A valuation assigns a charge to each predication cell. -/
abbrev Valuation := PredicationCell -> Charge

namespace Valuation

/-- The knowledge-least valuation positing seeds: bottom charge on every cell of
the predication base. -/
def knowledgeLeast : Valuation := fun _ => Charge.kBot

/-- Pointwise knowledge order on valuations. -/
def leK (v w : Valuation) : Prop := forall phi, Charge.leK (v phi) (w phi) = true

/-- The knowledge-least valuation is below every valuation. -/
theorem knowledgeLeast_le (v : Valuation) : leK knowledgeLeast v := by
  intro phi
  exact Charge.kBot_leK (v phi)

/-- Pointwise knowledge-join of valuations. -/
def joinK (v w : Valuation) : Valuation := fun phi => Charge.joinK (v phi) (w phi)

end Valuation

end Infomaterial
