{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary/terms/integral-domain",
  "title": "integral-domain",
  "description": "A commutative ring with no zero divisors and 1≠0 — the object generated by `cancelling` a ring.",
  "allOf": [
    {
      "$ref": "./ring.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "commutativity",
    "no-zero-divisors"
  ],
  "properties": {
    "commutativity": {
      "description": "multiplication commutes",
      "const": true
    },
    "no-zero-divisors": {
      "description": "a·b=0 ⟹ a=0 or b=0 (cancellation holds)",
      "const": true
    }
  }
}
