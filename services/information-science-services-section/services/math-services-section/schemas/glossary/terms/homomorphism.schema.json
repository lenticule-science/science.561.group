{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary/terms/homomorphism",
  "title": "homomorphism",
  "description": "A structure-preserving map between magmas — generated by `mapping`. Not an algebraic structure but a morphism; the root of the homomorphism family. Its source and target are magmas.",
  "type": "object",
  "required": [
    "source",
    "target",
    "preserves-operation"
  ],
  "properties": {
    "source": {
      "description": "domain magma A",
      "$ref": "./magma.schema.json"
    },
    "target": {
      "description": "codomain magma B",
      "$ref": "./magma.schema.json"
    },
    "preserves-operation": {
      "description": "f(a ∗ b) = f(a) · f(b)",
      "const": true
    }
  }
}
