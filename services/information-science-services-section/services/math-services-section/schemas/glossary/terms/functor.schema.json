{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "glossary/terms/functor",
  "title": "functor",
  "description": "A structure-preserving map between categories: sends objects to objects and morphisms to morphisms, preserving composition and identities. The homomorphism of categories. Not itself a category — generated by `functoring`.",
  "type": "object",
  "required": [
    "source",
    "target",
    "preserves-composition",
    "preserves-identity"
  ],
  "properties": {
    "source": {
      "description": "the domain category C",
      "$ref": "./category.schema.json"
    },
    "target": {
      "description": "the codomain category D",
      "$ref": "./category.schema.json"
    },
    "preserves-composition": {
      "description": "F(g ∘ f) = F(g) ∘ F(f)",
      "const": true
    },
    "preserves-identity": {
      "description": "F(id_A) = id_{F(A)}",
      "const": true
    }
  }
}
