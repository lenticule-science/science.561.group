{
  "name": "@emsenn/animating",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "keywords": [
    "relational-computing",
    "relational-computing-kernel"
  ],
  "description": "Animating is the agency reading of @emsenn/relating: one descent read as becoming/doing/working/governing and glued into an interior agent. Carriers are single-source JSON-Schema literals registered through Relating's category kernel; actions are Relating actions projected to CLI/OpenAPI/MCP/web with no package-local schema codegen.",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "clean": "rm -rf dist .tmp",
    "check": "tsc --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.scripts.json && chmod +x dist/scripts/*.mjs",
    "test": "pnpm run build && node --test \"test/*.test.mjs\"",
    "verify": "pnpm run check && pnpm run build",
    "rebuild": "pnpm run clean && pnpm run build",
    "examples": "node examples/agency-descent.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "animate": "./dist/scripts/cli.mjs",
    "animate-serve": "./dist/scripts/serve.mjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "dependencies": {
    "@emsenn/communicating": "workspace:*",
    "@emsenn/knowing": "workspace:*",
    "@emsenn/playing": "workspace:*",
    "@emsenn/relating": "workspace:*"
  },
  "devDependencies": {
    "@emsenn/organizing": "workspace:*",
    "@emsenn/socializing": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./becoming": {
      "types": "./dist/becoming/index.d.mts",
      "import": "./dist/becoming/index.mjs"
    },
    "./becoming/doing": {
      "types": "./dist/becoming/doing/index.d.mts",
      "import": "./dist/becoming/doing/index.mjs"
    },
    "./becoming/doing/embodying": {
      "types": "./dist/becoming/doing/embodying/index.d.mts",
      "import": "./dist/becoming/doing/embodying/index.mjs"
    },
    "./becoming/doing/working": {
      "types": "./dist/becoming/doing/working/index.d.mts",
      "import": "./dist/becoming/doing/working/index.mjs"
    },
    "./becoming/doing/working/governing": {
      "types": "./dist/becoming/doing/working/governing/index.d.mts",
      "import": "./dist/becoming/doing/working/governing/index.mjs"
    },
    "./writing/captp": {
      "types": "./dist/writing/captp/index.d.mts",
      "import": "./dist/writing/captp/index.mjs"
    },
    "./writing/openai-chat": {
      "types": "./dist/writing/openai-chat/index.d.mts",
      "import": "./dist/writing/openai-chat/index.mjs"
    },
    "./package.json": "./package.json"
  }
}
