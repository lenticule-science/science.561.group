#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -z "${repo_root}" ]]; then
  exit 0
fi
cd "${repo_root}"

fail() { printf '%s\n' "$*" >&2; return 1; }
has_cmd() { command -v "$1" >/dev/null 2>&1; }

changed_files() {
  git diff --cached --name-only --diff-filter=ACMR
}

check_no_trailing_whitespace() {
  local bad=0
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    if has_cmd file && file -b --mime "$f" | grep -q "charset=binary"; then
      continue
    fi
    if grep -nE "[[:blank:]]+$" "$f" >/dev/null 2>&1; then
      printf 'Trailing whitespace: %s\n' "$f" >&2
      bad=1
    fi
  done < <(changed_files)
  [[ $bad -eq 0 ]]
}

check_large_files() {
  local limit_bytes="${1:-10485760}" # 10 MiB
  local bad=0
  while IFS= read -r f; do
    [[ -f "$f" ]] || continue
    local size
    size="$(wc -c <"$f" | tr -d ' ')"
    if [[ "$size" -gt "$limit_bytes" ]]; then
      printf 'Large file staged (%s bytes): %s\n' "$size" "$f" >&2
      bad=1
    fi
  done < <(changed_files)
  [[ $bad -eq 0 ]]
}

check_no_trailing_whitespace || fail "Fix trailing whitespace (or commit with --no-verify)."
check_large_files || fail "Refusing to commit large files (adjust hook if needed)."

if [[ -f "pyproject.toml" ]] && has_cmd ruff; then
  echo "hook: ruff check ."
  ruff check .
fi

if [[ -f "Cargo.toml" ]] && has_cmd cargo; then
  echo "hook: cargo fmt --check"
  cargo fmt --check >/dev/null 2>&1 || fail "Run: cargo fmt"
fi

# MkDocs build is intentionally not run on pre-commit (too slow/noisy); see pre-push.

