{
  "name": "@red-cup-engineering/relational-domain-provider",
  "version": "0.1.3",
  "type": "module",
  "description": "The narrow relational carrier/action and finite linguistic-law surface consumed by communicating.",
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist",
    "types",
    "provenance/communicating-symbols.json",
    "README.md"
  ],
  "main": "./dist/src/index.mjs",
  "types": "./types/index.d.mts",
  "exports": {
    ".": {
      "types": "./types/index.d.mts",
      "import": "./dist/src/index.mjs"
    },
    "./writing": {
      "types": "./types/writing.d.mts",
      "import": "./dist/src/writing.mjs"
    },
    "./provenance/communicating-symbols.json": "./provenance/communicating-symbols.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs test/*/*.test.mjs test/*/*/*.test.mjs",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@lenticule-science/articulating": "0.2.2",
    "@red-cup-engineering/json-codec-service": "0.1.6",
    "@red-cup-engineering/relation-model-notation": "0.0.2",
    "@red-cup-engineering/relation-model-notation-eval": "0.0.4",
    "@red-cup-engineering/relation-model-notation-json-codec": "0.0.6",
    "@red-cup-engineering/relation-model-notation-typing": "0.0.2",
    "@red-cup-engineering/typed-resource-classification-kernel-service": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "sideEffects": false,
  "license": "UNLICENSED"
}
