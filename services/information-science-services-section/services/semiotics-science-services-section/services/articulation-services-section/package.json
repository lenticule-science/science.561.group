{
  "name": "@lenticule-science/articulating",
  "version": "0.4.0",
  "engines": {
    "forge": "1.7.1"
  },
  "type": "module",
  "description": "Articulating: the Node and EVM law of admitted marks, utterance, free recursion, predication, positing, and settling.",
  "main": "./dist/lib/articulating/index.mjs",
  "types": "./dist/lib/articulating/index.d.mts",
  "files": [
    "dist",
    "data/state/forge-out/Mark.sol",
    "data/state/forge-out/Utterance.sol",
    "data/state/forge-out/Articulating.sol",
    "data/state/forge-out/ArticulationCell.sol",
    "content/deployments"
  ],
  "scripts": {
    "check:node": "tsc --noEmit",
    "build": "npm run build:node",
    "build:node": "tsc -p tsconfig.build.json",
    "check": "npm run check:node && forge build --force",
    "test": "npm run test:node && forge test",
    "test:node": "node --test \"test/**/*.test.mjs\"",
    "prepack": "npm run check && npm run build:node"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.20.1",
    "@red-cup-engineering/canonical-json-service": "0.2.1",
    "@red-cup-engineering/computer-data-type-engine": "0.1.0"
  },
  "dependencies": {
    "@lenticule-science/metrologic": "0.1.1",
    "@red-cup-engineering/json-codec-service": "0.2.0",
    "@red-cup-engineering/eavt": "0.10.0",
    "@red-cup-engineering/computer-data-type-engine": "0.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/lib/articulating/index.d.mts",
      "import": "./dist/lib/articulating/index.mjs"
    },
    "./predicating": {
      "types": "./dist/lib/articulating/predicating/index.d.mts",
      "import": "./dist/lib/articulating/predicating/index.mjs"
    },
    "./predicating/positing": {
      "types": "./dist/lib/articulating/predicating/positing/index.d.mts",
      "import": "./dist/lib/articulating/predicating/positing/index.mjs"
    },
    "./predicating/positing/settling": {
      "types": "./dist/lib/articulating/predicating/positing/settling/index.d.mts",
      "import": "./dist/lib/articulating/predicating/positing/settling/index.mjs"
    },
    "./predicating/positing/settling/analysis": {
      "types": "./dist/lib/articulating/predicating/positing/settling/analysis/index.d.mts",
      "import": "./dist/lib/articulating/predicating/positing/settling/analysis/index.mjs"
    },
    "./predicating/positing/settling/dynamics": {
      "types": "./dist/lib/articulating/predicating/positing/settling/dynamics/index.d.mts",
      "import": "./dist/lib/articulating/predicating/positing/settling/dynamics/index.mjs"
    },
    "./predicating/geometry": {
      "types": "./dist/lib/articulating/predicating/geometry/index.d.mts",
      "import": "./dist/lib/articulating/predicating/geometry/index.mjs"
    },
    "./predicating/geometry/spatial": {
      "types": "./dist/lib/articulating/predicating/geometry/spatial/index.d.mts",
      "import": "./dist/lib/articulating/predicating/geometry/spatial/index.mjs"
    },
    "./evm/Mark.json": "./data/state/forge-out/Mark.sol/Mark.json",
    "./evm/Utterance.json": "./data/state/forge-out/Utterance.sol/Utterance.json",
    "./evm/Articulating.json": "./data/state/forge-out/Articulating.sol/Articulating.json",
    "./evm/ArticulationCell.json": "./data/state/forge-out/ArticulationCell.sol/ArticulationCell.json",
    "./deployments/eip155-5615610.json": "./content/deployments/eip155-5615610.json",
    "./*": {
      "types": "./dist/lib/articulating/*.d.mts",
      "import": "./dist/lib/articulating/*.mjs"
    },
    "./package.json": "./package.json"
  },
