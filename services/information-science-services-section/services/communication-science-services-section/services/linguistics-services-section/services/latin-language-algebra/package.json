{
  "name": "@lenticule-science/latin-language-algebra",
  "version": "0.1.4",
  "type": "module",
  "description": "latin-language-algebra: Latin as a language fiber — its lexicon, morphology, reference, attachment and segmentation tables — presented as a live, discoverable, directly contractable micro-enterprise (a die) of linguistics-services-section.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emsenn/latin-language.git"
  },
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "solicit-service": "./src/latin-die.mjs",
    "invoke-service": "./src/latin-die.mjs"
  },
  "scripts": {
    "check": "for f in src/*.mjs test/*.mjs; do node --check \"$f\" || exit 1; done && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mjs src/*.test.mts",
    "prepack": "npm run verify"
  },
  "main": "./src/bundle.mjs",
  "exports": {
    ".": "./src/bundle.mjs",
    "./bundle": "./src/bundle.mjs",
    "./tag": "./src/tag.mjs",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@lenticule-science/communicating": "0.0.4",
    "@red-cup-engineering/semantic-content-identify-service": "0.2.7"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  },
  "files": [
    "content",
    "src/bundle.mjs",
    "src/latin-die.mjs",
    "src/semantic-identity.mjs",
    "src/tag.mjs"
  ],
  "sideEffects": false,
  "license": "UNLICENSED"
}
