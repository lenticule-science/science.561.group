{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lenticule-science:schema:leader-message-parse:1",
  "title": "Leader message candidate parse",
  "type": "object",
  "required": ["id", "kind", "candidateReading", "source", "languageMap", "forest", "discourse", "limitations"],
  "properties": {
    "id": {"type": "string", "pattern": "^urn:sha256:[a-f0-9]{64}$"},
    "kind": {"const": "lenticule-science.leader-message-parse"},
    "candidateReading": {"const": true},
    "source": {"type": "object", "required": ["sha256", "length", "text"]},
    "languageMap": {"type": "object", "required": ["id", "version", "code", "sha256"]},
    "forest": {"type": "object", "required": ["kind", "text", "readings"]},
    "discourse": {"type": "object", "required": ["commitments", "repairs"]},
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  },
  "additionalProperties": true
}
