{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:lenticule-science:schema:frame-language-map:1",
  "title": "Linguistics Services Section frame language map",
  "type": "object",
  "required": ["kind", "id", "version", "status", "vocabulary", "readings", "nonCorrespondences", "authority"],
  "properties": {
    "kind": {"const": "lenticule-science.frame-language-map"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "status": {"enum": ["candidate", "operational", "retired"]},
    "vocabulary": {"type": "array", "items": {"type": "object", "required": ["term", "localReading"]}},
    "readings": {"type": "array", "items": {"type": "object", "required": ["expression", "localReading"]}},
    "nonCorrespondences": {"type": "array", "items": {"type": "object", "required": ["left", "right", "reason"]}},
    "authority": {"type": "object", "required": ["mayPresent", "mayNotSettleLeaderIntent"]}
  },
  "additionalProperties": true
}
