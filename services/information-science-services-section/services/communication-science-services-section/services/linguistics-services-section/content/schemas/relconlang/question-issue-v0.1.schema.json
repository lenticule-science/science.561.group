{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/relconlang/question-issue-v0.1",
  "title": "RelConLang Question Issue v0.1",
  "description": "Experimental issue opened by an interrogative move. Separates target proposition, requested dimension, alternatives, and answer conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "id",
    "openedBy",
    "target",
    "issueKind",
    "answerCondition",
    "status"
  ],
  "properties": {
    "kind": {
      "const": "lenticule.relconlang.question-issue"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "openedBy": {
      "type": "integer",
      "minimum": 0
    },
    "target": {
      "$ref": "lenticule/relconlang/proposition-nucleus-v0.1"
    },
    "issueKind": {
      "enum": [
        "polar",
        "argument-hole",
        "alternative-set",
        "clarification",
        "unknown"
      ]
    },
    "openRole": {
      "enum": [
        "agent",
        "patient",
        "provenance",
        "locus",
        "kind",
        "predicate",
        "none",
        "unknown"
      ]
    },
    "alternatives": {
      "type": "array",
      "items": {}
    },
    "focusExpectation": {
      "description": "Optional role/constituent expected to carry new information in a resolving response.",
      "type": [
        "string",
        "null"
      ]
    },
    "answerCondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "compatibility"
      ],
      "properties": {
        "compatibility": {
          "enum": [
            "same-nucleus",
            "fills-open-role",
            "selects-alternative",
            "clarifies-target",
            "other",
            "unknown"
          ]
        },
        "allowedMoves": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "status": {
      "enum": [
        "open",
        "answered",
        "refused",
        "superseded",
        "abandoned",
        "undetermined"
      ]
    }
  }
}
