{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/relconlang/dialogue-deictic-context-v0.1",
  "title": "RelConLang Dialogue Deictic Context v0.1",
  "description": "Experimental speech-event context used to ground person deixis before proposition comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "turn",
    "speaker",
    "participants",
    "addressees"
  ],
  "properties": {
    "kind": {
      "const": "lenticule.relconlang.dialogue-deictic-context"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "speaker": {
      "type": "string",
      "minLength": 1
    },
    "participants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "addressees": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "firstPerson": {
          "type": "string"
        },
        "secondPerson": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "thirdPerson": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "quotedContext": {
      "description": "Optional nested context for quoted or role-shifted speech.",
      "type": [
        "object",
        "null"
      ]
    }
  }
}
