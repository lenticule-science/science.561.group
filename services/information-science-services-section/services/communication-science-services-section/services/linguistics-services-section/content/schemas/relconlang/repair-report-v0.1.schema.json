{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/relconlang/repair-report-v0.1",
  "title": "RelConLang Repair Report v0.1",
  "description": "Experimental report that an utterance proposes or marks a repair. It does not itself retract, affirm, or otherwise mutate evidence on the repair target.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "utterance",
    "speaker",
    "surfaceMechanism",
    "target",
    "proposal",
    "transition"
  ],
  "properties": {
    "kind": {
      "const": "lenticule.relconlang.repair-report"
    },
    "utterance": {
      "type": "string",
      "minLength": 1
    },
    "speaker": {
      "type": "string",
      "minLength": 1
    },
    "surfaceMechanism": {
      "enum": [
        "ren-lexical",
        "ri-replacement",
        "dialogue-repair-label",
        "other"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "reference"
      ],
      "properties": {
        "kind": {
          "enum": [
            "proposition",
            "term",
            "utterance",
            "dialogue-relevance",
            "diagnostic",
            "unknown"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "replace-term",
            "replace-proposition",
            "clarify",
            "reframe",
            "acknowledge-problem",
            "other",
            "unknown"
          ]
        },
        "replacement": {},
        "note": {
          "type": "string"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "evidenceEffect"
      ],
      "properties": {
        "status": {
          "enum": [
            "proposed",
            "accepted",
            "rejected",
            "superseded",
            "undetermined"
          ]
        },
        "evidenceEffect": {
          "enum": [
            "none-by-language-alone",
            "add-for-witness",
            "add-against-witness",
            "retract-for-witness",
            "retract-against-witness",
            "preserve-contradiction",
            "other"
          ],
          "description": "Any non-none effect requires an independently licensed evidence-transition policy or substrate operation."
        },
        "warrant": {
          "type": "array",
          "items": {}
        }
      }
    }
  }
}
