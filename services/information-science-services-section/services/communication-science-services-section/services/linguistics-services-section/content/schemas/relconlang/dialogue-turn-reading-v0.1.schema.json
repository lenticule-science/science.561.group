{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/relconlang/dialogue-turn-reading-v0.1",
  "title": "RelConLang Blind Dialogue Turn Reading v0.1",
  "description": "Experimental reading of one RelConLang dialogue turn. Separates syntax, content, indexed evidence, force, conditional-relevance relations, repair, and history. Conditional relevance is not automatically a normative obligation. No field authorizes external or institutional action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "turn",
    "speaker",
    "text",
    "syntax",
    "content",
    "evidence",
    "illocutionaryForce",
    "opens",
    "addresses",
    "remaining",
    "dialogueMove",
    "deicticContext"
  ],
  "properties": {
    "kind": {
      "const": "lenticule.relconlang.dialogue-turn-reading"
    },
    "turn": {
      "type": "integer",
      "minimum": 0
    },
    "speaker": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "syntax": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "complete",
        "obstructions"
      ],
      "properties": {
        "complete": {
          "type": "boolean"
        },
        "obstructions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "description": "Propositional/semantic reading; intentionally schema-light while the experiment determines a stable representation."
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "fiber"
      ],
      "properties": {
        "value": {
          "enum": [
            "absurd",
            "potential",
            "active",
            "stable"
          ]
        },
        "fiber": {
          "type": "string",
          "minLength": 1
        },
        "for": {
          "type": "array",
          "items": {}
        },
        "against": {
          "type": "array",
          "items": {}
        }
      }
    },
    "informationStructure": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relation",
          "target"
        ],
        "properties": {
          "relation": {
            "enum": [
              "topic",
              "focus",
              "contrast",
              "replacement"
            ]
          },
          "target": {
            "type": "string"
          }
        }
      }
    },
    "opens": {
      "type": "array",
      "description": "Conditional-relevance expectations opened by this turn; these are conversational relevancies, not automatically deontic obligations.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "minLength": 1,
            "description": "Expected response family or other relevance relation opened by the turn."
          },
          "content": {}
        }
      }
    },
    "addresses": {
      "type": "array",
      "description": "Candidate prior conditional-relevance item this turn attempts to address.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relevance",
          "compatibility"
        ],
        "properties": {
          "compatibility": {
            "enum": [
              "supported",
              "opposed",
              "partial",
              "irrelevant",
              "unknown"
            ]
          },
          "evidence": {
            "type": "array",
            "items": {}
          },
          "relevance": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repair": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "mode",
        "target"
      ],
      "properties": {
        "mode": {
          "enum": [
            "affirm",
            "retract",
            "acknowledge",
            "replace",
            "clarify",
            "unknown"
          ]
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "effect": {
          "enum": [
            "cleared",
            "persisting",
            "transformed",
            "unknown"
          ]
        }
      }
    },
    "remaining": {
      "type": "array",
      "description": "Conditional-relevance items still open after this turn; normative obligations, if modeled, belong in a separate explicitly deontic carrier.",
      "items": {
        "type": "string"
      }
    },
    "illocutionaryForce": {
      "description": "Coarse speech-act family. This is kept distinct from the finer dialogue move.",
      "enum": [
        "assertive",
        "directive",
        "commissive",
        "expressive",
        "declaration",
        "unknown"
      ]
    },
    "dialogueMove": {
      "description": "Fine-grained conversational move recovered from the language/context; not identical to illocutionary force.",
      "enum": [
        "question",
        "request",
        "answer",
        "acknowledgement",
        "refusal",
        "repair",
        "counter-question",
        "other",
        "unknown"
      ]
    },
    "deicticContext": {
      "description": "Speech-event context or a reference to it; required before first/second-person proposition comparison.",
      "anyOf": [
        {
          "$ref": "lenticule/relconlang/dialogue-deictic-context-v0.1"
        },
        {
          "type": "string",
          "minLength": 1
        }
      ]
    }
  }
}
