{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "lenticule/relconlang/emission-policy-v0.1",
  "title": "RelConLang Emission Policy v0.1",
  "description": "Experimental policy separating corpus continuation from semantic realization. It does not authorize production actions; it specifies what evidence and semantic coordinates a language experiment must preserve when producing surface text.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "mode",
    "candidate",
    "selectionalBasis",
    "epistemicBasis",
    "stanceDecision",
    "forceDecision",
    "realization",
    "receiptClass"
  ],
  "properties": {
    "kind": {
      "const": "lenticule.relconlang.emission-policy"
    },
    "mode": {
      "enum": [
        "corpus-continuation",
        "semantic-realization"
      ]
    },
    "candidate": {
      "description": "The proposition/content candidate to be verbalized.",
      "anyOf": [
        {
          "$ref": "lenticule/relconlang/proposition-nucleus-v0.1"
        },
        {
          "type": "object"
        }
      ]
    },
    "selectionalBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "permitsSurfaceCombination"
      ],
      "properties": {
        "source": {
          "enum": [
            "signcraft-saturation-fibers",
            "declared-lexicon-grammar",
            "other"
          ]
        },
        "permitsSurfaceCombination": {
          "type": "boolean"
        },
        "witnesses": {
          "type": "array",
          "items": {}
        }
      }
    },
    "epistemicBasis": {
      "description": "Evidence about the candidate proposition, not grammatical attestation. May be absent in corpus-continuation mode.",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "for",
            "against",
            "derivedReading"
          ],
          "properties": {
            "for": {
              "type": "array",
              "items": {}
            },
            "against": {
              "type": "array",
              "items": {}
            },
            "derivedReading": {
              "enum": [
                "absurd",
                "potential",
                "active",
                "stable"
              ]
            }
          }
        }
      ]
    },
    "stanceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "particle"
      ],
      "properties": {
        "source": {
          "enum": [
            "none",
            "explicit-plan",
            "current-evidence-policy",
            "corpus-style-sampling",
            "other"
          ]
        },
        "particle": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "ta",
            "na",
            "sha",
            "mu",
            null
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "forceDecision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "force",
        "dialogueMove"
      ],
      "properties": {
        "source": {
          "enum": [
            "explicit-plan",
            "dialogue-state",
            "corpus-style-sampling",
            "other"
          ]
        },
        "force": {
          "enum": [
            "assertive",
            "directive",
            "commissive",
            "expressive",
            "declaration",
            "unknown"
          ]
        },
        "dialogueMove": {
          "enum": [
            "none",
            "question",
            "request",
            "answer",
            "acknowledgement",
            "refusal",
            "repair",
            "counter-question",
            "other",
            "unknown"
          ]
        }
      }
    },
    "realization": {
      "$ref": "lenticule/relconlang/realization-plan-v0.1"
    },
    "receiptClass": {
      "enum": [
        "sampling-receipt",
        "semantic-preservation-receipt",
        "evidential-warrant-receipt",
        "combined"
      ],
      "description": "Sampling provenance and epistemic warrant are deliberately different receipt classes."
    },
    "assertions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
