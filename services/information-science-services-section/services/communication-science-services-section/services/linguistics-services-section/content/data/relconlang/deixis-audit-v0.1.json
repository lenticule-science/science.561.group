{
  "kind": "lenticule.relconlang.deixis-audit",
  "version": "0.1",
  "status": "experimental",
  "documentedPronouns": {
    "mi": {
      "person": 1,
      "number": "sg",
      "gloss": "I / speaker"
    },
    "tu": {
      "person": 2,
      "number": "sg",
      "gloss": "you / addressee"
    },
    "sa": {
      "person": 3,
      "number": "sg"
    },
    "ni": {
      "person": 3,
      "number": "both"
    }
  },
  "sharedResolver": {
    "scope": "third-person anaphora only",
    "firstSecondPersonGrounding": false,
    "source": "communicating/src/speaking/listening/understanding/referring.mts"
  },
  "dialogueCases": [
    {
      "id": "legacy-capability-question-answer",
      "turns": [
        {
          "speaker": "mi",
          "text": "ku tu ga kan do kano?",
          "surfaceSubject": "tu",
          "deicticReading": "addressee of mi"
        },
        {
          "speaker": "tu",
          "text": "se tu ga kan do kano.",
          "surfaceSubject": "tu",
          "deicticReading": "addressee of speaker tu"
        }
      ],
      "legacyLabel": "question-answer",
      "status": "provisional",
      "issue": "Repeated surface tu does not preserve referent when speaker changes unless a nonstandard non-deictic interpretation is intended."
    },
    {
      "id": "legacy-request-acknowledgement",
      "turns": [
        {
          "speaker": "mi",
          "text": "du tu ga ran do kelu.",
          "surfaceSubject": "tu",
          "deicticReading": "addressee of mi"
        },
        {
          "speaker": "tu",
          "text": "ha tu ga ran-en do kelu.",
          "surfaceSubject": "tu",
          "deicticReading": "addressee of speaker tu"
        }
      ],
      "legacyLabel": "request-acknowledgement",
      "status": "provisional",
      "issue": "The response does not straightforwardly predicate ongoing relating of the responder under documented second-person semantics."
    }
  ],
  "implication": "Dialogue relation scoring must compare context-resolved referents, not raw pronoun strings."
}
