{
  "kind": "lenticule.relconlang.aspect-admission-assay",
  "version": "0.1",
  "status": "experimental",
  "purpose": "Distinguish productive morphological recognition from lexical and mathematical semantic warrant.",
  "cases": [
    {
      "id": "known-process",
      "form": "ran-en",
      "declaredRoot": true,
      "expectedMorphology": [
        "verb",
        "aspect:process"
      ],
      "semanticClaim": "ongoing relating"
    },
    {
      "id": "known-inchoative",
      "form": "var-ai",
      "declaredRoot": true,
      "expectedMorphology": [
        "verb",
        "aspect:inchoative"
      ],
      "semanticClaim": "begin transforming"
    },
    {
      "id": "known-settled",
      "form": "ran-um",
      "declaredRoot": true,
      "expectedMorphology": [
        "verb",
        "aspect:settled"
      ],
      "semanticClaim": "resultative/settled aspect; mathematical fixed-point interpretation not assumed"
    },
    {
      "id": "known-release",
      "form": "ran-o",
      "declaredRoot": true,
      "expectedMorphology": [
        "verb",
        "aspect:release"
      ],
      "semanticClaim": "release/discharge aspect"
    },
    {
      "id": "nonce-settled",
      "form": "blarg-um",
      "declaredRoot": false,
      "expectedMorphology": [
        "verb",
        "aspect:settled"
      ],
      "semanticClaim": "none; tests whether regex morphology admits an undeclared stem"
    },
    {
      "id": "nonce-release",
      "form": "blarg-o",
      "declaredRoot": false,
      "expectedMorphology": [
        "verb",
        "aspect:release"
      ],
      "semanticClaim": "none; tests whether regex morphology admits an undeclared stem"
    }
  ],
  "hypothesis": "Current compiler morphologyTags/featureTags will recognize nonce suffixed forms despite absence from rootPatternRules; this would show syntactic morphological productivity without lexical-semantic admission."
}
