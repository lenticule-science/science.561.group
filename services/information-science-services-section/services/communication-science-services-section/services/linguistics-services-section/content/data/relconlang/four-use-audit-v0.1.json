      "interpretation": {
        "potential": "supported hypothesis",
        "active": "negative evidence",
        "stable": "conflicting evidence",
        "absurd": "no evidence"
      },
      "status": "explicit-bilattice-application",
      "source": ".../communicating/src/speaking/listening/parsing/charging.mts"
    },
    {
