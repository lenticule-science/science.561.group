  "rule": "Every use must state its fiber and coordinate interpretation. Reusing a ChargeValueName is not itself a semantic bridge.",
  "derivedBridges": [
    {
      "id": "relconlang-chu-row-to-clause-stance",
      "operation": "knowledge-order join across the truth/falsity state axis",
      "result": {
        "ta": "potential",
        "na": "potential",
        "sha": "stable",
        "mu": "absurd"
      },
      "status": "derived from existing matrix + algebra; not implemented in parser"
