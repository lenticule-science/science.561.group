{
  "kind": "lenticule.relconlang.register-profiles",
  "version": "0.1",
  "status": "experimental-reconstruction",
  "profiles": [
    {
      "id": "everyday",
      "goals": [
        "brevity",
        "low marking when recoverable"
      ],
      "realizationPreferences": {
        "roleVisibility": "position-only-preferred",
        "obliques": "as-needed",
        "aspect": "as-needed",
        "stance": "independent",
        "dialogue": "independent"
      },
      "invariants": [
        "semantic roles must remain recoverable enough for the intended context"
      ],
      "noninvariants": [
        "three-token maximum"
      ]
    },
    {
      "id": "technical",
      "goals": [
        "inspectability",
        "low ambiguity",
        "handoff readability"
      ],
      "realizationPreferences": {
        "roleVisibility": "explicit-ga-do-preferred",
        "provenance": "prefer when evidentially relevant",
        "locus": "prefer when context matters",
        "kind": "prefer when ascription matters",
        "aspect": "prefer when process state matters",
        "stance": "independent and explicit only when intended"
      },
      "invariants": [
        "do not invent provenance/context/kind merely to sound technical"
      ]
    },
    {
      "id": "proof",
      "goals": [
        "explicit proposition structure",
        "warrant visibility",
        "repair/contradiction visibility when actually present"
      ],
      "realizationPreferences": {
        "roleVisibility": "explicit",
        "ccomp": "use for proposition targets when needed",
        "provenance": "prefer warrants/sources",
        "stance": "orthogonal",
        "contradiction": "sha only when contradiction-held stance is intended"
      },
      "invariants": [
        "proof register does not imply sha",
        "sha does not imply proof",
        "linguistic proof register is not a Lean proof receipt"
      ]
    },
    {
      "id": "ritual",
      "goals": [
        "memory",
        "parallelism",
        "collective uptake",
        "lawful repetition"
      ],
      "realizationPreferences": {
        "parallelism": "preferred",
        "dialogueParticles": "only when their move semantics are actually intended",
        "stance": "independent",
        "roleVisibility": "may be explicit for rhythmic/structural reasons"
      },
      "invariants": [
        "parallel form must not override proposition/deixis/dialogue semantics"
      ]
    }
  ],
  "sharedRegisterFiberCandidate": {
    "register": [
      "everyday",
      "technical",
      "proof",
      "ritual"
    ],
    "style": [
      "plain",
      "explicit",
      "parallel"
    ],
    "evidentiality": [
      "unmarked",
      "source-explicit",
      "stance-explicit"
    ],
    "politeness": [],
    "genre": [
      "utterance",
      "log",
      "proof-discussion",
      "ritual"
    ]
  },
  "caution": "These values are an experimental mapping into the generic register fiber; they are not yet written into the RelConLang source manifest."
}
