  "program": "lenticule:relconlang-experimental-semantics",
  "policy": {
    "productionIntegration": false,
    "rule": "Prefer experiments that discriminate competing semantic models. Do not patch source grammar merely to make a current test pass.",
    "maturity": "Each node reports evidence layer: source inspection, predicted differential, executable current test, or new assay."
  },
  "phases": [
    {
      "id": "P0",
      "name": "carrier semantics",
      "purpose": "Determine what the mathematical carriers mean before mapping grammar into them."
    },
    {
      "id": "P1",
      "name": "single-turn normalization",
      "purpose": "Recover a context-grounded proposition plus independently represented stance, force, aspect, information structure, and provenance."
    },
    {
      "id": "P2",
      "name": "cross-turn dialogue",
      "purpose": "Infer question/relevance/response/repair relations without hand-authored adjacency metadata."
    },
    {
      "id": "P3",
      "name": "realization",
      "purpose": "Generate surface RelConLang from explicit semantic plans and measure round-trip loss."
    },
    {
      "id": "P4",
      "name": "learning and language evolution",
      "purpose": "Test learned saturation, root-family productivity, and later diachronic change without leaking gold semantics."
    }
  ],
