{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lenticule.science/schemas/koios-asset-grammar-v3.json",
  "title": "Koios visual scene graph v3",
  "type": "object",
  "required": [
    "version",
    "consumer",
    "use",
    "canvas",
    "projection",
    "palette",
    "layers"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": "koios.visual-scene/v3"
    },
    "consumer": {
      "type": "string",
      "minLength": 1
    },
    "use": {
      "enum": [
        "article-hero",
        "article-inline",
        "homepage-card",
        "social-card",
        "email",
        "video-still",
        "slide",
        "symbol-library"
      ]
    },
    "canvas": {
      "type": "object",
      "required": [
        "aspectRatio"
      ],
      "additionalProperties": false,
      "properties": {
        "aspectRatio": {
          "enum": [
            "1:1",
            "4:5",
            "3:2",
            "16:9",
            "21:9"
          ]
        },
        "safeArea": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.25
        }
      }
    },
    "palette": {
      "type": "object",
      "required": [
        "paper",
        "ink",
        "signal"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^#[0-9A-Fa-f]{6}$"
      },
      "properties": {
        "paper": {
          "const": "#fbfaf7"
        },
        "ink": {
          "const": "#171a21"
        },
        "signal": {
          "const": "#000088"
        }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "id",
          "role",
          "generatorPolicy",
          "z",
          "layout"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
          },
          "role": {
            "enum": [
              "primary-symbol",
              "actor",
              "institution",
              "terrain",
              "world",
              "trajectory",
              "threshold",
              "signal",
              "network",
              "evidence",
              "background-field",
              "ornament"
            ]
          },
          "generatorPolicy": {
            "enum": [
              "generate",
              "reuse-first",
              "deterministic-only"
            ]
          },
          "primitiveHints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "circle",
                "arc",
                "bar",
                "wedge",
                "threshold",
                "horizon",
                "line-field",
                "silhouette",
                "terrain",
                "lattice",
                "aperture",
                "isometric-block",
                "isometric-plane",
                "isometric-column",
                "isometric-stair"
              ]
            }
          },
          "paletteRoles": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "paper",
                "ink",
                "signal",
                "signal-secondary",
                "fog",
                "mineral"
              ]
            }
          },
          "transparent": {
            "type": "boolean"
          },
          "z": {
            "type": "integer",
            "minimum": 0,
            "maximum": 99
          },
          "semanticPrompt": {
            "type": "string",
            "maxLength": 2000
          },
          "avoid": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          },
          "layout": {
            "type": "object",
            "required": [
              "x",
              "y",
              "width",
              "height"
            ],
            "additionalProperties": false,
            "properties": {
              "x": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "y": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "anchor": {
                "enum": [
                  "center",
                  "north",
                  "south",
                  "east",
                  "west",
                  "north-east",
                  "north-west",
                  "south-east",
                  "south-west"
                ],
                "default": "center"
              },
              "fit": {
                "enum": [
                  "contain",
                  "cover"
                ],
                "default": "contain"
              },
              "opacity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1,
                "default": 1
              },
              "rotation": {
                "type": "number",
                "minimum": -180,
                "maximum": 180,
                "default": 0
              },
              "clip": {
                "type": "boolean",
                "default": true
              },
              "blend": {
                "enum": [
                  "normal",
                  "multiply",
                  "screen"
                ],
                "default": "normal"
              }
            }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wordmark": {
          "type": "boolean",
          "default": false
        },
        "textMode": {
          "enum": [
            "none",
            "deterministic-overlay"
          ],
          "default": "deterministic-overlay"
        },
        "cropStrategy": {
          "enum": [
            "cover",
            "contain",
            "subject-aware"
          ],
          "default": "subject-aware"
        },
        "compositionMode": {
          "enum": [
            "normalized-scene"
          ],
          "const": "normalized-scene"
        },
        "apertureMark": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "projection": {
      "type": "object",
      "required": [
        "kind",
        "axisAngleDeg",
        "parallel"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "isometric"
        },
        "axisAngleDeg": {
          "const": 30
        },
        "parallel": {
          "const": true
        }
      }
    }
  }
}
