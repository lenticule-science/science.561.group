{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/session/library/turn/doing/working/logging-a-turn/logging-a-turn-in-a-session/logging-a-turn-in-a-session-with-an-inference-model/logging-a-turn-in-a-session-with-an-inference-model.schema.json",
  "title": "Logging-a-turn-in-a-session-with-an-inference-model (transformer)",
  "description": "Leaf of the logging specialization chain. Input is {session-id, inference-model, turn}; output is {appended, row, error?}. The turn is validated against the turn schema before append; the target jsonl is resolved to the realizing leaf's library/<session-id>/<session-id>.jsonl.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["session-id", "inference-model", "turn"],
      "additionalProperties": false,
      "properties": {
        "session-id": {
          "description": "The session-id naming the session the turn belongs to.",
          "$ref": "https://research-notes.561.group/hacking/library/predication-notes/identifier/library/name/name.schema.json"
        },
        "inference-model": {
          "description": "The model identifier (e.g., claude-opus-4-7).",
          "type": "string",
          "minLength": 1
        },
        "turn": {
          "description": "The turn-record being logged. Validated against the turn JSON schema.",
          "$ref": "https://research-notes.561.group/hacking/library/predication-notes/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/session/library/turn/turn.schema.json"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["appended"],
      "additionalProperties": false,
      "properties": {
        "appended": { "type": "boolean" },
        "row": {
          "type": "object",
          "required": ["e", "a", "v", "t"],
          "properties": {
            "e": { "type": "string" },
            "a": { "type": "string" },
            "v": {},
            "t": { "type": "string", "format": "date-time" }
          }
        },
        "error": { "type": "string" }
      }
    }
  }
}
