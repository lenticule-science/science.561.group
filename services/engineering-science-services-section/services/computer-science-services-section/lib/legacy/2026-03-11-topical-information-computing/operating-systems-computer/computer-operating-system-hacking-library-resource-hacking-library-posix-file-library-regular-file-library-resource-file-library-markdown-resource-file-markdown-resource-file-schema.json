{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/code/structures/library/resource/markdown-resource-file.schema.json",
  "title": "markdown-resource-file-observation",
  "description": "Per-form observation schema for a markdown-resource-file. Validates the optional `references:` frontmatter map: each entry inhabits cited-work shape (citations.md §5.2-§5.4). Applies to every observation with isMarkdown === true; composes orthogonally with per-role schemas via allOf accumulation.",
  "type": "object",
  "properties": {
    "frontmatter": {
      "type": "object",
      "properties": {
        "references": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["class", "authors", "year", "title"],
            "properties": {
              "class": {
                "enum": ["book", "article", "chapter", "preprint", "report", "thesis", "online", "software"],
                "description": "The cited-work class. Determines which class-specific cells the entry must additionally carry."
              },
              "authors": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "description": "Non-empty list of authors. Each author is a string in `\"Surname, Firstname\"` order (citations.md §5.5); corporate or collective authors appear as a single string with no comma inversion."
              },
              "year": {
                "type": "integer",
                "description": "Year of publication."
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "description": "Full title of the work."
              },
              "journal": { "type": "string" },
              "in": { "type": "string", "description": "Title of the containing volume for class: chapter." },
              "editors": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              },
              "pages": { "type": "string" },
              "publisher": { "type": "string" },
              "location": { "type": "string" },
              "volume": { "type": ["integer", "string"] },
              "issue": { "type": ["integer", "string"] },
              "doi": { "type": "string", "description": "DOI without the `https://doi.org/` prefix." },
              "isbn": { "type": "string", "description": "ISBN-13 preferred." },
              "url": { "type": "string", "format": "uri" },
              "edition": { "type": "string" },
              "series": { "type": "string" },
              "repository": { "type": "string", "description": "Archive or preprint repository (e.g. arXiv, SSRN, PhilArchive)." },
              "institution": { "type": "string" },
              "degree": { "enum": ["phd", "masters"] },
              "note": { "type": "string" }
            },
            "allOf": [
              {
                "if": { "properties": { "class": { "const": "article" } }, "required": ["class"] },
                "then": { "required": ["journal"] }
              },
              {
                "if": { "properties": { "class": { "const": "chapter" } }, "required": ["class"] },
                "then": { "required": ["in"] }
              },
              {
                "if": { "properties": { "class": { "const": "preprint" } }, "required": ["class"] },
                "then": { "required": ["repository"] }
              },
              {
                "if": { "properties": { "class": { "const": "report" } }, "required": ["class"] },
                "then": { "required": ["institution"] }
              },
              {
                "if": { "properties": { "class": { "const": "thesis" } }, "required": ["class"] },
                "then": { "required": ["institution", "degree"] }
              },
              {
                "if": { "properties": { "class": { "const": "online" } }, "required": ["class"] },
                "then": { "required": ["url"] }
              }
            ]
          }
        }
      }
    }
  }
}
