{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/computer-operating-system.schema.json",
  "title": "computer-operating-system",
  "description": "Schema for the computer-operating-system kind — an operating-system bound to a POSIX 1003.1 runtime, with file types, signals, processes, and the byte-level standards conformance the operator's draft layout requires. Specialization of operating-system. 561 is an instance.",
  "allOf": [{ "$ref": "https://research-notes.561.group/hacking/library/predication-notes/object/library/thing/library/system/library/operating-system/operating-system.schema.json" }],
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "kind-of": { "type": "string", "const": "operating-system" },
    "posix-conformance": { "type": "string", "default": "IEEE 1003.1" },
    "implementation-language": { "type": "string", "default": "ESM Node" },
    "speaks-protocols": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["posix-conformance", "implementation-language"]
}
