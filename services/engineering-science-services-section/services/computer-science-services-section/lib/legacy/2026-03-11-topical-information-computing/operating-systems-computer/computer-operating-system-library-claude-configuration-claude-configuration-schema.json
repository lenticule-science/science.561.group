{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/claude-configuration/claude-configuration.schema.json",
  "title": "Claude configuration",
  "description": "JSON Schema for a claude-configuration instance: the bundle of files that installs a character against a Claude Code project root.",
  "type": "object",
  "required": ["installs-character", "settings-path", "mcp-config-path"],
  "additionalProperties": true,
  "properties": {
    "installs-character": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "description": "Character slug the configuration installs."
    },
    "settings-path": {"type": "string"},
    "mcp-config-path": {"type": "string"},
    "claude-md-path": {"type": "string"},
    "permissions-allow": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Tool patterns the configuration allows without prompt."
    },
    "hooks": {
      "type": "object",
      "description": "Map from lifecycle-event slug to hook handler reference.",
      "additionalProperties": true
    },
    "installed-at": {"type": "string", "format": "date-time"}
  }
}
