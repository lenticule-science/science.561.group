{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/message/receiving-a-message-from-a-script/receiving-a-message-from-a-script.schema.json",
  "title": "receiving-a-message-from-a-script",
  "description": "Input and output shape for turning a local script invocation result into the structured response envelope returned by the script dispatch chain.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["sendResult"],
      "additionalProperties": false,
      "properties": {
        "sendResult": {
          "$ref": "https://research-notes.561.group/hacking/library/predication-notes/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/parameters/sending-parameters-to-a-script/sending-parameters-to-a-script.schema.json#/$defs/send-result"
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["scriptPath", "parameters", "return-value", "sent-at", "received-at"],
      "additionalProperties": false,
      "properties": {
        "scriptPath": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "return-value": {},
        "sent-at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "received-at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
