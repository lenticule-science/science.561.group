{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/code/structures/library/document/specification.schema.json",
  "title": "specification-observation",
  "description": "Per-role observation schema for a specification record at work/governance/rules/specifications/<slug>.md. Per the specification spec, MUST carry name, description, status. SHOULD carry requires, supersedes, superseded-by, topic, applies-to-runtimes, ordering. The filename slug encodes the entity kind the spec pins; no frontmatter key repeats this.",
  "type": "object",
  "required": ["roleClass", "frontmatter"],
  "properties": {
    "roleClass": { "const": "specification" },
    "frontmatter": {
      "type": "object",
      "required": ["name", "description", "status"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "status": { "enum": ["draft", "active", "superseded"] },
        "requires": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "supersedes": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "superseded-by": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "topic": { "type": "string" },
        "applies-to-runtimes": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        },
        "ordering": { "type": ["integer", "string"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "superseded" } }, "required": ["status"] },
          "then": { "required": ["superseded-by"] }
        },
        {
          "not": { "required": ["derives-from"] }
        }
      ]
    }
  }
}
