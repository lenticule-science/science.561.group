{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/session/library/git-session/git-session.schema.json",
  "title": "Git session",
  "description": "JSON Schema for a git-session: a session bracketed by a git operation's lifecycle hooks.",
  "type": "object",
  "required": ["triggers-on", "started-at"],
  "additionalProperties": true,
  "properties": {
    "triggers-on": {
      "type": "string",
      "enum": ["commit", "push", "merge", "rebase", "checkout"]
    },
    "staged-changes": {
      "type": "array",
      "items": {"type": "string"}
    },
    "commit-object": {
      "type": "string",
      "pattern": "^[0-9a-f]{4,40}$"
    },
    "runs-as-identity": {
      "type": "string",
      "description": "Local git identity string at the time of the operation."
    },
    "started-at": {"type": "string", "format": "date-time"},
    "ended-at": {"type": "string", "format": "date-time"}
  }
}
