{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/work-item/library/lifecycle-state-machine/lifecycle-state-machine.schema.json",
  "title": "Lifecycle-state-machine",
  "description": "JSON Schema for the lifecycle-state-machine record. Validates the transition table.",
  "type": "object",
  "required": ["transitions"],
  "properties": {
    "transitions": {
      "type": "object",
      "propertyNames": {"enum": ["open", "in-progress", "blocked", "review", "done", "deferred", "abandoned", "reopened"]},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "string", "enum": ["open", "in-progress", "blocked", "review", "done", "deferred", "abandoned", "reopened"]},
        "uniqueItems": true
      }
    }
  }
}
