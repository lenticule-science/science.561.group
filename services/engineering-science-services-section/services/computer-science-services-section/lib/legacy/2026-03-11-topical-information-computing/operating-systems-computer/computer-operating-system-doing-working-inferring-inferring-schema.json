{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/doing/working/inferring/inferring.schema.json",
  "title": "Inferring (transformer)",
  "description": "Input/output shape of the inferring transformer: input is a query plus a workitem; output is an inference plus its outcome. Specializations decompose by what is being inferred.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["query"],
      "properties": {
        "query": { "description": "The query to be inferred." },
        "workitem": { "description": "Optional workitem context for the dispatch." }
      }
    },
    "output": {
      "type": "object",
      "required": ["outcome"],
      "properties": {
        "outcome": { "enum": ["ok", "error", "forwarded"] },
        "inference": { "description": "The produced inference, when outcome is ok." },
        "error": { "type": "string" }
      }
    }
  }
}
