{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/resource-file/resource-file.schema.json",
  "title": "Resource file",
  "description": "JSON Schema for a resource-file record: a regular-file that additionally realizes a resource via a parse functor. The pullback of regular-file × resource along the role-class partition.",
  "type": "object",
  "required": ["has-path", "specializing", "realizing"],
  "additionalProperties": true,
  "properties": {
    "has-path": {"type": "string"},
    "specializing": {"type": "string", "const": "regular-file"},
    "realizing": {"type": "string", "const": "resource"},
    "parses-under": {"type": "string"},
    "has-content-address": {"type": "string"}
  }
}
