{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/work-item/dispatching-a-script/dispatching-a-script.schema.json",
  "title": "dispatching-a-script",
  "description": "Input and output shape for resolving a local script realization and composing sending-parameters-to-a-script with receiving-a-message-from-a-script.",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["workItem"],
      "additionalProperties": false,
      "anyOf": [
        {"required": ["scriptPath"]},
        {"required": ["skillRealizations"]},
        {"required": ["repoRoot"]}
      ],
      "properties": {
        "repoRoot": {
          "description": "POSIX directory capability used to build a skill realization index when scriptPath or skillRealizations is not supplied.",
          "type": "string",
          "minLength": 1
        },
        "scriptPath": {
          "description": "Already-resolved POSIX path to the ESM Node script realization.",
          "type": "string",
          "minLength": 1
        },
        "skillRealizations": {
          "description": "Precomputed realization index. Supplying this keeps dispatching-a-script pure over explicit data.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["skill", "scriptPath"],
            "additionalProperties": false,
            "properties": {
              "skill": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
              },
              "scriptPath": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "workItem": {
          "type": "object",
          "required": ["skill"],
          "additionalProperties": true,
          "properties": {
            "skill": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
            },
            "parameters": {
              "type": "object",
              "default": {}
            }
          }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["scriptPath", "parameters", "return-value", "sent-at", "received-at", "skill"],
      "additionalProperties": true,
      "properties": {
        "scriptPath": {
          "type": "string",
          "minLength": 1
        },
        "parameters": {
          "type": "object"
        },
        "return-value": {},
        "sent-at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "received-at": {
          "type": "string",
          "format": "date-time"
        },
        "skill": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
        }
      }
    }
  }
}
