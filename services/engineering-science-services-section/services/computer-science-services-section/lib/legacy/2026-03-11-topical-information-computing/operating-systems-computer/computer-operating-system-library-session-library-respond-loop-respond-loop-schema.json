{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/session/library/respond-loop/respond-loop.schema.json",
  "title": "Respond loop",
  "description": "JSON Schema for a respond-loop: one user-input-to-assistant-message cycle inside a claude-session.",
  "type": "object",
  "required": ["nested-inside", "triggered-by", "started-at"],
  "additionalProperties": true,
  "properties": {
    "nested-inside": {
      "type": "string",
      "description": "Reference to the containing claude-session."
    },
    "triggered-by": {
      "type": "string",
      "description": "Reference to the inbound message that opened the loop."
    },
    "composed-of": {
      "type": "array",
      "items": {"type": "string"},
      "description": "References to the turns that fired inside this loop."
    },
    "terminated-by": {
      "type": "string",
      "enum": ["end_turn", "stop_sequence", "max_tokens", "tool_use", "pause_turn", "refusal"]
    },
    "started-at": {"type": "string", "format": "date-time"},
    "ended-at": {"type": "string", "format": "date-time"}
  }
}
