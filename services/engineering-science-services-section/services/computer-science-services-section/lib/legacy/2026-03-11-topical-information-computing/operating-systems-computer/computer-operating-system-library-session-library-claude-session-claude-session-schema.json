{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/computer-operating-system/library/session/library/claude-session/claude-session.schema.json",
  "title": "Claude session",
  "description": "JSON Schema for a claude-session: one Claude Code runtime instance bound to a character, bracketed by SessionStart and Stop.",
  "type": "object",
  "required": ["runs-as", "has-working-directory"],
  "additionalProperties": true,
  "properties": {
    "runs-as": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "has-working-directory": {"type": "string"},
    "injects-context": {
      "type": "array",
      "items": {"type": "string"}
    },
    "emits-witnesses-to": {"type": "string"},
    "started-at": {"type": "string", "format": "date-time"},
    "ended-at": {"type": "string", "format": "date-time"},
    "session-id": {"type": "string"}
  }
}
