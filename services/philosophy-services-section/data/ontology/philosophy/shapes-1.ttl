@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix phild: <https://emsenn.net/ns/domain/philosophical#> .

# =============================================================================
# Philosophical ASR — SHACL Validation Shapes
#
# Fewer MUST requirements than mathematics: philosophical validity is
# dialectical rather than foundational. Cycles in the dependency graph
# are expected and valid.
# =============================================================================

phild:ClaimShape
    a sh:NodeShape ;
    sh:targetClass phild:Claim ;
    sh:property [
        sh:path phild:arguedBy ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A claim SHOULD have at least one supporting argument."
    ] .

phild:ArgumentShape
    a sh:NodeShape ;
    sh:targetClass phild:Argument ;
    sh:property [
        sh:path phild:supports ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An argument MUST specify what claim it supports."
    ] ;
    sh:property [
        sh:path phild:argumentForm ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "An argument SHOULD specify its form (deductive, inductive, abductive, transcendental, dialectical, etc.)."
    ] .

phild:ObjectionShape
    a sh:NodeShape ;
    sh:targetClass phild:Objection ;
    sh:property [
        sh:path phild:targets ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "An objection MUST specify what claim or argument it targets."
    ] .

phild:ResponseShape
    a sh:NodeShape ;
    sh:targetClass phild:Response ;
    sh:property [
        sh:path phild:addressesObjection ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A response MUST specify what objection it addresses."
    ] .
