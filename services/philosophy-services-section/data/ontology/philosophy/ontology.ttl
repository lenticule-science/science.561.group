@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix phild: <https://emsenn.net/ns/domain/philosophical#> .
@prefix asr:   <https://emsenn.net/ns/agential-semioverse-repository#> .

phild: a owl:Ontology ;
    rdfs:label "Philosophical ASR Ontology" ;
    rdfs:comment """
        Content types and typed relations for philosophical knowledge
        within an Agential Semioverse Repository. Validity is dialectical:
        claims are evaluated through argument, objection, and response.
    """ .

# --- Classes ---

phild:Claim a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Claim" ;
    rdfs:comment "A proposition advanced as true, inviting evaluation." .

phild:Argument a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Argument" ;
    rdfs:comment "A structured case with premises and conclusion supporting a claim." .

phild:Objection a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Objection" ;
    rdfs:comment "A challenge targeting a claim or argument." .

phild:Response a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Response" ;
    rdfs:comment "A reply to an objection." .

# --- Properties ---

phild:arguedBy a owl:ObjectProperty ;
    rdfs:label "argued by" ;
    rdfs:domain phild:Claim ;
    rdfs:range phild:Argument ;
    owl:inverseOf phild:supports .

phild:supports a owl:ObjectProperty ;
    rdfs:label "supports" ;
    rdfs:domain phild:Argument ;
    rdfs:range phild:Claim ;
    owl:inverseOf phild:arguedBy .

phild:argumentForm a owl:DatatypeProperty ;
    rdfs:label "argument form" ;
    rdfs:domain phild:Argument ;
    rdfs:range xsd:string .

phild:targets a owl:ObjectProperty ;
    rdfs:label "targets" ;
    rdfs:domain phild:Objection ;
    owl:inverseOf phild:contestedBy .

phild:contestedBy a owl:ObjectProperty ;
    rdfs:label "contested by" ;
    rdfs:range phild:Objection ;
    owl:inverseOf phild:targets .

phild:addressesObjection a owl:ObjectProperty ;
    rdfs:label "addresses" ;
    rdfs:domain phild:Response ;
    rdfs:range phild:Objection ;
    owl:inverseOf phild:addressedBy .

phild:addressedBy a owl:ObjectProperty ;
    rdfs:label "addressed by" ;
    rdfs:domain phild:Objection ;
    rdfs:range phild:Response ;
    owl:inverseOf phild:addressesObjection .

phild:revises a owl:ObjectProperty ;
    rdfs:label "revises" ;
    rdfs:domain phild:Response ;
    rdfs:range phild:Claim .

phild:concedes a owl:ObjectProperty ;
    rdfs:label "concedes" ;
    rdfs:domain phild:Response ;
    rdfs:range phild:Objection .

phild:proposes a owl:ObjectProperty ;
    rdfs:label "proposes" ;
    rdfs:domain phild:Objection ;
    rdfs:range phild:Claim .

phild:tradition a owl:DatatypeProperty ;
    rdfs:label "tradition" ;
    rdfs:range xsd:string .

phild:requires a owl:ObjectProperty ;
    rdfs:label "requires" .
