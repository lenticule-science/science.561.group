{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/predication-settling-category/library/predication-settling/doing/working/working.schema.json",
  "title": "Working-act",
  "description": "JSON Schema for a working-act — a doing-act whose target cell lies in the operational sub-presheaf of the host fiber. Categorically the pullback of doing along Φ_op ↪ Φ. Extends doing-act with the discriminator target-class = 'operational'.",
  "type": "object",
  "required": ["cell", "value-before", "value-after", "kind", "stratum", "derived-from", "derived-via", "belnap-class", "t", "target-class"],
  "additionalProperties": false,
  "properties": {
    "cell": {"$ref": "https://research-notes.561.group/hacking/library/predication-notes/predication-cell-set/library/predication-cell/predication-cell.schema.json"},
    "value-before": {"$ref": "https://research-notes.561.group/hacking/library/predication-notes/lattice/library/twist-product/library/bilattice-value/bilattice-value.schema.json"},
    "value-after": {"$ref": "https://research-notes.561.group/hacking/library/predication-notes/lattice/library/twist-product/library/bilattice-value/bilattice-value.schema.json"},
    "kind": {"enum": ["sigma", "delta"]},
    "stratum": {"enum": ["saturated", "settled"]},
    "derived-from": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://research-notes.561.group/hacking/library/predication-notes/predication-cell-set/library/predication-cell/library/cell-record/library/cell-id/cell-id.schema.json"},
      "uniqueItems": true
    },
    "derived-via": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"},
    "belnap-class": {"enum": ["inferring", "refuting", "idling", "conflicting"]},
    "closure-status": {"enum": ["fully-settled", "saturation-pending", "stabilization-pending", "fully-open"]},
    "t": {"type": "string", "format": "date-time"},
    "target-class": {
      "description": "The cell-class partition the target cell lies in. Pinned to 'operational' for working-acts; the discriminator that distinguishes working from sibling specializations governing ('normative') and planning ('plan-document').",
      "const": "operational"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "sigma"}}, "required": ["kind"]},
      "then": {"properties": {"stratum": {"const": "saturated"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "delta"}}, "required": ["kind"]},
      "then": {"properties": {"stratum": {"const": "settled"}}}
    }
  ]
}
