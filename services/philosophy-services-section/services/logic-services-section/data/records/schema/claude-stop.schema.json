{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/operating-system/library/claude-code/library/claude-stop/claude-stop.schema.json",
  "title": "Claude Stop event",
  "description": "JSON Schema for a claude-stop event payload — what Claude Code sends on stdin to a Stop hook script.",
  "type": "object",
  "required": ["session_id", "transcript_path"],
  "additionalProperties": true,
  "properties": {
    "session_id": {"type": "string"},
    "transcript_path": {"type": "string"},
    "stop_hook_active": {"type": "boolean"},
    "cwd": {"type": "string"}
  }
}
