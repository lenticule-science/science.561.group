{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/inference-model/library/logical-inference/logical-inference.schema.json",
  "title": "Logical inference",
  "description": "JSON Schema for one logical-inference act — the image-cell of one inferring arrow firing on a query.",
  "type": "object",
  "required": ["produced-by", "from-query", "sampled-output", "at-time"],
  "additionalProperties": true,
  "properties": {
    "produced-by": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "description": "Slug of the inference-model that produced the sample."
    },
    "from-query": {
      "description": "The query input."
    },
    "sampled-output": {
      "description": "The conditional sample output."
    },
    "at-time": {"type": "string", "format": "date-time"},
    "wire-witness": {
      "type": "object",
      "description": "References to the sent and received message records.",
      "additionalProperties": true
    },
    "cost": {
      "type": "object",
      "properties": {
        "input-tokens": {"type": "integer", "minimum": 0},
        "output-tokens": {"type": "integer", "minimum": 0}
      }
    }
  }
}
