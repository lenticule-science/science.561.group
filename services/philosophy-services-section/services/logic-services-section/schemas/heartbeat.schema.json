{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/heartbeat/heartbeat.schema.json",
  "title": "Heartbeat",
  "description": "JSON Schema for a heartbeat record: a per-thing standing-orientation checklist with bounded item count and mutability by principal direction.",
  "type": "object",
  "required": ["belongs-to", "items"],
  "additionalProperties": true,
  "properties": {
    "belongs-to": {
      "type": "string",
      "description": "Slug of the thing this heartbeat belongs to."
    },
    "items": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["text", "state"],
        "additionalProperties": true,
        "properties": {
          "text": {"type": "string", "minLength": 1},
          "state": {"type": "string", "enum": ["open", "done"]},
          "added-at": {"type": "string", "format": "date-time"},
          "completed-at": {"type": "string", "format": "date-time"}
        }
      }
    },
    "renders-to": {
      "type": "string",
      "description": "Path the heartbeat is copied to on install."
    }
  }
}
