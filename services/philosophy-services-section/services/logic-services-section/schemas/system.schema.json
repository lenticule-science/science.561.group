{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/system.schema.json",
  "title": "system",
  "description": "Schema for the system kind — the most general kind in the 561 OS kind hierarchy. A system is a structure that bears a running transformer at its doing/working/hacking/doing/working/running/ slot.",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "name": { "type": "string" },
    "description": { "type": "string" },
    "kind-of": { "type": "string", "const": "structure" },
    "bears-transformer": { "type": "array", "items": { "type": "string" }, "default": ["running"] },
    "runs-at": { "type": "string", "default": "doing/working/hacking/doing/working/running/" },
    "specialized-by": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["name", "description", "kind-of", "bears-transformer", "runs-at"]
}
