{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/git/library/git-pre-commit-hook/git-pre-commit-hook.schema.json",
  "title": "Git pre-commit hook installer payload",
  "description": "JSON Schema for the installed git-pre-commit-hook file record.",
  "type": "object",
  "required": ["installed-at", "execs"],
  "additionalProperties": true,
  "properties": {
    "installed-at": {"type": "string"},
    "execs": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "installed-by": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "permissions": {
      "type": "string",
      "description": "POSIX mode bits as octal string (e.g., '0755')."
    },
    "installed-at-time": {"type": "string", "format": "date-time"}
  }
}
