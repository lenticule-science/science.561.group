@prefix rel:    <https://emsenn.net/relationality/ontology#> .
@prefix sh:     <http://www.w3.org/ns/shacl#> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix skos:   <http://www.w3.org/2004/02/skos/core#> .

# =============================================================
# SHACL Shapes for Relationality Ontology
# =============================================================
#
# These shapes enforce consistency constraints on the relational
# concept graph. They encode the rules that make the ontology
# a usable reference: every concept has a definition, every
# act produces something, every operator has a signature, etc.
#
# Validate with:
#   python -m pyshacl -s shapes.ttl -d ontology.ttl -f human
#
# =============================================================

# --- Every RelationalConcept must have a label and definition ---

rel:RelationalConceptShape a sh:NodeShape ;
    sh:targetClass rel:RelationalConcept ;
    rdfs:comment """Every relational concept must be identifiable (label)
and explained (definition). Without these, the ontology fails its
primary purpose: consistent writing.""" ;
    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every relational concept must have exactly one rdfs:label." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "Every relational concept must have exactly one skos:definition." ;
    ] ;
    sh:property [
        sh:path rel:attestedIn ;
        sh:minCount 1 ;
        sh:message "Every relational concept must cite at least one source draft." ;
    ] .

# --- Acts must produce or sustain something ---

rel:ActShape a sh:NodeShape ;
    sh:targetClass rel:Act ;
    rdfs:comment """An act is ongoing activity. If it produces nothing and
sustains nothing, it is not doing anything — it is not an act.""" ;
    sh:or (
        [ sh:property [ sh:path rel:produces ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:sustains ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:derivesFrom ; sh:minCount 1 ] ]
    ) ;
    sh:message "An Act must produce, sustain, or derive from something." .

# --- Operators must have arity ---

rel:OperatorShape a sh:NodeShape ;
    sh:targetClass rel:Operator ;
    rdfs:comment """Operators are the algebraic encoding of acts. They must
declare their arity (how many arguments they take).""" ;
    sh:property [
        sh:path rel:signatureArity ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype xsd:integer ;
        sh:minInclusive 0 ;
        sh:message "Every operator must declare its arity (0 = constant, 1 = unary, 2 = binary)." ;
    ] .

# --- Conditions must be produced by something ---

rel:ConditionShape a sh:NodeShape ;
    sh:targetClass rel:Condition ;
    rdfs:comment """A condition is what an act holds open. If nothing produces
it, it has no source — it is not grounded in the derivation.""" ;
    sh:or (
        [ sh:property [ sh:path rel:producedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:derivesFrom ; sh:minCount 1 ] ]
    ) ;
    sh:message "A Condition must be produced by or derived from something." .

# --- Structures must stabilize something ---

rel:StructureShape a sh:NodeShape ;
    sh:targetClass rel:Structure ;
    rdfs:comment """A structure holds a condition open durably. If it does not
stabilize anything and is not produced by anything, it floats free.""" ;
    sh:or (
        [ sh:property [ sh:path rel:stabilizes ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:producedBy ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:derivesFrom ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:requires ; sh:minCount 1 ] ]
        [ sh:property [ sh:path rel:fixedPointsOf ; sh:minCount 1 ] ]
    ) ;
    sh:message "A Structure must stabilize, be produced by, derive from, require, or be fixed points of something." .

# --- derivesFrom targets must be RelationalConcepts ---

rel:DerivesFromShape a sh:NodeShape ;
    sh:targetSubjectsOf rel:derivesFrom ;
    sh:property [
        sh:path rel:derivesFrom ;
        sh:class rel:RelationalConcept ;
        sh:message "derivesFrom must point to a RelationalConcept." ;
    ] .

# --- dualOf targets must be RelationalConcepts ---

rel:DualTargetShape a sh:NodeShape ;
    sh:targetSubjectsOf rel:dualOf ;
    rdfs:comment """Dual targets must exist as RelationalConcepts.""" ;
    sh:property [
        sh:path rel:dualOf ;
        sh:class rel:RelationalConcept ;
        sh:message "dualOf must point to a RelationalConcept." ;
    ] .

# --- Movement membership should be declared for non-phenomena ---

rel:MovementMembershipShape a sh:NodeShape ;
    sh:targetClass rel:Act, rel:Operator, rel:Condition, rel:Structure, rel:Seed ;
    rdfs:comment """Non-cross-cutting concepts should declare their movement.
Phenomena are exempt because they recur across movements.""" ;
    sh:property [
        sh:path rel:inMovement ;
        sh:minCount 1 ;
        sh:class rel:Movement ;
        sh:severity sh:Warning ;
        sh:message "Non-phenomenon concepts should declare their movement (rel:inMovement)." ;
    ] .

# --- leftAdjointOf targets must be Operators ---

rel:AdjunctionTargetShape a sh:NodeShape ;
    sh:targetSubjectsOf rel:leftAdjointOf ;
    rdfs:comment """Adjunction targets must be Operators.""" ;
    sh:property [
        sh:path rel:leftAdjointOf ;
        sh:class rel:Operator ;
        sh:message "leftAdjointOf must point to an Operator." ;
    ] .
