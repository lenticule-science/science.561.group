# World-qualified glossary query against relationality/data/records/ontology.ttl.
# This is NOT a reader of the personal log or evidence of public publication.
# Query six distinct source-owned historical inquiry senses by their original
# semantic world, retaining label, definition, exclusions and source.
PREFIX rel: <https://emsenn.net/relationality/ontology#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

SELECT ?sense ?world ?label ?definition ?scope ?source ?glossary
WHERE {
  VALUES ?world { rel:March28InquirySenseScheme }
  ?sense a skos:Concept ;
         skos:inScheme ?world ;
         skos:prefLabel ?label ;
         skos:definition ?definition ;
         skos:scopeNote ?scope ;
         dcterms:source ?source .
  OPTIONAL { ?sense rdfs:seeAlso ?glossary }
}
ORDER BY ?label ?sense
