{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/witness/witness.schema.json",
  "title": "Witness (signed action record)",
  "description": "Per platform-opener: 'Federation is by signature, not by protocol. When outposts and inboxes are entities and witnesses are signed, federation is the substrate's merge of signed messages.' A witness is a signed action record that an agent emitted, citing actor + action + traceRows + signature.",
  "kind": "object",
  "type": "object",
  "required": ["actor", "action", "traceRows", "emittedAt", "evidence"],
  "additionalProperties": false,
  "properties": {
    "actor": { "type": "string", "minLength": 1 },
    "action": { "type": "string", "minLength": 1 },
    "traceRows": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "emittedAt": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
