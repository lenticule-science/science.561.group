{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/system/library/agentic-systems/library/character/library/diary-entry/diary-entry.schema.json",
  "title": "Diary entry",
  "description": "JSON Schema for a diary-entry: one EAVT row in a per-day journal file.",
  "type": "object",
  "required": ["e", "a", "v", "t"],
  "additionalProperties": true,
  "properties": {
    "e": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "description": "Entity — the writing character's slug."
    },
    "a": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
      "description": "Attribute — the writer skill's slug."
    },
    "v": {
      "description": "Value — the body of writing."
    },
    "t": {
      "type": "string",
      "format": "date-time"
    }
  }
}
