{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/agential-relations-system/agential-relations-system.schema.json",
  "title": "Agential relations system (the system of relations between agents)",
  "description": "Per lab/.../predicated-agentic-orchestration-platform/agent/agential-relations-system/: the structured system of typed relations between agents — who-recognizes-whom, who-delegates-to-whom, who-supersedes-whom. Distinct from governance: governance is the office-graph; agential-relations-system is the inter-agent predication graph.",
  "kind": "object",
  "type": "object",
  "required": ["id", "relations", "evidence"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["fromAgent", "predicate", "toAgent"],
        "additionalProperties": false,
        "properties": {
          "fromAgent": { "type": "string", "minLength": 1 },
          "predicate": { "type": "string", "minLength": 1 },
          "toAgent": { "type": "string", "minLength": 1 },
          "value": { "$ref": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/potential-aperiodic-articulation-cell/predicating/library/transfinite-predication-category/library/transfinite-predication-cell/library/potential-transfinite-predication-cell/positing/library/scott-continuous-posit-category/library/bilattice/library/bilattice-value/bilattice-value.schema.json" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
