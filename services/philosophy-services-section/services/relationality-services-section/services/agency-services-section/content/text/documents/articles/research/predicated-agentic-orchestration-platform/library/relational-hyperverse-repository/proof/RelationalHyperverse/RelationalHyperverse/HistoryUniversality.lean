-- Establishes: history-universality

/-!
# HistoryUniversality: M(Alph,I) as the initial history system

Corresponds to `math/history-universality.md`.

We construct the history monoid M(Alph,I) as the quotient of `List Alph`
(finite step sequences) by the equivalence generated by commutation swaps
of independent steps. We prove:

1. `HistEquiv I` is an equivalence relation on `List Alph`.
2. `HistoryMonoid Alph I` (the quotient) is a `Monoid` under concatenation.
3. All commutation swaps preserve step sequence length, so the monoid is unit-free.
4. The prefix relation is a partial order (via `prefixLE_antisymm`).
5. `HistoryMonoid Alph I` satisfies `PrefixOrdering` (and hence `HistorySystem`).

## The Diamond in T

The operationally decisive structural fact (§commutation): when `s ⊥ t`,
the history monoid satisfies `s★(t★h) = t★(s★h)`. This diamond is what
makes the directed front-reduction locally confluent. Combined with strong
normalization (word length bounds the displacement measure), Newman's Lemma
gives unique Foata NF, from which left-cancellation follows.

See `diamond_in_T` (§5) for the proved statement.

## OPEN items
- `mul_left_cancel` : left-cancellativity. Reduced to `left_cancel_single`
  (strip one leading step at a time via `left_cancel_seq`). The `rel`, `refl`,
  `symm` cases are proved. The `trans` case is OPEN: the intermediate history
  representative may begin with a different step than the cancelled one, so the
  induction hypothesis does not apply directly. Closing requires the Foata NF
  uniqueness argument (§history-normalization): the directed front-reduction is
  locally confluent because of the diamond in T; it is strongly normalizing
  because step sequence length bounds the displacement; Newman's Lemma then gives
  a unique NF from which cancellation follows.
-/

universe u v

variable {Alph : Type u}

-- ── §1: Commutation equivalence ─────────────────────────────────────────────────

/-- One-step commutation swap of two independent steps.
    `HistSwap I w w'` holds when w' is obtained from w by swapping two
    adjacent independent steps s, t at some position, where s ⊥ t. -/
def HistSwap (I : CommutationRelation Alph) (w w' : List Alph) : Prop :=
  ∃ s t : Alph, I.commute s t ∧
    ∃ p q : List Alph, w = p ++ (s :: t :: q) ∧ w' = p ++ (t :: s :: q)

/-- HistSwap is symmetric: independence is symmetric. -/
theorem HistSwap_symm (I : CommutationRelation Alph) {w w' : List Alph}
    (h : HistSwap I w w') : HistSwap I w' w := by
  obtain ⟨s, t, hst, p, q, rfl, rfl⟩ := h
  exact ⟨t, s, I.symm_comm s t hst, p, q, rfl, rfl⟩

/-- The commutation equivalence: equivalence closure of adjacent swaps. -/
def HistEquiv (I : CommutationRelation Alph) : List Alph → List Alph → Prop :=
  Relation.EqvGen (HistSwap I)

theorem HistEquiv_equivalence (I : CommutationRelation Alph) :
    Equivalence (HistEquiv I) :=
  Relation.EqvGen.is_equivalence _

/-- The commutation setoid on `List Alph`. -/
def HistSetoid (I : CommutationRelation Alph) : Setoid (List Alph) :=
  ⟨HistEquiv I, HistEquiv_equivalence I⟩

-- ── §2: HistEquiv is a congruence for concatenation ────────────────────────────

/-- Key computation: (p ++ a :: b :: q) ++ r = p ++ a :: b :: (q ++ r). -/
private lemma cons_cons_append_assoc (a b : Alph) (p q r : List Alph) :
    (p ++ a :: b :: q) ++ r = p ++ a :: b :: (q ++ r) := by
  simp [List.append_assoc]

private lemma HistSwap_append_right (I : CommutationRelation Alph) (r : List Alph)
    {w w' : List Alph} (h : HistSwap I w w') : HistSwap I (w ++ r) (w' ++ r) := by
  obtain ⟨s, t, hst, p, q, hw, hw'⟩ := h
  exact ⟨s, t, hst, p, q ++ r,
    by rw [hw]; exact cons_cons_append_assoc s t p q r,
    by rw [hw']; exact cons_cons_append_assoc t s p q r⟩

private lemma HistSwap_append_left (I : CommutationRelation Alph) (l : List Alph)
    {w w' : List Alph} (h : HistSwap I w w') : HistSwap I (l ++ w) (l ++ w') := by
  obtain ⟨s, t, hst, p, q, hw, hw'⟩ := h
  exact ⟨s, t, hst, l ++ p, q,
    by rw [hw]; simp [List.append_assoc],
    by rw [hw']; simp [List.append_assoc]⟩

lemma HistEquiv_append_right (I : CommutationRelation Alph) (r : List Alph)
    {w w' : List Alph} (h : HistEquiv I w w') : HistEquiv I (w ++ r) (w' ++ r) := by
  induction h with
  | rel a b h      => exact Relation.EqvGen.rel _ _ (HistSwap_append_right I r h)
  | refl a         => exact Relation.EqvGen.refl _
  | symm a b _ ih  => exact Relation.EqvGen.symm _ _ ih
  | trans a b c _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

lemma HistEquiv_append_left (I : CommutationRelation Alph) (l : List Alph)
    {w w' : List Alph} (h : HistEquiv I w w') : HistEquiv I (l ++ w) (l ++ w') := by
  induction h with
  | rel a b h      => exact Relation.EqvGen.rel _ _ (HistSwap_append_left I l h)
  | refl a         => exact Relation.EqvGen.refl _
  | symm a b _ ih  => exact Relation.EqvGen.symm _ _ ih
  | trans a b c _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

-- ── §3: The history monoid ─────────────────────────────────────────────────────

/-- The free history monoid M(Alph,I): equivalence classes of step sequences
    (`List Alph`) under the commutation equivalence. -/
def HistoryMonoid (Alph : Type u) (I : CommutationRelation Alph) : Type u :=
  Quotient (HistSetoid I)

namespace HistoryMonoid

variable (I : CommutationRelation Alph)

/-- Embed a word into the history monoid. -/
def mk (w : List Alph) : HistoryMonoid Alph I :=
  Quotient.mk (HistSetoid I) w

/-- Concatenation: [w] * [v] = [w ++ v]. -/
instance instMul : Mul (HistoryMonoid Alph I) where
  mul := Quotient.lift₂
    (fun w r => mk I (w ++ r))
    (fun a₁ b₁ a₂ b₂ ha hb => Quotient.sound
      ((HistEquiv_equivalence I).trans
        (HistEquiv_append_right I b₁ ha)
        (HistEquiv_append_left  I a₂ hb)))

/-- The empty history is the unit. -/
instance instOne : One (HistoryMonoid Alph I) where
  one := mk I []

/-- `HistoryMonoid` is a monoid. -/
instance instMonoid : Monoid (HistoryMonoid Alph I) where
  mul_assoc a b c := by
    refine Quotient.inductionOn a (fun w => ?_)
    refine Quotient.inductionOn b (fun r => ?_)
    refine Quotient.inductionOn c (fun s => ?_)
    exact congr_arg (mk I) (List.append_assoc w r s)
  one_mul a := by
    refine Quotient.inductionOn a (fun w => ?_)
    exact congr_arg (mk I) (List.nil_append w)
  mul_one a := by
    refine Quotient.inductionOn a (fun w => ?_)
    exact congr_arg (mk I) (List.append_nil w)

-- ── §4: Length invariance and unit-free ──────────────────────────────────────

/-- Each HistSwap preserves step sequence length. -/
private lemma HistSwap_length_eq (I : CommutationRelation Alph) {w w' : List Alph}
    (h : HistSwap I w w') : w.length = w'.length := by
  obtain ⟨s, t, _, p, q, rfl, rfl⟩ := h
  simp [List.length_append]

/-- HistEquiv preserves step sequence length. -/
lemma HistEquiv_length_eq (I : CommutationRelation Alph) {w w' : List Alph}
    (h : HistEquiv I w w') : w.length = w'.length := by
  induction h with
  | rel a b h      => exact HistSwap_length_eq I h
  | refl a         => rfl
  | symm a b _ ih  => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2

/-- `HistoryMonoid` is unit-free: [w] * [v] = 1 implies [w] = [v] = 1.
    Proof: step sequence length is preserved by HistEquiv, so [w ++ v] ~ [] forces
    length 0, hence w = v = []. -/
theorem mul_unitFree (a b : HistoryMonoid Alph I) (h : a * b = 1) :
    a = 1 ∧ b = 1 := by
  revert h
  refine Quotient.inductionOn a (fun w => ?_)
  refine Quotient.inductionOn b (fun r => ?_)
  intro h
  have heq : HistEquiv I (w ++ r) [] := Quotient.exact h
  have hlen : w.length + r.length = 0 := by
    have := (HistEquiv_length_eq I heq).trans rfl
    simpa [List.length_append] using this
  have hw : w = [] := List.eq_nil_of_length_eq_zero (by omega)
  have hr : r = [] := List.eq_nil_of_length_eq_zero (by omega)
  subst hw; subst hr
  exact ⟨rfl, rfl⟩

-- ── §5: Left-cancellativity (OPEN) ───────────────────────────────────────────

-- ── §5a: The Diamond in T ─────────────────────────────────────────────────────

/-- The Diamond in T (§commutation): when s ⊥ t, independent steps commute in
    the history monoid: `s★(t★h) = t★(s★h)`. This is the operationally decisive
    consequence of commutation (§commutation) — the same algebraic fact that
    drives nucleus commutativity σ∘Δ = Δ∘σ (§fiber-doctrine).

    In terms of the directed front-reduction (move a step left when independent
    of its left neighbor), this diamond is exactly local confluence: two
    reductions at non-overlapping positions always join in one more step each.
    Combined with strong normalization (word length bounds the displacement),
    Newman's Lemma gives confluence and unique Foata NF (§history-normalization),
    from which left-cancellation follows. -/
theorem diamond_in_T {I : CommutationRelation Alph} {s t : Alph}
    (hst : I.commute s t) (h : HistoryMonoid Alph I) :
    mk I [s] * (mk I [t] * h) = mk I [t] * (mk I [s] * h) :=
  Quotient.inductionOn h fun w =>
    Quotient.sound (Relation.EqvGen.rel _ _ ⟨s, t, hst, [], w, rfl, rfl⟩)

-- ── §5b: Key structural lemma ─────────────────────────────────────────────────

/-- A single swap on a cons-headed word keeps the head:
    if HistSwap I (a :: w) (a :: v) then HistSwap I w v.

    Proof: the swap is at some position. If at position 0 (straddling the head),
    then `s = a` and `t = a`, so `I.commute a a`, contradicting `irref_comm`.
    Otherwise the swap is interior and the head `a` is unaffected. -/
private lemma HistSwap_cons_left_cancel {I : CommutationRelation Alph}
    {a : Alph} {w v : List Alph}
    (h : HistSwap I (a :: w) (a :: v)) : HistSwap I w v := by
  obtain ⟨s, t, hst, p, q, hw, hv⟩ := h
  cases p with
  | nil =>
    -- p = [] means s = a and t = a (from both heads), contradicting irref_comm
    simp only [List.nil_append] at hw hv
    have hs : s = a := (List.cons.inj hw).1.symm
    have ht : t = a := (List.cons.inj hv).1.symm
    rw [hs, ht] at hst
    exact absurd hst (I.irref_comm a)
  | cons b p' =>
    -- p = b :: p', so b = a and the swap is in the tail
    simp only [List.cons_append] at hw hv
    obtain ⟨_, hw'⟩ := List.cons.inj hw
    obtain ⟨_, hv'⟩ := List.cons.inj hv
    exact ⟨s, t, hst, p', q, hw', hv'⟩

/-- Left-cancellation for a single leading step:
    HistEquiv I (a :: w) (a :: v) → HistEquiv I w v.

    The `rel`, `refl`, `symm` cases follow from `HistSwap_cons_left_cancel`.
    The `trans` case is OPEN: the intermediate history representative may not
    begin with `a` (step `a` can commute rightward past independent steps), so
    the IH does not apply directly.

    The organizing principle for the proof is the diamond in T (`diamond_in_T`):
    when s ⊥ t, `s★(t★h) = t★(s★h)`. This makes the directed front-reduction
    (move a step left when independent of its left neighbor) locally confluent.
    The directed reduction is strongly normalizing because the displacement
    measure (sum of left-movable gaps, bounded by word length²) decreases by 1
    per step. Newman's Lemma (SN + LC → confluence) then gives unique Foata NF.
    Cancellation follows: NF(a :: w) = NF(a :: v) implies NF(w) = NF(v) by
    stripping the leading step from the Foata front.
    See §history-normalization for the full argument. -/
private lemma left_cancel_single {I : CommutationRelation Alph}
    {a : Alph} {w v : List Alph}
    (h : HistEquiv I (a :: w) (a :: v)) : HistEquiv I w v := by
  -- Use the free-variable form to keep induction on EqvGen clean.
  suffices ∀ x y : List Alph, HistEquiv I x y →
      ∀ b : Alph, ∀ u r : List Alph, x = b :: u → y = b :: r → HistEquiv I u r by
    exact this _ _ h a w v rfl rfl
  intro x y hxy
  induction hxy with
  | rel x y hxy =>
    intro b u r hx hy; subst hx; subst hy
    exact Relation.EqvGen.rel _ _ (HistSwap_cons_left_cancel hxy)
  | refl x =>
    intro b u r hx hy
    exact (List.cons.inj (hx.symm.trans hy)).2 ▸ Relation.EqvGen.refl _
  | symm x y _ ih =>
    intro b u r hx hy
    exact (HistEquiv_equivalence I).symm (ih b r u hy hx)
  | trans x y z hxy hyz ih1 ih2 =>
    intro b u r hx hz
    -- Case split on the first element of the intermediate word y.
    cases y with
    | nil =>
      -- y = [] contradicts HistEquiv_length_eq: length(b :: u) = 0 is impossible.
      have hlen : (b :: u).length = ([] : List Alph).length :=
        HistEquiv_length_eq I (hx ▸ hxy)
      simp at hlen
    | cons c y' =>
      by_cases hb : c = b
      · -- y = b :: y': both IHs apply directly.
        have hy_eq : c :: y' = b :: y' := congrArg (· :: y') hb
        exact (HistEquiv_equivalence I).trans (ih1 b u y' hx hy_eq) (ih2 b y' r hy_eq hz)
      · -- y = c :: y' with c ≠ b.
        -- OPEN: the intermediate history representative starts with a different step
        -- than the cancelled step b. The IH requires both sub-chains to start with b.
        --
        -- The diamond in T (`diamond_in_T`) is the key structural fact:
        --   s ⊥ t  →  s★(t★h) = t★(s★h)  in HistoryMonoid
        -- This makes the directed front-reduction locally confluent:
        --   • two reductions at non-overlapping positions join in one step each
        --     (the two swaps don't interfere; the diamond holds directly)
        --   • a reduction producing c ≠ b at the head must pass through the
        --     diamond — b and c commute, and the Foata front of b :: u and b :: v
        --     contains b in both cases, from which cancellation follows.
        -- SN of the directed reduction: each step decreases the displacement count
        -- (bounded by word length²; no alphabet structure needed).
        -- Newman's Lemma: SN + LC (diamond) → confluence → unique Foata NF.
        -- NF uniqueness gives cancellation: see §history-normalization.
        sorry -- OPEN: diamond_in_T → Foata NF → cancellation (§history-normalization)

/-- Left-cancellation for a step sequence prefix:
    HistEquiv I (p ++ w) (p ++ v) → HistEquiv I w v.
    Proved by induction on `p` using `left_cancel_single` at each step.
    Inherits the sorry from `left_cancel_single` for non-trivial `p`. -/
private lemma left_cancel_seq (I : CommutationRelation Alph)
    (p w v : List Alph) (h : HistEquiv I (p ++ w) (p ++ v)) : HistEquiv I w v := by
  induction p with
  | nil  => simpa using h
  | cons a p' ih =>
    apply ih
    apply left_cancel_single
    simpa [List.cons_append] using h

/-- Left-cancellativity: a * b = a * c → b = c.

    Proof: lift to step sequences, apply `left_cancel_seq`.
    Inherits the open sorry from `left_cancel_single` (trans/c≠b case).
    Closes once Foata NF uniqueness is formalized (§history-normalization). -/
theorem mul_left_cancel (a b c : HistoryMonoid Alph I) (h : a * b = a * c) : b = c := by
  revert h
  refine Quotient.inductionOn a (fun p => ?_)
  refine Quotient.inductionOn b (fun w => ?_)
  refine Quotient.inductionOn c (fun v => ?_)
  intro h
  have heq : HistEquiv I (p ++ w) (p ++ v) := Quotient.exact h
  exact Quotient.sound (left_cancel_seq I p w v heq)

-- ── §6: The prefix order ──────────────────────────────────────────────────────

private def prefixLE (a b : HistoryMonoid Alph I) : Prop :=
  ∃ u : HistoryMonoid Alph I, b = a * u

private theorem prefixLE_refl (a : HistoryMonoid Alph I) : prefixLE I a a :=
  ⟨1, (mul_one a).symm⟩

private theorem prefixLE_trans {a b c : HistoryMonoid Alph I}
    (h : prefixLE I a b) (h' : prefixLE I b c) : prefixLE I a c := by
  obtain ⟨u, hu⟩ := h; obtain ⟨v, hv⟩ := h'
  exact ⟨u * v, by rw [hv, hu, mul_assoc]⟩

private theorem prefixLE_antisymm_HM {a b : HistoryMonoid Alph I}
    (h : prefixLE I a b) (h' : prefixLE I b a) : a = b :=
  prefixLE_antisymm (mul_left_cancel I) (mul_unitFree I) h h'

/-- The prefix order on `HistoryMonoid`. -/
instance instPartialOrder : PartialOrder (HistoryMonoid Alph I) where
  le             := prefixLE I
  le_refl        := prefixLE_refl I
  le_trans _ _ _ := prefixLE_trans I
  le_antisymm _ _ := prefixLE_antisymm_HM I

/-- `HistoryMonoid Alph I` satisfies `PrefixOrdering`. -/
instance instPrefixOrdering : PrefixOrdering (HistoryMonoid Alph I) where
  le_iff_prefix _ _ := Iff.rfl

/-- `HistoryMonoid Alph I` is a history system. -/
instance instHistorySystem : HistorySystem (HistoryMonoid Alph I) where

-- ── §7: Universal property ────────────────────────────────────────────────────

/-- An abstract history monoid over (Alph, I): a monoid M with generators
    satisfying commutativity from I.
    Corresponds to `math/history-universality.md §def-abstract-history-monoid`. -/
structure AbstractHistoryMonoid (M : Type v) [Monoid M] where
  gen      : Alph → M
  comm_ind : ∀ s t : Alph, I.commute s t →
               gen s * gen t = gen t * gen s

/-- Evaluate a step sequence in a monoid by left-fold on `gen` (accumulator starts at 1). -/
private def seqMap {M : Type v} [Monoid M] (gen : Alph → M) (w : List Alph) : M :=
  w.foldl (fun acc s => acc * gen s) 1

/-- The accumulator shifts out as a left factor:
    foldl (· * gen ·) acc w = acc * foldl (· * gen ·) 1 w.
    Proved by induction on w; the key step uses mul_assoc. -/
private lemma foldl_acc_shift {M : Type v} [Monoid M] (gen : Alph → M)
    (acc : M) (w : List Alph) :
    w.foldl (fun a s => a * gen s) acc = acc * w.foldl (fun a s => a * gen s) 1 := by
  induction w generalizing acc with
  | nil => simp
  | cons a w ih =>
    simp only [List.foldl_cons, one_mul]
    rw [ih (acc * gen a), ih (gen a), mul_assoc]

/-- seqMap distributes over ++. -/
private lemma seqMap_append {M : Type v} [Monoid M] (gen : Alph → M) (w r : List Alph) :
    seqMap gen (w ++ r) = seqMap gen w * seqMap gen r := by
  simp only [seqMap, List.foldl_append]
  exact foldl_acc_shift gen _ r

/-- A single HistSwap does not change the evaluation: gen(s)*gen(t) = gen(t)*gen(s)
    by the commutativity hypothesis. Proved by splitting at the swap position
    and applying mul_assoc + comm_ind. -/
private lemma seqMap_HistSwap_eq {M : Type v} [Monoid M]
    (ahm : AbstractHistoryMonoid I M) {w w' : List Alph}
    (h : HistSwap I w w') : seqMap ahm.gen w = seqMap ahm.gen w' := by
  obtain ⟨s, t, hst, p, q, rfl, rfl⟩ := h
  -- Split at p / rest boundary before unfolding seqMap
  rw [seqMap_append, seqMap_append]
  congr 1
  -- Goal: seqMap gen (s :: t :: q) = seqMap gen (t :: s :: q)
  simp only [seqMap, List.foldl_cons, one_mul]
  -- Goal: q.foldl f (gen s * gen t) = q.foldl f (gen t * gen s)
  rw [ahm.comm_ind s t hst]

/-- The step sequence map is HistEquiv-invariant. -/
private lemma seqMap_HistEquiv_eq {M : Type v} [Monoid M]
    (ahm : AbstractHistoryMonoid I M) {w w' : List Alph}
    (h : HistEquiv I w w') : seqMap ahm.gen w = seqMap ahm.gen w' := by
  induction h with
  | rel a b h      => exact seqMap_HistSwap_eq I ahm h
  | refl a         => rfl
  | symm a b _ ih  => exact ih.symm
  | trans a b c _ _ ih1 ih2 => exact ih1.trans ih2

/-- The unique monoid homomorphism `HistoryMonoid Alph I →* M` extending gen.
    Corresponds to `math/history-universality.md §thm-history-universality`. -/
def toAbstractHistoryMonoid {M : Type v} [Monoid M] (ahm : AbstractHistoryMonoid I M) :
    HistoryMonoid Alph I →* M where
  toFun  := Quotient.lift (seqMap ahm.gen)
              (fun a b h => seqMap_HistEquiv_eq I ahm h)
  map_one' := rfl
  map_mul' a b := by
    refine Quotient.inductionOn a (fun w => ?_)
    refine Quotient.inductionOn b (fun r => ?_)
    change seqMap ahm.gen (w ++ r) = seqMap ahm.gen w * seqMap ahm.gen r
    exact seqMap_append ahm.gen w r

end HistoryMonoid
