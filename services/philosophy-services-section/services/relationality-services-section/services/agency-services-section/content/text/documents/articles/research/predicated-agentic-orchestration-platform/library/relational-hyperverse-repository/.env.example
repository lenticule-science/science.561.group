# Copy this file to .env and fill in your values.
# .env is gitignored — never commit it.

# Your SSH public key (contents of ~/.ssh/id_ed25519.pub or similar).
# The container will only accept logins with the matching private key.
SSH_AUTHORIZED_KEYS=

# GitHub Personal Access Token.
# Used by: gh CLI, GitHub MCP server.
# Needs: repo, read:org, read:user scopes at minimum.
GITHUB_TOKEN=

# Anthropic API key (or your replacement AI tool's key).
ANTHROPIC_API_KEY=
