PREFIX sec: <https://561.group/ontology/service-section-custody#>

# Qualified inventory audit. This only detects explicitly inventoried assets;
# an empty result MUST NOT be reported as repository compliance.
SELECT DISTINCT ?section ?name ?role ?artifact ?kind ?path ?revision
WHERE {
  ?section a sec:ServiceSection ;
           sec:sourceCustody ?role ;
           sec:sectionName ?name ;
           sec:holds ?artifact .
  ?artifact a ?kind ;
            sec:sourcePath ?path ;
            sec:sourceRevision ?revision .
  FILTER (?kind IN (sec:Knowledge, sec:EngineeringImplementation,
                    sec:OperationParameter, sec:InstanceParameter))
  FILTER (
    (?kind = sec:Knowledge && ?role != sec:Science) ||
    (?kind = sec:EngineeringImplementation && ?role != sec:Engineering) ||
    (?kind = sec:OperationParameter && ?role != sec:Operations) ||
    (?kind = sec:InstanceParameter && ?role NOT IN (sec:Group, sec:Public))
  )
}
ORDER BY ?section ?path
