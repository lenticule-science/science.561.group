{
  "name": "@lenticule-science/weiqi-web",
  "version": "0.1.0",
  "type": "module",
  "description": "Static web face for a normal 9x9 Weiqi match, lessons, and glossary reading, built on the exact-pinned shared Weiqi engine.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "node scripts/build-kernel.mjs && node scripts/build-glossary.mjs",
    "check": "node check-mts.mjs test/*.test.mts",
    "test": "npm run check && node --test 'test/*.test.mts'",
    "verify:normal-play": "node scripts/verify-normal-play.mjs",
    "verify:release": "npm test && npm run build && npm run verify:normal-play",
    "verify:public": "node scripts/verify-public-release.mjs",
    "serve": "node scripts/serve.mjs",
    "deploy": "npm run verify:release && node scripts/deploy-public-release.mjs",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "@red-cup-engineering/education-platform-service": "0.2.5",
    "@red-cup-engineering/web-release-candidate-service": "0.3.0",
    "@red-cup-engineering/weiqi-engine": "0.3.0"
  },
  "devDependencies": {
    "wrangler": "4.123.0"
  }
}
