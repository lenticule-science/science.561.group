#!/usr/bin/env bash

# Project-local Python environment for the Relational Core.
#
# On first entry, this will create a virtualenv in .venv and install
# the editable package with developer, docs, and linting extras so
# that pytest, Sphinx, mypy, black, and ruff are all available for
# local workflows.

if [ ! -d .venv ]; then
  echo "Creating local virtualenv in .venv"
  python3 -m venv .venv
  # Install project and extras on first creation; failures here leave
  # the venv in place so you can install manually.
  # shellcheck disable=SC1091
  source .venv/bin/activate
  pip install --upgrade pip
  pip install -e ".[dev,docs,lint]" || true
fi

# shellcheck disable=SC1091
source .venv/bin/activate

# Make the project importable as `relational_core` when running inside
# this directory.
export PYTHONPATH="$PWD:${PYTHONPATH}"
