{
  "mcpServers": {
    "lean-lsp": {
      "command": "uvx",
      "args": [
        "lean-lsp-mcp"
      ],
      "env": {
        "LEAN_PROJECT_PATH": "/repo/proof/RelationalHyperverse",
        "LEAN_REPL": "true",
        "LEAN_LOG_LEVEL": "NONE"
      }
    },
    "github": {
      "command": "github-mcp-server",
      "args": [
        "stdio"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_TOKEN}"
      }
    },
    "repo-engine": {
      "command": "python3",
      "args": [
        "-m", "src.engine.mcp_server"
      ],
      "cwd": "C:\\Users\\emsen\\research\\library\\triage\\gsu-ccs-20260313",
      "env": {
        "ANTHROPIC_API_KEY": "${ANTHROPIC_API_KEY}"
      }
    }
  }
}
