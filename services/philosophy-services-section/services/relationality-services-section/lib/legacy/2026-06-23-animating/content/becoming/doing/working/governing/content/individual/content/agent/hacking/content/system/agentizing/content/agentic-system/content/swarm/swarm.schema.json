{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/agentic-system/swarm/swarm.schema.json",
  "title": "Swarm (a kind of agentic-system)",
  "description": "Per spotcomp/library/swarm-runtime/specification.md §2 and lab/.../agentic-systems/library/swarm/: a swarm is a family of modeled players (= agents in CGS view per emsenn 2026-05-28) over a shared federation and settling discipline. S = (O, V, r, Players, SharedTrace, Fed, Gov, Settle, Ops). Restriction of agentic-system to the family-coordinated case with declared federation profile and regime profile.",
  "kind": "object",
  "type": "object",
  "required": [
    "id",
    "participants",
    "coordinatesVia",
    "recognitionDiscipline",
    "governanceProcess",
    "sharedTrace",
    "federationProfile",
    "regimeProfile",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "coordinatesVia": { "type": "string", "minLength": 1 },
    "recognitionDiscipline": { "type": "string", "minLength": 1 },
    "governanceProcess": { "type": "string", "minLength": 1 },
    "sharedTrace": { "type": "string", "minLength": 1 },
    "federationProfile": { "type": "string", "minLength": 1 },
    "regimeProfile": { "type": "string", "minLength": 1 },
    "leader": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$"
    },
    "engagement": { "type": "string", "minLength": 1 },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
