{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/federation/federation.schema.json",
  "title": "Federation morphism record (substrate merge across platforms)",
  "description": "Morphism: (local-trace, peer-witnesses) → merged-trace. Per platform-opener: 'Federation is by signature, not by protocol... federation is the substrate's merge of signed messages.' Lifts existing merging/ morphism into the platform layer with witness-signature verification before admission.",
  "kind": "morphism",
  "domain": "(local-trace, peer-witnesses)",
  "codomain": "trace",
  "variance": "restriction",
  "monotone": true,
  "type": "object",
  "required": ["localTrace", "peerWitnesses", "outputTrace", "admissionDecisions", "evidence"],
  "additionalProperties": false,
  "properties": {
    "localTrace": { "type": "object" },
    "peerWitnesses": { "type": "array" },
    "outputTrace": { "type": "object" },
    "admissionDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["witnessId", "decision"],
        "additionalProperties": false,
        "properties": {
          "witnessId": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["admitted", "rejected", "quarantined"] },
          "reason": { "type": "string" }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
