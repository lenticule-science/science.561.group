{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/binding-character-to-player/binding-character-to-player.schema.json",
  "title": "Binding-character-to-player morphism record",
  "description": "Morphism: (character, bindingParams) → modeled-player. Variance: extension (adds localSettling, cgsProfile, handedness bounds, capabilities, governance to the character's bearer evidence to produce the modeled-player tuple). Per PLAYER-CHARACTER-BOUNDARY §3-§6 distinct positions.",
  "kind": "morphism",
  "domain": "(character, bindingParams)",
  "codomain": "#schema/modeled-player",
  "variance": "extension",
  "monotone": true,
  "type": "object",
  "required": [
    "character",
    "bindingParams",
    "output",
    "evidence"
  ],
  "additionalProperties": false,
  "properties": {
    "character": {
      "type": "object"
    },
    "bindingParams": {
      "type": "object"
    },
    "output": {
      "$ref": "../library/modeled-player/modeled-player.schema.json"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
