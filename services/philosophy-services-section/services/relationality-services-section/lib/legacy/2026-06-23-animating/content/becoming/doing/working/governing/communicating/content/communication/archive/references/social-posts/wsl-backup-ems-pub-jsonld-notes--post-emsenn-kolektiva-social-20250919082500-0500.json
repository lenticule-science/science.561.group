          },
          "contents": [
            "September 19th"
          ]
        },
        "is ",
        {
          "$$data_type": "org-node",
          "type": "link",
          "ref": "orgcc2d6ea",
          "properties": {
            "post-blank": 0,
            "secondary": null,
            "mode": null,
            "granularity": null,
            "cached": null,
            "true-level": null,
            "deferred": null,
            "structure": null,
            "type": "id",
            "type-explicit-p": true,
            "path": "ddc6b7d3-f4a2-48e9-8d42-46b0db27b08d",
            "format": "bracket",
            "raw-link": "id:ddc6b7d3-f4a2-48e9-8d42-46b0db27b08d",
