{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/office/office.schema.json",
  "title": "Office (role bundle of skills and authority)",
  "description": "Per lab/.../predicated-agentic-orchestration-platform/office/ and PLAYER-CHARACTER-BOUNDARY §3: an office is a context-specific bundle of skills and authority an agent holds. Agents hold offices; offices grant skill access and scope; the office graph is in the substrate as predications, making governance a substrate-level structure rather than out-of-band config.",
  "kind": "object",
  "type": "object",
  "required": ["slug", "grantsSkills", "scope", "authority", "evidence"],
  "additionalProperties": false,
  "properties": {
    "slug": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
    "grantsSkills": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "scope": { "type": "string", "minLength": 1 },
    "authority": { "type": "string", "minLength": 1 },
    "supersedes": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
