{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/ensembling/ensembling.schema.json",
  "title": "Ensembling (swarm → ensemble)",
  "description": "Ensembling restricts a swarm into an ensemble: forgets ungoverned coordination and undisciplined membership, binds a single governance theory, and names a coordinating office. Generator of the ensemble object; composes restricting + governing. Variance: restriction. Per docs/ORCHESTRATION-GENEALOGY.md.",
  "kind": "morphism",
  "variance": "restriction",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["swarm"],
      "additionalProperties": false,
      "properties": {
        "swarm": { "type": "object", "description": "the swarm (a restricted forming) to ensemble" },
        "governance": { "enum": ["orchestration", "choreography", "kyriarchical", "kin-relational"] },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "output": { "$ref": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/ensembling/library/ensemble/ensemble.schema.json" }
  }
}
