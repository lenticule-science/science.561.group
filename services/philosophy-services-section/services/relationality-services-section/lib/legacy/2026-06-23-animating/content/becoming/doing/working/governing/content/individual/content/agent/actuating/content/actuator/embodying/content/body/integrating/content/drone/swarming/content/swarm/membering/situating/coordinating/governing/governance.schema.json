{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/agentic-orchestration-platform/governance/governance.schema.json",
  "title": "Governance (office-graph-as-substrate)",
  "description": "Per platform-opener: 'Governance edits the agent population. When the office graph is in the substrate, a governance decision to add a new office is a predication insertion. The platform's behavior changes on the next tick — no separate configuration out-of-band, no deployment.' Governance is the office-graph structure as predication-graph content.",
  "kind": "object",
  "type": "object",
  "required": ["officeSet", "edges", "modalRestrictions", "evidence"],
  "additionalProperties": false,
  "properties": {
    "officeSet": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$" },
      "minItems": 1,
      "uniqueItems": true
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "kind"],
        "additionalProperties": false,
        "properties": {
          "from": { "type": "string", "minLength": 1 },
          "to": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["supersedes", "delegates-to", "reports-to", "grants-recognition"] }
        }
      }
    },
    "modalRestrictions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
