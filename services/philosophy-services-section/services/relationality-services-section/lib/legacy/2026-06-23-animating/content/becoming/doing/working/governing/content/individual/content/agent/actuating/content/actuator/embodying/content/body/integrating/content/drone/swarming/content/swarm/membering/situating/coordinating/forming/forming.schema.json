{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/forming/forming.schema.json",
  "title": "Forming (characters → formed-collective)",
  "description": "Forming composes characters into a collective by parallel composition (∥). Generator of the formed-collective object. swarm and ensemble are restricted formings (forming then restricting). Variance: extension (joining parts into a larger structure). Per docs/ORCHESTRATION-GENEALOGY.md; grounded in the lab orchestration surveys (forming = monoidal product on arenas).",
  "kind": "morphism",
  "variance": "extension",
  "type": "object",
  "required": ["input", "output"],
  "additionalProperties": false,
  "properties": {
    "input": {
      "type": "object",
      "required": ["characters"],
      "additionalProperties": false,
      "properties": {
        "characters": { "type": "array", "description": "characters (or persona/role-slug references) to compose", "items": { "anyOf": [{ "type": "string", "minLength": 1 }, { "$ref": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/characterizing/library/character/character.schema.json" }] } },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "output": { "$ref": "https://561.group/swarm-intelligence/articulating/library/aperiodic-articulation-category/library/aperiodic-articulation-cell/library/stable-aperiodic-articulation-cell/forming/library/formed-collective/formed-collective.schema.json" }
  }
}
