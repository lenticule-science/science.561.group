import Infomaterial.Language.Positing.BigradedCohomology
import Infomaterial.Language.Positing.ChargeTactic

/-!
# Positing.Gauge — K₄ = ⟨∼,−⟩ ≅ ℤ/2 × ℤ/2 as a first-class group object

`Four` proved the *facts* of the Klein-four symmetry of `FOUR` element by element:
negation `∼` (`negate`, the slot swap), conflation `−` (`conflate`, the
complemented swap), their composite `∼∘−` (`negConf`, the coordinatewise
complement), the involution laws, the commutation `∼∘− = −∘∼`, and each
generator's effect on the two orders. This module **packages those facts as one
group object**: a four-element carrier `K4 = {id, neg, conf, negConf}` with a
multiplication, an action on `Charge`, and the full group laws proven over it.

The corpus node — `…/pre-bilattice/content/bilattice/content/klein-four-symmetry`
— records:

> The **Klein-four group** `K₄ ≅ ℤ/2 × ℤ/2` acting on a bilattice equipped with
> both negation `∼` and conflation `−`, generated by these two commuting
> involutions: `K₄ := ⟨∼, −⟩ = {id, ∼, −, ∼∘−}`.

and its table on `FOUR`:

| element | `∼`  | `−`  | `∼∘−` |
|---------|------|------|-------|
| `⊥`     | `⊥`  | `⊤`  | `⊤`   |
| `t`     | `f`  | `t`  | `f`   |
| `f`     | `t`  | `f`  | `t`   |
| `⊤`     | `⊤`  | `⊥`  | `⊥`   |

with orbits `{t, f}` (a 2-orbit under `∼`, fixed by `−`) and `{⊥, ⊤}` (a 2-orbit
under `−`, fixed by `∼`), and order-effects: `∼` preserves `≤ₖ` / reverses `≤ₜ`,
`−` reverses `≤ₖ` / preserves `≤ₜ`, `∼∘−` reverses both.

We give:

* the carrier `K4` and its action `act : K4 → Charge → Charge` (reusing `Four`'s
  `negate`/`conflate`/`negConf`);
* the **Cayley table** `mul : K4 → K4 → K4` (4×4, by `rfl`), proven to **realize
  composition** of the action (`act_mul`);
* the **group laws**: closure (`mul` is total into `K4`, structural), associativity,
  two-sided identity, and **each element its own inverse** (`mul g g = id`);
* the abelian law `mul g h = mul h g` (`∼` and `−` commute);
* the **orbits**: `{t, f}` is the `∼`-orbit fixed by `−`; `{⊥, ⊤}` is the `−`-orbit
  fixed by `∼` — restated from `Four`'s `negate_orbit`/`conflate_orbit`;
* the **order-effects** of each element, reusing `Four`'s `_reverses`/`_preserves`;
* the **internal `ℤ/2` gauge** on valuations: the subgroup `{id, neg}` acting by
  `negateVal` (from `BigradedCohomology`), restated as a `K4`-gauge action, with
  paraconsistent points **gauge-stable** and classical points **gauge-moved**.

The `D₄`-with-`σ` extension (adjoining the order-swap involution `σ` to `K₄`,
yielding a dihedral symmetry of the twist-product) is **deferred**: it needs
`OrderSwapDuality`'s `σ`, to be added later.
-/

namespace Infomaterial
namespace Positing.Gauge

open Charge

/-! ## The carrier `K4 = {id, neg, conf, negConf}` -/

/-- The Klein-four group `K₄ = ⟨∼, −⟩` as a first-class four-element carrier: the
identity, negation `∼`, conflation `−`, and their composite `∼∘− = −∘∼`. -/
inductive K4 where
  /-- The identity element. -/
  | id
  /-- Negation `∼` — slot swap; the internal `ℤ/2` gauge generator. -/
  | neg
  /-- Conflation `−` — complemented slot swap. -/
  | conf
  /-- `∼∘−` — coordinatewise complement; the other nontrivial generator's product. -/
  | negConf
  deriving DecidableEq, Repr, Inhabited

namespace K4

/-- The four elements, enumerated. -/
def all : List K4 := [id, neg, conf, negConf]

theorem mem_all (g : K4) : g ∈ all := by
  charge
/-- `K₄` has exactly four elements. -/
theorem card_eq_four : all.length = 4 := rfl

/-! ## The action on `Charge`

Each group element acts on a charge by the corresponding `Four` map. -/

/-- The action `K4 → Charge → Charge`: `id` fixes, `neg` is `∼` (`negate`), `conf`
is `−` (`conflate`), `negConf` is `∼∘−` (`negConf`). -/
def act : K4 → Charge → Charge
  | K4.id,      a => a
  | K4.neg,     a => negate a
  | K4.conf,    a => conflate a
  | K4.negConf, a => Charge.negConf a

@[simp] theorem act_id (a : Charge) : act K4.id a = a := rfl
@[simp] theorem act_neg (a : Charge) : act K4.neg a = negate a := rfl
@[simp] theorem act_conf (a : Charge) : act K4.conf a = conflate a := rfl
@[simp] theorem act_negConf (a : Charge) : act K4.negConf a = Charge.negConf a := rfl

/-! ## The Cayley table (4×4)

The multiplication `g · h` is read off as "do `h`, then `g`" — i.e. the element
whose action equals `act g ∘ act h`. Each entry is forced by the involution and
commutation laws of `Four`; we record the table directly and then prove it
realizes composition. -/

/-- The group multiplication — the Cayley table of `K₄`. `mul g h` is the element
acting as `act g ∘ act h`. -/
def mul : K4 → K4 → K4
  | K4.id,      h        => h
  | g,          K4.id    => g
  | K4.neg,     K4.neg     => K4.id
  | K4.neg,     K4.conf    => K4.negConf
  | K4.neg,     K4.negConf => K4.conf
  | K4.conf,    K4.neg     => K4.negConf
  | K4.conf,    K4.conf    => K4.id
  | K4.conf,    K4.negConf => K4.neg
  | K4.negConf, K4.neg     => K4.conf
  | K4.negConf, K4.conf    => K4.neg
  | K4.negConf, K4.negConf => K4.id

/-- The whole Cayley table, presented as the explicit 4×4 grid (`rfl` per cell). -/
theorem cayley :
    -- row id
    mul K4.id K4.id = K4.id ∧ mul K4.id K4.neg = K4.neg
      ∧ mul K4.id K4.conf = K4.conf ∧ mul K4.id K4.negConf = K4.negConf
    -- row neg
    ∧ mul K4.neg K4.id = K4.neg ∧ mul K4.neg K4.neg = K4.id
      ∧ mul K4.neg K4.conf = K4.negConf ∧ mul K4.neg K4.negConf = K4.conf
    -- row conf
    ∧ mul K4.conf K4.id = K4.conf ∧ mul K4.conf K4.neg = K4.negConf
      ∧ mul K4.conf K4.conf = K4.id ∧ mul K4.conf K4.negConf = K4.neg
    -- row negConf
    ∧ mul K4.negConf K4.id = K4.negConf ∧ mul K4.negConf K4.neg = K4.conf
      ∧ mul K4.negConf K4.conf = K4.neg ∧ mul K4.negConf K4.negConf = K4.id :=
  ⟨rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl, rfl⟩

/-! ## The multiplication realizes composition of the action

This is the content that makes `K4` a *group acting on FOUR*, not just an abstract
table: `act (g · h) = act g ∘ act h`, pointwise. It is exactly here that `Four`'s
involution and commutation laws are used. -/

/-- **The action is a homomorphism.** `act (mul g h) a = act g (act h a)` — the
Cayley table is precisely composition of the `Four` maps. -/
theorem act_mul (g h : K4) (a : Charge) : act (mul g h) a = act g (act h a) := by
  charge

/-! ## The group laws -/

/-- **Left identity.** -/
@[simp] theorem id_mul (g : K4) : mul K4.id g = g := by
  charge
/-- **Right identity.** -/
@[simp] theorem mul_id (g : K4) : mul g K4.id = g := by
  charge

/-- **Associativity** — by exhaustion over the 64 triples. -/
theorem mul_assoc (g h k : K4) : mul (mul g h) k = mul g (mul h k) := by
  charge

/-- **Commutativity (abelian).** `∼` and `−` commute, so all of `K₄` does:
`g · h = h · g`. -/
theorem mul_comm (g h : K4) : mul g h = mul h g := by
  charge

/-- **Every element is its own inverse** — the defining `ℤ/2 × ℤ/2` shape: each
generator is an involution, hence each of the four squares to `id`. -/
theorem mul_self (g : K4) : mul g g = K4.id := by
  charge

/-- **Two-sided inverses.** Taking `g⁻¹ := g`, each element inverts itself on both
sides — `K₄` is a group with `inv = id`. -/
theorem inv_self (g : K4) : mul g g = K4.id ∧ mul g g = K4.id :=
  ⟨mul_self g, mul_self g⟩

/-- **Closure.** `mul` is a total function `K4 → K4 → K4`; every product of two
elements is again one of the four — structurally, the table never leaves `K4`. -/
theorem closure (g h : K4) : mul g h ∈ all := mem_all _

/-! ### The bundled group object

`K₄` is a (finite, abelian) group: associative, two-sided identity `id`, two-sided
inverse `inv = id`. We record the laws as one theorem, the "group object." -/

/-- **`K₄` is a group object** (in fact an abelian group `≅ ℤ/2 × ℤ/2`): associative
multiplication with identity `id` and each element self-inverse, and the action on
`FOUR` is a homomorphism. -/
theorem isGroup :
    (∀ g h k : K4, mul (mul g h) k = mul g (mul h k))
      ∧ (∀ g : K4, mul K4.id g = g ∧ mul g K4.id = g)
      ∧ (∀ g : K4, mul g g = K4.id)
      ∧ (∀ g h : K4, mul g h = mul h g)
      ∧ (∀ (g h : K4) (a : Charge), act (mul g h) a = act g (act h a)) :=
  ⟨mul_assoc, fun g => ⟨id_mul g, mul_id g⟩, mul_self, mul_comm, act_mul⟩

/-- The two generators `∼` and `−` generate the whole group: every element is `id`,
a generator, or their product. (Trivially: that is the carrier's enumeration.) -/
theorem generated_by_neg_conf (g : K4) :
    g = K4.id ∨ g = K4.neg ∨ g = K4.conf ∨ mul K4.neg K4.conf = g := by
  charge

/-! ## The orbits of `K₄` on `FOUR`

Restated from `Four.negate_orbit` / `Four.conflate_orbit`. The two non-identity
generators each have one 2-orbit and two fixed points; together they realize the
two orders' extreme/middle duality. -/

/-- The `∼`-orbit (action of `neg`) is `{t, f}`, swapped; the `−`-poles `⊥, ⊤` are
`∼`-fixed. -/
theorem neg_orbit :
    act K4.neg tTop = tBot ∧ act K4.neg tBot = tTop
      ∧ act K4.neg kBot = kBot ∧ act K4.neg kTop = kTop :=
  negate_orbit

/-- The `−`-orbit (action of `conf`) is `{⊥, ⊤}`, swapped; the `∼`-poles `t, f` are
`−`-fixed. -/
theorem conf_orbit :
    act K4.conf kBot = kTop ∧ act K4.conf kTop = kBot
      ∧ act K4.conf tTop = tTop ∧ act K4.conf tBot = tBot :=
  conflate_orbit

/-- `{t, f}` is the `∼`-orbit **fixed pointwise by `−`**: each is a `conf`-fixed
point, and `neg` swaps them. -/
theorem neg_orbit_conf_fixed :
    act K4.conf tTop = tTop ∧ act K4.conf tBot = tBot
      ∧ act K4.neg tTop = tBot ∧ act K4.neg tBot = tTop :=
  ⟨rfl, rfl, rfl, rfl⟩

/-- `{⊥, ⊤}` is the `−`-orbit **fixed pointwise by `∼`**: each is a `neg`-fixed
point, and `conf` swaps them. -/
theorem conf_orbit_neg_fixed :
    act K4.neg kBot = kBot ∧ act K4.neg kTop = kTop
      ∧ act K4.conf kBot = kTop ∧ act K4.conf kTop = kBot :=
  ⟨rfl, rfl, rfl, rfl⟩

/-- `∼∘−` (action of `negConf`) acts on each orbit as the *other* generator does:
it swaps `{⊥, ⊤}` (like `−`) and swaps `{t, f}` (like `∼`) — it reverses both
orders, so it moves both 2-orbits. -/
theorem negConf_moves_both :
    act K4.negConf kBot = kTop ∧ act K4.negConf kTop = kBot
      ∧ act K4.negConf tTop = tBot ∧ act K4.negConf tBot = tTop :=
  ⟨rfl, rfl, rfl, rfl⟩

/-! ## The order-effects of each element

Reusing `Four`'s `_reverses`/`_preserves` lemmas: `∼` preserves `≤ₖ` / reverses
`≤ₜ`; `−` reverses `≤ₖ` / preserves `≤ₜ`; `∼∘−` reverses both. -/

/-- `neg = ∼` **preserves** the knowledge order. -/
theorem neg_preserves_kle (a b : Charge) : KLE (act K4.neg a) (act K4.neg b) ↔ KLE a b :=
  negate_preserves_kle a b
/-- `neg = ∼` **reverses** the truth order. -/
theorem neg_reverses_tle (a b : Charge) : TLE (act K4.neg a) (act K4.neg b) ↔ TLE b a :=
  negate_reverses_tle a b
/-- `conf = −` **reverses** the knowledge order. -/
theorem conf_reverses_kle (a b : Charge) : KLE (act K4.conf a) (act K4.conf b) ↔ KLE b a :=
  conflate_reverses_kle a b
/-- `conf = −` **preserves** the truth order. -/
theorem conf_preserves_tle (a b : Charge) : TLE (act K4.conf a) (act K4.conf b) ↔ TLE a b :=
  conflate_preserves_tle a b
/-- `negConf = ∼∘−` **reverses both** orders. -/
theorem negConf_reverses_kle (a b : Charge) :
    KLE (act K4.negConf a) (act K4.negConf b) ↔ KLE b a :=
  Charge.negConf_reverses_kle a b
theorem negConf_reverses_tle (a b : Charge) :
    TLE (act K4.negConf a) (act K4.negConf b) ↔ TLE b a :=
  Charge.negConf_reverses_tle a b
/-- `id` preserves **both** orders — the trivial element fixes the bilattice. -/
theorem id_preserves (a b : Charge) :
    (KLE (act K4.id a) (act K4.id b) ↔ KLE a b)
      ∧ (TLE (act K4.id a) (act K4.id b) ↔ TLE a b) :=
  ⟨Iff.rfl, Iff.rfl⟩

/-! ## The internal `ℤ/2` gauge on valuations

The subgroup `⟨∼⟩ = {id, neg} ≅ ℤ/2` of `K₄` is the **internal gauge** of FOUR
(corpus: *internal-z2-gauge*). It acts on valuations by `negateVal` (the pointwise
`∼` from `BigradedCohomology`). We restate the gauge facts as the `K4`-gauge
action: it fixes the inconsistency side and sign-flips the truth side, paraconsistent
points are gauge-stable, classical points are gauge-moved. -/

/-- The `ℤ/2` gauge subgroup `{id, neg}`: a `K4` element is in the gauge iff it is
`id` or `neg`. -/
def inGauge : K4 → Bool
  | K4.id  => true
  | K4.neg => true
  | _      => false

/-- The gauge subgroup is closed under multiplication: `{id, neg}` is a subgroup
`≅ ℤ/2` of `K₄`. -/
theorem gauge_closed (g h : K4) (hg : inGauge g = true) (hh : inGauge h = true) :
    inGauge (mul g h) = true := by
  charge

/-- The gauge action on valuations: the nontrivial element `neg` acts as
`negateVal`, the identity acts trivially. -/
def gaugeAct : K4 → Valuation → Valuation
  | K4.neg, v => negateVal v
  | _,      v => v

@[simp] theorem gaugeAct_neg (v : Valuation) : gaugeAct K4.neg v = negateVal v := rfl
@[simp] theorem gaugeAct_id (v : Valuation) : gaugeAct K4.id v = v := rfl

/-- **The gauge fixes the inconsistency side.** Under the `neg`-gauge action, the
`⊤`-content is invariant (`⊤` is `∼`-fixed) — restated `gauge_fixes_inconsistency`. -/
theorem gauge_fixes_inconsistency (cells : List PredicationCell) (v : Valuation) :
    inconsistencyContent cells (gaugeAct K4.neg v) = inconsistencyContent cells v :=
  Infomaterial.gauge_fixes_inconsistency cells v

/-- **The gauge sign-flips the truth side.** A `t`-firing of the gauge-image is an
`f`-firing of `v` — restated `gauge_flips_truth`. -/
theorem gauge_flips_truth (cells : List PredicationCell) (v : Valuation) :
    truthContent cells (gaugeAct K4.neg v) = falseContent cells v :=
  Infomaterial.gauge_flips_truth cells v

/-- **Paraconsistent points are gauge-stable.** If every cell is `⊥` or `⊤`, the
whole `ℤ/2` gauge fixes `v`: every gauge element acts trivially. -/
theorem paraconsistent_gauge_stable (g : K4) (hg : inGauge g = true) (v : Valuation)
    (h : ∀ φ, v φ = kBot ∨ v φ = kTop) : gaugeAct g v = v := by
  cases g with
  | id => rfl
  | neg => exact Infomaterial.paraconsistent_gauge_stable v h
  | conf => simp [inGauge] at hg
  | negConf => simp [inGauge] at hg

/-- **Classical points are gauge-moved.** A `t`-cell is sent to an `f`-cell by the
gauge generator `neg` — restated `classical_gauge_moves`. -/
theorem classical_gauge_moves (v : Valuation) (φ : PredicationCell) (h : v φ = tTop) :
    gaugeAct K4.neg v φ ≠ v φ :=
  Infomaterial.classical_gauge_moves v φ h

/-! ## Deferred: the `D₄` extension

Adjoining the **order-swap involution** `σ` (swapping `≤ₖ ↔ ≤ₜ`) to the two
commuting involutions `∼, −` lifts the Klein-four `K₄` to a **dihedral** symmetry
`D₄` of the twist-product. This is **deferred**: it requires `OrderSwapDuality`'s
`σ`, which is to be added in a later module. Here we only certify the `K₄` core;
`σ` is not yet derivable in the spine, so the `D₄` group is not constructed. -/

end K4
end Positing.Gauge
end Infomaterial
