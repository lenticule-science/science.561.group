import Infomaterial.Relational.Spacetime.Causal.Cone
import Infomaterial.Cohomology.AlexandrovHusainov

/-!
# Causal Alexandrov topology — the topology generated by light cones

The synthetic Lorentzian bridge: from causal order to topology. `Cohomology.AlexandrovHusainov`
proves the generic fact that a poset's Alexandrov topology has up-sets for opens, that
specialization recovers the order, and that continuous maps are monotone. This module
**instantiates** that at the causal partial order `CausalLe` of a finite causal set, so that the
causal cones of `Lorentzian.ConeField` become the opens of a genuine topology — the corpus reading
*causal structure determines topology* (`content/.../lorentzian-causal-settling`), with no new
data: the topology is the Alexandrov topology of `causalPartialOrder`, itself built from the
`ConeField` order laws.

## Main definitions

* `causalPartialOrder` — the reflexive causal order `CausalLe` packaged as an `Order.PartialOrder`.
* `causalTopology` — its Alexandrov topology.
* `IsCausalOpen` — an up-set for reflexive causal precedence (a future-closed set).
* `CausalMonotone` — a causal-order-preserving map between causal sets.

## Main results

* `closedFuture_isOpen` / `future_isOpen` — future cones are open (principal up-sets).
* `specializes_iff_causalLe` — the specialization order **is** reflexive causal precedence.
* `reaches_iff_specializes_ne` — strict reachability is specialization plus inequality.
* `causalContinuous_iff_monotone` — continuous maps are exactly causal-monotone maps.
* `causal_alexandrov_recovers_cones` — the bundled headline: the Alexandrov topology recovers the
  causal order, strict reachability, and the openness of future cones.

## References

`content/.../lorentzian-causal-settling`. Built on `Infomaterial.Relational.Spacetime.Causal.Cone` and
`Infomaterial.Cohomology.AlexandrovHusainov`.

## Tags

Alexandrov topology, causal order, specialization order, light cone, causal continuity
-/

namespace Infomaterial
namespace Relational.Spacetime.Causal.Alexandrov

open Infomaterial.Relational.Spacetime.Causal.Order
open Infomaterial.Relational.Spacetime.Causal.Cone
open Infomaterial.Alexandrov

variable {E : Type} (C : CausalSet E)

/-! ## (A) The causal poset and its topology -/

/-- The reflexive causal order `CausalLe` as an `Order.PartialOrder` — reflexive, transitive,
antisymmetric by the `ConeField` cone laws. -/
def causalPartialOrder : Order.PartialOrder where
  carrier := E
  le := Spacetime.Causal.Cone.CausalLe C
  le_refl := Spacetime.Causal.Cone.causalLe_refl C
  le_trans := fun h1 h2 => Spacetime.Causal.Cone.causalLe_trans C h1 h2
  le_antisymm := fun h1 h2 => Spacetime.Causal.Cone.causalLe_antisymm C h1 h2

/-- The Alexandrov topology generated by the causal order: opens are the future-closed sets. -/
def causalTopology : AlexandrovTopology where
  poset := causalPartialOrder C

/-- A causal open is an up-set for reflexive causal precedence (a future-closed set). -/
def IsCausalOpen (U : E → Prop) : Prop :=
  ∀ ⦃x y : E⦄, U x → Spacetime.Causal.Cone.CausalLe C x y → U y

/-! ## (B) Cones are opens -/

/-- Causal openness is exactly Alexandrov openness in the causal topology. -/
theorem isCausalOpen_iff_isOpen (U : E → Prop) :
    IsCausalOpen C U ↔ (causalTopology C).IsOpen U := Iff.rfl

/-- The reflexive future cone is open — it is the principal up-set at `x`. -/
theorem closedFuture_isOpen (x : E) :
    (causalTopology C).IsOpen (Spacetime.Causal.Cone.ClosedFuture C x) :=
  (causalTopology C).isOpen_upperSet x

/-- The strict future cone is open — it is upward closed under causal precedence. -/
theorem future_isOpen (x : E) :
    (causalTopology C).IsOpen (Spacetime.Causal.Cone.Future C x) := by
  intro p q hp hpq
  exact Spacetime.Causal.Cone.future_is_upward_closed C hp hpq

/-! ## (C) Specialization recovers causal precedence -/

/-- The specialization order of the causal topology **is** reflexive causal precedence. -/
theorem specializes_iff_causalLe (x y : E) :
    (causalTopology C).specializes x y ↔ Spacetime.Causal.Cone.CausalLe C x y :=
  (causalTopology C).specializes_iff_le x y

/-- Strict reachability is specialization together with inequality. -/
theorem reaches_iff_specializes_ne {x y : E} :
    C.reaches x y ↔ ((causalTopology C).specializes x y ∧ x ≠ y) := by
  constructor
  · intro h
    refine ⟨(specializes_iff_causalLe C x y).mpr (Or.inr h), ?_⟩
    intro hxy
    exact C.reaches_irrefl x (hxy ▸ h)
  · rintro ⟨hspec, hne⟩
    rcases (specializes_iff_causalLe C x y).mp hspec with heq | hr
    · exact absurd heq hne
    · exact hr

/-! ## (D) Spacelike separation as topological incomparability -/

/-- For distinct events, mutual non-specialization is exactly spacelike separation. -/
theorem spacelike_iff_no_specialization {x y : E} (hne : x ≠ y) :
    Spacetime.Causal.Cone.Spacelike C x y ↔
      (¬ (causalTopology C).specializes x y ∧ ¬ (causalTopology C).specializes y x) := by
  constructor
  · rintro ⟨hxy, hyx⟩
    refine ⟨fun h => ?_, fun h => ?_⟩
    · rcases (specializes_iff_causalLe C x y).mp h with heq | hr
      · exact hne heq
      · exact hxy hr
    · rcases (specializes_iff_causalLe C y x).mp h with heq | hr
      · exact hne heq.symm
      · exact hyx hr
  · rintro ⟨hxy, hyx⟩
    refine ⟨fun h => hxy ((specializes_iff_causalLe C x y).mpr (Or.inr h)),
           fun h => hyx ((specializes_iff_causalLe C y x).mpr (Or.inr h))⟩

/-! ## (E) Continuous = causal monotone -/

/-- A causal-monotone map preserves reflexive causal precedence. -/
def CausalMonotone {F : Type} (C : CausalSet E) (D : CausalSet F) (f : E → F) : Prop :=
  ∀ ⦃x y : E⦄, Spacetime.Causal.Cone.CausalLe C x y → Spacetime.Causal.Cone.CausalLe D (f x) (f y)

/-- A map is continuous between causal topologies **iff** it is causal-monotone. -/
theorem causalContinuous_iff_monotone {F : Type} (C : CausalSet E) (D : CausalSet F)
    (f : E → F) :
    Continuous (causalTopology C) (causalTopology D) f ↔ CausalMonotone C D f :=
  continuous_iff_monotone (causalTopology C) (causalTopology D) f

/-! ## (F) The bundled headline -/

/-- **The causal Alexandrov topology recovers the cones.** The Alexandrov topology generated by a
finite causal set recovers exactly the reflexive causal order (as its specialization order),
strict reachability is specialization plus inequality, and every reflexive future cone is open. -/
theorem causal_alexandrov_recovers_cones :
    (∀ x y, (causalTopology C).specializes x y ↔ Spacetime.Causal.Cone.CausalLe C x y)
    ∧ (∀ x y, C.reaches x y ↔ ((causalTopology C).specializes x y ∧ x ≠ y))
    ∧ (∀ x, (causalTopology C).IsOpen (Spacetime.Causal.Cone.ClosedFuture C x)) :=
  ⟨fun x y => specializes_iff_causalLe C x y,
   fun _ _ => reaches_iff_specializes_ne C,
   fun x => closedFuture_isOpen C x⟩

end Relational.Spacetime.Causal.Alexandrov
end Infomaterial
