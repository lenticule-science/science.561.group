{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://research-notes.561.group/hacking/library/predication-notes/composting/library/object/library/thing/library/category/library/variety/library/bilattice/library/four-bilattice/four-bilattice.schema.json",
  "title": "FOUR (four-bilattice)",
  "description": "The four-element bilattice FOUR fully fixed as a schema via const. Any instance must equal this exact algebra: carrier {t, f, bot, top}, the two diamond orders (truth: f ≤_t bot ≤_t t, f ≤_t top ≤_t t; knowledge: bot ≤_k f ≤_k top, bot ≤_k t ≤_k top), negation fixing bot/top and swapping t/f, conflation fixing t/f and swapping bot/top.",
  "$ref": "https://research-notes.561.group/hacking/library/predication-notes/object/library/thing/library/category/library/variety/library/bilattice/bilattice.schema.json",
  "type": "object",
  "properties": {
    "carrier": {
      "const": ["t", "f", "bot", "top"]
    },
    "truth-meet": {
      "const": {
        "t":   {"t": "t",   "f": "f",   "bot": "bot", "top": "top"},
        "f":   {"t": "f",   "f": "f",   "bot": "f",   "top": "f"},
        "bot": {"t": "bot", "f": "f",   "bot": "bot", "top": "f"},
        "top": {"t": "top", "f": "f",   "bot": "f",   "top": "top"}
      }
    },
    "truth-join": {
      "const": {
        "t":   {"t": "t",   "f": "t",   "bot": "t",   "top": "t"},
        "f":   {"t": "t",   "f": "f",   "bot": "bot", "top": "top"},
        "bot": {"t": "t",   "f": "bot", "bot": "bot", "top": "t"},
        "top": {"t": "t",   "f": "top", "bot": "t",   "top": "top"}
      }
    },
    "knowledge-meet": {
      "const": {
        "t":   {"t": "t",   "f": "bot", "bot": "bot", "top": "t"},
        "f":   {"t": "bot", "f": "f",   "bot": "bot", "top": "f"},
        "bot": {"t": "bot", "f": "bot", "bot": "bot", "top": "bot"},
        "top": {"t": "t",   "f": "f",   "bot": "bot", "top": "top"}
      }
    },
    "knowledge-join": {
      "const": {
        "t":   {"t": "t",   "f": "top", "bot": "t",   "top": "top"},
        "f":   {"t": "top", "f": "f",   "bot": "f",   "top": "top"},
        "bot": {"t": "t",   "f": "f",   "bot": "bot", "top": "top"},
        "top": {"t": "top", "f": "top", "bot": "top", "top": "top"}
      }
    },
    "negating": {
      "const": {"t": "f", "f": "t", "bot": "bot", "top": "top"}
    },
    "conflating": {
      "const": {"t": "t", "f": "f", "bot": "top", "top": "bot"}
    }
  }
}
