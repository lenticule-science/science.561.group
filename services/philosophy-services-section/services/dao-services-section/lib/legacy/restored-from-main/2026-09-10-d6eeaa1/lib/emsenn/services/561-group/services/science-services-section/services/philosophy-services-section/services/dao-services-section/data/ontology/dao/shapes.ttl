@prefix sh:    <http://www.w3.org/ns/shacl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix daod:  <https://emsenn.net/ns/domain/daoist#> .

# =============================================================================
# Daoist ASR — SHACL Validation Shapes
#
# Comparative validity: a term is legible when it carries the identifying
# facts a search needs (hanzi, pinyin), cites at least one translation it
# was compared against, and grades its own house reading in the estate's
# own four-valued vocabulary rather than leaving it unstated. A translation
# must at minimum say who translated it. Section-wide: nothing cites itself.
# =============================================================================

daod:TermShape
    a sh:NodeShape ;
    sh:targetClass daod:Term ;
    sh:property [
        sh:path daod:hanzi ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A term MUST carry its hanzi."
    ] ;
    sh:property [
        sh:path daod:pinyin ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A term MUST carry its pinyin."
    ] ;
    sh:property [
        sh:path daod:cites ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A term SHOULD cite at least one translation it compares."
    ] ;
    sh:property [
        sh:path daod:houseGrade ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:in ( "B" "PROVED" "FRAMING" "VALVE" ) ;
        sh:severity sh:Violation ;
        sh:message "A term MUST grade its own house reading as exactly one of B, PROVED, FRAMING, or VALVE."
    ] ;
    sh:property [
        sh:path daod:isNewToGlossary ;
        sh:datatype xsd:boolean ;
        sh:maxCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A term SHOULD state whether its house reading is new to this glossary or quoted from an existing carrier."
    ] .

daod:TranslationShape
    a sh:NodeShape ;
    sh:targetClass daod:Translation ;
    sh:property [
        sh:path daod:translator ;
        sh:minCount 1 ;
        sh:severity sh:Violation ;
        sh:message "A translation MUST name its translator."
    ] ;
    sh:property [
        sh:path daod:translationYear ;
        sh:datatype xsd:integer ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A translation SHOULD state its first-publication year."
    ] .

daod:BookShape
    a sh:NodeShape ;
    sh:targetClass daod:Book ;
    sh:property [
        sh:path daod:classicalWork ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A book SHOULD state which classical work it concerns, or that it is original writing rather than commentary on one."
    ] .

daod:QuestionShape
    a sh:NodeShape ;
    sh:targetClass daod:Question ;
    sh:property [
        sh:path daod:cites ;
        sh:minCount 1 ;
        sh:severity sh:Warning ;
        sh:message "A question SHOULD cite the sources its survey actually checked."
    ] .

# --- Cross-type constraints ---

daod:NoSelfCitationShape
    a sh:NodeShape ;
    sh:targetClass daod:Term, daod:Book, daod:Question ;
    sh:sparql [
        sh:severity sh:Violation ;
        sh:message "A carrier must not cite, distinguish, or require itself." ;
        sh:prefixes daod: ;
        sh:select """
            SELECT $this WHERE {
                { $this daod:cites $this }
                UNION
                { $this daod:requires $this }
                UNION
                { $this daod:distinguishedFrom $this }
            }
        """
    ] .

daod:GroundingNamedShape
    a sh:NodeShape ;
    sh:targetSubjectsOf daod:cites ;
    sh:sparql [
        sh:severity sh:Warning ;
        sh:message "A cited translation rendering SHOULD name how it was grounded, so an unchecked quote is never indistinguishable from a checked one." ;
        sh:prefixes daod: ;
        sh:select """
            SELECT $this WHERE {
                $this daod:cites ?translation .
                FILTER NOT EXISTS { $this daod:groundingMethod ?method }
            }
        """
    ] .
