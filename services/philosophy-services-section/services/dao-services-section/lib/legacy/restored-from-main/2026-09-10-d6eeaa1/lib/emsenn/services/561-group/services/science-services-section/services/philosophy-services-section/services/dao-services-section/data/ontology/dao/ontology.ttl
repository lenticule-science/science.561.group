@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix daod:  <https://emsenn.net/ns/domain/daoist#> .
@prefix asr:   <https://emsenn.net/ns/agential-semioverse-repository#> .

daod: a owl:Ontology ;
    rdfs:label "Daoist ASR Ontology" ;
    rdfs:comment """
        Content types and typed relations for Daoist-philosophy knowledge
        within an Agential Semioverse Repository. Validity is comparative:
        a term is legible when its published-translation variance is
        grounded and this section's own reading is graded rather than
        asserted as a resolution of that variance.
    """ .

# --- Classes ---
# One class per carrier type this section actually produces, matching the
# section's own content/text/ layout rather than a general Daoist-studies
# taxonomy: a Term is a glossary carrier, a Translation a bibliography
# carrier, a Book this section's own original writing, a Question a
# first-class research question. No class for "hexagram" or "trigram" is
# minted here: those are the 2026 book of changes' own chapter content,
# not a distinct carrier class this section produces many of, and no
# sibling ontology in this tree (sociology, philosophy, games, education)
# mints entity classes below its own carrier-type grain either.

daod:Term a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Term" ;
    rdfs:comment "A Daodejing/Yijing vocabulary entry tracked across published translations against this section's own reading." .

daod:Translation a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Translation" ;
    rdfs:comment "One translator's published edition of a classical work this section cites." .

daod:Book a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Book" ;
    rdfs:comment "This section's own original writing about the Dao, not commentary on it as an external object." .

daod:Question a owl:Class ;
    rdfs:subClassOf asr:Content ;
    rdfs:label "Question" ;
    rdfs:comment "A first-class question whose placement in this section does not itself establish a Daoist attribution for it or its answer." .

# --- Object Properties ---

daod:cites a owl:ObjectProperty ;
    rdfs:label "cites" ;
    rdfs:comment "Source credits or references target." ;
    rdfs:range daod:Translation .

daod:formalizes a owl:ObjectProperty ;
    rdfs:label "formalizes" ;
    rdfs:comment "Source (a Book) states a graded house reading of target (a Term)." ;
    rdfs:domain daod:Book ;
    rdfs:range daod:Term ;
    owl:inverseOf daod:formalizedIn .

daod:formalizedIn a owl:ObjectProperty ;
    rdfs:label "formalized in" ;
    rdfs:comment "Source (a Term) has its house reading stated in target (a Book)." ;
    rdfs:domain daod:Term ;
    rdfs:range daod:Book ;
    owl:inverseOf daod:formalizes .

daod:requires a owl:ObjectProperty ;
    rdfs:label "requires" ;
    rdfs:comment "Source requires understanding of target — a compound term's declared constituent vocabulary (e.g. daodejing requires dao, de)." ;
    rdfs:domain daod:Term ;
    rdfs:range daod:Term .

daod:distinguishedFrom a owl:ObjectProperty ;
    rdfs:label "distinguished from" ;
    rdfs:comment "Source is a near neighbor of target that this section's own prose explicitly marks as a different concept, to head off a common conflation." ;
    rdfs:domain daod:Term ;
    rdfs:range daod:Term ;
    owl:inverseOf daod:distinguishedFrom .

# --- Datatype Properties ---
# Named to line up with translation-variance-record.schema.json's own
# field names one level down (data/records/schema/glossary/terms/), so
# the JSON-typed layer and the RDF-typed layer state the same facts under
# recognizably the same names rather than two silently drifting vocabularies.

daod:hanzi a owl:DatatypeProperty ;
    rdfs:label "hanzi" ;
    rdfs:comment "The term's Chinese characters as written in the received text." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:string .

daod:pinyin a owl:DatatypeProperty ;
    rdfs:label "pinyin" ;
    rdfs:comment "The term's pinyin romanization with tone marks." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:string .

daod:locus a owl:DatatypeProperty ;
    rdfs:label "locus" ;
    rdfs:comment "A chapter or other textual location, in the classical work, where the term is discussed. Not functional: a term may have several." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:string .

daod:classicalWork a owl:DatatypeProperty ;
    rdfs:label "classical work" ;
    rdfs:comment "The classical work (Daodejing, Yijing) a Term, Translation, or Book is about or an edition of." ;
    rdfs:range xsd:string .

daod:translator a owl:DatatypeProperty ;
    rdfs:label "translator" ;
    rdfs:comment "The translator's name as credited on the cited edition." ;
    rdfs:domain daod:Translation ;
    rdfs:range xsd:string .

daod:translationYear a owl:DatatypeProperty ;
    rdfs:label "translation year" ;
    rdfs:comment "First-publication year of the cited edition." ;
    rdfs:domain daod:Translation ;
    rdfs:range xsd:integer .

daod:houseGrade a owl:DatatypeProperty ;
    rdfs:label "house grade" ;
    rdfs:comment "This section's own [B]/PROVED/FRAMING/VALVE evidence grade for its reading of a Term, from the 2026 book of changes' own vocabulary." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:string .

daod:formalAnchor a owl:DatatypeProperty ;
    rdfs:label "formal anchor" ;
    rdfs:comment "When a Term's house reading extends the estate's own bilattice/causal-cone/settling-closure apparatus, the specific mechanism it extends. Absent when the reading is offered in plain prose without one, which this section treats as an honest choice rather than a gap to fill by force." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:string .

daod:isNewToGlossary a owl:DatatypeProperty ;
    rdfs:label "is new to glossary" ;
    rdfs:comment "False when a Term's house reading is quoted from a carrier this section already held before this glossary was built; true when this glossary is the first place the estate states it." ;
    rdfs:domain daod:Term ;
    rdfs:range xsd:boolean .

daod:groundingMethod a owl:DatatypeProperty ;
    rdfs:label "grounding method" ;
    rdfs:comment "How a cited translator rendering was checked before being recorded, named plainly so an ungrounded quote is never indistinguishable from a checked one: verified against the cited edition itself, checked against a translation-comparison aggregator, or not independently verified." ;
    rdfs:range xsd:string .
